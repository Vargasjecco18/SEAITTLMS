@using SEAITT_LMS.Auth
<!DOCTYPE html>
<html lang="en" data-theme="@Theme" data-theme-pref="@(Theme ?? "auto")" data-motion="@Motion" data-sound="@Sound">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    @* The look the person chose in the settings menu is kept in a cookie by wwwroot/app.js (and on the account, /account/look), and the server writes it onto <html> above. It has to come
       from the server: when a link is followed, Blazor swaps the page for the one the server sends, attributes of <html> included, so a look that only the browser knew would be lost.
       The script below only treats the login page (always Default) and the old memory of the browser. *@
    <script>
        (function () {
            try {
                var root = document.documentElement;
                // Round 48: the server draws the look (App.razor below reads the cookie: Default when there is none, the last look of the account after signing in). The login page is always
                // Default, and it clears what the browser kept of the person who was signed in before.
                if (/^\/login(\/|$)/i.test(location.pathname)) {
                    document.cookie = 'seaitt-theme=; path=/; max-age=0; samesite=lax';
                    document.cookie = 'seaitt-custom=; path=/; max-age=0; samesite=lax';
                    root.setAttribute('data-theme', 'default');
                    root.setAttribute('data-theme-pref', 'default');
                }
                localStorage.removeItem('seaitt-theme');
                localStorage.removeItem('seaitt-custom');
                root.removeAttribute('data-custom-scheme');
                root.removeAttribute('style');
                if (localStorage.getItem('seaitt-motion') === 'off') { root.setAttribute('data-motion', 'off'); }
                if (localStorage.getItem('seaitt-sound') === 'off') { root.setAttribute('data-sound', 'off'); }
                if (localStorage.getItem('seaitt-motion') === 'off' && document.cookie.indexOf('seaitt-motion=') < 0) { document.cookie = 'seaitt-motion=off; path=/; max-age=31536000; samesite=lax'; }
            } catch (e) { }
        })();
    </script>
    @* Each component's own .razor.css is bundled into this one file by Blazor. The colors live in App.razor.css. *@
    <link rel="stylesheet" href="@Assets["SEAITT-LMS.styles.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["app.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>The look the person chose (default, light, dark, midnight or paper), null for Auto (follow the computer). Round 48: Default when there is no cookie, and the login page is always Default.</summary>
    private string? Theme
    {
        get
        {
            if (HttpContext?.Request.Path.StartsWithSegments("/login") == true)
            {
                return Looks.Default;
            }

            return Looks.ThemeOf(HttpContext?.Request.Cookies[Looks.CookieName]);
        }
    }

    /// <summary>"off" when the person switched the animations off, otherwise null.</summary>
    private string? Motion => HttpContext?.Request.Cookies["seaitt-motion"] == "off" ? "off" : null;

    /// <summary>"off" when the person switched the sound of new messages and notifications off, otherwise null.</summary>
    private string? Sound => HttpContext?.Request.Cookies["seaitt-sound"] == "off" ? "off" : null;
}
