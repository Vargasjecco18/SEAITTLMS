<!DOCTYPE html>
<html lang="en" data-theme="@Theme" data-theme-pref="@(Theme ?? "auto")" data-motion="@Motion" data-sound="@Sound" data-custom-scheme="@CustomScheme" style="@CustomStyle">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    @* The look the person chose in the settings menu (light, dark or automatic) is kept in a cookie by wwwroot/app.js, and
       the server writes it onto <html> above. It has to come from the server: when a link is followed, Blazor swaps the page
       for the one the server sends, attributes of <html> included, so a look that only the browser knew would be lost.
       The script below is for a person who chose before the cookie existed (the choice was only in the browser then) and
       draws the right look before the page is shown, so it does not flash white first. *@
    <script>
        (function () {
            try {
                var root = document.documentElement;
                var theme = localStorage.getItem('seaitt-theme');
                var looks = ['light', 'dark', 'ocean', 'forest', 'sunset', 'paper', 'midnight', 'custom'];
                var known = looks.indexOf(theme) >= 0;
                if (known) { root.setAttribute('data-theme', theme); }
                if (theme === 'custom' && !root.getAttribute('style')) {
                    // the colors of Customize appearance, when the cookie that carries them to the server is missing
                    var c = JSON.parse(localStorage.getItem('seaitt-custom') || 'null');
                    if (c && /^#[0-9a-f]{6}$/i.test(c.bg) && /^#[0-9a-f]{6}$/i.test(c.surface) && /^#[0-9a-f]{6}$/i.test(c.text) && /^#[0-9a-f]{6}$/i.test(c.brand)) {
                        var n = parseInt(c.bg.slice(1), 16), dark = (0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255)) < 128;
                        root.style.cssText = '--c-bg:' + c.bg + ';--c-surface:' + c.surface + ';--c-text:' + c.text + ';--c-brand:' + c.brand + ';--c-scheme:' + (dark ? 'dark' : 'light');
                        root.setAttribute('data-custom-scheme', dark ? 'dark' : 'light');
                    }
                }
                root.setAttribute('data-theme-pref', known ? theme : 'auto');
                if (localStorage.getItem('seaitt-motion') === 'off') { root.setAttribute('data-motion', 'off'); }
                if (localStorage.getItem('seaitt-sound') === 'off') { root.setAttribute('data-sound', 'off'); }
                if (theme && document.cookie.indexOf('seaitt-theme=') < 0) { document.cookie = 'seaitt-theme=' + theme + '; path=/; max-age=31536000; samesite=lax'; }
                if (localStorage.getItem('seaitt-motion') === 'off' && document.cookie.indexOf('seaitt-motion=') < 0) { document.cookie = 'seaitt-motion=off; path=/; max-age=31536000; samesite=lax'; }
            } catch (e) { }
        })();
    </script>
    @* Each component's own .razor.css is bundled into this one file by Blazor. The colors live in App.razor.css. *@
    <link rel="stylesheet" href="@Assets["SEAITT-LMS.styles.css"]" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["app.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>The look the person chose (light, dark, ocean, forest, sunset, paper or midnight), otherwise null (automatic: follow the computer).</summary>
    private string? Theme
    {
        get
        {
            var choice = HttpContext?.Request.Cookies["seaitt-theme"];
            return choice is "light" or "dark" or "ocean" or "forest" or "sunset" or "paper" or "midnight" or "custom" ? choice : null;
        }
    }

    /// <summary>The four colors of Customize appearance from the cookie ("page,card,text,accent" as six hex digits each), checked: only hex colors are ever written onto the page.</summary>
    private string[]? CustomColors
    {
        get
        {
            if (Theme != "custom" || HttpContext?.Request.Cookies["seaitt-custom"] is not { } raw)
            {
                return null;
            }

            var parts = raw.Split(',');
            return parts.Length == 4 && parts.All(p => p.Length == 6 && p.All(Uri.IsHexDigit)) ? parts : null;
        }
    }

    /// <summary>"dark" when the page color of Customize appearance is dark (so the dark meaning colors are used), otherwise "light"; null when nothing custom is chosen.</summary>
    private string? CustomScheme
    {
        get
        {
            if (CustomColors is not { } c)
            {
                return null;
            }

            var n = Convert.ToInt32(c[0], 16);
            return 0.2126 * (n >> 16) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255) < 128 ? "dark" : "light";
        }
    }

    private string? CustomStyle => CustomColors is { } c ? $"--c-bg:#{c[0]};--c-surface:#{c[1]};--c-text:#{c[2]};--c-brand:#{c[3]};--c-scheme:{CustomScheme}" : null;

    /// <summary>"off" when the person switched the animations off, otherwise null.</summary>
    private string? Motion => HttpContext?.Request.Cookies["seaitt-motion"] == "off" ? "off" : null;

    /// <summary>"off" when the person switched the sound of new messages and notifications off, otherwise null.</summary>
    private string? Sound => HttpContext?.Request.Cookies["seaitt-sound"] == "off" ? "off" : null;
}
