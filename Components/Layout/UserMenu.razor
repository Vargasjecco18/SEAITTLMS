@using System.Security.Claims

<AuthorizeView>
    <Authorized>
        @{
            var name = context.User.Identity?.Name ?? "";
            var email = context.User.FindFirstValue(ClaimTypes.Email);
            var role = AppRoles.DisplayName(context.User.FindFirstValue(ClaimTypes.Role));
        }
        <details class="user-menu">
            <summary class="trigger" aria-label="Account menu">
                <Avatar Name="@name" />
                <span class="trigger-text">
                    <span class="trigger-name">@name</span>
                    <span class="trigger-role">@role</span>
                </span>
                <span class="chevron"><Icon Name="chevron-down" Size="16" /></span>
            </summary>

            <div class="panel">
                <div class="who">
                    <Avatar Name="@name" Size="44" />
                    <div class="who-text">
                        <span class="who-name">@name</span>
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <span class="who-email">@email</span>
                        }
                        <span class="who-role"><Badge Tone="Tone.Info">@role</Badge></span>
                    </div>
                </div>

                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="sign-out">
                        <Icon Name="log-out" Size="18" />
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </details>
    </Authorized>
</AuthorizeView>
