@using System.Security.Claims

@* Who is signed in, at the bottom of the menu, with the button to sign out. *@
<AuthorizeView>
    <Authorized>
        @{
            var name = context.User.Identity?.Name ?? "";
            var role = AppRoles.DisplayName(context.User.FindFirstValue(ClaimTypes.Role));
            int.TryParse(context.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);
        }
        <div class="card">
            <div class="who">
                <Avatar Name="@name" UserId="@userId" Size="40" />
                <span class="text">
                    <span class="name">@name</span>
                    <span class="role">@role</span>
                </span>
            </div>

            <form method="post" action="/account/logout">
                <AntiforgeryToken />
                <button type="submit" class="sign-out" aria-label="Sign out" title="Sign out">
                    <Icon Name="log-out" Size="18" />
                </button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>
