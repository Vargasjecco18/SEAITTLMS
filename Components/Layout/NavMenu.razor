<nav class="nav" aria-label="Main menu">
    @* Each role sees only its own pages. When the pointer rests on a page, a box shows what is inside it (see NavItem). *@
    <AuthorizeView Roles="@AppRoles.Admin">
        <p class="heading">Administration</p>

        <NavItem Href="admin" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="Accounts and enrollment of the school at a glance."
                 Items="AdminDashboard" />
        <NavItem Href="admin/users" Icon="users" Label="Users Management"
                 Description="Add, edit and switch off the accounts of every role."
                 Items="AdminUsers" />
        <NavItem Href="admin/archive" Icon="archive" Label="Archive Accounts"
                 Description="Students who graduated or left school are archived here."
                 Contents="AdminArchive" />
        <NavItem Href="analytics" Icon="chart-column" Label="Analytics"
                 Description="How the students are doing across the school."
                 Contents="AnalyticsContents" />
        <NavItem Href="admin/security-logs" Icon="scroll-text" Label="Security Logs"
                 Description="Who signed in, who failed to, and what was changed."
                 Items="AdminLogs" />
        <NavItem Href="admin/backups" Icon="database-backup" Label="Database Backup &amp; Restore"
                 Description="Save a copy of all the data, and put it back."
                 Contents="AdminBackups" />
        <NavItem Href="admin/settings" Icon="settings-2" Label="System Settings"
                 Description="The school, signing in, maintenance, messages, backups and files."
                 Contents="AdminSettings" />
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.AcademicCoordinator">
        <p class="heading">Academics</p>

        <NavItem Href="coordinator" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="Evaluations, announcements and the school setup at a glance."
                 Contents="CoordinatorDashboard" />
        <NavItem Href="coordinator/academic-setup" Icon="school" Label="Academic setup"
                 Description="The school year, terms, tracks, strands, courses and sections."
                 Items="CoordinatorSetup" />
        <NavItem Href="coordinator/evaluations" Icon="clipboard-check" Label="Teacher evaluation"
                 Description="Questionnaires about the teachers, sent to the students."
                 Contents="CoordinatorEvaluations" />
        <NavItem Href="coordinator/announcements" Icon="megaphone" Label="Announcements"
                 Description="Notices for the students, the teachers or everybody."
                 Contents="CoordinatorAnnouncements" />
        <NavItem Href="coordinator/analytics" Icon="chart-column" Label="Analytics"
                 Description="How the teachers were evaluated."
                 Contents="CoordinatorAnalytics" />
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.AcademicProvider">
        <p class="heading">Central Team</p>

        <NavItem Href="provider" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="What you sent, and who opened it."
                 Contents="ProviderDashboard" />
        <NavItem Href="provider/library" Icon="folder-open" Label="Course library"
                 Description="The syllabus, modules and activities you send to the teachers."
                 Contents="ProviderLibrary" />
        <NavItem Href="provider/tracking" Icon="eye" Label="Tracking"
                 Description="Every module you sent, and whether it was opened."
                 Items="ProviderTracking" />
        <NavItem Href="provider/users" Icon="users-round" Label="Users"
                 Description="The teachers and the students, and what they opened."
                 Items="ProviderUsers" />
        <NavItem Href="provider/analytics" Icon="chart-column" Label="Analytics"
                 Description="How far what you send gets: teachers, students, courses."
                 Contents="ProviderAnalytics" />
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.Registrar">
        <p class="heading">Registrar</p>

        <NavItem Href="registrar" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="Enrollment at a glance."
                 Contents="RegistrarDashboard" />
        <NavItem Href="registrar/enrollments" Icon="clipboard-list" Label="Enrollments"
                 Description="Enroll a student: LRN, section, courses."
                 Contents="RegistrarEnrollments" />
        <NavItem Href="registrar/student-accounts" Icon="graduation-cap" Label="Student's Accounts"
                 Description="The enrolled students, and who is enrolled for the next term."
                 Contents="RegistrarAccounts" />
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.Teacher">
        <p class="heading">Teaching</p>

        <NavItem Href="teacher" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="What needs your attention today."
                 Contents="TeacherDashboard" />
        <NavItem Href="teacher/subjects" Icon="book-open" Label="Courses"
                 Description="The courses you teach, with their modules and work."
                 Items="TeacherCourses" />
        <NavItem Href="teacher/attendance" Icon="calendar-check" Label="Attendance"
                 Description="Mark who came to class."
                 Contents="TeacherAttendance" />
        <NavItem Href="calendar" Icon="calendar-days" Label="Calendar"
                 Description="Deadlines and postings."
                 Items="CalendarViews" />
        <NavItem Href="teacher/gradebook" Icon="clipboard-list" Label="Gradebook"
                 Description="The scores of every student of a course."
                 Contents="TeacherGradebook" />
        <NavItem Href="analytics" Icon="chart-column" Label="Analytics"
                 Description="How the students of your courses are doing."
                 Contents="AnalyticsContents" />
        <NavItem Href="users" Icon="users-round" Label="Users"
                 Description="Your friends, your students and the other teachers."
                 Items="TeacherUsers" />
        <NavItem Href="groups" Icon="users" Label="Groups"
                 Description="Study groups and teams you are in."
                 Items="GroupItems" />
        <NavItem Href="resources" Icon="folder-open" Label="Resources"
                 Description="Your locker and the files shared with you."
                 Items="ResourceItems" />
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.Student">
        <p class="heading">Learning</p>

        <NavItem Href="student" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="Your day at a glance."
                 Contents="StudentDashboard" />
        <NavItem Href="student/subjects" Icon="book-open" Label="Courses"
                 Description="Your courses, with how far along you are."
                 Items="StudentCourses" />
        <NavItem Href="student/grades" Icon="trending-up" Label="Grades"
                 Description="Your grade in every course."
                 Contents="StudentGrades" />
        <NavItem Href="calendar" Icon="calendar-days" Label="Calendar"
                 Description="Deadlines of your work."
                 Items="CalendarViews" />
        <NavItem Href="users" Icon="users-round" Label="Users"
                 Description="Your classmates, your friends and your teachers."
                 Items="StudentUsers" />
        <NavItem Href="groups" Icon="users" Label="Groups"
                 Description="Study groups and teams you are in."
                 Items="GroupItems" />
        <NavItem Href="resources" Icon="folder-open" Label="Resources"
                 Description="Your locker and the files shared with you."
                 Items="ResourceItems" />
    </AuthorizeView>

    <AuthorizeView Roles="@AppRoles.GuidanceCounselor">
        <p class="heading">Guidance</p>

        <NavItem Href="guidance" Icon="layout-dashboard" Label="Dashboard" Match="NavLinkMatch.All"
                 Description="Referrals and students who need help."
                 Contents="GuidanceDashboard" />
        <NavItem Href="guidance/referrals" Icon="flag" Label="Referrals"
                 Description="Students the system sent to you."
                 Items="GuidanceReferrals" />
        <NavItem Href="guidance/students" Icon="triangle-alert" Label="Students at risk"
                 Description="Who is failing, close to failing, or missing class."
                 Items="GuidanceAtRisk" />
        <NavItem Href="analytics" Icon="chart-column" Label="Analytics"
                 Description="How the students are doing across the school."
                 Contents="AnalyticsContents" />
    </AuthorizeView>
</nav>

