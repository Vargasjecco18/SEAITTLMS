@inherits LayoutComponentBase

<div class="shell">
    @* On small screens the menu opens with this checkbox (the menu button is its label), so it also works before any
       script has loaded. *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show or hide the menu" />

    <header class="header">
        <label for="nav-toggle" class="menu-button" title="Menu">
            <span class="when-closed"><Icon Name="menu" Size="22" /></span>
            <span class="when-open"><Icon Name="x" Size="22" /></span>
        </label>

        <Brand />

        @* The search in the middle: a plain form that opens the search page. On a phone it is the magnifying glass. *@
        <form class="search" role="search" method="get" action="search">
            <Icon Name="search" Size="18" Class="search-icon" />
            <input type="search" name="q" placeholder="Search courses, people and pages" aria-label="Search" autocomplete="off" />
        </form>
        <a class="search-link" href="search" aria-label="Search" title="Search"><Icon Name="search" Size="20" /></a>

        <AuthorizeView>
            <Authorized>
                <HeaderTools />
            </Authorized>
        </AuthorizeView>
    </header>

    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <aside class="sidebar">
        <div class="sidebar-menu">
            <NavMenu />
        </div>
        <div class="sidebar-user">
            <UserCard />
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@* Blazor shows this by itself when something goes wrong in a page that is live (the enrollment form, the user lists). *@
<div id="blazor-error-ui" role="alert">
    Something went wrong on this page. <a href="">Reload it</a> to continue.
</div>
