@inherits LayoutComponentBase

<div class="shell">
    @* On small screens the menu opens with this checkbox (the menu button is its label), so it also works before any
       script has loaded. *@
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Show or hide the menu" />

    <header class="header">
        <label for="nav-toggle" class="menu-button" title="Menu">
            <span class="when-closed"><Icon Name="menu" Size="22" /></span>
            <span class="when-open"><Icon Name="x" Size="22" /></span>
        </label>

        <Brand />

        <AuthorizeView>
            <Authorized>
                @* The search in the middle opens a pop-up (on a phone it is the magnifying glass). *@
                <SearchBox />
                <HeaderTools />
            </Authorized>
        </AuthorizeView>
    </header>

    <label for="nav-toggle" class="backdrop" aria-hidden="true"></label>

    <aside class="sidebar">
        @* On the pages where a lesson is read the menu folds to its icons (wwwroot/app.js, data-side-rail); this button shows it again, or folds it again. It is only seen there. *@
        <button type="button" class="rail-toggle" data-rail-toggle aria-label="Show or hide the names of the menu" title="Show or hide the names of the menu">
            <span class="rail-when-on"><Icon Name="panel-left-open" Size="18" /></span>
            <span class="rail-when-shown"><Icon Name="panel-left-close" Size="18" /> <span>Hide the names</span></span>
        </button>
        <div class="sidebar-menu">
            <NavMenu />
        </div>
        <div class="sidebar-user">
            <AuthorizeView>
                <Authorized>
                    <HelpLink />
                </Authorized>
            </AuthorizeView>
            <UserCard />
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<TopAlert />

@* Blazor shows this by itself when something goes wrong in a page that is live (the enrollment form, the user lists). *@
<div id="blazor-error-ui" role="alert">
    Something went wrong on this page. <a href="">Reload it</a> to continue.
</div>
