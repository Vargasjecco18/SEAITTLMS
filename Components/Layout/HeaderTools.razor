@rendermode InteractiveServer
@using Microsoft.JSInterop
@using SEAITT_LMS.Auth
@implements IDisposable
@inject CurrentUser Me
@inject MessageService Messages
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject LiveUpdates Live
@inject ProfilePhotoService Photos
@inject PresenceService Presence
@inject MessageLauncher Launcher
@inject PopupGate Gate
@inject IJSRuntime JS
@inject AuthService Auth
@inject NotificationSoundService Sounds

@* The buttons at the right of the header: messages, notifications and settings. It is a live component, so the
   numbers on the buttons keep up with what happens while a page is open. *@
@if (user is not null)
{
    <div class="tools">
        <button type="button" class="tool" aria-label="@MessagesLabel" title="Messages" @onclick="OpenMessages">
            <Icon Name="message-square" Size="20" />
            @if (unreadMessages > 0)
            {
                <span class="badge" aria-hidden="true">@Count(unreadMessages)</span>
            }
        </button>
        <details class="pop" id="notifications-menu" @ontoggle="OnNotificationsToggle">
            <summary class="tool" aria-label="@NotificationsLabel" title="Notifications">
                <Icon Name="bell" Size="20" />
                @if (unreadNotifications > 0)
                {
                    <span class="badge" aria-hidden="true">@Count(unreadNotifications)</span>
                }
            </summary>

            <div class="panel notifications">
                <div class="panel-head">
                    <strong>Notifications</strong>
                    @if (unreadNotifications > 0)
                    {
                        <button type="button" class="link-button" @onclick="MarkAllReadAsync">Mark all as read</button>
                    }
                </div>

                @if (notificationList is not { Items.Count: > 0 })
                {
                    <p class="empty"><Icon Name="bell" Size="22" /><span>Nothing new. You will see here what happens in your courses.</span></p>
                }
                else
                {
                    <ul class="notification-list">
                        @foreach (var item in notificationList.Items)
                        {
                            <li class="@(item.IsRead ? "" : "unread")">
                                <a href="@(item.Link ?? "#")" @onclick="() => OpenNotificationAsync(item)">
                                    <span class="kind"><Icon Name="@KindIcon(item.Kind)" Size="18" /></span>
                                    <span class="text">
                                        <span class="title">@item.Title</span>
                                        @if (!string.IsNullOrEmpty(item.Body))
                                        {
                                            <span class="body">@item.Body</span>
                                        }
                                        <span class="when">@PhilippineTime.FormatDate(item.CreatedAtUtc) · @PhilippineTime.FormatTime(item.CreatedAtUtc)</span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </details>

        <button type="button" class="tool" aria-label="Settings" title="Settings" @onclick="OpenSettings">
            <Icon Name="settings" Size="20" />
        </button>
    </div>

    @* The counselor saved something about the student: a box in the middle of the screen, like an achievement, until the student presses OK. *@
    <Modal Open="@(guidance is not null && !Gate.Busy)" Title="Your guidance counselor" Centered="true" Narrow="true" Top="true" OnClose="CloseGuidanceAsync">
        @if (guidance is { } note)
        {
            <div class="guidance-box">
                <span class="guidance-medal"><Icon Name="heart-handshake" Size="40" /></span>
                <h3>@note.Title</h3>
                @if (!string.IsNullOrWhiteSpace(note.Body))
                {
                    <p class="guidance-text">@note.Body</p>
                }

                @if (guidanceQueue.Count > 1)
                {
                    <p class="guidance-count">@guidanceQueue.Count messages waiting</p>
                }

                <Button IconName="@(guidanceQueue.Count > 1 ? "arrow-right" : "circle-check")" OnClick="CloseGuidanceAsync">@(guidanceQueue.Count > 1 ? "Next" : "OK")</Button>
            </div>
        }
    </Modal>

    @* The settings are a box: the picture, the password, the look of the pages and the sound. *@
    <Modal Open="settingsOpen" Title="Settings" OnClose="CloseSettings">
        @if (settingsOpen)
        {
            <form class="settings-box" @onsubmit="SaveAsync" autocomplete="off">
                <section class="settings-section" aria-labelledby="set-photo">
                    <h3 class="group-title" id="set-photo">Profile picture</h3>
                    <div class="photo-row">
                        <Avatar @key="Photos.VersionOf(user.UserId)" Name="@user.Name" UserId="@user.UserId" Size="64" />
                        <div class="photo-actions">
                            <label class="photo-button" aria-busy="@photoBusy">
                                <InputFile OnChange="PhotoChosenAsync" accept="image/jpeg,image/png,image/webp,image/gif" aria-label="Choose a picture" />
                                <Icon Name="@(photoBusy ? "loader" : "camera")" Size="16" />
                                <span>@(photoBusy ? "Saving…" : HasPhoto ? "Change picture" : "Upload a picture")</span>
                            </label>
                            @if (HasPhoto)
                            {
                                <button type="button" class="link-button" disabled="@photoBusy" @onclick="RemovePhotoAsync">Remove</button>
                            }
                        </div>
                    </div>
                    @if (photoMessage is not null)
                    {
                        <p class="photo-message @(photoFailed ? "failed" : "")" role="status">@photoMessage</p>
                    }
                    else
                    {
                        <p class="hint photo-hint">JPG, PNG, GIF or WebP. It is made small for you.</p>
                    }
                </section>

                <section class="settings-section" aria-labelledby="set-password">
                    <h3 class="group-title" id="set-password">Change password</h3>
                    <div>
                        <Field For="pw-current" Label="Current password">
                            <input id="pw-current" type="@(showPasswords ? "text" : "password")" autocomplete="current-password" maxlength="@PasswordPolicy.MaxLength" @bind="currentPassword" @bind:event="oninput" />
                        </Field>
                        <Field For="pw-new" Label="New password" Hint="@($"At least {PasswordPolicy.MinLength} characters.")">
                            <input id="pw-new" type="@(showPasswords ? "text" : "password")" autocomplete="new-password" maxlength="@PasswordPolicy.MaxLength" @bind="newPassword" @bind:event="oninput" />
                        </Field>
                        <Field For="pw-confirm" Label="Type the new password again">
                            <input id="pw-confirm" type="@(showPasswords ? "text" : "password")" autocomplete="new-password" maxlength="@PasswordPolicy.MaxLength" @bind="confirmPassword" @bind:event="oninput" />
                        </Field>
                        <label class="show-passwords"><input type="checkbox" @bind="showPasswords" /> <span>Show the passwords</span></label>
                        @if (passwordMessage is not null)
                        {
                            <p class="password-message" role="alert">@passwordMessage</p>
                        }

                        <p class="hint">Leave these empty to keep your password. To change it, fill them in and press <strong>Save</strong> at the bottom. After the change you log in again with the new password.</p>
                    </div>
                </section>

                <section class="settings-section" aria-labelledby="set-look">
                    <h3 class="group-title" id="set-look">Appearance</h3>
                    <div class="choices" role="group" aria-label="Appearance">
                        <button type="button" class="choice" data-theme-choice="light"><Icon Name="sun" Size="18" /><span>Light</span></button>
                        <button type="button" class="choice" data-theme-choice="dark"><Icon Name="moon" Size="18" /><span>Dark</span></button>
                        <button type="button" class="choice" data-theme-choice="auto"><Icon Name="monitor" Size="18" /><span>Auto</span></button>
                    </div>
                    <p class="hint">Auto follows the setting of your computer.</p>

                    <button type="button" class="switch" data-motion-toggle>
                        <span class="switch-text">
                            <strong>Animations</strong>
                            <small>Small movements when pages and menus open</small>
                        </span>
                        <span class="track" aria-hidden="true"><span class="thumb"></span></span>
                    </button>

                    <button type="button" class="switch" data-sound-toggle>
                        <span class="switch-text">
                            <strong>Sound</strong>
                            <small>A short sound when a new message or notification arrives</small>
                        </span>
                        <span class="track" aria-hidden="true"><span class="thumb"></span></span>
                    </button>
                </section>

                <section class="settings-section" aria-labelledby="set-sound-title">
                    <h3 class="group-title" id="set-sound-title">Notification sound</h3>
                    <p class="hint">The sound you hear when a new message or a notification arrives. Choose one (it plays so you can hear it), or add your own file, then press <strong>Save</strong>. The switch <strong>Sound</strong> above turns it on and off.</p>
                    <Field For="set-sound" Label="Sound">
                        <select id="set-sound" value="@pendingSound" @onchange="ChooseSoundAsync">
                            @foreach (var choice in new[] { "tones", "chime", "bell", "pop", "knock" })
                            {
                                <option value="@choice">@NotificationSoundService.DisplayChoice(choice)</option>
                            }
                            @if (sound.HasSchool)
                            {
                                <option value="school">@NotificationSoundService.DisplayChoice("school") (@sound.SchoolName)</option>
                            }
                            @if (sound.HasOwn)
                            {
                                <option value="custom">@NotificationSoundService.DisplayChoice("custom") (@sound.OwnName)</option>
                            }
                        </select>
                    </Field>
                    <div class="sound-actions">
                        <button type="button" class="link-button" data-sound-test data-sound-choice="@pendingSound" data-sound-url="@UrlOfSound(pendingSound)">Play it</button>
                        @if (sound.HasOwn)
                        {
                            <button type="button" class="link-button" disabled="@soundBusy" @onclick="RemoveOwnSoundAsync">Remove my own sound</button>
                        }
                    </div>
                    <label class="sound-upload">
                        <span>Add your own sound: an .mp3, .ogg, .wav or .m4a file of up to @(NotificationSoundService.MaxBytes / (1024 * 1024)) MB</span>
                        <InputFile id="set-sound-file" OnChange="SoundFileChosenAsync" accept=".mp3,.ogg,.oga,.wav,.m4a,.aac,audio/*" disabled="@soundBusy" aria-label="Choose a sound file" />
                    </label>
                    @if (soundMessage is not null)
                    {
                        <p class="photo-message @(soundFailed ? "failed" : "")" role="status">@soundMessage</p>
                    }
                </section>

                <div class="settings-footer">
                    <p class="save-note @(saveFailed ? "failed" : "")" role="status">@saveMessage</p>
                    <Button Variant="ButtonVariant.Ghost" OnClick="CloseSettings">Close</Button>
                    <Button Type="submit" IconName="@(saveBusy ? "loader" : "circle-check")" Disabled="@saveBusy">@(saveBusy ? "Saving…" : "Save")</Button>
                </div>
            </form>
        }
    </Modal>

    <Modal Open="messagesOpen" Title="Messages" Large="true" OnClose="CloseMessages">
        @if (messagesOpen)
        {
            <MessagesPanel @key="startWith" UserId="user.UserId" StartWith="startWith" OnChanged="RefreshCountsAsync" OnIncoming="PlayIncomingSoundAsync" />
        }
    </Modal>
}

@code {
    private CurrentUserInfo? user;
    private int unreadMessages;
    private int unreadNotifications;
    private NotificationList? notificationList;
    private bool messagesOpen;
    private int? startWith;
    private Timer? timer;
    private IDisposable? subscription;

    // What the guidance counselor wrote to this student and the student has not seen yet (a box in the middle of the screen shows the first).
    private List<NotificationItem> guidanceQueue = [];
    private NotificationItem? guidance => guidanceQueue.Count > 0 ? guidanceQueue[0] : null;

    private bool photoBusy;
    private bool photoFailed;
    private string? photoMessage;

    private SoundInfo sound = new("", null, null, 0, 0);
    private bool soundBusy;
    private bool soundFailed;
    private string? soundMessage;

    private bool settingsOpen;
    private string pendingSound = "tones";
    private bool saveBusy;
    private bool saveFailed;
    private string? saveMessage;
    private DateTime lastSessionTouch;
    private bool showPasswords;
    private string? passwordMessage;
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    private bool HasPhoto => user is not null && Photos.VersionOf(user.UserId) is not null;

    private string MessagesLabel => unreadMessages > 0 ? $"Messages, {unreadMessages} unread" : "Messages";

    private string NotificationsLabel => unreadNotifications > 0 ? $"Notifications, {unreadNotifications} new" : "Notifications";

    protected override async Task OnInitializedAsync()
    {
        user = await Me.GetAsync();
        if (user is null)
        {
            return;
        }

        // This person has a page open: that is what "online" is (see PresenceService). It is said again at every look below.
        Presence.Touch(user.UserId);
        Launcher.Requested += OnMessageRequested;
        Gate.Changed += OnGateChanged;

        sound = await Sounds.GetInfoAsync(user.UserId);
        await RefreshCountsAsync();
        await LoadNotificationsAsync();
        await LoadGuidanceAsync();

        // New messages and notifications show up by themselves: at once when they are sent (LiveUpdates), and the numbers are looked at
        // again every 10 seconds while the page is open, in case the news came from somewhere else.
        subscription = Live.Subscribe(user.UserId, () => InvokeAsync(RefreshAllAsync));
        timer = new Timer(_ => _ = InvokeAsync(RefreshAllAsync), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A browser keeps sound off until the person has clicked on the page once: if that has not happened yet the page says so and waits for the click (wwwroot/app.js).
        if (firstRender && user is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("seaitt.prepareSound");
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
            }
        }
    }

    /// <summary>A message of the other person came into the conversation that is open: the sound (the numbers in the header do not grow, because it is read at once).</summary>
    private async Task PlayIncomingSoundAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("seaitt.playNotificationSound", SoundChoiceForPlay, SoundUrl);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
        }
    }

    private async Task RefreshAllAsync()
    {
        try
        {
            if (user is not null)
            {
                Presence.Touch(user.UserId);

                // The sign-in says it is still in use (once a minute); when the account was signed in somewhere else it is over and this page goes to the login page.
                if (DateTime.UtcNow - lastSessionTouch > TimeSpan.FromSeconds(50))
                {
                    lastSessionTouch = DateTime.UtcNow;
                    if (!await Auth.TouchSessionAsync(user.UserId, user.SessionId))
                    {
                        Navigation.NavigateTo("/account/session-ended", forceLoad: true);
                        return;
                    }
                }
            }

            var knownMessages = unreadMessages;
            var knownNotifications = unreadNotifications;
            await RefreshCountsAsync();
            if (notificationList is not null)
            {
                await LoadNotificationsAsync();
            }

            await LoadGuidanceAsync();
            StateHasChanged();

            // Something new came in while the page was open: a short sound (wwwroot/app.js; the person can turn it off in Settings).
            if (unreadMessages > knownMessages || unreadNotifications > knownNotifications)
            {
                await JS.InvokeVoidAsync("seaitt.playNotificationSound", SoundChoiceForPlay, SoundUrl);
            }
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSException or JSDisconnectedException or InvalidOperationException)
        {
        }
    }

    /// <summary>A student looks for what the guidance counselor wrote (kept, in order, while one box is open).</summary>
    private async Task LoadGuidanceAsync()
    {
        if (user?.Role != AppRoles.Student)
        {
            return;
        }

        var unread = await Notifications.GetUnreadOfKindAsync(user.UserId, "referral");
        foreach (var item in unread.Where(n => guidanceQueue.All(q => q.Id != n.Id)))
        {
            guidanceQueue.Add(item);
        }
    }

    /// <summary>The student pressed OK: this message is read (it stays in the bell) and the next one, if any, shows.</summary>
    private async Task CloseGuidanceAsync()
    {
        if (guidance is { } shown && user is not null)
        {
            guidanceQueue.RemoveAt(0);
            await Notifications.MarkReadAsync(user.UserId, shown.Id);
            await RefreshCountsAsync();
        }
    }

    private async Task RefreshCountsAsync()
    {
        if (user is null)
        {
            return;
        }

        unreadMessages = await Messages.UnreadCountAsync(user.UserId);
        unreadNotifications = await Notifications.UnreadCountAsync(user.UserId);
    }

    private async Task LoadNotificationsAsync()
    {
        if (user is not null)
        {
            notificationList = await Notifications.GetAsync(user.UserId);
            unreadNotifications = notificationList.Unread;
        }
    }

    private async Task OnNotificationsToggle() => await LoadNotificationsAsync();

    private async Task OpenNotificationAsync(NotificationItem item)
    {
        if (user is not null && !item.IsRead)
        {
            await Notifications.MarkReadAsync(user.UserId, item.Id);
            await LoadNotificationsAsync();
        }
    }

    private async Task MarkAllReadAsync()
    {
        if (user is not null)
        {
            await Notifications.MarkAllReadAsync(user.UserId);
            await LoadNotificationsAsync();
        }
    }

    // The picture is made small (256 pixels, JPEG) in the browser before it is sent, so a big photo from a phone is fine.
    private async Task PhotoChosenAsync(InputFileChangeEventArgs e)
    {
        if (user is null || photoBusy)
        {
            return;
        }

        photoBusy = true;
        photoMessage = null;
        photoFailed = false;
        try
        {
            var file = e.File;
            if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidDataException("Choose a picture: a JPG, PNG, GIF or WebP file.");
            }

            if (file.Size > ProfilePhotoService.MaxChosenBytes)
            {
                throw new InvalidDataException("That file is too big. Choose a picture under 12 MB.");
            }

            var small = await file.RequestImageFileAsync("image/jpeg", 256, 256);
            await using var stream = small.OpenReadStream(ProfilePhotoService.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var result = await Photos.SetAsync(user.UserId, buffer.ToArray());
            photoFailed = !result.Succeeded;
            photoMessage = result.Succeeded ? result.Message : string.Join(" ", result.Errors);
            if (result.Succeeded)
            {
                await ShowPictureInMenuAsync();
            }
        }
        catch (InvalidDataException ex)
        {
            photoFailed = true;
            photoMessage = ex.Message;
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException or TimeoutException)
        {
            photoFailed = true;
            photoMessage = "That picture could not be read. Try another one.";
        }
        finally
        {
            photoBusy = false;
        }
    }

    // The card at the bottom of the menu is not part of this live component (the page draws it), so it is told what its picture is now.
    private async Task ShowPictureInMenuAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("seaitt.setMyPicture", user is null ? null : Photos.UrlOf(user.UserId));
        }
        catch (JSException)
        {
        }
    }

    private async Task RemovePhotoAsync()
    {
        if (user is null || photoBusy)
        {
            return;
        }

        photoBusy = true;
        try
        {
            var result = await Photos.RemoveAsync(user.UserId);
            photoFailed = !result.Succeeded;
            photoMessage = result.Message;
            await ShowPictureInMenuAsync();
        }
        finally
        {
            photoBusy = false;
        }
    }

    private void OpenMessages() => messagesOpen = true;

    private async Task OpenSettings()
    {
        photoMessage = null;
        passwordMessage = null;
        saveMessage = null;
        saveFailed = false;
        if (user is not null)
        {
            sound = await Sounds.GetInfoAsync(user.UserId);
            soundMessage = null;
            pendingSound = EffectiveSoundChoice;
        }

        settingsOpen = true;
    }

    /// <summary>What the browser plays: the choice ("" is the sound of the school when there is one, else two tones) and the address of the file when there is one.</summary>
    private string SoundChoiceForPlay => sound.Choice != "" ? sound.Choice : sound.HasSchool ? "school" : "";

    private string SoundUrl => UrlOfSound(SoundChoiceForPlay);

    /// <summary>The choice the person has now, as the box of the settings shows it: the saved one, else the sound of the school when there is one, else the two tones.</summary>
    private string EffectiveSoundChoice => sound.Choice != "" ? sound.Choice : sound.HasSchool ? "school" : "tones";

    /// <summary>The address of the file for a choice (the school's or the person's own), or empty for a sound the browser makes by itself.</summary>
    private string UrlOfSound(string choice) => choice switch
    {
        "custom" => $"account/notification-sound?v={sound.OwnVersion}",
        "school" => $"account/school-sound?v={sound.SchoolVersion}",
        _ => "",
    };

    /// <summary>A sound is chosen in the list: it plays so the person hears it, and it is kept when they press Save.</summary>
    private async Task ChooseSoundAsync(ChangeEventArgs e)
    {
        if (soundBusy)
        {
            return;
        }

        pendingSound = e.Value?.ToString() ?? pendingSound;
        soundFailed = false;
        soundMessage = "Press Save to keep this sound.";
        await JS.InvokeVoidAsync("seaitt.playNotificationSound", pendingSound, UrlOfSound(pendingSound), true);
    }

    private async Task SoundFileChosenAsync(InputFileChangeEventArgs e)
    {
        if (user is null || soundBusy)
        {
            return;
        }

        soundBusy = true;
        try
        {
            var file = e.File;
            if (NotificationSoundService.TypeOf(file.Name) is null)
            {
                soundFailed = true;
                soundMessage = "Choose a sound file: .mp3, .ogg, .wav, .m4a or .aac.";
                return;
            }

            if (file.Size > NotificationSoundService.MaxBytes)
            {
                soundFailed = true;
                soundMessage = $"The sound is bigger than {NotificationSoundService.MaxBytes / (1024 * 1024)} MB. A sound of a second or two is enough.";
                return;
            }

            await using var stream = file.OpenReadStream(NotificationSoundService.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Sounds.SaveOwnAsync(user.UserId, file.Name, buffer.ToArray());
            soundFailed = !result.Succeeded;
            soundMessage = result.Succeeded ? result.Message : string.Join(" ", result.Errors);
            sound = await Sounds.GetInfoAsync(user.UserId);
            if (result.Succeeded)
            {
                // The file is kept and chosen at once (it has to be kept to be heard); Save keeps the other choices.
                pendingSound = EffectiveSoundChoice;
                await JS.InvokeVoidAsync("seaitt.playNotificationSound", SoundChoiceForPlay, SoundUrl, true);
            }
        }
        catch (IOException)
        {
            soundFailed = true;
            soundMessage = "The file could not be read. Try again.";
        }
        finally
        {
            soundBusy = false;
        }
    }

    private async Task RemoveOwnSoundAsync()
    {
        if (user is null || soundBusy)
        {
            return;
        }

        soundBusy = true;
        try
        {
            var result = await Sounds.RemoveOwnAsync(user.UserId);
            soundFailed = !result.Succeeded;
            soundMessage = result.Message;
            sound = await Sounds.GetInfoAsync(user.UserId);
            pendingSound = EffectiveSoundChoice;
        }
        finally
        {
            soundBusy = false;
        }
    }

    private void CloseSettings()
    {
        settingsOpen = false;
        currentPassword = newPassword = confirmPassword = "";
        passwordMessage = null;
        saveMessage = null;
        showPasswords = false;
    }

    /// <summary>
    /// The Save button at the bottom of the settings: it keeps the sound that is chosen in the list and, when the password boxes are filled in, changes the password (the page then goes to the
    /// login page). The picture, the file of the person's own sound and the look of the pages are kept as soon as they are chosen.
    /// </summary>
    private async Task SaveAsync()
    {
        if (user is null || saveBusy)
        {
            return;
        }

        saveBusy = true;
        saveMessage = null;
        saveFailed = false;
        passwordMessage = null;
        try
        {
            if (pendingSound != EffectiveSoundChoice)
            {
                var chosen = await Sounds.SetChoiceAsync(user.UserId, pendingSound);
                if (!chosen.Succeeded)
                {
                    saveFailed = true;
                    saveMessage = string.Join(" ", chosen.Errors);
                    return;
                }

                sound = await Sounds.GetInfoAsync(user.UserId);
                pendingSound = EffectiveSoundChoice;
                soundMessage = null;
            }

            if (currentPassword.Length > 0 || newPassword.Length > 0 || confirmPassword.Length > 0)
            {
                var changed = await Auth.ChangePasswordAsync(user.UserId, currentPassword, newPassword, confirmPassword);
                if (changed.Succeeded)
                {
                    // The session ends with the old password (a new security stamp): that page signs out and the login page says what happened.
                    Navigation.NavigateTo("/account/password-changed", forceLoad: true);
                    return;
                }

                passwordMessage = string.Join(" ", changed.Errors);
                currentPassword = "";
                saveFailed = true;
                saveMessage = "The password was not changed.";
                return;
            }

            saveMessage = "Saved.";
        }
        finally
        {
            saveBusy = false;
        }
    }

    // A page asked for the messages box on one person ("Message" on the Users page).
    private void OnMessageRequested(int otherUserId) => _ = InvokeAsync(() =>
    {
        startWith = otherUserId; // the box is made again for this person (the @key of the box is this number)
        messagesOpen = true;
        StateHasChanged();
    });

    private async Task CloseMessages()
    {
        messagesOpen = false;
        startWith = null;
        await RefreshCountsAsync();
    }

    private static string Count(int n) => n > 9 ? "9+" : n.ToString();

    private static string KindIcon(string kind) => kind switch
    {
        "message" => "message-square",
        "module" => "book-open",
        "activity" or "quiz" or "task" => "clipboard-list",
        "grade" => "award",
        "due" => "alarm-clock",
        "referral" => "flag",
        "attendance" => "calendar-check",
        "achievement" => "trophy",
        "announcement" => "megaphone",
        "materials" => "folder-open",
        "evaluation" => "clipboard-check",
        "calendar" => "calendar-days",
        _ => "bell",
    };

    public void Dispose()
    {
        timer?.Dispose();
        subscription?.Dispose();
        Launcher.Requested -= OnMessageRequested;
        Gate.Changed -= OnGateChanged;
    }

    // An achievement box opened or closed: the box of the guidance counselor hides or shows again.
    private void OnGateChanged() => _ = InvokeAsync(StateHasChanged);
}
