@implements IDisposable
@using Microsoft.AspNetCore.Components.Forms
@inject MessageService Messages
@inject LiveUpdates Live
@inject SystemSettingsService Settings

@* The inside of the Messages box: the conversations at the left, the open conversation at the right. On a phone one of the
   two shows at a time. *@
<div class="messages @(selected is not null ? "has-thread" : "")">
    <section class="list" aria-label="Conversations">
        <div class="list-head">
            <div class="search">
                <Icon Name="search" Size="16" Class="search-icon" />
                <input type="search" placeholder="Find a person" aria-label="Find a person" autocomplete="off" @bind="search" @bind:event="oninput" @bind:after="SearchAsync" />
            </div>
        </div>

        <div class="list-body">
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <p class="list-title">People</p>
                @if (contacts.Count == 0)
                {
                    <p class="empty">Nobody found.</p>
                }

                @foreach (var contact in contacts)
                {
                    <button type="button" class="person @(selected?.UserId == contact.UserId ? "active" : "")" @onclick="() => SelectAsync(contact)">
                        <Avatar Name="@contact.Name" UserId="@contact.UserId" Size="38" />
                        <span class="person-text">
                            <span class="person-name">@contact.Name</span>
                            <span class="person-sub">@contact.Detail</span>
                        </span>
                    </button>
                }
            }
            else
            {
                @if (conversations.Count == 0)
                {
                    <div class="empty big">
                        <Icon Name="message-square" Size="28" />
                        <p>No conversations yet.</p>
                        <p class="hint">Type a name above to write to somebody.</p>
                    </div>
                }

                @foreach (var conversation in conversations)
                {
                    <button type="button" class="person @(selected?.UserId == conversation.With.UserId ? "active" : "") @(conversation.Unread > 0 ? "unread" : "")"
                            @onclick="() => SelectAsync(conversation.With)">
                        <Avatar Name="@conversation.With.Name" UserId="@conversation.With.UserId" Size="38" />
                        <span class="person-text">
                            <span class="person-name">@conversation.With.Name</span>
                            <span class="person-sub">@(conversation.LastFromMe ? "You: " : "")@conversation.LastBody</span>
                        </span>
                        @if (conversation.Unread > 0)
                        {
                            <span class="count">@conversation.Unread</span>
                        }
                    </button>
                }
            }
        </div>
    </section>

    <section class="thread" aria-label="Conversation">
        @if (selected is null)
        {
            <div class="empty big">
                <Icon Name="message-circle" Size="32" />
                <p>Pick a conversation or search for a person.</p>
            </div>
        }
        else
        {
            <header class="thread-head">
                <button type="button" class="back" aria-label="Back to the conversations" @onclick="Back"><Icon Name="chevron-left" Size="20" /></button>
                <Avatar Name="@selected.Name" UserId="@selected.UserId" Size="38" />
                <div class="thread-who">
                    <strong>@selected.Name</strong>
                    <span>@selected.Detail</span>
                </div>
            </header>

            <div class="bubbles" @ref="bubblesElement">
                @if (thread.Count == 0)
                {
                    <p class="empty">No messages yet. Say hello.</p>
                }

                @foreach (var message in thread)
                {
                    <div class="bubble @(message.Mine ? "mine" : "theirs")">
                        @if (!string.IsNullOrEmpty(message.Body))
                        {
                            <p>@message.Body</p>
                        }

                        @if (message.Files is { Count: > 0 })
                        {
                            <AttachmentList Items="message.Files" Label="Files of this message" />
                        }

                        <span class="time">@PhilippineTime.FormatDate(message.SentAtUtc) · @PhilippineTime.FormatTime(message.SentAtUtc)</span>
                    </div>
                }
            </div>

            @if (closed)
            {
                <div class="closed" role="status">
                    <Icon Name="moon" Size="18" />
                    <span>@MessagingHours.ClosedText</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="error" role="alert">@error</p>
            }

            @if (pending.Count > 0)
            {
                <ul class="pending" aria-label="Files to send">
                    @foreach (var file in pending)
                    {
                        var chosen = file;
                        <li><Icon Name="file" Size="14" /><span class="pname">@chosen.Name</span><span class="psize">@FileSize.Text(chosen.Data.Length)</span>
                            <button type="button" aria-label="@($"Do not send {chosen.Name}")" title="Do not send" @onclick="() => pending.Remove(chosen)"><Icon Name="x" Size="12" /></button></li>
                    }
                </ul>
            }

            <form class="composer" @onsubmit="SendAsync">
                @* The paper clip, at the left of Send: choose files to send with the message. *@
                <label class="attach @(closed || sending || reading ? "off" : "")" title="Send files" aria-label="Send files">
                    <InputFile OnChange="ChooseFilesAsync" multiple disabled="@(closed || sending || reading)" />
                    <Icon Name="@(reading ? "loader" : "paperclip")" Size="18" />
                </label>
                <input type="text" placeholder="@(closed ? "Messages are closed until 7:00 AM" : "Write a message")" aria-label="Message" maxlength="@MessageService.MaxLength"
                       autocomplete="off" disabled="@closed" @bind="draft" @bind:event="oninput" />
                <button type="submit" class="send" aria-label="Send" disabled="@(closed || sending || reading || (string.IsNullOrWhiteSpace(draft) && pending.Count == 0))"><Icon Name="send" Size="18" /></button>
            </form>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public int UserId { get; set; }

    /// <summary>The person whose conversation is opened first (when the box is opened from "Message" on a person).</summary>
    [Parameter] public int? StartWith { get; set; }

    /// <summary>Called when something was read or sent, so the numbers in the header can be updated.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Called when a new message of the other person arrives in the conversation that is open (it is read at once, so the number in the header never grows): the header plays the sound.</summary>
    [Parameter] public EventCallback OnIncoming { get; set; }

    private IReadOnlyList<Conversation> conversations = [];
    private IReadOnlyList<Contact> contacts = [];
    private IReadOnlyList<ChatMessage> thread = [];
    private Contact? selected;
    private string search = "";
    private string draft = "";
    private string? error;
    private bool closed;
    private bool sending;
    private bool reading;
    private bool scrollDown;
    private readonly List<NewAttachment> pending = [];
    private ElementReference bubblesElement;
    private Timer? timer;
    private IDisposable? subscription;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        closed = Messages.IsClosed;
        conversations = await Messages.GetConversationsAsync(UserId);

        if (StartWith is { } first && await Messages.GetContactAsync(UserId, first) is { } contact)
        {
            selected = contact;
            thread = await Messages.GetThreadAsync(UserId, contact.UserId);
            scrollDown = true;
            await OnChanged.InvokeAsync();
        }

        // While the box is open a new message shows up at once (LiveUpdates), and it also looks for new ones every 5 seconds.
        subscription = Live.Subscribe(UserId, () => InvokeAsync(RefreshAsync));
        timer = new Timer(_ => _ = InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollDown)
        {
            scrollDown = false;
            try
            {
                await JS.InvokeVoidAsync("seaitt.scrollToEnd", bubblesElement);
            }
            catch (JSException)
            {
            }
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            closed = Messages.IsClosed;
            conversations = await Messages.GetConversationsAsync(UserId);
            if (selected is not null)
            {
                var latest = await Messages.GetThreadAsync(UserId, selected.UserId);
                var arrived = latest.Count > thread.Count && latest.Count > 0 && !latest[^1].Mine;
                scrollDown = latest.Count != thread.Count;
                thread = latest;
                StateHasChanged();
                if (arrived)
                {
                    await OnIncoming.InvokeAsync();
                }

                return;
            }

            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task SearchAsync() =>
        contacts = string.IsNullOrWhiteSpace(search) ? [] : await Messages.GetContactsAsync(UserId, search);

    private async Task SelectAsync(Contact contact)
    {
        selected = contact;
        error = null;
        draft = "";
        pending.Clear();
        thread = await Messages.GetThreadAsync(UserId, contact.UserId);
        conversations = await Messages.GetConversationsAsync(UserId);
        scrollDown = true;
        await OnChanged.InvokeAsync();
    }

    private void Back() => selected = null;

    /// <summary>The files chosen with the paper clip are read now and sent with the next message.</summary>
    private async Task ChooseFilesAsync(InputFileChangeEventArgs e)
    {
        reading = true;
        error = null;
        try
        {
            var maxBytes = Settings.Current.MaxFileMegabytes * 1024L * 1024;
            IReadOnlyList<IBrowserFile> chosen;
            try
            {
                chosen = e.GetMultipleFiles(AttachmentService.MaxPerOwner);
            }
            catch (InvalidOperationException)
            {
                error = $"Choose at most {AttachmentService.MaxPerOwner} files at a time.";
                return;
            }

            foreach (var file in chosen)
            {
                if (pending.Count >= AttachmentService.MaxPerOwner)
                {
                    error = $"At most {AttachmentService.MaxPerOwner} files in a message.";
                    break;
                }

                if (FileService.IsBlocked(file.Name))
                {
                    error = $"{file.Name}: programs and scripts can't be sent.";
                    continue;
                }

                if (file.Size > maxBytes)
                {
                    error = $"{file.Name} is bigger than {Settings.Current.MaxFileMegabytes} MB.";
                    continue;
                }

                try
                {
                    await using var stream = file.OpenReadStream(maxBytes);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    pending.Add(new NewAttachment(file.Name, file.ContentType, buffer.ToArray()));
                }
                catch (IOException)
                {
                    error = $"{file.Name} could not be read.";
                }
            }
        }
        finally
        {
            reading = false;
        }
    }

    private async Task SendAsync()
    {
        if (selected is null || sending)
        {
            return;
        }

        sending = true;
        error = null;
        try
        {
            var result = await Messages.SendAsync(UserId, selected.UserId, draft, pending.ToList());
            closed = Messages.IsClosed;
            if (result.Succeeded)
            {
                draft = "";
                pending.Clear();
                thread = await Messages.GetThreadAsync(UserId, selected.UserId);
                conversations = await Messages.GetConversationsAsync(UserId);
                scrollDown = true;
            }
            else
            {
                error = result.Error;
            }
        }
        finally
        {
            sending = false;
        }
    }

    public void Dispose()
    {
        timer?.Dispose();
        subscription?.Dispose();
    }
}
