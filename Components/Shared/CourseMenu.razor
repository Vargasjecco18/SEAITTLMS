@* The second menu of a course: Modules, Seatwork, Assignments, Quizzes and Task performance, each a dropdown that lists what is inside (press Modules and the modules show, press
   Quizzes and the quizzes show), and, under a line, the pages that belong to the course (for a teacher the students, the gradebook and the attendance, for a student the classmates,
   the teacher and the grades). The menu of the school stays as it is. The dropdowns are plain HTML (details), so they work without scripts. *@
<nav class="course-menu" id="@Id" aria-label="Menu of the course">
    @foreach (var group in Groups)
    {
        var isOpen = group.Key == Selected || group.Entries.Any(e => e.Current);
        <details class="cm-group" open="@isOpen" data-course-group="@group.Key">
            <summary class="cm-item @(isOpen ? "on" : "")">
                <Icon Name="@group.Icon" Size="18" /> <span class="cm-label">@group.Label</span> <span class="cm-count">@group.Count</span>
                <span class="cm-chevron" aria-hidden="true"><Icon Name="chevron-down" Size="16" /></span>
            </summary>
            <ul class="cm-list">
                <li><a class="cm-all @(group.Key == Selected ? "on" : "")" href="@group.SeeAllHref" data-course-menu="@group.Key"><Icon Name="list" Size="14" /> <span>See all @group.Label.ToLowerInvariant()</span></a></li>
                @foreach (var entry in group.Entries)
                {
                    <li><a class="cm-entry @(entry.Current ? "on" : "")" href="@entry.Href" aria-current="@(entry.Current ? "page" : null)" title="@entry.Title"><span>@entry.Title</span></a></li>
                }
                @if (group.Entries.Count == 0)
                {
                    <li class="cm-none">None yet.</li>
                }
            </ul>
        </details>
    }

    @if (Extra.Count > 0)
    {
        <span class="cm-rule" aria-hidden="true"></span>
        @foreach (var link in Extra)
        {
            <a class="cm-item cm-extra @(link.Current ? "on" : "")" href="@link.Href" aria-current="@(link.Current ? "page" : null)"><Icon Name="@link.Icon" Size="18" /> <span class="cm-label">@link.Label</span></a>
        }
    }
</nav>

@code {
    /// <summary>The id of the menu (the button that hides it points to it).</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>The dropdowns: Modules and the kinds of work.</summary>
    [Parameter] public IReadOnlyList<CourseMenuGroup> Groups { get; set; } = [];

    /// <summary>The group that is open: modules, seatwork, assignments, quizzes, tasks (empty on a module page, where the module that is open opens its group).</summary>
    [Parameter] public string Selected { get; set; } = "";

    /// <summary>The other pages of the course, under the line (the students, the gradebook ...).</summary>
    [Parameter] public IReadOnlyList<CourseMenuLink> Extra { get; set; } = [];

    /// <summary>The word in the address for a kind: assignments, quizzes or tasks.</summary>
    public static string KeyOf(string kind) => kind switch
    {
        ItemKinds.Quiz => "quizzes",
        ItemKinds.TaskPerformance => "tasks",
        ItemKinds.Seatwork => "seatwork",
        ItemKinds.Recitation => "recitations",
        ItemKinds.Exam => "exams",
        _ => "assignments",
    };

    /// <summary>The kind a tab shows, or null for the modules.</summary>
    public static string? KindOfKey(string? key) => key switch
    {
        "assignments" => ItemKinds.Activity,
        "quizzes" => ItemKinds.Quiz,
        "tasks" => ItemKinds.TaskPerformance,
        "seatwork" => ItemKinds.Seatwork,
        "recitations" => ItemKinds.Recitation,
        "exams" => ItemKinds.Exam,
        _ => null,
    };
}
