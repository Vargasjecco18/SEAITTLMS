<a class="brand @(Large ? "large" : "") @(Light ? "light" : "")" href="@Href" aria-label="SEAITT e-LMS, home">
    <img class="mark" src="@Assets["images/logo.png"]" alt="" width="@(Large ? 72 : 40)" height="@(Large ? 72 : 40)" />
    <span class="text">
        <span class="name">SEAITT <span class="accent">e-LMS</span></span>
        <span class="tagline">Senior High School</span>
    </span>
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";

    /// <summary>The bigger, centered version used above the sign-in card.</summary>
    [Parameter] public bool Large { get; set; }

    /// <summary>White text, for use on a dark picture.</summary>
    [Parameter] public bool Light { get; set; }
}
