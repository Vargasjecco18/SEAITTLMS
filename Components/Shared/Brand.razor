<a class="brand @(Large ? "large" : "")" href="@Href" aria-label="SEAITT e-LMS, home">
    <span class="mark"><Icon Name="school" Size="@(Large ? 30 : 22)" /></span>
    <span class="text">
        <span class="name">SEAITT <span class="accent">e-LMS</span></span>
        <span class="tagline">Senior High School</span>
    </span>
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";

    /// <summary>The bigger, centered version used above the sign-in card.</summary>
    [Parameter] public bool Large { get; set; }
}
