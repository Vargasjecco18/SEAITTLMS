@inject SystemSettingsService School

@* The name of the school is the one of System Settings. *@
<a class="brand @(Large ? "large" : "") @(Light ? "light" : "")" href="@Href" aria-label="@School.Current.SchoolTitle, home">
    <img class="mark" src="@Assets["images/logo.png"]" alt="" width="@(Large ? 72 : 40)" height="@(Large ? 72 : 40)" />
    <span class="text">
        <span class="name">@School.Current.SchoolShortName <span class="accent">LMS</span></span>
        @if (!string.IsNullOrWhiteSpace(School.Current.Tagline))
        {
            <span class="tagline">@School.Current.Tagline</span>
        }
    </span>
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";

    /// <summary>The bigger, centered version used above the sign-in card.</summary>
    [Parameter] public bool Large { get; set; }

    /// <summary>White text, for use on a dark picture.</summary>
    [Parameter] public bool Light { get; set; }
}
