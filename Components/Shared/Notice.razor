@using Microsoft.AspNetCore.Components.Web

@* The feedback of a page (saved, or what went wrong) as a pop-up in the middle of the screen, with an OK button. It sits over any other box that is open. *@
<Modal Open="!string.IsNullOrEmpty(Message)" Title="@(IsError ? "Please check" : "Done")" Centered="true" Narrow="true" Top="true" OnClose="Dismiss">
    <div class="notice-body @(IsError ? "error" : "")" role="@(IsError ? "alert" : "status")">
        <span class="notice-icon"><Icon Name="@(IsError ? "circle-alert" : "circle-check")" Size="22" /></span>
        <p>@Message</p>
    </div>
    <div class="notice-actions">
        <Button IconName="circle-check" OnClick="Dismiss">OK</Button>
    </div>
</Modal>

@code {
    [Parameter] public string? Message { get; set; }

    [Parameter] public bool IsError { get; set; }

    /// <summary>Called when OK, the X or Escape is pressed. The page then clears the message.</summary>
    [Parameter] public EventCallback OnDismiss { get; set; }

    private Task Dismiss() => OnDismiss.InvokeAsync();
}
