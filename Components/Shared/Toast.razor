@* Round 46: a short note at the top right of the screen (it does not cover the page and goes away by itself), for "saved" and for what went wrong.
   Give it a new Stamp every time there is something to say (the same words twice are shown twice). *@
@if (!string.IsNullOrEmpty(Message))
{
    <div class="toast-host" aria-live="polite">
        <div class="toast @(IsError ? "error" : "ok")" role="@(IsError ? "alert" : "status")" @key="Stamp" title="Click to close" @onclick="Dismiss">
            <span class="toast-icon"><Icon Name="@(IsError ? "circle-alert" : "circle-check")" Size="18" /></span>
            <span class="toast-text">@Message</span>
        </div>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }

    [Parameter] public bool IsError { get; set; }

    /// <summary>A number that changes with every message: it makes the note appear (and fade) again.</summary>
    [Parameter] public int Stamp { get; set; }

    [Parameter] public EventCallback OnDismiss { get; set; }

    private Task Dismiss() => OnDismiss.InvokeAsync();
}
