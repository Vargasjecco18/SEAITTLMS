@rendermode InteractiveServer
@implements IDisposable
@inject CurrentUser Me
@inject PeopleService People
@inject PresenceService Presence
@inject MessageLauncher Launcher

@* The people who are online right now. Kind "students": for a student their classmates and friends, for a teacher their students. Kind "teachers": for a
   student their teachers (and friends who teach), for a teacher the other teachers. Who counts is read now and then (every minute); who of them is online is
   looked at every few seconds (the app knows it in memory, see PresenceService). With six or more online, five are shown and "Show more" opens the rest. *@
<Card Title="@(Teachers ? "Online teachers" : "Online students")" IconName="@(Teachers ? "presentation" : "wifi")">
    @if (!loaded)
    {
        <p class="quiet">Looking…</p>
    }
    else if (online.Count == 0)
    {
        <p class="quiet">@(people.Count == 0 ? (Teachers ? "You don't have teachers to see here yet." : "You don't have students to see here yet.") : "Nobody is online right now.")</p>
    }
    else
    {
        <p class="count"><span class="dot"></span> @online.Count online</p>
        <ul class="list">
            @foreach (var s in showAll ? online : online.Take(ShownFirst).ToList())
            {
                var person = s;
                <li>
                    <PersonLine UserId="person.UserId" Name="@person.Name" Detail="@person.Detail" Online="true" Size="34">
                        <button type="button" class="chat" title="@($"Write to {person.Name}")" aria-label="@($"Write to {person.Name}")" @onclick="() => Launcher.Open(person.UserId)">
                            <Icon Name="message-square" Size="16" />
                        </button>
                    </PersonLine>
                </li>
            }
        </ul>
        <ShowMoreButton Total="online.Count" Shown="ShownFirst" Open="showAll" OnToggle="@(() => showAll = !showAll)" />
    }

    <a class="see-all" href="@SeeAllHref">See all users <Icon Name="arrow-right" Size="14" /></a>
</Card>

@code {
    /// <summary>"students" (the default) or "teachers".</summary>
    [Parameter] public string Kind { get; set; } = "students";

    private const int ShownFirst = 5;
    private bool showAll;
    private bool Teachers => Kind == "teachers";
    private int userId;
    private string role = "";
    private bool loaded;
    private IReadOnlyList<PersonCard> people = [];
    private IReadOnlyList<PersonCard> online = [];
    private Timer? timer;
    private DateTime lastLoad;

    private string SeeAllHref => Teachers ? "users?tab=teachers" : role == AppRoles.Teacher ? "users?tab=students" : "users?tab=classmates";

    protected override async Task OnInitializedAsync()
    {
        var me = await Me.GetAsync();
        if (me is null)
        {
            return;
        }

        userId = me.UserId;
        role = me.Role;
        await LoadAsync();
        timer = new Timer(_ => _ = InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAsync()
    {
        var reachable = await People.GetReachableAsync(userId);
        people = reachable.Where(p => p.IsStudent != Teachers).ToList();
        lastLoad = DateTime.UtcNow;
        loaded = true;
        Recount();
    }

    private void Recount()
    {
        var here = Presence.OnlineAmong(people.Select(s => s.UserId));
        online = people.Where(s => here.Contains(s.UserId)).ToList();
    }

    private async Task TickAsync()
    {
        try
        {
            if (DateTime.UtcNow - lastLoad > TimeSpan.FromMinutes(1))
            {
                await LoadAsync();
            }
            else
            {
                Recount();
            }

            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public void Dispose() => timer?.Dispose();
}
