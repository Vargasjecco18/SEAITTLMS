@* One announcement as a card: the icon of its category, the title, the text, who it is for and who wrote it. With OnEdit and OnDelete set it
   has the buttons to change or delete it (for the person who manages it). *@
<article class="announcement @Item.Category" aria-label="@Item.Title">
    <span class="icon" aria-hidden="true"><Icon Name="@AnnouncementCategories.Icon(Item.Category)" Size="20" /></span>
    <div class="main">
        <div class="top">
            <strong class="title">@Item.Title</strong>
            <AnnouncementTag Category="@Item.Category" />
        </div>
        <p class="text">@Item.Body</p>
        <div class="meta">
            <span>@AudienceText</span>
            @if (ScheduleText is { } schedule)
            {
                <Badge Tone="@ScheduleTone">@schedule</Badge>
            }
            <span class="who">@Item.AuthorName · @PhilippineTime.FormatDateTime(Item.CreatedAtUtc)</span>
        </div>
        @if (OnEdit.HasDelegate || OnDelete.HasDelegate)
        {
            <div class="actions">
                @if (OnEdit.HasDelegate)
                {
                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" Title="@($"Edit {Item.Title}")" OnClick="() => OnEdit.InvokeAsync(Item)">Edit</Button>
                }
                @if (OnDelete.HasDelegate)
                {
                    <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" Title="@($"Delete {Item.Title}")" OnClick="() => OnDelete.InvokeAsync(Item)">Delete</Button>
                }
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public AnnouncementView Item { get; set; } = null!;

    /// <summary>Today (a Philippine date), to tell a notice that has ended.</summary>
    [Parameter] public DateOnly Today { get; set; }

    [Parameter] public EventCallback<AnnouncementView> OnEdit { get; set; }

    [Parameter] public EventCallback<AnnouncementView> OnDelete { get; set; }

    /// <summary>The days it is about: "Nov 10 – Nov 12", "From Nov 10", "Until Nov 12", with "Ended" for one that is over. Empty when it has no Start and no End.</summary>
    private string? ScheduleText
    {
        get
        {
            var start = Item.StartsOn;
            var end = Item.ExpiresOn;
            if (start is null && end is null)
            {
                return null;
            }

            var range = (start, end) switch
            {
                ({ } a, { } b) when a == b => PhilippineTime.FormatDate(a),
                ({ } a, { } b) => $"{PhilippineTime.FormatDate(a)} – {PhilippineTime.FormatDate(b)}",
                ({ } a, null) => "From " + PhilippineTime.FormatDate(a),
                (null, { } b) => "Until " + PhilippineTime.FormatDate(b),
                _ => "",
            };
            return end is { } over && over < Today ? "Ended · " + range : range;
        }
    }

    private Tone ScheduleTone => Item.ExpiresOn is { } over && over < Today ? Tone.Neutral : Item.StartsOn is { } later && later > Today ? Tone.Info : Tone.Warning;

    private string AudienceText =>
        Item.CourseName is { } course ? $"{course} · {Item.SectionLabel}"
        : Item.SectionLabel is { } section ? $"Students of {section}"
        : Item.Audience switch
        {
            AnnouncementAudiences.Students => "The students",
            AnnouncementAudiences.Teachers => "The teachers",
            _ => "Everybody",
        };
}
