@inject CurrentUser Me
@inject ModuleService Modules
@inject AttachmentService Attachments

@* The form that edits a module of a teacher: the title, the link, the files and the slides. It is in the box of the course page and at the right of the
   page where the module is read (a PDF at the left, this form at the right). It saves by itself and says so with OnSaved. *@
<EditForm Model="form" OnValidSubmit="SaveAsync">
    <FormErrors Errors="errors" />
    <Field For="m-title" Label="Title" Required="true">
        <InputText id="m-title" @bind-Value="form.Title" maxlength="200" autocomplete="off" />
    </Field>
    <Field For="m-link" Label="Link" Hint="A file or video the lesson uses (starts with https://).">
        <InputText id="m-link" @bind-Value="form.LinkUrl" maxlength="500" autocomplete="off" />
    </Field>
    <AttachmentPicker @ref="filesPicker" Title="Files of the module" ModuleLabel="@FileLabel.OfModule(Module.Title)" Existing="@(Files.Where(f => !f.IsSlides).ToList())" />
    <AttachmentPicker @ref="slidesPicker" @key="@("slides")" Slides="true" Title="Slides of the module (PowerPoint or PDF)" ModuleLabel="@FileLabel.OfModule(Module.Title)" Existing="@(Files.Where(f => f.IsSlides).ToList())" />
    <div class="modal-actions">
        @if (OnCancel.HasDelegate)
        {
            <Button Variant="ButtonVariant.Ghost" OnClick="OnCancel">Cancel</Button>
        }
        <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : "Save module")</Button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public int TeacherId { get; set; }

    [Parameter, EditorRequired] public TeacherModule Module { get; set; } = null!;

    /// <summary>The files and slides of the module now.</summary>
    [Parameter] public IReadOnlyList<AttachmentRow> Files { get; set; } = [];

    /// <summary>Called after the module was saved, with the words to tell the teacher (the problems with a file, when there were any).</summary>
    [Parameter] public EventCallback<EditorResult> OnSaved { get; set; }

    /// <summary>When it is set the form has a Cancel button.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public int BodyRows { get; set; } = 9;

    public sealed record EditorResult(bool Ok, string Message);

    private ModuleInput form = new();
    private List<string> errors = [];
    private bool busy;
    private int loadedModuleId;
    private AttachmentPicker? filesPicker;
    private AttachmentPicker? slidesPicker;

    protected override void OnParametersSet()
    {
        // The form is filled once for each module; saving does not draw it over what the teacher typed.
        if (loadedModuleId != Module.Id)
        {
            loadedModuleId = Module.Id;
            form = new ModuleInput { Title = Module.Title, Description = Module.Description, Body = Module.Body, LinkUrl = Module.LinkUrl };
            errors = [];
        }
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.UpdateModuleAsync(TeacherId, Module.Id, form);
            if (!result.Succeeded)
            {
                errors = [.. result.Errors];
                return;
            }

            errors = [];
            var problems = await ApplyFilesAsync(filesPicker, slides: false);
            problems.AddRange(await ApplyFilesAsync(slidesPicker, slides: true));
            var text = problems.Count > 0 ? $"{result.Message} But the files: {string.Join(" ", problems)}" : result.Message ?? "The module was saved.";
            await OnSaved.InvokeAsync(new EditorResult(problems.Count == 0, text));
        }
        finally
        {
            busy = false;
        }
    }

    private async Task<List<string>> ApplyFilesAsync(AttachmentPicker? picker, bool slides)
    {
        var problems = new List<string>();
        if (picker is null)
        {
            return problems;
        }

        var userId = (await Me.GetAsync())?.UserId ?? 0;
        var owner = new AttachmentOwner(AttachmentOwnerKind.Module, Module.Id);
        var removed = await Attachments.RemoveAsync(userId, [.. picker.Removed]);
        if (!removed.Succeeded)
        {
            problems.AddRange(removed.Errors);
        }

        var added = await Attachments.AddAsync(userId, owner, picker.Pending, slides: slides);
        if (!added.Succeeded)
        {
            problems.AddRange(added.Errors);
        }

        return problems;
    }
}
