@using Microsoft.AspNetCore.Components.Web
@* The Add button at the top right of a course: it opens a small menu. First the handout (a lesson of the course), then what to add to it: an assignment,
   a quiz or a task performance. With only one handout the menu goes straight to the three kinds. At the top of the course (Choice) the menu is "Add activities" (a sheet of
   rows) or "Add quiz" (a sheet of questions): both ask for the handout inside the sheet. *@
<div class="add-menu" @onkeydown="OnKeyDown">
    <Button IconName="plus" OnClick="Toggle" aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")">@Label</Button>

    @if (open)
    {
        <div class="add-scrim" @onclick="Close"></div>
        <div class="add-pop" role="menu" aria-label="Add to the course">
            @if (Modules.Count == 0)
            {
                <p class="add-empty">There is no handout yet. Add a handout first.</p>
            }
            else if (Choice)
            {
                @* The Add button of the top of a course: add many activities in the sheet, or add a quiz by writing its questions (the sheet asks for the handout). *@
                <p class="add-title">What do you want to add?</p>
                <ul class="add-list">
                    <li>
                        <button type="button" role="menuitem" class="add-item" data-add-kind="excel" @onclick="() => PickAsync(AddItemMenuLabels.ExcelKind, 0)">
                            <Icon Name="table" Size="16" />
                            <span class="add-label">Add activities</span>
                        </button>
                    </li>
                    <li>
                        <button type="button" role="menuitem" class="add-item" data-add-kind="@ItemKinds.Quiz" @onclick="() => PickAsync(ItemKinds.Quiz, 0)">
                            <Icon Name="@SubjectStyle.KindIcon(ItemKinds.Quiz)" Size="16" />
                            <span class="add-label">Add quiz</span>
                        </button>
                    </li>
                </ul>
            }
            else if (Current is null || Kind is not null)
            {
                <p class="add-title">Choose a handout</p>
                <ul class="add-list">
                    @foreach (var m in Modules)
                    {
                        var module = m;
                        <li>
                            <button type="button" role="menuitem" class="add-item" @onclick="() => ChooseAsync(module)">
                                <Icon Name="layers" Size="16" />
                                <span class="add-label">@module.Label</span>
                                @if (Kind is null)
                                {
                                    <Icon Name="chevron-right" Size="16" />
                                }
                            </button>
                        </li>
                    }
                </ul>
            }
            else
            {
                @if (Modules.Count > 1)
                {
                    <button type="button" class="add-back" @onclick="() => chosen = null"><Icon Name="chevron-left" Size="16" /> <span>@Current.Label</span></button>
                }
                else
                {
                    <p class="add-title">@Current.Label</p>
                }

                <p class="add-title">Add to this handout</p>
                <ul class="add-list">
                    @foreach (var kind in ItemKinds.All)
                    {
                        var k = kind;
                        <li>
                            <button type="button" role="menuitem" class="add-item" data-add-kind="@k" @onclick="() => PickAsync(k)">
                                <Icon Name="@SubjectStyle.KindIcon(k)" Size="16" />
                                <span class="add-label">@ItemKinds.Display(k)</span>
                            </button>
                        </li>
                    }
                    <li class="add-rule" role="separator"></li>
                    <li>
                        <button type="button" role="menuitem" class="add-item" data-add-kind="excel" @onclick="() => PickAsync(AddItemMenuLabels.ExcelKind)">
                            <Icon Name="table" Size="16" />
                            <span class="add-label">Many in a sheet</span>
                        </button>
                    </li>
                </ul>
            }
        </div>
    }
</div>

@code {
    private bool open;
    private int? chosen;

    /// <summary>True when the menu is open as soon as the page is (the person came from "Add seatwork" in the menu of the course).</summary>
    [Parameter] public bool StartOpen { get; set; }

    protected override void OnInitialized() => open = StartOpen;

    /// <summary>The words on the button.</summary>
    [Parameter] public string Label { get; set; } = "Add";

    /// <summary>When the kind is known (the list of assignments, for example) only the module is asked.</summary>
    [Parameter] public string? Kind { get; set; }

    /// <summary>The button of the top of a course: the menu asks "Add activities" (the sheet of rows) or "Add quiz" (the sheet of questions).</summary>
    [Parameter] public bool Choice { get; set; }

    /// <summary>The modules of the course (not the syllabus), in order. The label is like "Module 2: Journal entries".</summary>
    [Parameter, EditorRequired] public IReadOnlyList<AddMenuModule> Modules { get; set; } = [];

    /// <summary>Called with the module and the kind (one of <see cref="ItemKinds"/>) the person chose.</summary>
    [Parameter] public EventCallback<AddMenuPick> OnPick { get; set; }

    private async Task ChooseAsync(AddMenuModule module)
    {
        if (Kind is { } kind)
        {
            Close();
            await OnPick.InvokeAsync(new AddMenuPick(module.Id, kind));
            return;
        }

        chosen = module.Id;
    }

    private AddMenuModule? Current => chosen is { } id ? Modules.FirstOrDefault(m => m.Id == id) : Modules.Count == 1 ? Modules[0] : null;

    private void Toggle()
    {
        open = !open;
        chosen = null;
    }

    private void Close()
    {
        open = false;
        chosen = null;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    private async Task PickAsync(string kind, int? moduleId = null)
    {
        var module = Current;
        Close();
        if (moduleId is { } id)
        {
            await OnPick.InvokeAsync(new AddMenuPick(id, kind));
        }
        else if (module is not null)
        {
            await OnPick.InvokeAsync(new AddMenuPick(module.Id, kind));
        }
    }
}
