@inject Microsoft.Extensions.Options.IOptions<SEAITT_LMS.Auth.AuthOptions> AuthSettings

@* The message at the top center for a person who has been away: after 30 minutes with nothing done (no mouse, key, touch or scroll in any page of the app) it says that the account
   will be logged out automatically in 10 minutes, with a countdown. A click, a key press or the button keeps the account signed in; when the time is over the account is signed out
   with the same form as the Sign out button. wwwroot/app.js does the counting and shows or hides this box (the minutes come from Auth:AfkWarnMinutes and Auth:AfkLogoutMinutes). *@
<div class="idle-alert" data-idle-alert data-idle-warn="@Warn" data-idle-logout="@Logout" role="alert" hidden>
    <span class="idle-icon" aria-hidden="true"><Icon Name="alarm-clock" Size="22" /></span>
    <div class="idle-text">
        <strong>Are you still there?</strong>
        <span>You have been away for @Warn minutes. Your account will be logged out automatically in <b data-idle-left>@Logout:00</b>.</span>
    </div>
    <button type="button" class="idle-stay" data-idle-stay>Stay signed in</button>
</div>

@code {
    private int Warn => Math.Max(1, AuthSettings.Value.AfkWarnMinutes);

    private int Logout => Math.Max(1, AuthSettings.Value.AfkLogoutMinutes);
}
