@* How much of a module has been read, at the right of its title. It only counts what happens inside the files of the module: the pages of a PDF that were in front of the reader and how far
   the reader scrolled inside it, how much of a sound or a video was played (wwwroot/app.js does the counting). Scrolling the rest of the page counts for nothing. It never goes back,
   and it is remembered on this computer. *@
<div class="read-progress" data-read-progress data-read-key="@Key" data-read-module="@(ModuleId > 0 ? ModuleId.ToString() : null)" data-read-save="@(Save ? "1" : null)" data-read-server="@(ServerPercent is > 0 ? ServerPercent.ToString() : null)" role="progressbar" aria-label="How much of this module was read" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
     title="It grows as you read inside the files: the pages you look at and how far you scroll in them">
    <span class="rp-text">Read <b data-rp-value>0%</b></span>
    <span class="rp-track"><i data-rp-bar></i></span>
</div>

@code {
    /// <summary>What the progress belongs to (the module), so each module remembers its own.</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    /// <summary>The module, for the bar to be kept on the server (the student's page): the bar of the module in the course reads it.</summary>
    [Parameter] public int ModuleId { get; set; }

    /// <summary>True on the page of a student: the bar is sent to the server. (The teacher's page only shows it.)</summary>
    [Parameter] public bool Save { get; set; }

    /// <summary>What the server already has for this student (so the bar starts there on another computer, and matches the bar of the course page).</summary>
    [Parameter] public int? ServerPercent { get; set; }
}
