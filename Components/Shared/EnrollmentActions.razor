@rendermode InteractiveServer
@inject EnrollmentService Enrollment
@inject StudentLifecycleService Lifecycle
@inject CurrentUser Me
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The registrar's buttons for one line of the list of enrollments: Account (the sign-in details of the student), Edit (the name, the term, the course of study
   and the section) and Drop out. Each opens a box over the list. It is its own live island, so it works inside a list that is otherwise plain. *@
<div class="buttons">
    <button type="button" class="act" @onclick="OpenAccountAsync"><Icon Name="key-round" Size="14" /> Account</button>
    @if (Status == "Enrolled")
    {
        <button type="button" class="act" @onclick="OpenEditAsync"><Icon Name="pencil" Size="14" /> Edit</button>
    }
    @if (StudentActive)
    {
        <button type="button" class="act danger" @onclick="OpenDrop"><Icon Name="user-x" Size="14" /> Drop out</button>
    }
</div>

<Modal Open="showingAccount" Title="@($"Sign-in details of {StudentName}")" OnClose="CloseAccount">
    @if (showingAccount)
    {
        @if (account is null)
        {
            <p class="muted">@(accountProblem ?? "Loading…")</p>
        }
        else
        {
            <dl class="account">
                <div><dt>Student</dt><dd>@account.StudentName</dd></div>
                <div><dt>LRN</dt><dd class="mono">@account.Lrn</dd></div>
                <div><dt>Email</dt><dd class="mono" id="account-email">@account.Email</dd></div>
                <div>
                    <dt>Password</dt>
                    @if (account.Password is { } password)
                    {
                        <dd class="mono" id="account-password">@password</dd>
                    }
                    else
                    {
                        <dd class="muted" id="account-password">Not shown</dd>
                    }
                </div>
            </dl>
            @if (account.Password is null)
            {
                <p class="quiet">The student changed the password, or an administrator set a new one, so it is not shown here. An administrator can set a new password in Users.</p>
            }
            else
            {
                <p class="quiet">This is the first password, made from the last name and the end of the LRN. Tell the student to keep it private.</p>
            }

            @if (!account.IsActive)
            {
                <p class="quiet">This account is switched off, so the student can't sign in.</p>
            }

            <div class="actions">
                @if (account.Password is not null)
                {
                    <Button Variant="ButtonVariant.Secondary" IconName="@(copied ? "circle-check" : "file-text")" OnClick="CopyAccountAsync">@(copied ? "Copied" : "Copy the login")</Button>
                }
                <Button OnClick="CloseAccount">Close</Button>
            </div>
        }
    }
</Modal>

<Modal Open="editing" Title="@($"Edit the enrollment of {StudentName}")" OnClose="CloseEdit" Large="true">
    @if (editing)
    {
        @if (lookups is null || view is null)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            <FormErrors Errors="errors" />

            <p class="quiet">LRN @view.Lrn. A change of the name is written in all the enrollments of the student.</p>
            <div class="two">
                <Field For="ed-first" Label="First name" Required="true"><input id="ed-first" type="text" maxlength="100" autocomplete="off" class="cap" data-letters @bind="first" /></Field>
                <Field For="ed-middle" Label="Middle name"><input id="ed-middle" type="text" maxlength="100" autocomplete="off" class="cap" data-letters @bind="middle" /></Field>
            </div>
            <div class="two">
                <Field For="ed-last" Label="Last name" Required="true"><input id="ed-last" type="text" maxlength="100" autocomplete="off" class="cap" data-letters @bind="last" /></Field>
                <Field For="ed-ext" Label="Name extension"><input id="ed-ext" type="text" maxlength="10" autocomplete="off" placeholder="Jr." class="cap" data-letters @bind="extension" /></Field>
            </div>
            <Field For="ed-phone" Label="Phone number" Hint="Optional. Digits only, like 09171234567."><input id="ed-phone" type="tel" inputmode="numeric" data-digits maxlength="12" autocomplete="off" @bind="PhoneBox" /></Field>

            <div class="two">
                <Field For="ed-term" Label="Term" Hint="The term of this enrollment (the calendar sets it).">
                    <input id="ed-term" readonly value="@TermText" />
                </Field>
                <Field For="ed-grade" Label="Grade level" Required="true">
                    <select id="ed-grade" @bind="grade" @bind:after="PlaceChangedAsync">
                        <option value="11">Grade 11</option>
                        <option value="12">Grade 12</option>
                    </select>
                </Field>
            </div>
            <div class="two">
                <Field For="ed-track" Label="Track" Required="true">
                    <select id="ed-track" @bind="trackId" @bind:after="TrackChangedAsync">
                        <option value="0">Choose a track</option>
                        @foreach (var track in lookups.Tracks)
                        {
                            <option value="@track.Id">@track.Code</option>
                        }
                    </select>
                </Field>
                <Field For="ed-strand" Label="Strand" Required="true">
                    <select id="ed-strand" disabled="@(trackId == 0)" @bind="strandId" @bind:after="PlaceChangedAsync">
                        <option value="0">@(trackId == 0 ? "Choose a track first" : "Choose a strand")</option>
                        @foreach (var strand in lookups.Strands.Where(s => s.TrackId == trackId))
                        {
                            <option value="@strand.Id">@strand.Code@(string.Equals(strand.Name, strand.Code, StringComparison.OrdinalIgnoreCase) ? "" : $" ({strand.Name})")</option>
                        }
                    </select>
                </Field>
            </div>
            <Field For="ed-section" Label="Section" Required="true" Hint="@SectionHint">
                <select id="ed-section" disabled="@(strandId == 0)" @bind="sectionName">
                    <option value="">@(strandId == 0 ? "Choose a strand first" : "Choose the section")</option>
                    @foreach (var load in loads)
                    {
                        <option value="@load.Name" disabled="@(load.IsFull && load.Name != sectionName)">@load.Name · @load.Text@(load.IsFull ? " (full)" : "")</option>
                    }
                </select>
            </Field>

            <p class="quiet">The courses are the courses of the strand in that grade level and term: they follow the strand and the grade level you choose.</p>

            <div class="actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseEdit">Cancel</Button>
                <Button IconName="circle-check" Disabled="@(busy || strandId == 0 || string.IsNullOrEmpty(sectionName))" OnClick="SaveAsync">@(busy ? "Saving…" : "Save changes")</Button>
            </div>
        }
    }
</Modal>

<Modal Open="dropping" Title="Mark this student as dropped out?" OnClose="CloseDrop">
    @if (dropping)
    {
        <p>
            <strong>@StudentName</strong> (LRN @Lrn) left school. The sign-in is switched off, the enrollments are marked dropped and the student is
            <strong>not in the list of graduating students</strong>. The records stay in the archive; an administrator can restore the student.
        </p>
        <Field For="dr-note" Label="Why (optional)"><input id="dr-note" type="text" maxlength="300" autocomplete="off" @bind="dropNote" /></Field>
        <FormErrors Errors="errors" />
        <div class="actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDrop">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" IconName="user-x" Disabled="busy" OnClick="ConfirmDropAsync">@(busy ? "Saving…" : "Mark as dropped out")</Button>
        </div>
    }
</Modal>

@code {
    [Parameter, EditorRequired] public int EnrollmentId { get; set; }

    [Parameter, EditorRequired] public int StudentId { get; set; }

    [Parameter, EditorRequired] public string StudentName { get; set; } = "";

    [Parameter, EditorRequired] public string Lrn { get; set; } = "";

    /// <summary>The status of the enrollment: only one that is going on ("Enrolled") can be edited.</summary>
    [Parameter] public string Status { get; set; } = "Enrolled";

    /// <summary>False for a student who is in the archive (nothing to drop out).</summary>
    [Parameter] public bool StudentActive { get; set; } = true;

    private bool showingAccount;
    private bool copied;
    private string? accountProblem;
    private StudentSignIn? account;
    private bool editing;
    private bool dropping;
    private bool busy;
    private List<string> errors = [];
    private EnrollmentLookups? lookups;
    private EnrollmentEditView? view;
    private IReadOnlyList<SectionLoad> loads = [];
    private HashSet<int> subjectIds = [];
    private string first = "", middle = "", last = "", extension = "", phone = "", sectionName = "", dropNote = "";

    // Only digits in the phone number (the box drops the rest as it is typed; this keeps it when the box was not able to).
    private string PhoneBox
    {
        get => phone;
        set => phone = NameCase.KeepDigits(value);
    }
    private int termId, trackId, strandId;
    private byte grade = 11;

    private string TermText => lookups?.Terms.FirstOrDefault(t => t.Id == termId) is { } term ? $"{term.SchoolYear} · {term.Name}" : "A term that is over";

    private string SectionHint => strandId == 0 ? "Choose the section, A, B or C." : loads.FirstOrDefault(l => l.Name == sectionName) is { } load
        ? $"Section {load.Name} has {load.Text}. {(load.IsFull ? "It is full." : load.SeatsLeft == 1 ? "1 seat is left." : $"{load.SeatsLeft} seats are left.")}"
        : "Choose the section, A, B or C.";

    private async Task OpenAccountAsync()
    {
        account = null;
        accountProblem = null;
        copied = false;
        showingAccount = true;
        var me = await Me.GetAsync();
        account = me is null ? null : await Enrollment.GetSignInAsync(StudentId, me.UserId);
        if (account is null)
        {
            accountProblem = "The sign-in details could not be read.";
        }
    }

    private void CloseAccount() => showingAccount = false;

    private async Task CopyAccountAsync()
    {
        if (account is { Password: { } password })
        {
            copied = await JS.InvokeAsync<bool>("seaitt.copyText", $"Email: {account.Email}\nPassword: {password}");
        }
    }

    private async Task OpenEditAsync()
    {
        errors = [];
        editing = true;
        lookups = await Enrollment.GetLookupsAsync();
        view = await Enrollment.GetEnrollmentForEditAsync(EnrollmentId);
        if (view is null)
        {
            errors = ["This enrollment was not found."];
            return;
        }

        (first, middle, last, extension, phone) = (view.FirstName, view.MiddleName ?? "", view.LastName, view.NameExtension ?? "", SEAITT_LMS.Auth.PhoneNumbers.ToLocal(view.PhoneNumber));
        (termId, grade, trackId, strandId, sectionName) = (view.TermId, view.GradeLevel, view.TrackId, view.StrandId, view.SectionName);
        subjectIds = view.SubjectIds.ToHashSet();
        await ReloadAsync();
    }

    private async Task TrackChangedAsync()
    {
        strandId = 0;
        sectionName = "";
        await ReloadAsync();
    }

    // The term, grade level or strand moved: the sections of the new place are shown. The grade level the registrar chose is kept when the track changes.
    private async Task PlaceChangedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        if (strandId == 0)
        {
            loads = [];
            return;
        }

        loads = await Enrollment.GetSectionLoadsAsync(termId, strandId, grade, EnrollmentId);
    }

    private void CloseEdit()
    {
        editing = false;
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (busy || view is null)
        {
            return;
        }

        busy = true;
        errors = [];
        try
        {
            var me = await Me.GetAsync();
            // The courses are not edited here: the courses the enrollment has are kept while the term, strand and grade level stay; when one of them moves the service gives the courses of the new place.
            var change = new EnrollmentChange(EnrollmentId, first, middle, last, extension, phone, termId, grade, trackId, strandId, sectionName, subjectIds.Count == 0 ? null : subjectIds.ToList());
            var result = me is null ? ServiceResult.Fail("Please sign in again.") : await Enrollment.UpdateEnrollmentAsync(change, me.UserId);
            if (result.Succeeded)
            {
                editing = false;
                Navigation.Refresh();
            }
            else
            {
                errors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenDrop()
    {
        errors = [];
        dropNote = "";
        dropping = true;
    }

    private void CloseDrop()
    {
        dropping = false;
        errors = [];
    }

    private async Task ConfirmDropAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        errors = [];
        try
        {
            var me = await Me.GetAsync();
            var result = me is null ? ServiceResult.Fail("Please sign in again.") : await Lifecycle.DropOutAsync(StudentId, dropNote, me.UserId);
            if (result.Succeeded)
            {
                dropping = false;
                Navigation.Refresh();
            }
            else
            {
                errors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }
}
