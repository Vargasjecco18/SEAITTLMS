@rendermode InteractiveServer
@inject CurrentUser Me
@inject ApplicationService Applications

@* The Info button of a line of Student's Accounts: opens the application the student sent (and the papers they uploaded) in a box in the middle of the screen. It is its own live island, so it works inside a
   list that is otherwise plain. A student who was enrolled without an application has none. *@
<button type="button" class="act" title="@($"The application of {StudentName}")" @onclick="OpenAsync"><Icon Name="info" Size="14" /> Info</button>

<ApplicationDialog Detail="detail" OnClose="Close" />
<Modal Open="noneOpen" Title="@($"Application of {StudentName}")" Centered="true" OnClose="() => noneOpen = false">
    <p>There is no application on record for this student: they were enrolled without sending one.</p>
    <div class="none-actions"><Button OnClick="() => noneOpen = false">Close</Button></div>
</Modal>

@code {
    [Parameter, EditorRequired] public int StudentId { get; set; }
    [Parameter] public string StudentName { get; set; } = "";

    private ApplicationDetail? detail;
    private bool noneOpen;

    private async Task OpenAsync()
    {
        var me = await Me.GetAsync();
        detail = me is null ? null : await Applications.GetForStudentAsync(me.UserId, StudentId);
        noneOpen = detail is null;
    }

    private void Close() => detail = null;
}
