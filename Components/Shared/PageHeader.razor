<header class="page-header">
    <div class="titles">
        <h1>
            @if (!string.IsNullOrEmpty(IconName))
            {
                <span class="title-icon"><Icon Name="@IconName" Size="22" /></span>
            }
            <span>@Title</span>
        </h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>

    @if (ChildContent is not null)
    {
        <div class="actions">@ChildContent</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>The icon in front of the title (a name from <see cref="IconSet"/>).</summary>
    [Parameter] public string? IconName { get; set; }

    /// <summary>Buttons or links shown at the right of the title.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
