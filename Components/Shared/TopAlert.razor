@* A message in the top center of the page, for something that was refused on the way here. It is asked for with ?alert=name in the address
   (the login page sends a signed-in person home with ?alert=signed-in). It goes away by itself after a few seconds, the X closes it, and
   wwwroot/app.js takes the ?alert= off the address so a refresh does not show it again. *@
@inject NavigationManager Navigation

@if (message is not null)
{
    <div class="top-alert" role="alert">
        <span class="top-alert-icon" aria-hidden="true"><Icon Name="triangle-alert" Size="20" /></span>
        <div class="top-alert-text">
            <strong>@message.Value.Title</strong>
            <span>@message.Value.Detail</span>
        </div>
        <button type="button" class="top-alert-close" data-close-top-alert aria-label="Close this message"><Icon Name="x" Size="16" /></button>
    </div>
}

@code {
    private (string Title, string Detail)? message;

    /// <summary>The message to show, by name, when the page asks for it itself (the login page, when the account is in use). Without it the name is read from ?alert= in the address.</summary>
    [Parameter] public string? Name { get; set; }

    protected override void OnInitialized()
    {
        if (Name is null)
        {
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
            message = query.TryGetValue("alert", out var name) ? Of(name.ToString()) : null;
        }
    }

    protected override void OnParametersSet()
    {
        if (Name is not null)
        {
            message = Of(Name);
        }
    }

    private static (string Title, string Detail)? Of(string name) => name switch
    {
        "signed-in" => ("Can't log in, someone is logged in", "Somebody is already signed in on this browser. Sign out first if you want to use another account."),
        "in-use" => ("Can't log in, someone is logged in", "This account is signed in on another device or browser. Log out there first, or try again in a few minutes."),
        "other-device" => ("You were logged out", "This account was signed in on another device or browser, so this one ended."),
        _ => null,
    };
}
