@* The widgets of the right column. It is its own live island, so its calendar works on pages that are otherwise plain. *@
@rendermode InteractiveServer
@implements IDisposable
@inject CurrentUser Me
@inject CalendarService Events
@inject DashboardService Dashboards
@inject AchievementService Achievements
@inject AnnouncementService Announcements
@inject TimeProvider Clock

@if (role is not null)
{
    <div class="widgets">
        @foreach (var widget in order)
        {
            @switch (widget)
            {
                case "online":
                    <OnlineStudents />
                    break;
                case "announcements":
                    <Card Title="Announcements" IconName="megaphone" Class="announcements">
                        @if (notices.Count == 0)
                        {
                            <p class="quiet">No announcements right now.</p>
                        }
                        else
                        {
                            <ul class="notices">
                                @foreach (var n in notices)
                                {
                                    <li>
                                        @* A plain details box: the title opens the whole text, no script needed. *@
                                        <details>
                                            <summary>
                                                <span class="notice-kind"><AnnouncementTag Category="@n.Category" /></span>
                                                <span class="notice-title">@n.Title</span>
                                                <small>@n.AuthorName · @PhilippineTime.FormatDate(n.CreatedAtUtc)@(n.CourseName is null ? (n.SectionLabel is null ? "" : " · " + n.SectionLabel) : " · " + n.CourseName)</small>
                                            </summary>
                                            <p class="notice-body">@n.Body</p>
                                        </details>
                                    </li>
                                }
                            </ul>
                        }
                    </Card>
                    break;
                case "unassigned":
                    <Card Title="Unassigned activities" IconName="clipboard-list" Class="unassigned">
                        <p class="drag-hint"><Icon Name="grip-vertical" Size="14" /> Drag one onto a day of the calendar to give it a due date.</p>
                        @if (unassigned.Count == 0)
                        {
                            <p class="quiet">Every activity has a due date.</p>
                        }
                        else
                        {
                            <ul class="unassigned-list">
                                @foreach (var u in unassigned)
                                {
                                    @* data-unassigned-item is what wwwroot/app.js looks for when something is dragged. "Set date" does the same without the mouse. *@
                                    <li draggable="true" data-unassigned-item="@u.ItemId" title="Drag onto a day of the calendar">
                                        <span class="kind @u.Kind.ToLowerInvariant()"><Icon Name="@SubjectStyle.KindIcon(u.Kind)" Size="16" /></span>
                                        <span class="next-text">
                                            <span class="next-title">@u.Title</span>
                                            <small>@u.SubjectName · @u.SectionLabel</small>
                                        </span>
                                        <a class="set-date" href="calendar?edit=@u.ItemId" title="@($"Set the due date of {u.Title}")">Set date</a>
                                    </li>
                                }
                            </ul>
                        }
                    </Card>
                    break;
                case "activities":
                    <Card Title="Activities" IconName="clipboard-list">
                        @if (activities.Count == 0)
                        {
                            <p class="quiet">No activities waiting for you.</p>
                        }
                        else
                        {
                            <ul class="next">
                                @foreach (var w in activities)
                                {
                                    <li>
                                        <span class="kind @w.Kind.ToLowerInvariant()"><Icon Name="@SubjectStyle.KindIcon(w.Kind)" Size="16" /></span>
                                        <span class="next-text">
                                            <a href="student/items/@w.ItemId">@w.Title</a>
                                            <small>@w.SubjectName · @ItemKinds.Display(w.Kind)@(w.InProgress ? " · in progress" : "")</small>
                                        </span>
                                        <span class="when @(w.IsOverdue ? "late" : "")">@(w.DueAtUtc is { } due ? PhilippineTime.DueText(due, PhilippineTime.Now(Clock)).Replace("due ", "") : "No due date")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </Card>
                    break;
                case "calendar":
                    <MiniCalendar Refresh="refreshStamp" />
                    break;
                case "upnext":
                    <Card Title="Due dates" IconName="alarm-clock">
                        @if (upNext.Count == 0)
                        {
                            <p class="quiet">Nothing is due in the next two weeks.</p>
                        }
                        else
                        {
                            <ul class="next">
                                @foreach (var e in upNext)
                                {
                                    <li>
                                        <span class="kind @e.Kind.ToLowerInvariant()"><Icon Name="@CalendarKinds.Icon(e.Kind)" Size="16" /></span>
                                        <span class="next-text">
                                            @if (e.Href is not null)
                                            {
                                                <a href="@e.Href">@e.Title</a>
                                            }
                                            else
                                            {
                                                <span class="next-title">@e.Title</span>
                                            }
                                            <small>@e.Subtitle</small>
                                        </span>
                                        <span class="when @(e.Overdue ? "late" : "")">@WhenText(e)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </Card>
                    break;
                case "achievements":
                    <AchievementsWidget Items="achievements" />
                    break;
                case "unchecked":
                    <Card Title="Unchecked activities" IconName="clipboard-pen" Class="unchecked">
                        @if (toCheck is null || toCheck.Unchecked.Count == 0)
                        {
                            <p class="quiet">Every activity is checked.</p>
                        }
                        else
                        {
                            <ul class="unchecked-list">
                                @foreach (var u in toCheck.Unchecked.Take(8))
                                {
                                    <li>
                                        <a href="@($"teacher/items/{u.ItemId}")">
                                            <span class="u-title">@u.Title</span>
                                            <small>@u.SubjectName · @u.SectionLabel · @PhilippineTime.FormatDate(u.OldestAtUtc)</small>
                                        </a>
                                        <Badge Tone="Tone.Warning">@u.Count</Badge>
                                    </li>
                                }
                            </ul>
                        }
                    </Card>
                    break;
                case "tocheck":
                    <Card Title="Needs your attention" IconName="clipboard-list">
                        @if (toCheck is null || (toCheck.ToCheck == 0 && toCheck.FlaggedCount == 0 && toCheck.DraftCount == 0))
                        {
                            <p class="quiet">All caught up. Nothing waits for you.</p>
                        }
                        else
                        {
                            <ul class="attention">
                                @if (toCheck.ToCheck > 0)
                                {
                                    <li><Badge Tone="Tone.Warning">@toCheck.ToCheck</Badge> @(toCheck.ToCheck == 1 ? "piece of work" : "pieces of work") to check @if (toCheck.Unchecked.Count > 0) { <a href="teacher/items/@toCheck.Unchecked[0].ItemId">Start with @toCheck.Unchecked[0].Title</a> }</li>
                                }

                                @if (toCheck.FlaggedCount > 0)
                                {
                                    <li><Badge Tone="Tone.Danger">@toCheck.FlaggedCount</Badge> flagged quiz @(toCheck.FlaggedCount == 1 ? "attempt" : "attempts") @if (toCheck.Flagged.Count > 0) { <a href="teacher/items/@toCheck.Flagged[0].ItemId">Look at it</a> }</li>
                                }

                                @if (toCheck.DraftCount > 0)
                                {
                                    <li><Badge Tone="Tone.Info">@toCheck.DraftCount</Badge> @(toCheck.DraftCount == 1 ? "module is" : "modules are") not posted yet @if (toCheck.Drafts.Count > 0) { <a href="teacher/subjects/@toCheck.Drafts[0].AssignmentId">Open</a> }</li>
                                }
                            </ul>
                        }
                    </Card>
                    break;
            }
        }
    </div>
}

@code {
    /// <summary>Which widgets, in this order: announcements, activities (students), unassigned (teachers), unchecked (teachers: the work waiting to be checked), calendar, upnext (the due dates), achievements, tocheck, online (the students who are online).</summary>
    [Parameter] public string Show { get; set; } = "calendar,upnext";

    private string? role;
    private string[] order = [];
    private List<CalendarEvent> upNext = [];
    private IReadOnlyList<Achievement> achievements = [];
    private TeacherDashboard? toCheck;
    private IReadOnlyList<AnnouncementView> notices = [];
    private IReadOnlyList<DashboardWork> activities = [];
    private IReadOnlyList<UnassignedItem> unassigned = [];
    private int refreshStamp;
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // The widgets look again every 30 seconds, so a new announcement, deadline or piece of work shows up without a refresh.
        if (role is not null)
        {
            timer = new Timer(_ => _ = InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            await LoadAsync();
            refreshStamp++;
            StateHasChanged();
        }
        catch (ObjectDisposedException)
        {
        }
    }

    public void Dispose() => timer?.Dispose();

    private async Task LoadAsync()
    {
        var user = await Me.GetAsync();
        role = user?.Role;
        if (user is null || (role != AppRoles.Student && role != AppRoles.Teacher))
        {
            role = null;
            return;
        }

        order = Show.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(w => w switch
            {
                "achievements" or "activities" or "announcements" => role == AppRoles.Student,
                "tocheck" or "unassigned" or "unchecked" => role == AppRoles.Teacher,
                "online" => true,
                _ => true,
            })
            .ToArray();

        if (order.Contains("announcements"))
        {
            notices = await Me.GetStudentIdAsync() is { } sid ? await Announcements.GetForStudentAsync(sid, 5) : [];
        }

        if (order.Contains("unassigned") && await Me.GetTeacherIdAsync() is { } teacherIdForItems)
        {
            unassigned = await Events.GetUnassignedAsync(teacherIdForItems);
        }

        if (order.Contains("activities") && await Me.GetStudentIdAsync() is { } studentIdForWork)
        {
            activities = (await Dashboards.GetStudentAsync(studentIdForWork))?.Work.Take(8).ToList() ?? [];
        }

        if (order.Contains("upnext"))
        {
            var today = PhilippineTime.Today(Clock);
            var now = Clock.GetUtcNow().UtcDateTime;
            upNext = (await Events.GetEventsAsync(user, today, today.AddDays(13)))
                .Where(e => !e.Done && e.Kind != CalendarKinds.Module && (e.AtUtc is null || e.AtUtc >= now || e.Overdue))
                .Take(5).ToList();
        }

        if (order.Contains("achievements") && await Me.GetStudentIdAsync() is { } studentId)
        {
            achievements = await Achievements.GetAsync(studentId);
        }

        if ((order.Contains("tocheck") || order.Contains("unchecked")) && await Me.GetTeacherIdAsync() is { } teacherId)
        {
            toCheck = await Dashboards.GetTeacherAsync(teacherId);
        }
    }

    private string WhenText(CalendarEvent e) =>
        e.AtUtc is { } at ? PhilippineTime.DueText(at, PhilippineTime.Now(Clock)).Replace("due ", "") : PhilippineTime.FormatDate(e.Day);
}
