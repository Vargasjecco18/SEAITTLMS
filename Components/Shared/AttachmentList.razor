@* The files attached to a syllabus, a module or an assignment. A name opens the file in the box in the middle of the screen (Components/Shared/FileViewer.razor)
   first: shown there when the browser can show it (a PDF, a picture, a text file, a sound, a video), otherwise with a Download button. The small
   arrow saves it at once. *@
@if (Items.Count > 0)
{
    <ul class="files" aria-label="@Label">
        @foreach (var f in Items)
        {
            <li>
                <span class="file-icon" aria-hidden="true"><Icon Name="@IconOf(f.Name)" Size="16" /></span>
                @if (PageHref?.Invoke(f) is { } readerHref)
                {
                    <a class="file-name" href="@readerHref" title="Read it here">@f.Name</a>
                }
                else
                {
                    <a class="file-name" href="files/a/@f.Id" target="_blank" rel="noopener noreferrer" data-file="@f.Name" data-show="@(f.CanPreview ? "1" : "0")" data-enhance-nav="false" title="Show the file">@f.Name</a>
                }
                <span class="file-size">@FileSize.Text(f.SizeBytes)</span>
                <a class="file-save" href="files/a/@f.Id?download=1" download="@f.Name" aria-label="@($"Download {f.Name}")" title="Download"><Icon Name="download" Size="15" /></a>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AttachmentRow> Items { get; set; } = [];

    /// <summary>When it gives an address for a file, the name opens that page of the system (the module, with the file shown in it) instead of a new tab of the browser.</summary>
    [Parameter] public Func<AttachmentRow, string?>? PageHref { get; set; }

    /// <summary>What the list is, for screen readers.</summary>
    [Parameter] public string Label { get; set; } = "Attached files";

    internal static string IconOf(string name) => Path.GetExtension(name).ToLowerInvariant() switch
    {
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" => "file-image",
        ".xls" or ".xlsx" or ".csv" => "file-spreadsheet",
        ".zip" or ".rar" or ".7z" => "file-archive",
        ".ppt" or ".pptx" or ".pps" or ".ppsx" or ".odp" or ".key" => "presentation",
        ".pdf" or ".doc" or ".docx" or ".txt" or ".md" => "file-text",
        _ => "file",
    };
}
