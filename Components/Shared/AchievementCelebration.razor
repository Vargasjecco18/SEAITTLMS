@rendermode InteractiveServer
@implements IDisposable
@inject CurrentUser Me
@inject AchievementService Achievements
@inject PopupGate Gate
@inject IJSRuntime JS

@* The box in the middle of the screen when a student has earned achievements. It is <b>one box</b> for everything earned since the last time: one achievement is shown big, several are
   listed together in the same box (they are not shown one after the other). It is shown once (what is on it is written down as seen when the student closes it). It is its own live island,
   so it works on a page that is otherwise plain. *@
<Modal Open="queue.Count > 0 && !closed" Title="@(queue.Count == 1 ? "Achievement unlocked!" : $"{queue.Count} achievements unlocked!")" OnClose="CloseAsync" Centered="true" Narrow="@(queue.Count == 1)">
    @if (queue.Count == 1)
    {
        var a = queue[0];
        <div class="celebrate @a.Color.ToString().ToLowerInvariant()">
            <div class="confetti" aria-hidden="true">
                @for (var i = 0; i < 16; i++)
                {
                    <i style="--i: @i"></i>
                }
            </div>
            <span class="medal"><Icon Name="@a.Icon" Size="44" /></span>
            <h3>@a.Title</h3>
            <p class="what">@a.Description</p>

            <Button IconName="circle-check" OnClick="CloseAsync">Great!</Button>
        </div>
    }
    else if (queue.Count > 1)
    {
        <div class="celebrate many">
            <div class="confetti" aria-hidden="true">
                @for (var i = 0; i < 16; i++)
                {
                    <i style="--i: @i"></i>
                }
            </div>
            <ul class="earned" aria-label="The achievements you earned">
                @foreach (var a in queue)
                {
                    <li class="@a.Color.ToString().ToLowerInvariant()" data-achievement="@a.Key">
                        <span class="mini-medal"><Icon Name="@a.Icon" Size="24" /></span>
                        <span class="earned-text">
                            <strong>@a.Title</strong>
                            <span>@a.Description</span>
                        </span>
                    </li>
                }
            </ul>

            <Button IconName="circle-check" OnClick="CloseAsync">Great!</Button>
        </div>
    }
</Modal>

@code {
    private IReadOnlyList<Achievement> queue = [];
    private bool closed;
    private int studentId;

    protected override async Task OnInitializedAsync()
    {
        studentId = await Me.GetStudentIdAsync() ?? 0;
        queue = studentId == 0 ? [] : await Achievements.GetUnseenAsync(studentId);
        if (queue.Count > 0)
        {
            // The box of the guidance counselor waits until this one is closed.
            holding = true;
            Gate.Enter();
        }
    }

    private bool holding;
    private bool soundPlayed;

    // The sound plays once when the box opens, however many achievements were earned together.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!soundPlayed && queue.Count > 0)
        {
            soundPlayed = true;
            try
            {
                await JS.InvokeVoidAsync("seaitt.playAchievementSound");
            }
            catch (JSException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    public void Dispose() => Release();

    private void Release()
    {
        if (holding)
        {
            holding = false;
            Gate.Leave();
        }
    }

    /// <summary>The student has seen them (or closed the box): all of them are written down as seen, so the box does not come back.</summary>
    private async Task CloseAsync()
    {
        if (closed)
        {
            return;
        }

        closed = true;
        await Achievements.MarkSeenAsync(studentId, queue.Select(a => a.Key).ToList());
        Release();
    }
}
