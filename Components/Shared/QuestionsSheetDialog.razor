@* The sheet for writing the questions of a summative exam inside the system, like the sheet of the modules: a row for each question with the Question, its Type (a list to choose
   from), the choices, the Right answer (a list to choose from: the choice that is right, or True or False) and the Points, and the step by step at the right. A box is read when it is
   left (not at every key) and nothing is built until the box is opened. The questions of the exam are the rows of the sheet: Save gives the page the whole list (the exam is saved
   when the page's own Save is pressed). *@
<Modal Open="Open" Title="@(Heading ?? $"Questions · {ExamTitle}")" Wider="true" Top="true" OnClose="CloseAsync">
    @if (Open)
    {
        <div class="sheet-layout">
            <div class="sheet-main">
                @if (HeaderContent is not null)
                {
                    @* Fields above the questions (the handout and the title of a new quiz). *@
                    <div class="sheet-head">@HeaderContent</div>
                }
                @if (Errors.Count > 0)
                {
                    <ul class="sheet-errors" role="alert">
                        @foreach (var error in Errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                }
                <p class="sheet-summary" role="status">
                    <strong>@ReadyCount</strong> of @Filled.Count @(Filled.Count == 1 ? "question is" : "questions are") ready.
                    @if (Filled.Count > ReadyCount)
                    {
                        <span class="bad">Every question must be ready to save. The reason is on its line.</span>
                    }
                    else if (ReadyCount > 0)
                    {
                        <span class="muted">The @Subject is worth @Filled.Sum(r => r.PointsValue).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) points.</span>
                    }
                </p>

                <div class="sheet-wrap">
                    <table class="sheet" aria-label="@($"Questions of the {Subject}")">
                        <thead>
                            <tr>
                                <th scope="col" class="c-n">#</th>
                                <th scope="col" class="c-q">Question</th>
                                <th scope="col" class="c-type">Type</th>
                                <th scope="col" class="c-choice">Choice A</th>
                                <th scope="col" class="c-choice">Choice B</th>
                                <th scope="col" class="c-choice">Choice C</th>
                                <th scope="col" class="c-choice">Choice D</th>
                                <th scope="col" class="c-right">Right answer</th>
                                <th scope="col" class="c-points">Points</th>
                                <th scope="col" class="c-state">Ready</th>
                                <th scope="col" class="c-open"><span class="sr-only">Open the question in a box</span></th>
                                <th scope="col" class="c-x"><span class="sr-only">Remove the row</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, n) in rows.Select((r, i) => (r, i + 1)))
                            {
                                var problems = row.Problems();
                                var filled = row.IsFilled;
                                var kind = row.Kind;
                                var isChoice = kind is QuestionKinds.MultipleChoice or QuestionKinds.MultipleSelect;
                                <tr class="@(filled ? (problems.Count == 0 ? "ok" : "bad") : "empty")" data-row="@n">
                                    <td class="c-n">@n</td>
                                    @* The question and the choices open in a box of their own (a double click, or the button): there the pictures and all the choices are. *@
                                    <td class="c-q" @ondblclick="() => OpenRow(row)">
                                        @if (kind == QuestionKinds.Matching)
                                        {
                                            <button type="button" class="cell summary" aria-label="@($"Open matching question {n}")" @onclick="() => OpenRow(row)">@MatchingSummary(row)</button>
                                        }
                                        else
                                        {
                                            <input class="cell" type="text" maxlength="1000" autocomplete="off" aria-label="@($"Question {n}")" placeholder="@(kind == QuestionKinds.FillInTheBlank ? "Write the sentence with ___ for each blank" : "Write the question")" value="@row.Text" @key="@($"q-{row.Id}-{kind}")"
                                                   @onchange="e => row.Text = e.Value?.ToString() ?? string.Empty" />
                                        }
                                        @if (row.Image is not null)
                                        {
                                            <span class="has-picture" title="This question has a picture"><Icon Name="image" Size="14" /></span>
                                        }
                                    </td>
                                    <td class="c-type">
                                        <select class="cell pick" aria-label="@($"Type of question {n}")" @onchange="e => ChangeKind(row, e.Value?.ToString())">
                                            @foreach (var k in QuestionKinds.All)
                                            {
                                                <option value="@k" selected="@(kind == k)">@QuestionKinds.Display(k)</option>
                                            }
                                        </select>
                                    </td>
                                    @for (var c = 0; c < Columns; c++)
                                    {
                                        var at = c;
                                        <td class="c-choice" @ondblclick="() => OpenRow(row)">
                                            <input class="cell" type="text" maxlength="200" autocomplete="off" aria-label="@($"Choice {(char)('A' + at)} of question {n}")" disabled="@(!isChoice)"
                                                   placeholder="@(isChoice ? "" : "—")" value="@(isChoice ? row.Options[at] : "")" @key="@($"c{at}-{row.Id}-{kind}")"
                                                   @onchange="e => row.Options[at] = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                    }
                                    <td class="c-right" @ondblclick="() => OpenRow(row)">
                                        @switch (kind)
                                        {
                                            case QuestionKinds.ShortAnswer:
                                            case QuestionKinds.Identification:
                                                <input class="cell" type="text" maxlength="500" autocomplete="off" aria-label="@($"Right answer of question {n}")" placeholder="Answer (or a | b)" value="@row.Short" @key="@($"s-{row.Id}")"
                                                       @onchange="e => row.Short = e.Value?.ToString() ?? string.Empty" />
                                                break;
                                            case QuestionKinds.TrueFalse:
                                                <select class="cell pick" aria-label="@($"Right answer of question {n}")" @onchange="e => row.Right = e.Value?.ToString() ?? string.Empty">
                                                    <option value="" selected="@(row.Right.Length == 0)">Choose</option>
                                                    <option value="True" selected="@(row.Right == "True")">True</option>
                                                    <option value="False" selected="@(row.Right == "False")">False</option>
                                                </select>
                                                break;
                                            case QuestionKinds.MultipleChoice:
                                                <select class="cell pick" aria-label="@($"Right answer of question {n}")" @onchange="e => row.Right = e.Value?.ToString() ?? string.Empty">
                                                    <option value="" selected="@(row.Right.Length == 0)">Choose</option>
                                                    @for (var c = 0; c < row.Options.Count; c++)
                                                    {
                                                        var letter = QuestionSheetRow.Letter(c);
                                                        if (row.Options[c].Trim().Length > 0)
                                                        {
                                                            <option value="@letter" selected="@(row.Right == letter)">@letter · @Shorten(row.Options[c])</option>
                                                        }
                                                    }
                                                </select>
                                                break;
                                            case QuestionKinds.MultipleSelect:
                                                <button type="button" class="cell summary" aria-label="@($"Right answers of question {n}")" @onclick="() => OpenRow(row)">@(row.RightSet.Count == 0 ? "Choose the right ones" : string.Join(", ", row.RightSet.OrderBy(x => x).Select(QuestionSheetRow.Letter)))</button>
                                                break;
                                            case QuestionKinds.FillInTheBlank:
                                                <button type="button" class="cell summary" aria-label="@($"Answers of the blanks of question {n}")" @onclick="() => OpenRow(row)">@(row.BlankCount == 0 ? "Add a blank ___ first" : $"{row.Blanks.Count(b => b.Trim().Length > 0)} of {row.BlankCount} answers")</button>
                                                break;
                                            case QuestionKinds.Matching:
                                                <button type="button" class="cell summary" aria-label="@($"Pairs of question {n}")" @onclick="() => OpenRow(row)">@(row.Pairs.Count(p => p.Trim().Length > 0)) of @(row.ColumnA.Count(a => a.Trim().Length > 0)) pairs</button>
                                                break;
                                            default:
                                                <span class="cell muted-cell">Scored by the teacher</span>
                                                break;
                                        }
                                    </td>
                                    <td class="c-points">
                                        <input class="cell cell-num" type="number" min="0.01" max="100" step="any" autocomplete="off" aria-label="@($"Points of question {n}")" value="@row.Points" @key="@($"p-{row.Id}")"
                                               @onchange="e => row.Points = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                    <td class="c-state">
                                        @if (!filled)
                                        {
                                            <span class="muted">—</span>
                                        }
                                        else if (problems.Count == 0)
                                        {
                                            <span class="state-ok"><Icon Name="circle-check" Size="15" /> Ready</span>
                                        }
                                        else
                                        {
                                            <span class="state-bad" title="@string.Join(" ", problems)"><Icon Name="circle-alert" Size="15" /> @problems[0]</span>
                                        }
                                    </td>
                                    <td class="c-open">
                                        <button type="button" class="row-open" data-open-row="@n" title="@($"Open question {n} in a box: pictures, all the choices")" aria-label="@($"Open question {n} in a box")" @onclick="() => OpenRow(row)"><Icon Name="pencil" Size="15" /></button>
                                    </td>
                                    <td class="c-x">
                                        <button type="button" class="row-x" title="@($"Take row {n} out")" aria-label="@($"Take row {n} out")" disabled="@(rows.Count <= 1)" @onclick="() => RemoveRow(row)"><Icon Name="trash-2" Size="15" /></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="sheet-tools">
                    @* Add [type] [number] row: the type of the new rows is chosen from a list and how many from a number box. *@
                    <span class="add-rows" role="group" aria-label="Add rows">
                        <span>Add</span>
                        <select id="add-kind" class="cell pick add-kind" aria-label="Type of the rows to add" @bind="addKind">
                            @foreach (var k in QuestionKinds.All)
                            {
                                <option value="@k">@QuestionKinds.Display(k)</option>
                            }
                        </select>
                        <input id="add-count" class="cell cell-num add-count" type="number" min="1" max="50" inputmode="numeric" aria-label="How many rows to add" @bind="addCount" @bind:event="oninput" />
                        <span>@(addCount == 1 ? "row" : "rows")</span>
                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" Disabled="@(rows.Count >= ItemSheets.MaxQuestions)" OnClick="AddChosenRows">Add</Button>
                    </span>
                    <span class="muted">@rows.Count of @ItemSheets.MaxQuestions rows</span>
                </div>

                <div class="sheet-actions">
                    <Button Variant="ButtonVariant.Ghost" OnClick="CloseAsync">Cancel</Button>
                    <Button IconName="circle-check" Disabled="@(Busy || SaveBlocked || Filled.Count == 0 || Filled.Count > ReadyCount)" OnClick="SaveAsync">@(Busy ? "Saving…" : Filled.Count == 1 ? "Save 1 question" : $"Save {Filled.Count} questions")</Button>
                </div>
            </div>

            <aside class="sheet-steps" aria-label="Step by step">
                <h3><Icon Name="list-checks" Size="18" /> Step by step</h3>
                <ol>
                    <li><strong>Write the question</strong> in a row. Press Tab to go to the next box.</li>
                    <li><strong>Choose the type</strong> from the list: multiple choice, true or false, short answer, identification, fill in the blank, matching type, multiple select or essay.</li>
                    <li>For <em>multiple choice</em> and <em>multiple select</em>, <strong>write the choices</strong> in A to D (at least two).</li>
                    <li><strong>Choose the right answer</strong> from the list: the choice that is right, or True or False. For a short answer or an identification, type the answer (several accepted answers are separated by <em>|</em>).</li>
                    <li><strong>Double click a question</strong> (or press the box button at the end of the row) to open it in a box: there you can <strong>add a picture</strong> to the question and to each choice, write more choices, the blanks, the two columns of a matching type, and pick the right answers.</li>
                    <li><strong>Set the points</strong> of the question (1 if you leave it).</li>
                    <li><strong>Look at the Ready column.</strong> A row with a problem tells you what is missing. A row with nothing in it is ignored.</li>
                    <li><strong>Press Save.</strong> @SaveStep</li>
                </ol>
            </aside>
        </div>
    }
</Modal>

<QuestionRowDialog Row="opened" Number="@(opened is null ? 0 : rows.IndexOf(opened) + 1)" OnClose="CloseRow" />

@code {
    /// <summary>Choice A to D: four boxes in the sheet. The box of a row has all the choices (up to eight).</summary>
    private const int Columns = 4;

    private readonly List<QuestionSheetRow> rows = [];
    private int nextId;
    private QuestionSheetRow? opened;

    // The type and the number of the rows that "Add [type] [number] rows" puts at the end.
    private string addKind = QuestionKinds.MultipleChoice;
    private int addCount = 1;

    [Parameter] public bool Open { get; set; }

    /// <summary>The exam the questions go to, for the heading.</summary>
    [Parameter] public string ExamTitle { get; set; } = "";

    /// <summary>The whole heading of the box, when it is not "Questions · exam title" (Add quiz).</summary>
    [Parameter] public string? Heading { get; set; }

    /// <summary>What the questions belong to, in the sentences: "exam" or "quiz".</summary>
    [Parameter] public string Subject { get; set; } = "exam";

    /// <summary>Fields above the sheet (Add quiz asks for the handout and the title there).</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>True while something outside the sheet is missing (the title of the quiz): Save waits.</summary>
    [Parameter] public bool SaveBlocked { get; set; }

    /// <summary>True while the page is saving: the button says so and waits.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>What went wrong when the page tried to save (shown above the sheet).</summary>
    [Parameter] public IReadOnlyList<string> Errors { get; set; } = [];

    /// <summary>The last step of the step by step.</summary>
    [Parameter] public string SaveStep { get; set; } = "The questions are put in the exam. The exam is saved when you press Save in the exam box.";

    /// <summary>The questions the exam has now: they are the first rows of the sheet.</summary>
    [Parameter] public IReadOnlyList<QuestionInput> Existing { get; set; } = [];

    /// <summary>Called with the whole list of questions of the sheet (the right ones) when Save is pressed.</summary>
    [Parameter] public EventCallback<IReadOnlyList<QuestionInput>> OnSave { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            rows.Clear();
            opened = null;
        }
        else if (!wasOpen)
        {
            // It opens with the questions the exam has, and a few empty rows after them.
            rows.Clear();
            foreach (var q in Existing)
            {
                rows.Add(QuestionSheetRow.From(q, ++nextId));
            }

            AddRows(rows.Count == 0 ? 3 : 1, QuestionKinds.MultipleChoice);
        }

        wasOpen = Open;
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private void AddRows(int count, string kind)
    {
        for (var n = 0; n < count && rows.Count < ItemSheets.MaxQuestions; n++)
        {
            var row = new QuestionSheetRow { Id = ++nextId, Kind = kind };
            row.Fit();
            rows.Add(row);
        }
    }

    private void AddChosenRows() => AddRows(Math.Clamp(addCount, 1, 50), addKind);

    private void RemoveRow(QuestionSheetRow row)
    {
        if (rows.Count > 1)
        {
            rows.Remove(row);
        }
    }

    private static void ChangeKind(QuestionSheetRow row, string? kind)
    {
        if (kind is not null)
        {
            row.ChangeKind(kind);
        }
    }

    private void OpenRow(QuestionSheetRow row) => opened = row;

    private void CloseRow() => opened = null;

    private static string Shorten(string text) => text.Length <= 18 ? text : text[..17] + "…";

    private static string MatchingSummary(QuestionSheetRow row)
    {
        var a = row.ColumnA.Count(x => x.Trim().Length > 0);
        var b = row.Options.Count(x => x.Trim().Length > 0);
        return a + b == 0 ? "Matching: open to write Column A and B" : $"Column A: {a} · Column B: {b}";
    }

    private IReadOnlyList<QuestionSheetRow> Filled => [.. rows.Where(r => r.IsFilled)];

    private int ReadyCount => Filled.Count(r => r.Problems().Count == 0);

    private async Task SaveAsync()
    {
        var list = Filled.Select(r =>
        {
            var q = r.ToQuestion();
            if (r.Points.Trim().Length == 0)
            {
                q.Points = 1;
            }

            return q;
        }).ToList();

        await OnSave.InvokeAsync(list);
    }
}
