@* The sheet for writing the questions of a summative exam inside the system, like the sheet of the modules: a row for each question with the Question, its Type (a list to choose
   from), the choices, the Right answer (a list to choose from: the choice that is right, or True or False) and the Points, and the step by step at the right. A box is read when it is
   left (not at every key) and nothing is built until the box is opened. The questions of the exam are the rows of the sheet: Save gives the page the whole list (the exam is saved
   when the page's own Save is pressed). *@
<Modal Open="Open" Title="@($"Questions · {ExamTitle}")" Wide="true" Top="true" OnClose="CloseAsync">
    @if (Open)
    {
        <div class="sheet-layout">
            <div class="sheet-main">
                <p class="sheet-summary" role="status">
                    <strong>@ReadyCount</strong> of @Filled.Count @(Filled.Count == 1 ? "question is" : "questions are") ready.
                    @if (Filled.Count > ReadyCount)
                    {
                        <span class="bad">Every question must be ready to save. The reason is on its line.</span>
                    }
                    else if (ReadyCount > 0)
                    {
                        <span class="muted">The exam is worth @Filled.Sum(r => r.PointsValue).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) points.</span>
                    }
                </p>

                <div class="sheet-wrap">
                    <table class="sheet" aria-label="Questions of the exam">
                        <thead>
                            <tr>
                                <th scope="col" class="c-n">#</th>
                                <th scope="col" class="c-q">Question</th>
                                <th scope="col" class="c-type">Type</th>
                                <th scope="col" class="c-choice">Choice A</th>
                                <th scope="col" class="c-choice">Choice B</th>
                                <th scope="col" class="c-choice">Choice C</th>
                                <th scope="col" class="c-choice">Choice D</th>
                                <th scope="col" class="c-right">Right answer</th>
                                <th scope="col" class="c-points">Points</th>
                                <th scope="col" class="c-state">Ready</th>
                                <th scope="col" class="c-x"><span class="sr-only">Remove the row</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, n) in rows.Select((r, i) => (r, i + 1)))
                            {
                                var problems = ProblemsOf(row);
                                var filled = IsFilled(row);
                                var isChoice = row.Kind == QuestionKinds.MultipleChoice;
                                <tr class="@(filled ? (problems.Count == 0 ? "ok" : "bad") : "empty")" data-row="@n">
                                    <td class="c-n">@n</td>
                                    <td class="c-q">
                                        <input class="cell" type="text" maxlength="1000" autocomplete="off" aria-label="@($"Question {n}")" placeholder="Write the question" value="@row.Text" @key="@($"q-{row.Id}")"
                                               @onchange="e => row.Text = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                    <td class="c-type">
                                        <select class="cell pick" aria-label="@($"Type of question {n}")" @onchange="e => ChangeKind(row, e.Value?.ToString())">
                                            <option value="@QuestionKinds.MultipleChoice" selected="@(row.Kind == QuestionKinds.MultipleChoice)">Multiple choice</option>
                                            <option value="@QuestionKinds.TrueFalse" selected="@(row.Kind == QuestionKinds.TrueFalse)">True or false</option>
                                            <option value="@QuestionKinds.ShortAnswer" selected="@(row.Kind == QuestionKinds.ShortAnswer)">Short answer</option>
                                        </select>
                                    </td>
                                    @for (var c = 0; c < Columns; c++)
                                    {
                                        var at = c;
                                        <td class="c-choice">
                                            <input class="cell" type="text" maxlength="200" autocomplete="off" aria-label="@($"Choice {(char)('A' + at)} of question {n}")" disabled="@(!isChoice)"
                                                   placeholder="@(isChoice ? "" : "—")" value="@row.Choices[at]" @key="@($"c{at}-{row.Id}-{row.Kind}")"
                                                   @onchange="e => row.Choices[at] = e.Value?.ToString() ?? string.Empty" />
                                        </td>
                                    }
                                    <td class="c-right">
                                        @if (row.Kind == QuestionKinds.ShortAnswer)
                                        {
                                            <input class="cell" type="text" maxlength="500" autocomplete="off" aria-label="@($"Right answer of question {n}")" placeholder="Answer (or a | b)" value="@row.Short" @key="@($"s-{row.Id}")"
                                                   @onchange="e => row.Short = e.Value?.ToString() ?? string.Empty" />
                                        }
                                        else
                                        {
                                            <select class="cell pick" aria-label="@($"Right answer of question {n}")" @onchange="e => row.Right = e.Value?.ToString() ?? string.Empty">
                                                <option value="" selected="@(row.Right.Length == 0)">Choose</option>
                                                @if (isChoice)
                                                {
                                                    @for (var c = 0; c < Columns; c++)
                                                    {
                                                        var letter = ((char)('A' + c)).ToString();
                                                        if (row.Choices[c].Trim().Length > 0)
                                                        {
                                                            <option value="@letter" selected="@(row.Right == letter)">@letter · @Shorten(row.Choices[c])</option>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <option value="True" selected="@(row.Right == "True")">True</option>
                                                    <option value="False" selected="@(row.Right == "False")">False</option>
                                                }
                                            </select>
                                        }
                                    </td>
                                    <td class="c-points">
                                        <input class="cell cell-num" type="number" min="0.01" max="100" step="any" autocomplete="off" aria-label="@($"Points of question {n}")" value="@row.Points" @key="@($"p-{row.Id}")"
                                               @onchange="e => row.Points = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                    <td class="c-state">
                                        @if (!filled)
                                        {
                                            <span class="muted">—</span>
                                        }
                                        else if (problems.Count == 0)
                                        {
                                            <span class="state-ok"><Icon Name="circle-check" Size="15" /> Ready</span>
                                        }
                                        else
                                        {
                                            <span class="state-bad" title="@string.Join(" ", problems)"><Icon Name="circle-alert" Size="15" /> @problems[0]</span>
                                        }
                                    </td>
                                    <td class="c-x">
                                        <button type="button" class="row-x" title="@($"Take row {n} out")" aria-label="@($"Take row {n} out")" disabled="@(rows.Count <= 1)" @onclick="() => RemoveRow(row)"><Icon Name="trash-2" Size="15" /></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="sheet-tools">
                    @* Add [type] [number] row: the type of the new rows is chosen from a list and how many from a number box. *@
                    <span class="add-rows" role="group" aria-label="Add rows">
                        <span>Add</span>
                        <select id="add-kind" class="cell pick add-kind" aria-label="Type of the rows to add" @bind="addKind">
                            <option value="@QuestionKinds.MultipleChoice">Multiple choice</option>
                            <option value="@QuestionKinds.TrueFalse">True or false</option>
                            <option value="@QuestionKinds.ShortAnswer">Short answer</option>
                        </select>
                        <input id="add-count" class="cell cell-num add-count" type="number" min="1" max="50" inputmode="numeric" aria-label="How many rows to add" @bind="addCount" @bind:event="oninput" />
                        <span>@(addCount == 1 ? "row" : "rows")</span>
                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" Disabled="@(rows.Count >= ItemSheets.MaxQuestions)" OnClick="AddChosenRows">Add</Button>
                    </span>
                    <span class="muted">@rows.Count of @ItemSheets.MaxQuestions rows</span>
                </div>

                <div class="sheet-actions">
                    <Button Variant="ButtonVariant.Ghost" OnClick="CloseAsync">Cancel</Button>
                    <Button IconName="circle-check" Disabled="@(Filled.Count == 0 || Filled.Count > ReadyCount)" OnClick="SaveAsync">@(Filled.Count == 1 ? "Save 1 question" : $"Save {Filled.Count} questions")</Button>
                </div>
            </div>

            <aside class="sheet-steps" aria-label="Step by step">
                <h3><Icon Name="list-checks" Size="18" /> Step by step</h3>
                <ol>
                    <li><strong>Write the question</strong> in a row. Press Tab to go to the next box.</li>
                    <li><strong>Choose the type</strong> from the list: multiple choice, true or false, or short answer.</li>
                    <li>For <em>multiple choice</em>, <strong>write the choices</strong> in A to D (at least two).</li>
                    <li><strong>Choose the right answer</strong> from the list: the choice that is right, or True or False. For a short answer, type the answer (several accepted answers are separated by <em>|</em>).</li>
                    <li><strong>Set the points</strong> of the question (1 if you leave it).</li>
                    <li><strong>Look at the Ready column.</strong> A row with a problem tells you what is missing. A row with nothing in it is ignored.</li>
                    <li><strong>Press Save.</strong> The questions are put in the exam. The exam is saved when you press Save in the exam box.</li>
                </ol>
            </aside>
        </div>
    }
</Modal>

@code {
    /// <summary>Choice A to D: four boxes. A question that has more choices (from an earlier import) keeps them in <see cref="SheetRow.More"/>.</summary>
    private const int Columns = 4;

    private sealed class SheetRow
    {
        public int Id { get; init; }
        public string Text { get; set; } = "";
        public string Kind { get; set; } = QuestionKinds.MultipleChoice;
        public string[] Choices { get; } = new string[Columns].Select(_ => "").ToArray();

        /// <summary>The choices after D of a question that was written before this sheet (they stay as they are).</summary>
        public List<string> More { get; } = [];

        /// <summary>The right answer of a multiple choice (the letter, A to D) or of a true or false (True or False).</summary>
        public string Right { get; set; } = "";

        /// <summary>The right answer of a short answer.</summary>
        public string Short { get; set; } = "";

        public string Points { get; set; } = "1";

        public decimal PointsValue => decimal.TryParse(Points, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var p) ? p : 0;
    }

    private readonly List<SheetRow> rows = [];
    private int nextId;

    // The type and the number of the rows that "Add [type] [number] rows" puts at the end.
    private string addKind = QuestionKinds.MultipleChoice;
    private int addCount = 1;

    [Parameter] public bool Open { get; set; }

    /// <summary>The exam the questions go to, for the heading.</summary>
    [Parameter] public string ExamTitle { get; set; } = "";

    /// <summary>The questions the exam has now: they are the first rows of the sheet.</summary>
    [Parameter] public IReadOnlyList<QuestionInput> Existing { get; set; } = [];

    /// <summary>Called with the whole list of questions of the sheet (the right ones) when Save is pressed.</summary>
    [Parameter] public EventCallback<IReadOnlyList<QuestionInput>> OnSave { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            rows.Clear();
        }
        else if (!wasOpen)
        {
            // It opens with the questions the exam has, and a few empty rows after them.
            rows.Clear();
            foreach (var q in Existing)
            {
                rows.Add(FromQuestion(q));
            }

            AddRows(rows.Count == 0 ? 3 : 1, QuestionKinds.MultipleChoice);
        }

        wasOpen = Open;
    }

    private SheetRow FromQuestion(QuestionInput q)
    {
        var row = new SheetRow { Id = ++nextId, Text = q.Text, Kind = q.Kind, Points = q.Points.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) };
        if (q.Kind == QuestionKinds.MultipleChoice)
        {
            var options = (q.OptionsText ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            for (var c = 0; c < options.Count; c++)
            {
                if (c < Columns)
                {
                    row.Choices[c] = options[c];
                }
                else
                {
                    row.More.Add(options[c]);
                }
            }

            var at = options.FindIndex(o => string.Equals(o, q.CorrectAnswer.Trim(), StringComparison.OrdinalIgnoreCase));
            row.Right = at is >= 0 and < Columns ? ((char)('A' + at)).ToString() : "";
        }
        else if (q.Kind == QuestionKinds.TrueFalse)
        {
            row.Right = q.CorrectAnswer;
        }
        else
        {
            row.Short = q.CorrectAnswer;
        }

        return row;
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private void AddRows(int count, string kind)
    {
        for (var n = 0; n < count && rows.Count < ItemSheets.MaxQuestions; n++)
        {
            rows.Add(new SheetRow { Id = ++nextId, Kind = kind });
        }
    }

    private void AddChosenRows() => AddRows(Math.Clamp(addCount, 1, 50), addKind);

    private void RemoveRow(SheetRow row)
    {
        if (rows.Count > 1)
        {
            rows.Remove(row);
        }
    }

    /// <summary>A new type clears what only fits the old one (the right answer, and the choices when it is not multiple choice).</summary>
    private static void ChangeKind(SheetRow row, string? kind)
    {
        if (kind is null || kind == row.Kind)
        {
            return;
        }

        row.Kind = kind;
        row.Right = "";
        row.Short = "";
        if (kind != QuestionKinds.MultipleChoice)
        {
            for (var c = 0; c < Columns; c++)
            {
                row.Choices[c] = "";
            }

            row.More.Clear();
        }
    }

    private static string Shorten(string text) => text.Length <= 18 ? text : text[..17] + "…";

    private static bool IsFilled(SheetRow row) =>
        row.Text.Trim().Length > 0 || row.Choices.Any(c => c.Trim().Length > 0) || row.Right.Length > 0 || row.Short.Trim().Length > 0;

    private IReadOnlyList<SheetRow> Filled => [.. rows.Where(IsFilled)];

    private int ReadyCount => Filled.Count(r => ProblemsOf(r).Count == 0);

    private static QuestionInput ToQuestion(SheetRow row)
    {
        var question = new QuestionInput { Text = row.Text.Trim(), Kind = row.Kind, Points = row.PointsValue };
        if (row.Kind == QuestionKinds.MultipleChoice)
        {
            var texts = row.Choices.Select(c => c.Trim()).ToList();
            question.OptionsText = string.Join('\n', texts.Where(t => t.Length > 0).Concat(row.More));
            var at = row.Right.Length == 1 ? row.Right[0] - 'A' : -1;
            question.CorrectAnswer = at is >= 0 and < Columns ? texts[at] : "";
        }
        else if (row.Kind == QuestionKinds.TrueFalse)
        {
            question.CorrectAnswer = row.Right;
        }
        else
        {
            question.CorrectAnswer = row.Short.Trim();
        }

        return question;
    }

    private static List<string> ProblemsOf(SheetRow row)
    {
        var problems = new List<string>();
        if (row.Points.Trim().Length > 0 && row.PointsValue <= 0)
        {
            problems.Add("The points must be a number from 0.01 to 100.");
        }

        if (row.Kind == QuestionKinds.MultipleChoice && row.Right.Length == 0 && row.Choices.Count(c => c.Trim().Length > 0) >= 2)
        {
            problems.Add("Choose the right answer.");
        }

        if (problems.Count == 0)
        {
            var question = ToQuestion(row);
            if (row.Points.Trim().Length == 0)
            {
                question.Points = 1;
            }

            problems.AddRange(ModuleService.ValidateQuestions([question]).Select(e => e.Replace("Question 1: ", "")));
        }

        return problems;
    }

    private async Task SaveAsync()
    {
        var list = Filled.Select(r =>
        {
            var q = ToQuestion(r);
            if (r.Points.Trim().Length == 0)
            {
                q.Points = 1;
            }

            return q;
        }).ToList();

        await OnSave.InvokeAsync(list);
    }
}
