<div class="empty">
    <span class="empty-icon @Tone.ToString().ToLowerInvariant()"><Icon Name="@IconName" Size="28" /></span>
    @if (IsPage)
    {
        <h1>@Title</h1>
    }
    else
    {
        <h3>@Title</h3>
    }
    @if (ChildContent is not null)
    {
        <div class="empty-body">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string IconName { get; set; } = "";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public Tone Tone { get; set; } = Tone.Neutral;

    /// <summary>True when this is the main message of the whole page: the title is then the page's h1.</summary>
    [Parameter] public bool IsPage { get; set; }

    /// <summary>The explanation and the buttons under the title.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
