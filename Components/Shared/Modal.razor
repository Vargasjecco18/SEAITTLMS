@using Microsoft.AspNetCore.Components.Web

@if (Open)
{
    @* A box over the page. It closes with the X, with the Cancel button of the form in it, or with Escape.
       Clicking next to it does not close it, so a half-filled form is not lost by accident. The key handler sits on the
       whole overlay (which can take the focus too), so Escape still works after a click next to the box. *@
    <div class="backdrop @(Centered ? "centered" : "") @(Top ? "top" : "") @(Banner ? "banner" : "")" tabindex="-1" @onkeydown="OnKeyDown">
        <div class="dialog @(Large ? "large" : "") @(Narrow ? "narrow" : "") @DialogClass" role="dialog" aria-modal="true" aria-labelledby="@titleId" tabindex="-1" @ref="dialog">
            <header class="dialog-head">
                <h2 id="@titleId">@Title</h2>
                <button type="button" class="close" aria-label="Close" title="Close" @onclick="Close"><Icon Name="x" Size="20" /></button>
            </header>
            <div class="dialog-body">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    private readonly string titleId = "modal-title-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference dialog;
    private bool wasOpen;

    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>A wider box, for content like a conversation.</summary>
    [Parameter] public bool Large { get; set; }

    /// <summary>Shown in the middle of the screen instead of near the top (for a short message, like a celebration).</summary>
    [Parameter] public bool Centered { get; set; }

    /// <summary>Over every other box (for the notice of a page, which can open while a form is still open).</summary>
    [Parameter] public bool Top { get; set; }

    /// <summary>At the top center of the screen, dropping in from above with a lighter backdrop (for the notice of a page, which has to be seen at once).</summary>
    [Parameter] public bool Banner { get; set; }

    /// <summary>An extra style for the box: "success" or "error" (a colored edge).</summary>
    [Parameter] public string? DialogClass { get; set; }

    /// <summary>A narrower box.</summary>
    [Parameter] public bool Narrow { get; set; }

    /// <summary>Called when the X or Escape asks to close it. The page then sets Open to false.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // When it opens, put the keyboard in it.
        if (Open && !wasOpen)
        {
            await dialog.FocusAsync();
        }

        wasOpen = Open;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await Close();
        }
    }
}
