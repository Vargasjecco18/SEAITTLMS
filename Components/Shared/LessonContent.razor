@* A module as the student reads it: the files and the slides shown right in the page (a PDF, a picture ...), under the title of the module. There is no lesson text any more: the
   title of the module is the title of its file. The teacher sees the same thing on the page of the module, with the form to edit it at the right. *@
@{
    var slides = Files.Where(f => f.IsSlides).ToList();
    var others = Files.Where(f => !f.IsSlides).ToList();
}
<div class="layout">
    @if (others.Count > 0)
    {
        <Card Title="@(Title ?? (others.Count == 1 ? "File" : "Files"))" IconName="file-text">
            <FilePreviewPane Items="others" InitialId="InitialFileId" Label="Files of this module" ModuleLabel="@ModuleLabel" />
        </Card>
    }

    @if (slides.Count > 0)
    {
        <Card Title="@(others.Count > 0 || Title is null ? "Slides" : Title)" IconName="presentation">
            <FilePreviewPane Items="slides" InitialId="InitialFileId" Label="Slides of this module" ModuleLabel="@ModuleLabel" />
        </Card>
    }

    @if (Files.Count == 0)
    {
        <Card Title="@(Title ?? "Files")" IconName="paperclip">
            <p class="muted">@(ShowText ? "This module has no file yet." : "This module has no file. Add one in Edit module, at the right.")</p>
        </Card>
    }

    @if (!string.IsNullOrWhiteSpace(LinkUrl))
    {
        <p class="link"><Icon Name="link" Size="16" /> <a href="@LinkUrl" target="_blank" rel="noopener noreferrer">@LinkUrl <Icon Name="external-link" Size="14" /></a></p>
    }
</div>

@code {
    /// <summary>The title of the module: it is the title shown over its file.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? LinkUrl { get; set; }

    [Parameter] public IReadOnlyList<AttachmentRow> Files { get; set; } = [];

    /// <summary>False on the page of the teacher (it says where to add a file); true for the student.</summary>
    [Parameter] public bool ShowText { get; set; } = true;

    /// <summary>The module the files belong to ("Module 1"): a long file name is shown as this.</summary>
    [Parameter] public string? ModuleLabel { get; set; }

    /// <summary>The file to show first, when the person came from the name of a file.</summary>
    [Parameter] public int? InitialFileId { get; set; }
}
