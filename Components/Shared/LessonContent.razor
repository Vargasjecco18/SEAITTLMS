@* A module as the student reads it: the files and the slides shown right in the page (a PDF, a picture ...), under the title of the module. There is no lesson text any more: the
   title of the handout is the title of its file. The teacher sees the same thing on the page of the handout, with the form to edit it at the right. *@
@{
    var slides = Files.Where(f => f.IsSlides).ToList();
    var others = Files.Where(f => !f.IsSlides).ToList();
}
<div class="layout">
    @* The reference link is in the bar of the first file shown (at the left of "Open in a new tab"). *@
    @if (others.Count > 0)
    {
        <div id="module-files">
            <Card>
                <FilePreviewPane Items="others" InitialId="InitialFileId" Label="Files of this handout" ModuleLabel="@ModuleLabel" LinkUrl="@LinkUrl" />
            </Card>
        </div>
    }

    @if (slides.Count > 0)
    {
        @* The Slides button of the course page comes here (#slides). *@
        <div id="slides">
            <Card>
                <FilePreviewPane Items="slides" InitialId="InitialFileId" Label="Slides of this handout" ModuleLabel="@ModuleLabel" LinkUrl="@(others.Count == 0 ? LinkUrl : null)" IsSlides="true" />
            </Card>
        </div>
    }

    @if (Files.Count == 0)
    {
        <Card>
            @LinkLine
            <p class="muted">@(ShowText ? "This handout has no file yet." : "This handout has no file. Add one in Edit handout, at the right.")</p>
        </Card>
    }

</div>

@code {
    /// <summary>The link of the module (when it has one), inside the card of its file.</summary>
    private RenderFragment LinkLine => @<text>
        @if (!string.IsNullOrWhiteSpace(LinkUrl))
        {
            <p class="link"><Icon Name="link" Size="16" /> <a href="@LinkUrl" target="_blank" rel="noopener noreferrer" title="@LinkUrl">Reference link <Icon Name="external-link" Size="14" /></a></p>
        }
    </text>;

    /// <summary>The title of the module: it is the title shown over its file.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? LinkUrl { get; set; }

    [Parameter] public IReadOnlyList<AttachmentRow> Files { get; set; } = [];

    /// <summary>False on the page of the teacher (it says where to add a file); true for the student.</summary>
    [Parameter] public bool ShowText { get; set; } = true;

    /// <summary>The module the files belong to ("Module 1"): a long file name is shown as this.</summary>
    [Parameter] public string? ModuleLabel { get; set; }

    /// <summary>The file to show first, when the person came from the name of a file.</summary>
    [Parameter] public int? InitialFileId { get; set; }
}
