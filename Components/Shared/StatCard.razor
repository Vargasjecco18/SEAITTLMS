<article class="stat @Accent.ToString().ToLowerInvariant()">
    <span class="stat-icon"><Icon Name="@IconName" Size="22" /></span>
    <div class="stat-text">
        <span class="stat-value">@Value.ToString("N0")</span>
        <span class="stat-label">@Label</span>
        @if (!string.IsNullOrEmpty(Hint))
        {
            <span class="stat-hint">@Hint</span>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public int Value { get; set; }

    [Parameter, EditorRequired] public string IconName { get; set; } = "";

    [Parameter] public AccentColor Accent { get; set; } = AccentColor.Blue;

    /// <summary>A small extra line under the label, for example "2 inactive".</summary>
    [Parameter] public string? Hint { get; set; }
}
