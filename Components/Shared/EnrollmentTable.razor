@using SEAITT_LMS.Data.Queries
@using SEAITT_LMS.Services

<div class="table-wrap">
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Student</th>
                <th scope="col">Section</th>
                <th scope="col">Term</th>
                @if (ShowSubjects)
                {
                    <th scope="col" class="col-subjects">Courses</th>
                }
                @if (ShowFinalGrade)
                {
                    <th scope="col" class="col-grade">Final grade</th>
                }
                @if (ShowNextTerm)
                {
                    <th scope="col" class="col-next">Next term</th>
                }
                <th scope="col" class="col-date">Enrolled</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td>
                        <div class="person">
                            <Avatar Name="@row.StudentName" Size="34" />
                            <div class="person-text">
                                <span class="person-name">@row.StudentName</span>
                                <span class="sub">LRN @row.Lrn</span>
                                @if (ShowPhone && row.Phone is not null)
                                {
                                    <span class="sub phone">@row.Phone</span>
                                }
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="section">@row.Section</span>
                        <span class="sub">@row.Track</span>
                    </td>
                    <td class="col-term">
                        <span>@row.Term</span>
                        <span class="sub">@row.SchoolYear</span>
                        @if (row.Status != "Enrolled")
                        {
                            <Badge Tone="Tone.Warning">@row.Status</Badge>
                        }
                    </td>
                    @if (ShowSubjects)
                    {
                        <td class="col-subjects">
                            @if (SubjectNames(row) is { Count: > 0 } names)
                            {
                                @* The button opens a pop-up (the HTML popover) over the page, so the columns of the table do not move.
                                   wwwroot/app.js puts the pop-up next to the button. *@
                                <button type="button" class="courses-button" popovertarget="@PopupId(row)">
                                    @(names.Count == 1 ? "1 course" : $"{names.Count} courses")
                                </button>
                                <div id="@PopupId(row)" popover class="courses-pop" role="group" aria-label="@($"Courses of {row.StudentName}")">
                                    <div class="pop-head">
                                        <div class="pop-title">
                                            <strong>Courses</strong>
                                            <span class="sub">@row.StudentName · @row.Term, @row.SchoolYear</span>
                                        </div>
                                        <button type="button" class="pop-close" popovertarget="@PopupId(row)" popovertargetaction="hide" aria-label="Close">
                                            <Icon Name="x" Size="16" />
                                        </button>
                                    </div>
                                    <ul>
                                        @foreach (var name in names)
                                        {
                                            <li>@name</li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <span class="sub">None</span>
                            }
                        </td>
                    }
                    @if (ShowFinalGrade)
                    {
                        <td class="col-grade">
                            @if (row.FinalGrade is { } grade)
                            {
                                <Badge Tone="@GradeRules.ToneOf(grade)">@grade.ToString("0.#")%</Badge>
                                <span class="sub">@GradeRules.Descriptor(grade)</span>
                            }
                            else
                            {
                                <span class="sub">No grades yet</span>
                            }
                        </td>
                    }
                    @if (ShowNextTerm)
                    {
                        <td class="col-next">
                            @if (NextTerm is null)
                            {
                                <span class="sub" title="The academic coordinator adds the next term in the academic setup.">No next term yet</span>
                            }
                            else if (row.NextEnrollmentId is not null)
                            {
                                <Badge Tone="Tone.Success">Enrolled</Badge>
                                <span class="sub">@NextTerm.Name</span>
                                <UnenrollButton StudentId="row.StudentId" StudentName="@row.StudentName" TermLabel="@NextTerm.Label" />
                            }
                            else
                            {
                                <Badge>Not enrolled</Badge>
                                <span class="sub">@NextTerm.Name</span>
                                <a class="enroll-link" href="registrar/enrollments?lrn=@row.Lrn&term=@NextTerm.Id">Enroll</a>
                            }
                        </td>
                    }
                    <td class="col-date">
                        <span>@PhilippineTime.FormatDate(row.EnrolledAtUtc)</span>
                        <span class="sub">@PhilippineTime.FormatTime(row.EnrolledAtUtc)</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<EnrollmentRow> Rows { get; set; } = [];

    /// <summary>The list of subjects makes the table wide, so the dashboard leaves it out.</summary>
    [Parameter] public bool ShowSubjects { get; set; }

    /// <summary>The final grade of each enrollment (the average of its courses), left of the next term. The rows need it worked out.</summary>
    [Parameter] public bool ShowFinalGrade { get; set; }

    /// <summary>The student's phone number under the LRN (the registrar's list).</summary>
    [Parameter] public bool ShowPhone { get; set; }

    /// <summary>The column that says whether the student is enrolled for the next term, with the button to unenroll.</summary>
    [Parameter] public bool ShowNextTerm { get; set; }

    /// <summary>The term after the current one (null when there is none).</summary>
    [Parameter] public TermRef? NextTerm { get; set; }

    private static string PopupId(EnrollmentRow row) => $"courses-{row.Id}";

    /// <summary>The course names of one enrollment (they are saved as one text, separated by commas).</summary>
    private static List<string> SubjectNames(EnrollmentRow row) =>
        (row.Subjects ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
}
