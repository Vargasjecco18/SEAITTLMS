@* The files of a lesson shown right in the page: a PDF or a text file in a viewer, a picture, a sound or a video in its player. When there are several files, a button for each
   one switches the viewer. A file the browser can't show (a Word or PowerPoint file, for example) says so and offers the download. A PDF is drawn page by page in the page itself (so the reading progress
   knows which pages were seen); "Open in a new tab" opens it in the browser's own viewer, which has the print button, and Download saves it. *@
@if (Items.Count > 0)
{
    var current = Current;
    <div class="pane" data-file-ids="@string.Join(',', Items.Select(i => i.Id))">
        @if (Items.Count > 1)
        {
            <div class="chips" role="group" aria-label="@Label">
                @foreach (var (f, place) in Items.Select((f, i) => (f, i + 1)))
                {
                    var id = f.Id;
                    <button type="button" class="chip @(id == current.Id ? "on" : "")" aria-pressed="@(id == current.Id ? "true" : "false")" title="@f.Name" @onclick="() => selectedId = id">
                        <Icon Name="@AttachmentList.IconOf(f.Name)" Size="15" /> <span>@FileLabel.Short(f.Name, ModuleLabel, place)</span>
                    </button>
                }
            </div>
        }

        <div class="bar">
            <span class="file-title" title="@current.Name"><Icon Name="@AttachmentList.IconOf(current.Name)" Size="16" /> <strong>@FileLabel.Short(current.Name, ModuleLabel, PlaceOf(current))</strong> <span class="size">@FileSize.Text(current.SizeBytes)</span></span>
            <span class="bar-links">
                @if (current.CanPreview)
                {
                    <a href="files/a/@current.Id" target="_blank" rel="noopener noreferrer"><Icon Name="external-link" Size="14" /> Open in a new tab</a>
                }

                <a href="files/a/@current.Id?download=1" download="@current.Name" data-file-id="@current.Id"><Icon Name="download" Size="14" /> Download</a>
            </span>
        </div>

        <div class="viewer">
            @switch (KindOf(current.Name))
            {
                case "pdf":
                    @* The pages of the PDF are drawn here by wwwroot/app.js (PDF.js): what was scrolled and the pages that were seen inside this box count for the reading progress. *@
                    <div class="pdf-view" @key="current.Id" data-pdf-src="files/a/@current.Id" data-file-id="@current.Id" data-file-name="@current.Name" role="document" aria-label="@current.Name"></div>
                    break;
                case "frame":
                    <iframe title="@current.Name" src="files/a/@current.Id" loading="lazy" data-file-id="@current.Id"></iframe>
                    break;
                case "image":
                    <img src="files/a/@current.Id" alt="@current.Name" data-file-id="@current.Id" />
                    break;
                case "audio":
                    <audio controls src="files/a/@current.Id" aria-label="@current.Name" data-file-id="@current.Id"></audio>
                    break;
                case "video":
                    <video controls src="files/a/@current.Id" aria-label="@current.Name" data-file-id="@current.Id"></video>
                    break;
                default:
                    <p class="none"><Icon Name="file" Size="20" /> This kind of file can't be shown here. Download it to read it.</p>
                    break;
            }
        </div>
    </div>
}

@code {
    private int? selectedId;

    [Parameter, EditorRequired] public IReadOnlyList<AttachmentRow> Items { get; set; } = [];

    /// <summary>The file that is shown first (the one the person pressed in a list); the first one the browser can show when it is not given.</summary>
    [Parameter] public int? InitialId { get; set; }

    /// <summary>The module the files belong to ("Module 1"): a long file name is shown as this.</summary>
    [Parameter] public string? ModuleLabel { get; set; }

    private int PlaceOf(AttachmentRow file) => Items.ToList().FindIndex(f => f.Id == file.Id) + 1;

    /// <summary>What the buttons are, for screen readers.</summary>
    [Parameter] public string Label { get; set; } = "Files of the lesson";

    protected override void OnParametersSet() => selectedId ??= InitialId;

    private AttachmentRow Current => Items.FirstOrDefault(f => f.Id == selectedId) ?? Items.FirstOrDefault(f => f.CanPreview) ?? Items[0];

    private static string KindOf(string name) => Path.GetExtension(name).ToLowerInvariant() switch
    {
        ".pdf" => "pdf",
        ".txt" or ".csv" or ".md" or ".log" => "frame",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" => "image",
        ".mp3" or ".wav" or ".ogg" => "audio",
        ".mp4" or ".webm" => "video",
        _ => "none",
    };
}
