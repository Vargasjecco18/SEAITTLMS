@inject IJSRuntime JS

@* A writing box with the tools of a word processor in a bar above it: font, size, bold, italic, underline, colors, alignment, lists, indents,
   line spacing, headings, a table, a link and undo. The page asks for what was written with GetHtmlAsync (the server cleans it again before saving).
   The box itself is drawn and edited by the browser (wwwroot/app.js, "seaittEditor"); Blazor only draws the bar and starts it. *@
<div class="rte" data-rte>
    <div class="bar" role="toolbar" aria-label="Text formatting">
        <div class="group">
            <button type="button" data-cmd="undo" title="Undo (Ctrl+Z)" aria-label="Undo"><Icon Name="undo-2" Size="16" /></button>
            <button type="button" data-cmd="redo" title="Redo (Ctrl+Y)" aria-label="Redo"><Icon Name="redo-2" Size="16" /></button>
        </div>
        <div class="group">
            <select data-select="formatBlock" title="Paragraph style" aria-label="Paragraph style">
                <option value="p">Normal</option>
                <option value="h1">Heading 1</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
                <option value="blockquote">Quote</option>
            </select>
            <select data-select="fontName" class="font" title="Font" aria-label="Font">
                @foreach (var font in Fonts)
                {
                    <option value="@font" style="font-family: @font">@font</option>
                }
            </select>
            <select data-select="fontSizePt" class="size" title="Font size" aria-label="Font size">
                @foreach (var size in Sizes)
                {
                    <option value="@size" selected="@(size == 11)">@size</option>
                }
            </select>
        </div>
        <div class="group">
            <button type="button" data-cmd="bold" data-state title="Bold (Ctrl+B)" aria-label="Bold"><Icon Name="bold" Size="16" /></button>
            <button type="button" data-cmd="italic" data-state title="Italic (Ctrl+I)" aria-label="Italic"><Icon Name="italic" Size="16" /></button>
            <button type="button" data-cmd="underline" data-state title="Underline (Ctrl+U)" aria-label="Underline"><Icon Name="underline" Size="16" /></button>
            <button type="button" data-cmd="strikeThrough" data-state title="Strikethrough" aria-label="Strikethrough"><Icon Name="strikethrough" Size="16" /></button>
            <button type="button" data-cmd="subscript" data-state title="Subscript" aria-label="Subscript"><Icon Name="subscript" Size="16" /></button>
            <button type="button" data-cmd="superscript" data-state title="Superscript" aria-label="Superscript"><Icon Name="superscript" Size="16" /></button>
        </div>
        <div class="group">
            <label class="color" title="Text color">
                <Icon Name="baseline" Size="16" />
                <input type="color" value="#000000" data-color="foreColor" aria-label="Text color" />
            </label>
            <label class="color" title="Highlight color">
                <Icon Name="highlighter" Size="16" />
                <input type="color" value="#ffff00" data-color="hiliteColor" aria-label="Highlight color" />
            </label>
            <button type="button" data-cmd="removeFormat" title="Clear formatting" aria-label="Clear formatting"><Icon Name="remove-formatting" Size="16" /></button>
        </div>
        <div class="group">
            <button type="button" data-cmd="justifyLeft" data-state title="Align left (Ctrl+L)" aria-label="Align left"><Icon Name="align-left" Size="16" /></button>
            <button type="button" data-cmd="justifyCenter" data-state title="Center (Ctrl+E)" aria-label="Center"><Icon Name="align-center" Size="16" /></button>
            <button type="button" data-cmd="justifyRight" data-state title="Align right (Ctrl+R)" aria-label="Align right"><Icon Name="align-right" Size="16" /></button>
            <button type="button" data-cmd="justifyFull" data-state title="Justify (Ctrl+J)" aria-label="Justify"><Icon Name="align-justify" Size="16" /></button>
        </div>
        <div class="group">
            <button type="button" data-cmd="insertUnorderedList" data-state title="Bullets" aria-label="Bullets"><Icon Name="list" Size="16" /></button>
            <button type="button" data-cmd="insertOrderedList" data-state title="Numbering" aria-label="Numbering"><Icon Name="list-ordered" Size="16" /></button>
            <button type="button" data-cmd="outdent" title="Decrease indent" aria-label="Decrease indent"><Icon Name="indent-decrease" Size="16" /></button>
            <button type="button" data-cmd="indent" title="Increase indent" aria-label="Increase indent"><Icon Name="indent-increase" Size="16" /></button>
            <select data-select="lineHeight" class="spacing" title="Line spacing" aria-label="Line spacing">
                <option value="1">1.0</option>
                <option value="1.15">1.15</option>
                <option value="1.5" selected>1.5</option>
                <option value="2">2.0</option>
                <option value="2.5">2.5</option>
            </select>
        </div>
        <div class="group">
            <button type="button" data-action="table" title="Insert a table (3 × 3)" aria-label="Insert a table"><Icon Name="table" Size="16" /></button>
            <button type="button" data-action="link" title="Insert a link" aria-label="Insert a link"><Icon Name="link" Size="16" /></button>
            <button type="button" data-cmd="insertHorizontalRule" title="Insert a line" aria-label="Insert a line"><Icon Name="minus" Size="16" /></button>
        </div>
    </div>
    <div id="@Id" class="rte-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="@Label"
         spellcheck="true" data-placeholder="@Placeholder" data-max="@MaxLength"></div>
    <div class="status" aria-live="polite"><span data-rte-count>0 words · 0 characters</span><span class="tip">Pasting keeps the words only.</span></div>
</div>

@code {
    private static readonly string[] Fonts = ["Arial", "Calibri", "Cambria", "Georgia", "Times New Roman", "Verdana", "Courier New"];
    private static readonly int[] Sizes = [8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 36, 48];

    /// <summary>The id of the writing box (it must be unique on the page).</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    /// <summary>What the box starts with (formatted text saved before).</summary>
    [Parameter] public string? Html { get; set; }

    /// <summary>Read by screen readers.</summary>
    [Parameter] public string Label { get; set; } = "Your answer";

    [Parameter] public string Placeholder { get; set; } = "Write your answer here…";

    /// <summary>The most characters (without the formatting) the answer can have; the box counts them.</summary>
    [Parameter] public int MaxLength { get; set; } = 20000;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("seaittEditor.start", Id, Html);
        }
    }

    /// <summary>What is in the box now, as formatted text ("" when it is empty).</summary>
    public async Task<string> GetHtmlAsync() => await JS.InvokeAsync<string>("seaittEditor.getHtml", Id);

    /// <summary>Puts new text in the box.</summary>
    public async Task SetHtmlAsync(string? html) => await JS.InvokeVoidAsync("seaittEditor.setHtml", Id, html);
}
