<div class="field @Class @(string.IsNullOrEmpty(Error) ? "" : "invalid")">
    <label for="@For">
        @Label
        @if (Required)
        {
            <span class="required" aria-hidden="true">*</span>
        }
    </label>
    @ChildContent
    @if (!string.IsNullOrEmpty(Error))
    {
        <small class="field-error" role="alert"><Icon Name="circle-alert" Size="13" /> @Error</small>
    }
    else if (!string.IsNullOrEmpty(Hint))
    {
        <small class="hint">@Hint</small>
    }
</div>

@code {
    /// <summary>The id of the input, select or textarea inside, so the label belongs to it.</summary>
    [Parameter, EditorRequired] public string For { get; set; } = "";

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>A small line of help under the box.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Shows a star after the label. (Put the required attribute on the input itself.)</summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>What is wrong with the box (it is empty or not right): a red line under it and a red border. Empty: nothing is shown.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>The input, select or textarea.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
