@page "/teacher/gradebook"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@using System.Globalization
@inject CurrentUser Me
@inject TeachingService Teaching
@inject GradebookService Books
@inject ModuleService Modules
@inject FileDownloads Downloads

<PageTitle>Gradebook · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Gradebook" IconName="clipboard-list" />

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (subjects.Count == 0)
{
    <Card>
        <EmptyState IconName="book-open" Title="No courses yet">
            <p>The administrator gives each teacher their courses. The gradebook shows up once you have one.</p>
        </EmptyState>
    </Card>
}
else
{
    <Card>
        <div class="pick">
            <Field For="g-subject" Label="Select course">
                <select id="g-subject" value="@subjectId" @onchange="SubjectChanged">
                    @foreach (var s in subjects)
                    {
                        <option value="@s.AssignmentId" selected="@(s.AssignmentId == subjectId)">@s.SubjectName · @s.SectionLabel</option>
                    }
                </select>
            </Field>
        </div>
    </Card>

    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    @if (book is not null)
    {
        <div class="summary">
            <div class="tile"><span class="tile-value">@book.Rows.Count</span><span class="tile-label">students</span></div>
            <div class="tile"><span class="tile-value">@(book.ClassAverage is { } avg ? $"{avg:0.#}%" : "—")</span><span class="tile-label">class average</span></div>
            <div class="tile @(book.Failing > 0 ? "alert" : "")"><span class="tile-value">@book.Failing</span><span class="tile-label">below @GradeRules.PassingPercent.ToString("0")</span></div>
            <div class="tile"><span class="tile-value">@book.Rows.Sum(r => r.ToCheck)</span><span class="tile-label">to check</span></div>
        </div>

        <Card>
            @if (book.Columns.Count == 0)
            {
                <EmptyState IconName="clipboard-list" Title="Nothing to grade yet">
                    <p>Assignments, quizzes and task performances of posted modules appear as columns here.</p>
                    <ButtonLink Href="@($"teacher/subjects/{book.AssignmentId}")" Variant="ButtonVariant.Secondary">Open the course</ButtonLink>
                    <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => OpenExtra(false)">Add Activities</Button>
                    <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => OpenExtra(true)">Add Exam</Button>
                </EmptyState>
            }
            else if (book.Rows.Count == 0)
            {
                <EmptyState IconName="users" Title="No students in this course yet" />
            }
            else
            {
                <FormErrors Errors="formErrors" />
                @* The way to use the gradebook, and what can be done with it, at the top right. *@
                <div class="table-tools">
                    <p class="muted">Type a score in a box and move on: it is saved by itself. Write the final grade of each student in the last column, then press Save final grades. The arrows under a column move it to the left or to the right.</p>
                    <div class="tools">
                        <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => OpenExtra(false)">Add Activities</Button>
                        <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => OpenExtra(true)">Add Exam</Button>
                        <Button Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" OnClick="ExportAsync">Export to Excel</Button>
                        <Button IconName="circle-check" Disabled="busy" OnClick="SaveFinalGradesAsync">Save final grades</Button>
                    </div>
                </div>
                <div class="scroll">
                    <table class="grid">
                        <thead>
                            <tr>
                                <th scope="col" class="sticky">Student</th>
                                @for (var place = 0; place < book.Columns.Count; place++)
                                {
                                    var c = book.Columns[place];
                                    var first = place == 0;
                                    var last = place == book.Columns.Count - 1;
                                    <th scope="col" class="col">
                                        <a href="teacher/items/@c.ItemId" title="@c.Title · @c.ModuleTitle · @ItemKinds.Display(c.Kind)" aria-label="@($"{c.Title}, {ItemKinds.Display(c.Kind)}")"><Icon Name="@SubjectStyle.KindIcon(c.Kind)" Size="14" /> @c.Code</a>
                                        <span class="max">out of @c.Max.ToString("0.##")</span>
                                        <span class="move" role="group" aria-label="@($"Move {c.Code}")">
                                            <button type="button" class="mv" data-move="left" disabled="@(first || busy)" title="Move to the left" aria-label="@($"Move {c.Code} to the left")" @onclick="() => MoveAsync(c, -1)"><Icon Name="chevron-left" Size="14" /></button>
                                            <button type="button" class="mv" data-move="right" disabled="@(last || busy)" title="Move to the right" aria-label="@($"Move {c.Code} to the right")" @onclick="() => MoveAsync(c, 1)"><Icon Name="chevron-right" Size="14" /></button>
                                        </span>
                                    </th>
                                }
                                <th scope="col" class="avg">Average</th>
                                <th scope="col" class="final">Final grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in book.Rows)
                            {
                                <tr>
                                    <th scope="row" class="sticky">
                                        <span class="name">@row.Name</span>
                                        <span class="sub">@row.Lrn</span>
                                    </th>
                                    @for (var n = 0; n < book.Columns.Count; n++)
                                    {
                                        var column = book.Columns[n];
                                        var cell = row.Cells[n];
                                        <td class="cell @CellClass(cell, column)">
                                            @if (cell.Status == SubmissionStatus.Submitted && cell.LateDecision is LateDecisions.Pending or LateDecisions.Declined)
                                            {
                                                @* Late work is graded after the teacher accepted it. *@
                                                <a class="check" href="teacher/items/@column.ItemId" title="Handed in late: accept or decline it first">@(cell.LateDecision == LateDecisions.Pending ? "Late · decide" : "Declined")</a>
                                            }
                                            else
                                            {
                                                <div class="cell-box">
                                                    <span class="cell-line">
                                                        <input type="number" step="any" min="0" max="@column.Max.ToString(CultureInfo.InvariantCulture)" class="input score-input" @key="@($"{row.StudentId}-{column.ItemId}-{renderStamp}")"
                                                               aria-label="@($"{row.Name}, {column.Title}")" placeholder="—" value="@CellText(cell)"
                                                               @onchange="e => SaveCellAsync(row, column, e.Value?.ToString())" />
                                                        @if (cell.IsLate) { <i class="late-dot" title="Handed in late"></i> }
                                                        @if (cell.IsFlagged) { <i class="flag-dot" title="Flagged by the anti-cheating watch"></i> }
                                                    </span>
                                                    @if (cell.Status == SubmissionStatus.Submitted)
                                                    {
                                                        <a class="check small" href="teacher/items/@column.ItemId" title="Handed in, waiting for a score">To check</a>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                    <td class="avg">
                                        @if (row.Percent is { } p)
                                        {
                                            <Badge Tone="@GradeRules.ToneOf(p)">@p.ToString("0.#")%</Badge>
                                        }
                                        else
                                        {
                                            <span class="dash">—</span>
                                        }
                                    </td>
                                    <td class="final">
                                        <input type="number" inputmode="decimal" step="0.01" min="0" max="100" class="input final-input" placeholder="—"
                                               aria-label="@($"Final grade of {row.Name}")" value="@finalInputs.GetValueOrDefault(row.StudentId)"
                                               @onchange="e => finalInputs[row.StudentId] = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="legend"><strong>A</strong> assignment &nbsp; <strong>Q</strong> quiz &nbsp; <strong>TP</strong> task performance &nbsp; <strong>S</strong> seatwork &nbsp; <strong>R</strong> recitation &nbsp; <strong>E</strong> exam &nbsp; <span class="late-dot"></span> handed in late &nbsp; <span class="flag-dot"></span> flagged by the anti-cheating watch &nbsp; Scores under @GradeRules.PassingPercent.ToString("0")% of the highest score are shown in red.</p>
            }
        </Card>
    }
}

@* ===== Extra grades: activities (an assignment, a quiz or a task performance) and exams that are only there to give scores ===== *@
<Modal Open="extraOpen" Title="@(extraKind == ItemKinds.Exam ? "Add an exam" : "Add Activities")" OnClose="CloseExtra">
    @if (extraOpen)
    {
        @if (extraKind == ItemKinds.Exam)
        {
            <p class="dialog-text">Add an exam, like a midterm or a final, to give its scores. It becomes a new column of the gradebook, and the students see it under Exams in the course menu.</p>
        }
        else
        {
            <p class="dialog-text">Add an assignment, a quiz, a task performance, a seatwork or a recitation to give <strong>extra scores</strong>. It becomes a new column of the gradebook, and it is added to the module you choose, so the students see it too.</p>
        }
        <FormErrors Errors="formErrors" />
        @if (extraModules.Count == 0)
        {
            <p class="muted">There is no module that is posted yet. Post a module in the course first: the gradebook only has the work of posted modules.</p>
        }
        else
        {
            @if (extraKind != ItemKinds.Exam)
            {
                <div class="kind-choice" role="group" aria-label="What to add">
                    @foreach (var kind in ItemKinds.All)
                    {
                        var k = kind;
                        <button type="button" class="kind @(extraKind == k ? "on" : "")" aria-pressed="@(extraKind == k ? "true" : "false")" @onclick="() => extraKind = k"><Icon Name="@SubjectStyle.KindIcon(k)" Size="16" /> @ItemKinds.Display(k)</button>
                    }
                </div>
            }
            @if (extraKind != ItemKinds.Exam)
            {
                <Field For="x-module" Label="Module" Required="true">
                    <select id="x-module" @bind="extraModuleId">
                        @foreach (var m in extraModules)
                        {
                            <option value="@m.Id">@m.Title</option>
                        }
                    </select>
                </Field>
            }
            <Field For="x-title" Label="Title" Required="true">
                <input id="x-title" type="text" maxlength="200" autocomplete="off" @bind="extraTitle" @bind:event="oninput" />
            </Field>
            <Field For="x-score" Label="Highest score" Required="true">
                <input id="x-score" type="number" step="any" min="1" max="1000" @bind="extraMax" />
            </Field>
            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseExtra">Cancel</Button>
                <Button IconName="circle-check" Disabled="busy" OnClick="SaveExtraAsync">@(busy ? "Adding…" : "Add the column")</Button>
            </div>
        }
    }
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "subject")] private int? SubjectQuery { get; set; }

    private int teacherId;
    private bool loaded;
    private IReadOnlyList<TeacherSubjectCard> subjects = [];
    private int subjectId;
    private SubjectGradebook? book;
    private readonly Dictionary<int, string> finalInputs = [];
    private int renderStamp;
    private readonly SemaphoreSlim saveLock = new(1, 1);
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    protected override async Task OnInitializedAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        subjects = teacherId == 0 ? [] : await Teaching.GetTeacherCardsAsync(teacherId);
        subjectId = subjects.Any(s => s.AssignmentId == SubjectQuery) ? SubjectQuery!.Value : subjects.FirstOrDefault()?.AssignmentId ?? 0;
        await LoadAsync();
        loaded = true;
    }

    private void ClearMessage() => message = null;

    private async Task LoadAsync()
    {
        formErrors = [];
        book = subjectId == 0 ? null : await Books.GetAsync(teacherId, subjectId);
        ReadBook();
    }

    /// <summary>The final grades that are saved (the short names of the columns, A1, Q1 ..., come with the columns).</summary>
    private void ReadBook()
    {
        finalInputs.Clear();
        if (book is null)
        {
            return;
        }

        foreach (var row in book.Rows)
        {
            finalInputs[row.StudentId] = row.FinalGrade is { } g ? g.ToString("0.##", CultureInfo.InvariantCulture) : "";
        }
    }

    private async Task SubjectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            subjectId = id;
            message = null;
            await LoadAsync();
        }
    }

    /// <summary>The look of a score: red under the passing mark, a color for work waiting to be checked.</summary>
    private static string CellClass(GradebookCell cell, GradebookColumn column) =>
        cell.Status == SubmissionStatus.Graded && cell.Score is { } s && column.Max > 0 && s / column.Max * 100 < GradeRules.PassingPercent ? "failing" : "";

    private async Task SaveFinalGradesAsync()
    {
        if (busy || book is null)
        {
            return;
        }

        var grades = new Dictionary<int, decimal?>();
        foreach (var row in book.Rows)
        {
            var text = finalInputs.GetValueOrDefault(row.StudentId);
            if (string.IsNullOrWhiteSpace(text))
            {
                grades[row.StudentId] = null;
            }
            else if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
            {
                grades[row.StudentId] = value;
            }
            else
            {
                formErrors = [$"{row.Name}: the final grade must be a number."];
                return;
            }
        }

        busy = true;
        try
        {
            var result = await Books.SetFinalGradesAsync(teacherId, subjectId, grades);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            formErrors = [];
            messageIsError = false;
            message = result.Message;
            book = await Books.GetAsync(teacherId, subjectId);
            ReadBook();
        }
        finally
        {
            busy = false;
        }
    }

    private static string CellText(GradebookCell cell) =>
        cell.Status == SubmissionStatus.Graded && cell.Score is { } score ? score.ToString("0.##", CultureInfo.InvariantCulture) : "";

    /// <summary>A score typed in a box is saved when the person leaves the box. An empty box leaves the cell as it is.</summary>
    private async Task SaveCellAsync(GradebookRow row, GradebookColumn column, string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            Fail("A score must be a number.");
            return;
        }

        // Two scores typed one after the other are saved one after the other.
        await saveLock.WaitAsync();
        try
        {
            var result = await Books.SetScoresAsync(teacherId, subjectId, row.StudentId, new Dictionary<int, decimal?> { [column.ItemId] = value });
            if (!result.Succeeded)
            {
                Fail(string.Join(" ", result.Errors));
                return;
            }

            messageIsError = false;
            message = result.Message == "Nothing changed." ? null : $"{row.Name}, {column.Title}: saved.";
            // Only the numbers are read again: the final grades that are typed and not saved yet stay as they are.
            book = await Books.GetAsync(teacherId, subjectId);
        }
        finally
        {
            saveLock.Release();
        }
    }

    private void Fail(string text)
    {
        messageIsError = true;
        message = text;
        renderStamp++;   // the boxes are drawn again, so the wrong number is not left in the box
    }

    /// <summary>Moves a column one place. Only the columns are read again: the final grades that are typed and not saved yet stay as they are.</summary>
    private async Task MoveAsync(GradebookColumn column, int delta)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Books.MoveColumnAsync(teacherId, subjectId, column.ItemId, delta);
            if (!result.Succeeded)
            {
                Fail(string.Join(" ", result.Errors));
                return;
            }

            messageIsError = false;
            message = null;
            book = await Books.GetAsync(teacherId, subjectId);
            renderStamp++;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (book is null)
        {
            return;
        }

        await Downloads.SaveAsync(GradebookExport.FileName(book), GradebookExport.Build(book));
    }

    // ---------------------------------------------------------------- extra grades

    private bool extraOpen;
    private string extraKind = ItemKinds.Activity;
    private int extraModuleId;
    private string extraTitle = "";
    private decimal extraMax = 50;
    private IReadOnlyList<TeacherModule> extraModules = [];

    private async Task OpenExtra(bool exam)
    {
        formErrors = [];
        var subject = await Modules.GetTeacherSubjectAsync(teacherId, subjectId);
        extraModules = subject?.Modules.Where(m => !m.IsSyllabus && m.State == Visibility.Posted).ToList() ?? [];
        extraModuleId = extraModules.LastOrDefault()?.Id ?? 0;
        extraKind = exam ? ItemKinds.Exam : ItemKinds.Activity;
        extraTitle = "";
        extraMax = exam ? 100 : 50;
        extraOpen = true;
    }

    private void CloseExtra() => extraOpen = false;

    private async Task SaveExtraAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.SaveItemAsync(teacherId, extraModuleId, null, new ItemInput { Kind = extraKind, Title = extraTitle, MaxScore = extraMax });
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            extraOpen = false;
            messageIsError = false;
            message = $"{ItemKinds.Display(extraKind)} added: it is a new column. Type the scores in it.";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
