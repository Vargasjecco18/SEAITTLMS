@page "/teacher/gradebook"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@using System.Globalization
@inject CurrentUser Me
@inject TeachingService Teaching
@inject GradebookService Books
@inject ModuleService Modules
@inject FileDownloads Downloads
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Gradebook · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Gradebook" IconName="clipboard-list" />

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (subjects.Count == 0)
{
    <Card>
        <EmptyState IconName="book-open" Title="No courses yet">
            <p>The administrator gives each teacher their courses. The gradebook shows up once you have one.</p>
        </EmptyState>
    </Card>
}
else
{
    @* Round 46: what is saved (or what went wrong) is a note at the top right of the screen, not a pop-up in the middle, so the scores can be typed one after the other. *@
    <Toast Message="@message" IsError="@messageIsError" Stamp="@messageStamp" OnDismiss="ClearMessage" />

    @if (book is not null)
    {
        <div class="summary">
            <div class="tile"><span class="tile-value">@book.Rows.Count</span><span class="tile-label">students</span></div>
            <div class="tile"><span class="tile-value">@(book.ClassAverage is { } avg ? avg.ToString("0.#") : "—")</span><span class="tile-label">class final grade (complete gradebooks)</span></div>
            <div class="tile @(book.Failing > 0 ? "alert" : "")"><span class="tile-value">@book.Failing</span><span class="tile-label">below @GradeRules.PassingPercent.ToString("0")</span></div>
            <div class="tile @(book.Incomplete > 0 ? "warn" : "")" id="tile-incomplete"><span class="tile-value">@book.Incomplete</span><span class="tile-label">with a score missing (grade 0)</span></div>
            <div class="tile"><span class="tile-value">@book.Rows.Sum(r => r.ToCheck)</span><span class="tile-label">to check</span></div>
        </div>

        <p class="system" id="grading-system"><strong>Grading system:</strong>
            @foreach (var part in GradingSystem.Parts)
            {
                <span class="part part-@GradingSystem.Short(part).ToLowerInvariant()">@GradingSystem.Name(part) <b>@GradingSystem.Weights.Of(part).ToString("0.##")%</b></span>
            }
        </p>

        <Card>
            @* The course is chosen at the top left of the card; the buttons are at the top right. *@
            <div class="card-top">
                <div class="pick">
                    <Field For="g-subject" Label="Select course">
                        <select id="g-subject" value="@subjectId" @onchange="SubjectChanged">
                            @foreach (var s in subjects)
                            {
                                <option value="@s.AssignmentId" selected="@(s.AssignmentId == subjectId)">@s.SubjectName · @s.SectionLabel</option>
                            }
                        </select>
                    </Field>
                </div>
                @if (book is { Columns.Count: > 0, Rows.Count: > 0 })
                {
                    <div class="tools">
                        <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="OpenExtra">Add section</Button>
                        @* Hide from students: the students do not see the scores, the average and the grade of this course until it is shown again. *@
                        <Button Variant="ButtonVariant.Secondary" IconName="@(book.GradesHidden ? "eye" : "eye-off")" Disabled="busy" OnClick="ToggleHiddenAsync"
                                Title="@(book.GradesHidden ? "The students can't see their grades of this course. Press to show them." : "The students see their scores, average and grade of this course. Press to hide them.")">@(book.GradesHidden ? "Show to students" : "Hide from students")</Button>
                        <Button Variant="ButtonVariant.Secondary" IconName="upload" OnClick="OpenImport" Title="Give the scores of the class from an Excel file">Import class grades</Button>
                        <Button Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" OnClick="ExportAsync" Title="One Excel file with all your courses, a sheet for each">Export to Excel</Button>
                        <Button IconName="send" Disabled="busy" OnClick="SaveFinalGradesAsync" Title="Send the final grades to the registrar (they are the Final grade column)">Send final grades</Button>
                    </div>
                }
            </div>
            @if (book.Columns.Count == 0)
            {
                <EmptyState IconName="clipboard-list" Title="Nothing to grade yet">
                    <p>Assignments, quizzes and task performances of posted handouts appear as columns here.</p>
                    <ButtonLink Href="@($"teacher/subjects/{book.AssignmentId}")" Variant="ButtonVariant.Secondary">Open the course</ButtonLink>
                    <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="OpenExtra">Add section</Button>
                </EmptyState>
            }
            else if (book.Rows.Count == 0)
            {
                <EmptyState IconName="users" Title="No students in this course yet" />
            }
            else
            {
                <FormErrors Errors="formErrors" />
                <div class="scroll">
                    <table class="grid">
                        <thead>
                            <tr>
                                <th scope="col" class="sticky">Student</th>
                                @for (var place = 0; place < book.Columns.Count; place++)
                                {
                                    var c = book.Columns[place];
                                    var first = place == 0;
                                    var last = place == book.Columns.Count - 1;
                                    <th scope="col" class="col" data-col="@c.Code">
                                        <a href="teacher/items/@c.ItemId" title="@($"{c.Title} · {c.ModuleTitle} · {KindLabel(c)}{(c.AutoChecked ? " · checked by the system" : "")}")" aria-label="@($"{c.Title}, {KindLabel(c)}")"><Icon Name="@SubjectStyle.KindIcon(c.Kind)" Size="14" /> @c.Code</a>
                                        <span class="chip chip-@GradingSystem.Short(c.Part).ToLowerInvariant()" title="@GradingSystem.Name(c.Part)">@GradingSystem.Short(c.Part)@(c.AutoChecked ? " · auto" : "")</span>
                                        <span class="max">out of @c.Max.ToString("0.##")</span>
                                        <span class="move" role="group" aria-label="@($"Move {c.Code}")">
                                            <button type="button" class="mv" data-move="left" disabled="@(first || busy)" title="Move to the left" aria-label="@($"Move {c.Code} to the left")" @onclick="() => MoveAsync(c, -1)"><Icon Name="chevron-left" Size="14" /></button>
                                            <button type="button" class="mv" data-move="right" disabled="@(last || busy)" title="Move to the right" aria-label="@($"Move {c.Code} to the right")" @onclick="() => MoveAsync(c, 1)"><Icon Name="chevron-right" Size="14" /></button>
                                        </span>
                                    </th>
                                }
                                @foreach (var part in GradingSystem.Parts)
                                {
                                    <th scope="col" class="part-col part-col-@GradingSystem.Short(part).ToLowerInvariant()" data-part="@GradingSystem.Short(part)" title="@GradingSystem.Name(part)">@GradingSystem.Short(part)<span class="max">@GradingSystem.Weights.Of(part).ToString("0.##")%</span></th>
                                }
                                <th scope="col" class="final" data-final-head>Final grade</th>
                                <th scope="col" class="descriptor">Descriptor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in book.Rows)
                            {
                                <tr>
                                    <th scope="row" class="sticky">
                                        <span class="name">@row.Name</span>
                                        <span class="sub">@row.Lrn</span>
                                    </th>
                                    @for (var n = 0; n < book.Columns.Count; n++)
                                    {
                                        var column = book.Columns[n];
                                        var cell = row.Cells[n];
                                        <td class="cell @CellClass(cell, column)">
                                            @if (cell.Status == SubmissionStatus.Submitted && cell.LateDecision is LateDecisions.Pending or LateDecisions.Declined)
                                            {
                                                @* Late work is graded after the teacher accepted it. *@
                                                <a class="check" href="teacher/items/@column.ItemId" title="Handed in late: accept or decline it first">@(cell.LateDecision == LateDecisions.Pending ? "Late · decide" : "Declined")</a>
                                            }
                                            else if (!column.Typed)
                                            {
                                                @* A quiz or an exam with questions: the system checked it, nobody types its score (only an essay is scored by the teacher). *@
                                                <span class="cell-box">
                                                    <span class="score auto" data-auto title="Checked by the system">@(cell.Status == SubmissionStatus.Graded && cell.Score is { } autoScore ? autoScore.ToString("0.##", CultureInfo.InvariantCulture) : "—")</span>
                                                    @if (cell.IsFlagged) { <i class="flag-dot" title="Flagged by the anti-cheating watch"></i> }
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="cell-box">
                                                    <span class="cell-line">
                                                        <input type="number" step="any" min="0" max="@column.Max.ToString(CultureInfo.InvariantCulture)" class="input score-input" @key="@($"{row.StudentId}-{column.ItemId}-{renderStamp}")"
                                                               aria-label="@($"{row.Name}, {column.Title}")" placeholder="—" value="@CellText(cell)"
                                                               @onchange="e => SaveCellAsync(row, column, e.Value?.ToString())" />
                                                        @if (cell.IsLate) { <i class="late-dot" title="Handed in late"></i> }
                                                        @if (cell.IsFlagged) { <i class="flag-dot" title="Flagged by the anti-cheating watch"></i> }
                                                    </span>
                                                    @if (cell.Status == SubmissionStatus.Submitted)
                                                    {
                                                        <a class="check small" href="teacher/items/@column.ItemId" title="@(column.HasEssay ? "Handed in: score the essay" : "Handed in, waiting for a score")">To check</a>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                    @foreach (var part in GradingSystem.Parts)
                                    {
                                        <td class="part-col" data-part="@GradingSystem.Short(part)">
                                            @if (row.Grade?.PartPercent(part) is { } partPercent)
                                            {
                                                <span class="score">@partPercent.ToString("0.#")</span>
                                            }
                                            else
                                            {
                                                <span class="dash">—</span>
                                            }
                                        </td>
                                    }
                                    <td class="final" data-final>
                                        @* The final grade is worked out by the gradebook (nobody types it): 0 until every activity, quiz and exam has a score. *@
                                        @if (row.Final is { } finalGrade)
                                        {
                                            <span class="final-grade @(row.Grade is { Complete: false } ? "incomplete" : "")" title="@FinalTitle(row)"><Badge Tone="@(row.Grade is { Complete: false } ? Tone.Neutral : GradeRules.ToneOf(finalGrade))">@finalGrade</Badge></span>
                                        }
                                        else
                                        {
                                            <span class="dash">—</span>
                                        }
                                    </td>
                                    <td class="descriptor" data-descriptor>
                                        @if (row.Final is { } descriptorGrade)
                                        {
                                            <span class="descriptor-name">@GradingSystem.Descriptor(descriptorGrade)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="legend"><strong>A</strong> assignment &nbsp; <strong>Q</strong> quiz &nbsp; <strong>TP</strong> task performance &nbsp; <strong>S</strong> seatwork &nbsp; <strong>R</strong> recitation &nbsp; <strong>O</strong> others &nbsp; <strong>SE</strong> summative test &nbsp; <strong>TE</strong> term examination &nbsp; <span class="late-dot"></span> handed in late &nbsp; <span class="flag-dot"></span> flagged by the anti-cheating watch &nbsp; Scores under @GradeRules.PassingPercent.ToString("0")% of the highest score are shown in red. A quiz or an exam with questions is checked by the system (<strong>auto</strong>): only an essay is scored by you. The final grade is 0 until every activity, quiz and exam has a score.</p>

                @* The two tables of the class: the descriptors and Passed / Failed, with male, female and total (the same as in the Excel). *@
                <div class="summary-tables" id="grade-summary">
                    <SummaryTable Title="SUMMARY" ColumnTitle="DESCRIPTOR" Lines="summary.Descriptor" Male="summary.Male" Female="summary.Female" Total="summary.Total" Id="summary-descriptor" />
                    <SummaryTable Title="" ColumnTitle="REMARKS" Lines="summary.Remark" Male="summary.Male" Female="summary.Female" Total="summary.Total" Id="summary-remarks" />
                </div>
            }
        </Card>
    }
}

@* ===== Add section: a recitation, others, a performance task or a term examination: a new column of the gradebook ===== *@
<Modal Open="extraOpen" Title="Add section" OnClose="CloseExtra">
    @if (extraOpen)
    {
        <p class="dialog-text">Add a <strong>recitation</strong>, <strong>others</strong>, a <strong>performance task</strong> or a <strong>Term Examination (TE)</strong>. It becomes a new column of the gradebook, and it is added to the handout you choose, so the students see it too.</p>
        <FormErrors Errors="formErrors" />
        @if (extraModules.Count == 0)
        {
            <p class="muted">There is no handout that is posted yet. Post a handout in the course first: the gradebook only has the work of posted handouts.</p>
        }
        else
        {
            <div class="kind-choice" role="group" aria-label="What to add">
                @foreach (var kind in ExtraKinds)
                {
                    var k = kind;
                    <button type="button" class="kind @(extraKind == k ? "on" : "")" data-kind="@k" aria-pressed="@(extraKind == k ? "true" : "false")" @onclick="() => extraKind = k"><Icon Name="@SubjectStyle.KindIcon(k)" Size="16" /> @ExtraLabel(k)</button>
                }
            </div>
            <p class="hint" id="x-part">It counts in <strong>@GradingSystem.Name(GradingSystem.PartOf(extraKind, false))</strong> (@GradingSystem.Weights.Of(GradingSystem.PartOf(extraKind, false)).ToString("0.##")%).</p>
            <Field For="x-module" Label="Handout" Required="true">
                <select id="x-module" @bind="extraModuleId">
                    @foreach (var m in extraModules)
                    {
                        <option value="@m.Id">@m.Title</option>
                    }
                </select>
            </Field>
            <Field For="x-title" Label="Title" Required="true">
                <input id="x-title" type="text" maxlength="200" autocomplete="off" @bind="extraTitle" @bind:event="oninput" />
            </Field>
            <Field For="x-score" Label="Highest score" Required="true">
                <input id="x-score" type="number" step="any" min="1" max="1000" @bind="extraMax" />
            </Field>
            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseExtra">Cancel</Button>
                <Button IconName="circle-check" Disabled="busy" OnClick="SaveExtraAsync">@(busy ? "Adding…" : "Add the column")</Button>
            </div>
        }
    }
</Modal>

@* ===== Import class grades: the Excel of the gradebook, with the scores typed in it ===== *@
<Modal Open="importOpen" Title="Import class grades" Large="true" OnClose="CloseImport">
    @if (importOpen)
    {
        <p class="dialog-text">Give the scores of the whole class from an Excel file. The file is the one the gradebook exports.</p>
        <ol class="import-steps">
            <li>
                <strong>Download the Excel</strong> of this course. It has a row for every student and a column for every activity, quiz and exam (the code of the column is its title: A1, Q1, TP1, TE1 ...).
                <div><Button Variant="ButtonVariant.Secondary" IconName="download" OnClick="DownloadForImportAsync">Download the Excel of this course</Button></div>
            </li>
            <li><strong>Type the scores</strong> in the sheet <em>Grades</em>. Keep the columns Student and LRN and the code of each column. A quiz or an exam that the system checks is not imported. An empty cell leaves the score as it is.</li>
            <li>
                <strong>Choose the file</strong> and press Import.
                <Field For="imp-grades-file" Label="Excel file (.xlsx)" Required="true">
                    <InputFile id="imp-grades-file" OnChange="ImportFileChosenAsync" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                </Field>
                @if (importFileName is not null)
                {
                    <p class="chosen-file"><Icon Name="file-spreadsheet" Size="16" /> @importFileName</p>
                }
            </li>
        </ol>
        <FormErrors Errors="importErrors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseImport">Cancel</Button>
            <Button IconName="upload" Disabled="@(busy || importBytes is null)" OnClick="ImportAsync">@(busy ? "Importing…" : "Import")</Button>
        </div>
    }
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "subject")] private int? SubjectQuery { get; set; }

    private int teacherId;
    private bool loaded;
    private IReadOnlyList<TeacherSubjectCard> subjects = [];
    private int subjectId;
    private SubjectGradebook? book;
    private int renderStamp;
    private readonly SemaphoreSlim saveLock = new(1, 1);
    private string? message;
    private bool messageIsError;
    private int messageStamp;
    private bool busy;
    private List<string> formErrors = [];

    /// <summary>The two tables of the class (descriptors, passed/failed) for the book on the screen.</summary>
    private (IReadOnlyList<GradingSystem.SummaryLine> Descriptor, IReadOnlyList<GradingSystem.SummaryLine> Remark, int Male, int Female, int Total) summary =>
        book?.Summary ?? ([], [], 0, 0, 0);

    /// <summary>What a column is, in words: the Summative Test is the summative exam of the academic provider; an exam of the teacher is a Term Examination (TE).</summary>
    private static string KindLabel(GradebookColumn c) => c.Kind == ItemKinds.Exam ? (c.Summative ? "Summative Test (SE)" : "Term Examination (TE)") : ItemKinds.Display(c.Kind);

    private static string FinalTitle(GradebookRow row) =>
        row.Grade is { Complete: false, Missing: > 0 } g
            ? $"{g.Missing} score{(g.Missing == 1 ? " is" : "s are")} missing, so the final grade is 0 until every activity, quiz and exam has a score."
            : $"Final grade {row.Final} · {GradingSystem.Descriptor(row.Final ?? 0)} · {GradingSystem.Remark(row.Final ?? 0)}";

    /// <summary>A note at the top right of the screen (a new one every time, even with the same words).</summary>
    private void Say(string? text, bool isError = false)
    {
        message = text;
        messageIsError = isError;
        messageStamp++;
    }

    protected override async Task OnInitializedAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        subjects = teacherId == 0 ? [] : await Teaching.GetTeacherCardsAsync(teacherId);
        subjectId = subjects.Any(s => s.AssignmentId == SubjectQuery) ? SubjectQuery!.Value : subjects.FirstOrDefault()?.AssignmentId ?? 0;
        await LoadAsync();
        loaded = true;
    }

    private void ClearMessage() => message = null;

    private async Task LoadAsync()
    {
        formErrors = [];
        book = subjectId == 0 ? null : await Books.GetAsync(teacherId, subjectId);
    }

    private async Task SubjectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            subjectId = id;
            Say(null);
            await LoadAsync();
        }
    }

    /// <summary>The look of a score: red under the passing mark, a color for work waiting to be checked.</summary>
    private static string CellClass(GradebookCell cell, GradebookColumn column) =>
        cell.Status == SubmissionStatus.Graded && cell.Score is { } s && column.Max > 0 && s / column.Max * 100 < GradeRules.PassingPercent ? "failing" : "";

    /// <summary>Send final grades: the final grades the gradebook worked out go to the registrar.</summary>
    private async Task SaveFinalGradesAsync()
    {
        if (busy || book is null)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Books.SendFinalGradesAsync(teacherId, subjectId);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                Say(string.Join(" ", result.Errors), true);
                return;
            }

            formErrors = [];
            Say(result.Message);
            book = await Books.GetAsync(teacherId, subjectId);
        }
        finally
        {
            busy = false;
        }
    }

    private static string CellText(GradebookCell cell) =>
        cell.Status == SubmissionStatus.Graded && cell.Score is { } score ? score.ToString("0.##", CultureInfo.InvariantCulture) : "";

    /// <summary>A score typed in a box is saved when the person leaves the box. An empty box leaves the cell as it is.</summary>
    private async Task SaveCellAsync(GradebookRow row, GradebookColumn column, string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }

        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            Fail("A score must be a number.");
            return;
        }

        // Two scores typed one after the other are saved one after the other.
        await saveLock.WaitAsync();
        try
        {
            var result = await Books.SetScoresAsync(teacherId, subjectId, row.StudentId, new Dictionary<int, decimal?> { [column.ItemId] = value });
            if (!result.Succeeded)
            {
                Fail(string.Join(" ", result.Errors));
                return;
            }

            // Round 46: the note is at the top right of the screen; the scores that are typed next are not interrupted.
            if (result.Message != "Nothing changed.")
            {
                Say($"{row.Name} · {column.Code}: saved.");
            }

            book = await Books.GetAsync(teacherId, subjectId);
        }
        finally
        {
            saveLock.Release();
        }
    }

    private void Fail(string text)
    {
        Say(text, true);
        renderStamp++;   // the boxes are drawn again, so the wrong number is not left in the box
    }

    /// <summary>Moves a column one place. Only the columns are read again: the final grades that are typed and not saved yet stay as they are.</summary>
    private async Task MoveAsync(GradebookColumn column, int delta)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Books.MoveColumnAsync(teacherId, subjectId, column.ItemId, delta);
            if (!result.Succeeded)
            {
                Fail(string.Join(" ", result.Errors));
                return;
            }

            Say(null);
            book = await Books.GetAsync(teacherId, subjectId);
            renderStamp++;
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Export to Excel: every course of the teacher in one file, a sheet for each.</summary>
    private async Task ExportAsync()
    {
        var books = new List<SubjectGradebook>();
        foreach (var s in subjects)
        {
            var one = s.AssignmentId == subjectId && book is not null ? book : await Books.GetAsync(teacherId, s.AssignmentId);
            if (one is not null)
            {
                books.Add(one);
            }
        }

        if (books.Count == 0)
        {
            return;
        }

        await Downloads.SaveAsync(GradebookExport.FileNameAll(), GradebookExport.BuildAll(books));
    }

    /// <summary>Hide from students / Show to students: the students see the grades of this course or not.</summary>
    private async Task ToggleHiddenAsync()
    {
        if (busy || book is null)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Books.SetGradesHiddenAsync(teacherId, subjectId, !book.GradesHidden);
            Say(result.Succeeded ? result.Message : string.Join(" ", result.Errors), !result.Succeeded);
            book = await Books.GetAsync(teacherId, subjectId);
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- extra grades

    private bool extraOpen;
    private string extraKind = ItemKinds.Recitation;

    /// <summary>What "Add section" gives: a recitation, others, a performance task or a Term Examination. (The assignments and quizzes are made in the course.)</summary>
    private static readonly string[] ExtraKinds = [ItemKinds.Recitation, ItemKinds.Other, ItemKinds.TaskPerformance, ItemKinds.Exam];

    private static string ExtraLabel(string kind) => kind == ItemKinds.Exam ? "Term Examination (TE)" : ItemKinds.Display(kind);
    private int extraModuleId;
    private string extraTitle = "";
    private decimal extraMax = 50;
    private IReadOnlyList<TeacherModule> extraModules = [];

    private async Task OpenExtra()
    {
        formErrors = [];
        var subject = await Modules.GetTeacherSubjectAsync(teacherId, subjectId);
        // the box of the summative exam is not a module of the course: nothing is added to it from here
        extraModules = subject?.Modules.Where(m => !m.IsSyllabus && !m.IsExamSet && m.State == Visibility.Posted).ToList() ?? [];
        extraModuleId = extraModules.LastOrDefault()?.Id ?? 0;
        extraKind = ItemKinds.Recitation;
        extraTitle = "";
        extraMax = 50;
        extraOpen = true;
    }

    private void CloseExtra() => extraOpen = false;

    private async Task SaveExtraAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.SaveItemAsync(teacherId, extraModuleId, null, new ItemInput { Kind = extraKind, Title = extraTitle, MaxScore = extraMax }, fromGradebook: true);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            extraOpen = false;
            Say($"{ExtraLabel(extraKind)} added: it is a new column. Type the scores in it.");
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- import class grades

    private bool importOpen;
    private byte[]? importBytes;
    private string? importFileName;
    private List<string> importErrors = [];

    private void OpenImport()
    {
        importBytes = null;
        importFileName = null;
        importErrors = [];
        importOpen = true;
    }

    private void CloseImport() => importOpen = false;

    private async Task DownloadForImportAsync()
    {
        if (book is null)
        {
            return;
        }

        await Downloads.SaveAsync(GradebookExport.FileName(book), GradebookExport.Build(book));
    }

    private async Task ImportFileChosenAsync(InputFileChangeEventArgs e)
    {
        importErrors = [];
        importBytes = null;
        importFileName = null;
        try
        {
            await using var stream = e.File.OpenReadStream(XlsxReader.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            importBytes = buffer.ToArray();
            importFileName = e.File.Name;
        }
        catch (IOException)
        {
            importErrors = ["The file could not be read. Choose it again."];
        }
    }

    private async Task ImportAsync()
    {
        if (busy || importBytes is null)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Books.ImportScoresAsync(teacherId, subjectId, importBytes);
            if (!result.Succeeded)
            {
                importErrors = [.. result.Errors];
                return;
            }

            importOpen = false;
            Say(result.Message);
            book = await Books.GetAsync(teacherId, subjectId);
            renderStamp++;
        }
        finally
        {
            busy = false;
        }
    }
}
