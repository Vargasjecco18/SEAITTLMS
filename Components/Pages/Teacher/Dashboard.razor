@page "/teacher"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@inject CurrentUser Me
@inject DashboardService Dashboards
@inject TimeProvider Clock

<PageTitle>Dashboard · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

@{
    var now = PhilippineTime.Now(Clock);
}

<PageHeader Title="@($"{PhilippineTime.Greeting(now)}, {data?.FirstName ?? "teacher"}")" IconName="layout-dashboard" />

@if (data is null)
{
    <Card>
        <EmptyState IconName="presentation" Title="No teacher record found">
            <p>Your account is not linked to a teacher record. Please ask an administrator.</p>
        </EmptyState>
    </Card>
}
else
{
    <PageWithAside Show="calendar,online,onlineteachers">
        <div class="stats">
            <StatCard Label="Assignments to check" Value="@data.ToCheck" IconName="clipboard-list" Accent="@(data.ToCheck > 0 ? AccentColor.Amber : AccentColor.Green)" Hint="@(data.ToCheck == 0 ? "All checked" : "Waiting for a score")" />
            <StatCard Label="Flagged quizzes" Value="@data.FlaggedCount" IconName="shield-alert" Accent="@(data.FlaggedCount > 0 ? AccentColor.Rose : AccentColor.Green)" Hint="Last 30 days. See who on the calendar." Href="calendar" />
            <StatCard Label="Not posted yet" Value="@data.DraftCount" IconName="eye-off" Accent="AccentColor.Violet" Hint="Drafts and scheduled modules" />
            <StatCard Label="Due this week" Value="@data.DueSoon" IconName="calendar-clock" Accent="AccentColor.Blue" Hint="@($"{data.SubjectCount} courses · {data.StudentCount} students")" />
        </div>

        <div class="cards">
            <Card Title="Unchecked assignments" IconName="clipboard-list">
                @if (data.Unchecked.Count == 0)
                {
                    <EmptyState IconName="circle-check" Title="Everything is checked">
                        <p>Assignments that students hand in and that still need a score show up here.</p>
                    </EmptyState>
                }
                else
                {
                    <ul class="rows">
                        @foreach (var u in data.Unchecked)
                        {
                            <li>
                                <a href="teacher/items/@u.ItemId">
                                    <span class="row-icon"><Icon Name="@SubjectStyle.KindIcon(u.Kind)" Size="18" /></span>
                                    <span class="row-text"><span class="row-title">@u.Title</span><span class="row-sub">@u.SubjectName · @u.SectionLabel · oldest @PhilippineTime.FormatDate(u.OldestAtUtc)</span></span>
                                    <Badge Tone="Tone.Warning">@u.Count to check</Badge>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </Card>

            <Card Title="Modules students can't see yet" IconName="eye-off">
                @if (data.Drafts.Count == 0)
                {
                    <EmptyState IconName="layers" Title="Everything is posted">
                        <p>Drafts and scheduled modules show up here.</p>
                    </EmptyState>
                }
                else
                {
                    <ul class="rows">
                        @foreach (var m in data.Drafts)
                        {
                            <li>
                                <a href="teacher/subjects/@m.AssignmentId">
                                    <span class="row-icon"><Icon Name="layers" Size="18" /></span>
                                    <span class="row-text"><span class="row-title">@m.Title</span><span class="row-sub">@m.SubjectName · @m.SectionLabel</span></span>
                                    @if (m.VisibleFromUtc is { } at)
                                    {
                                        <Badge Tone="Tone.Warning">Posts @PhilippineTime.FormatDateTime(at)</Badge>
                                    }
                                    else
                                    {
                                        <Badge>Draft</Badge>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
            </Card>
        </div>
    </PageWithAside>
}

@code {
    private TeacherDashboard? data;

    protected override async Task OnInitializedAsync()
    {
        var teacherId = await Me.GetTeacherIdAsync();
        data = teacherId is { } id ? await Dashboards.GetTeacherAsync(id) : null;
    }
}
