@page "/teacher/items/{ItemId:int}"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject WorkService Work
@inject ModuleService Modules
@inject AttachmentService Files

<PageTitle>@(data?.Title ?? "Assignment") · SEAITT Legazpi LMS</PageTitle>

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (data is null)
{
    <Card>
        <EmptyState IconName="file-text" Title="Not found" IsPage="true">
            <p>This is not one of your assignments, or it was deleted.</p>
            <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Secondary">Back to your courses</ButtonLink>
        </EmptyState>
    </Card>
}
else
{
    var handedIn = data.Rows.Count(r => r.Status is SubmissionStatus.Submitted or SubmissionStatus.Graded);
    var toCheck = data.Rows.Count(r => r.NeedsCheck);
    var lateWaiting = data.Rows.Count(r => r.LateDecision == LateDecisions.Pending);
    var scored = data.Rows.Where(r => r.Score is not null).ToList();
    var flagged = data.Rows.Count(r => r.IsFlagged);

    @* A double click on the title opens what was given (there is no View activity button any more). *@
    <div class="title-dbl" @ondblclick="OpenGiven" title="@($"Double-click to view the {(data.Kind == ItemKinds.Quiz ? "quiz" : "activity")}")">
    <PageHeader Title="@data.Title" IconName="@SubjectStyle.KindIcon(data.Kind)">
        <ButtonLink Href="@($"teacher/subjects/{data.AssignmentId}")" Variant="ButtonVariant.Ghost" IconName="chevron-left">Back to the course</ButtonLink>
        @if (data.Kind == ItemKinds.Quiz && !isFileQuiz)
        {
            <ButtonLink Href="@($"teacher/items/{data.ItemId}/questions")" Variant="ButtonVariant.Secondary" IconName="list-checks">Questions</ButtonLink>
        }
    </PageHeader>
    </div>

    @* The Course Menu at the left (Courses, Modules, Activities, Students, Gradebook, Attendance); the menu of the school folds to its icons so the table has room. *@
    <CourseLayout Teacher="course" CurrentItemId="data.ItemId" Selected="@CourseMenu.KeyOf(data.Kind)" CollapseMenu="true">
    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    @if (lateWaiting > 0)
    {
        <p class="late-hint" role="status"><Icon Name="alarm-clock" Size="16" /> <span>@lateWaiting @(lateWaiting == 1 ? "student handed in late" : "students handed in late"). Accept the work you want to grade, or decline it.</span></p>
    }

    @* What the teacher gave (the question, the instructions, the file) is in the box that View activity opens, in the middle of the screen. *@
    <div class="submissions">
    <div class="summary">
        <div class="tile"><span class="tile-value">@handedIn / @data.Rows.Count</span><span class="tile-label">handed in</span></div>
        <div class="tile"><span class="tile-value">@toCheck</span><span class="tile-label">to check</span></div>
        <div class="tile"><span class="tile-value">@(scored.Count == 0 ? "—" : SubjectStyle.Percent(scored.Average(r => r.Score!.Value), data.MaxScore))</span><span class="tile-label">class average</span></div>
        <div class="tile @(flagged > 0 ? "alert" : "")"><span class="tile-value">@flagged</span><span class="tile-label">flagged</span></div>
        <div class="tile wide">
            <span class="tile-label">Highest score</span>
            <span class="tile-value small">@data.MaxScore.ToString("0.##")</span>
            @if (data.DueAtUtc is { } due)
            {
                <span class="tile-label">Due @PhilippineTime.FormatDateTime(due)</span>
            }
        </div>
    </div>

    <Card>
        @if (data.Rows.Count == 0)
        {
            <EmptyState IconName="users" Title="No students in this course yet">
                <p>Students appear here once the registrar has enrolled them in this section with this course.</p>
            </EmptyState>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Student</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="col-more">Handed in</th>
                            <th scope="col">Score</th>
                            <th scope="col" class="col-files">Answers</th>
                            @if (data.AntiCheat)
                            {
                                <th scope="col" class="col-more">Warnings</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in data.Rows)
                        {
                            var (text, tone) = TeacherStatus(row);
                            <tr class="clickable @(row.IsFlagged ? "flagged" : "")" tabindex="0" title="@($"Open the work of {row.StudentName}")" aria-label="@($"Open the work of {row.StudentName}")"
                                @onclick="() => OpenAsync(row)" @onkeydown="e => OpenKey(e, row)">
                                <td>
                                    <div class="person">
                                        <Avatar Name="@row.StudentName" Size="32" />
                                        <div><span class="person-name">@row.StudentName</span><span class="sub">@row.Lrn</span></div>
                                    </div>
                                </td>
                                <td><Badge Tone="@tone">@text</Badge>@if (row.IsLate) { <Badge Tone="Tone.Warning">Late</Badge> }</td>
                                <td class="col-more">@(row.SubmittedAtUtc is { } at ? PhilippineTime.FormatDateTime(at) : "—")</td>
                                <td>@(row.Score is { } score ? $"{score:0.##} / {data.MaxScore:0.##}" : "—")</td>
                                <td class="col-files">
                                    @* The answer and the files of the student: pressing them opens the work in the box (the row does it). *@
                                    @if (row.Status is SubmissionStatus.Submitted or SubmissionStatus.Graded)
                                    {
                                        <span class="answer-chips">
                                            <span class="answer-chip"><Icon Name="file-text" Size="13" /> Answer</span>
                                            @if (row.SubmissionId is { } submissionId && rowFiles.TryGetValue(submissionId, out var sent))
                                            {
                                                @foreach (var file in sent.Take(3))
                                                {
                                                    <span class="answer-chip file" title="@file.Name"><Icon Name="paperclip" Size="13" /> <span class="chip-name">@file.Name</span></span>
                                                }

                                                @if (sent.Count > 3)
                                                {
                                                    <span class="answer-chip">+@(sent.Count - 3)</span>
                                                }
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                @if (data.AntiCheat)
                                {
                                    <td class="col-more">
                                        @if (row.IsFlagged)
                                        {
                                            <Badge Tone="Tone.Danger"><Icon Name="flag" Size="12" /> @row.ViolationCount</Badge>
                                        }
                                        else
                                        {
                                            <span class="muted">0</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>
    </div>
    </CourseLayout>
}

@* ===== What the teacher gave: the instructions and the files, in the middle of the screen ===== *@
<Modal Open="givenOpen && data is not null" Title="@(data is null ? "" : data.Title)" OnClose="CloseGiven" Large="true">
    @if (data is not null)
    {
        <p class="given-kind"><Icon Name="@SubjectStyle.KindIcon(data.Kind)" Size="16" /> @(data.Kind == ItemKinds.Quiz ? "The quiz" : "What you gave")</p>
        @if (string.IsNullOrWhiteSpace(data.Instructions) && itemFiles.Count == 0)
        {
            <p class="muted">@(data.Kind == ItemKinds.Quiz && !isFileQuiz ? "The questions are in Questions, at the top." : "No instructions or file were added.")</p>
        }

        @if (!string.IsNullOrWhiteSpace(data.Instructions))
        {
            <div class="text">@data.Instructions</div>
        }

        @if (itemFiles.Count > 0)
        {
            <h3 class="files-title"><Icon Name="paperclip" Size="16" /> Files</h3>
            <FilePreviewPane Items="itemFiles" Label="@($"Files of {data.Title}")" />
        }

        <div class="modal-actions">
            <Button Variant="ButtonVariant.Secondary" OnClick="CloseGiven">Close</Button>
        </div>
    }
</Modal>

@* ===== One student's work ===== *@
<Modal Open="detail is not null" Title="@(detail?.StudentName ?? "")" OnClose="CloseDetail" Wide="true">
    @if (detail is not null && data is not null)
    {
        @* The students who handed in are at the left (press one to see theirs), the answers of the student in the middle, the score and the feedback at the right. *@
        <div class="detail-grid">
        <nav class="detail-students" aria-label="Students who handed in">
            <h3 class="grade-title"><Icon Name="users" Size="16" /> Handed in</h3>
            <ul>
                @foreach (var other in data.Rows.Where(r => r.Status is SubmissionStatus.Submitted or SubmissionStatus.Graded))
                {
                    <li>
                        <button type="button" class="student-pick @(other.StudentId == detail.StudentId ? "on" : "")" aria-current="@(other.StudentId == detail.StudentId ? "true" : null)" @onclick="() => OpenAsync(other)">
                            <span class="pick-name">@other.StudentName</span>
                            <span class="pick-sub">@(other.Score is { } sc ? $"{sc:0.##} / {data.MaxScore:0.##}" : "To check")</span>
                        </button>
                    </li>
                }
            </ul>
        </nav>
        <div class="detail-answer">
        <div class="detail-head">
            <Badge Tone="@(detail.Status == SubmissionStatus.Graded ? Tone.Success : detail.Status == SubmissionStatus.Submitted ? Tone.Info : Tone.Neutral)">@StatusText(detail.Status)</Badge>
            @if (detail.IsLate) { <Badge Tone="Tone.Warning">Handed in late</Badge> }
            @if (detail.SubmittedAtUtc is { } at) { <span class="muted">@PhilippineTime.FormatDateTime(at)</span> }
        </div>

        @if (detail.IsFlagged || detail.AutoSubmitReason is not null)
        {
            <div class="watch">
                <strong><Icon Name="shield-alert" Size="16" /> Anti-cheating watch</strong>
                <p>
                    @detail.ViolationCount @(detail.ViolationCount == 1 ? "warning" : "warnings").
                    @if (detail.AutoSubmitReason == "violations") { <span>The quiz was handed in by the system after too many warnings.</span> }
                    else if (detail.AutoSubmitReason == "time") { <span>The quiz was handed in by the system when the time was over.</span> }
                </p>
                @if (!string.IsNullOrWhiteSpace(detail.ViolationLog))
                {
                    <pre class="log">@detail.ViolationLog</pre>
                }
            </div>
        }

        @if (ItemKinds.IsQuizLike(data.Kind) && data.Questions > 0)
        {
            @if (detail.Answers.Count == 0)
            {
                <p class="muted">The student has not handed in this quiz.</p>
            }
            else
            {
                <ol class="answers">
                    @foreach (var answer in detail.Answers)
                    {
                        <li class="@(answer.Manual ? "manual" : answer.IsCorrect ? "right" : "wrong")">
                            <div class="q"><span class="q-lines">@answer.Question</span> <span class="pts">@(answer.Manual ? $"you score it · up to {answer.Points:0.##}" : $"{answer.Earned:0.##} / {answer.Points:0.##}")</span></div>
                            <div class="a"><span>Answer:</span> @(answer.Given ?? "— no answer —")</div>
                            @if (!answer.IsCorrect && !answer.Manual)
                            {
                                <div class="a ok"><span>Right answer:</span> @answer.Correct</div>
                            }
                        </li>
                    }
                </ol>
            }
        }
        else
        {
            @if (string.IsNullOrWhiteSpace(detail.AnswerText) && string.IsNullOrWhiteSpace(detail.LinkUrl) && detailFiles.Count == 0)
            {
                <p class="muted">Nothing was handed in. You can still give a score (for example for something done in class).</p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(detail.AnswerText))
                {
                    <div class="work"><RichView Html="@detail.AnswerHtml" Text="@detail.AnswerText" /></div>
                }

                @if (!string.IsNullOrWhiteSpace(detail.LinkUrl))
                {
                    <p><Icon Name="link" Size="16" /> <a href="@detail.LinkUrl" target="_blank" rel="noopener noreferrer">@detail.LinkUrl</a></p>
                }

                @if (detailFiles.Count > 0)
                {
                    <h3 class="files-title"><Icon Name="paperclip" Size="16" /> Files the student sent</h3>
                    @* The file is shown right here (a PDF, a picture, a text file, a sound or a video), so the answer can be read and scored without opening it somewhere else. *@
                    <FilePreviewPane @key="@($"sent-{detail.StudentId}")" Items="detailFiles" Label="Files the student sent" />
                }
            }
        }

        </div>
        <aside class="detail-grade" aria-label="Score">
        <h3 class="grade-title"><Icon Name="clipboard-check" Size="16" /> Score</h3>
        @if (detail.IsLate && detail.LateDecision is LateDecisions.Pending or LateDecisions.Declined && detail.Status != SubmissionStatus.Graded)
        {
            <div class="late-box" role="status">
                <p>
                    <Icon Name="alarm-clock" Size="16" />
                    @if (detail.LateDecision == LateDecisions.Declined)
                    {
                        <span>You declined this late work, so it is not graded. You can still accept it.</span>
                    }
                    else
                    {
                        <span>This was handed in after the due date. Accept it to give it a score, or decline it.</span>
                    }
                </p>
                <div class="late-actions">
                    <Button Small="true" IconName="circle-check" Disabled="busy" OnClick="() => DecideAsync(detail.StudentId, true)">Accept late work</Button>
                    @if (detail.LateDecision != LateDecisions.Declined)
                    {
                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="circle-x" Disabled="busy" OnClick="() => DecideAsync(detail.StudentId, false)">Decline</Button>
                    }
                </div>
            </div>
        }

        <FormErrors Errors="formErrors" />
        <div class="grade-box">
            <Field For="g-score" Label="@($"Score (highest {data.MaxScore:0.##})")" Required="true">
                <InputNumber id="g-score" @bind-Value="scoreInput" />
            </Field>
            <Field For="g-fb" Label="Feedback" Class="grow">
                <InputTextArea id="g-fb" @bind-Value="feedbackInput" rows="3" />
            </Field>
        </div>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDetail">Cancel</Button>
            <Button IconName="circle-check" Disabled="@(busy || WaitingForDecision)" OnClick="SaveGradeAsync">@(busy ? "Saving…" : "Save score")</Button>
        </div>
        </aside>
        </div>
    }
</Modal>

@code {
    [Parameter] public int ItemId { get; set; }

    private int teacherId;
    private bool loaded;
    private TeacherSubject? course;

    private async Task OpenKey(KeyboardEventArgs e, SubmissionRow row)
    {
        if (e.Key is "Enter" or " ")
        {
            await OpenAsync(row);
        }
    }
    private ItemSubmissionList? data;
    private SubmissionDetail? detail;
    private bool givenOpen;

    private void OpenGiven() => givenOpen = true;

    private void CloseGiven() => givenOpen = false;
    private IReadOnlyList<AttachmentRow> detailFiles = [];
    private decimal? scoreInput;
    private string? feedbackInput;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    protected override async Task OnParametersSetAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        if (teacherId != 0)
        {
            await Modules.MarkItemOpenedAsync(teacherId, ItemId);
        }

        await LoadAsync();
        loaded = true;
    }

    /// <summary>Late work is graded only after the teacher accepted it.</summary>
    private bool WaitingForDecision => detail is { IsLate: true, LateDecision: LateDecisions.Pending or LateDecisions.Declined } && detail.Status != SubmissionStatus.Graded;

    private async Task DecideAsync(int studentId, bool accept)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Work.DecideLateAsync(teacherId, ItemId, studentId, accept);
            if (detail is not null)
            {
                formErrors = result.Succeeded ? [] : [.. result.Errors];
            }
            else
            {
                messageIsError = !result.Succeeded;
                message = result.Succeeded ? result.Message : string.Join(" ", result.Errors);
            }

            await LoadAsync();
            if (detail is not null && result.Succeeded)
            {
                detail = await Work.GetSubmissionAsync(teacherId, ItemId, studentId);
            }
        }
        finally
        {
            busy = false;
        }
    }

    private bool isFileQuiz;

    /// <summary>The files the teacher attached to the work.</summary>
    private IReadOnlyList<AttachmentRow> itemFiles = [];

    /// <summary>The files each student handed in, by the number of the submission (the Files column of the list).</summary>
    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> rowFiles = new Dictionary<int, IReadOnlyList<AttachmentRow>>();

    private async Task LoadAsync()
    {
        data = teacherId == 0 ? null : await Work.GetItemSubmissionsAsync(teacherId, ItemId);
        rowFiles = data is null ? new Dictionary<int, IReadOnlyList<AttachmentRow>>()
            : await Files.ListForAsync(AttachmentOwnerKind.Submission, data.Rows.Where(r => r.SubmissionId != null).Select(r => r.SubmissionId!.Value).ToList());
        itemFiles = data is null ? [] : await Files.ListAsync(new AttachmentOwner(AttachmentOwnerKind.Item, ItemId));
        isFileQuiz = data is { Kind: ItemKinds.Quiz, Questions: 0 } && itemFiles.Count > 0;
        course = data is null ? null : await Modules.GetTeacherSubjectAsync(teacherId, data.AssignmentId);
    }

    private void ClearMessage() => message = null;

    private static string StatusText(string status) => status switch
    {
        SubmissionStatus.Graded => "Graded",
        SubmissionStatus.Submitted => "Handed in",
        SubmissionStatus.InProgress => "In progress",
        _ => "Nothing handed in",
    };

    private static (string Text, Tone Tone) TeacherStatus(SubmissionRow row) => row.Status switch
    {
        SubmissionStatus.Graded => ("Graded", Tone.Success),
        SubmissionStatus.Submitted when row.LateDecision == LateDecisions.Pending => ("Late · accept?", Tone.Warning),
        SubmissionStatus.Submitted when row.LateDecision == LateDecisions.Declined => ("Late · declined", Tone.Danger),
        SubmissionStatus.Submitted => ("To check", Tone.Warning),
        SubmissionStatus.InProgress => ("In progress", Tone.Info),
        _ => ("Not handed in", Tone.Neutral),
    };

    private async Task OpenAsync(SubmissionRow row)
    {
        formErrors = [];
        detail = await Work.GetSubmissionAsync(teacherId, ItemId, row.StudentId);
        detailFiles = detail?.SubmissionId is { } submissionId ? await Files.ListAsync(new AttachmentOwner(AttachmentOwnerKind.Submission, submissionId)) : [];
        scoreInput = detail?.Score;
        feedbackInput = detail?.Feedback;
    }

    private void CloseDetail() => detail = null;

    private async Task SaveGradeAsync()
    {
        if (detail is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Work.GradeAsync(teacherId, ItemId, detail.StudentId, scoreInput, feedbackInput);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            var name = detail.StudentName;
            detail = null;
            messageIsError = false;
            message = $"{name}: {result.Message}";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
