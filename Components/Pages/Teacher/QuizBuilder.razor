@page "/teacher/items/{ItemId:int}/questions"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject WorkService Work
@inject ModuleService Modules

<PageTitle>Questions · @(data?.Title ?? "Quiz") · SEAITT Legazpi LMS</PageTitle>

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (data is null || data.Kind != ItemKinds.Quiz || questions is null)
{
    <Card>
        <EmptyState IconName="file-question" Title="Quiz not found" IsPage="true">
            <p>This is not one of your quizzes, or it was deleted.</p>
            <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Secondary">Back to your courses</ButtonLink>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@data.Title" IconName="file-question">
        <ButtonLink Href="@($"teacher/subjects/{data.AssignmentId}")" Variant="ButtonVariant.Ghost" IconName="chevron-left">Back to the course</ButtonLink>
        <ButtonLink Href="@($"teacher/items/{data.ItemId}")" Variant="ButtonVariant.Secondary" IconName="eye">Results</ButtonLink>
    </PageHeader>

    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    @if (locked)
    {
        <div class="locked" role="status">
            <Icon Name="lock-keyhole" Size="18" />
            <span>Students have already started this quiz, so its questions can't be changed any more. You can still read them here.</span>
        </div>
    }

    <FormErrors Errors="formErrors" />

    <div class="total">
        <strong>@questions.Count @(questions.Count == 1 ? "question" : "questions")</strong>
        <span>·</span>
        <span>The quiz is worth <strong>@questions.Sum(q => q.Points).ToString("0.##")</strong> points</span>
        @if (!locked)
        {
            <span class="spacer"></span>
            <Button IconName="circle-check" Disabled="busy" OnClick="SaveAsync">@(busy ? "Saving…" : "Save questions")</Button>
        }
    </div>

    @if (questions.Count == 0)
    {
        <Card>
            <EmptyState IconName="file-question" Title="No questions yet">
                <p>Add multiple choice, true or false, and short answer questions. The quiz is graded by itself when the student hands it in.</p>
            </EmptyState>
        </Card>
    }

    <ol class="questions">
        @for (var n = 0; n < questions.Count; n++)
        {
            var index = n; // the boxes are drawn later, so they must use this copy and not the loop variable
            var q = questions[n];
            var options = ModuleService.SplitOptions(q.OptionsText);
            <li class="question">
                <header class="question-head">
                    <span class="number">@(index + 1)</span>
                    <InputSelect id="@($"q{index}-kind")" class="input kind" Value="q.Kind" ValueChanged="(string kind) => ChangeKind(q, kind)" ValueExpression="() => q.Kind" disabled="@locked" aria-label="@($"Kind of question {index + 1}")">
                        <option value="@QuestionKinds.MultipleChoice">Multiple choice</option>
                        <option value="@QuestionKinds.TrueFalse">True or false</option>
                        <option value="@QuestionKinds.ShortAnswer">Short answer</option>
                    </InputSelect>
                    <label class="points">
                        <span>Points</span>
                        <InputNumber id="@($"q{index}-points")" class="input" @bind-Value="q.Points" disabled="@locked" />
                    </label>
                    @if (!locked)
                    {
                        <span class="move">
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="arrow-up" Title="Move up" Disabled="@(index == 0)" OnClick="() => Move(index, -1)" />
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="arrow-down" Title="Move down" Disabled="@(index == questions.Count - 1)" OnClick="() => Move(index, 1)" />
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="trash-2" Title="Remove this question" OnClick="() => Remove(index)" />
                        </span>
                    }
                </header>

                <Field For="@($"q{index}-text")" Label="Question">
                    <InputTextArea id="@($"q{index}-text")" @bind-Value="q.Text" rows="2" disabled="@locked" />
                </Field>

                @if (q.Kind == QuestionKinds.MultipleChoice)
                {
                    <div class="two">
                        <Field For="@($"q{index}-options")" Label="Choices" Hint="One choice per line, at least two.">
                            @* A plain box (not InputTextArea) so the "Right choice" list follows the typing letter by letter. *@
                            <textarea id="@($"q{index}-options")" @bind="q.OptionsText" @bind:event="oninput" rows="4" disabled="@locked"></textarea>
                        </Field>
                        <Field For="@($"q{index}-correct")" Label="Right choice">
                            <InputSelect id="@($"q{index}-correct")" @bind-Value="q.CorrectAnswer" disabled="@locked">
                                <option value="">Pick the right choice</option>
                                @foreach (var option in options)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </Field>
                    </div>
                }
                else if (q.Kind == QuestionKinds.TrueFalse)
                {
                    <Field For="@($"q{index}-correct")" Label="The statement is">
                        <InputSelect id="@($"q{index}-correct")" @bind-Value="q.CorrectAnswer" disabled="@locked">
                            <option value="True">True</option>
                            <option value="False">False</option>
                        </InputSelect>
                    </Field>
                }
                else
                {
                    <Field For="@($"q{index}-correct")" Label="Right answer" Hint="Capital letters and extra spaces don't matter. Separate other accepted answers with |, like: equity | owner's equity">
                        <InputText id="@($"q{index}-correct")" @bind-Value="q.CorrectAnswer" maxlength="500" autocomplete="off" disabled="@locked" />
                    </Field>
                }
            </li>
        }
    </ol>

    @if (!locked)
    {
        <div class="adders">
            <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => Add(QuestionKinds.MultipleChoice)">Multiple choice</Button>
            <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => Add(QuestionKinds.TrueFalse)">True or false</Button>
            <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => Add(QuestionKinds.ShortAnswer)">Short answer</Button>
            <span class="spacer"></span>
            <Button IconName="circle-check" Disabled="busy" OnClick="SaveAsync">@(busy ? "Saving…" : "Save questions")</Button>
        </div>
    }
}

@code {
    [Parameter] public int ItemId { get; set; }

    private int teacherId;
    private bool loaded;
    private ItemSubmissionList? data;
    private List<QuestionInput>? questions;
    private bool locked;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    protected override async Task OnParametersSetAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        if (teacherId != 0)
        {
            await Modules.MarkItemOpenedAsync(teacherId, ItemId);
        }

        data = teacherId == 0 ? null : await Work.GetItemSubmissionsAsync(teacherId, ItemId);
        if (data is { Kind: ItemKinds.Quiz })
        {
            var saved = await Modules.GetQuestionsAsync(teacherId, ItemId);
            questions = saved is null ? null : [.. saved];
            locked = data.Rows.Any(r => r.Status != "NotStarted");
        }

        loaded = true;
    }

    private void ClearMessage() => message = null;

    private void Add(string kind) => questions!.Add(new QuestionInput
    {
        Kind = kind,
        Points = 1,
        CorrectAnswer = kind == QuestionKinds.TrueFalse ? "True" : "",
    });

    private void Remove(int index) => questions!.RemoveAt(index);

    private void Move(int index, int direction)
    {
        var target = index + direction;
        if (target < 0 || target >= questions!.Count)
        {
            return;
        }

        (questions[index], questions[target]) = (questions[target], questions[index]);
    }

    private static void ChangeKind(QuestionInput q, string kind)
    {
        q.Kind = kind;
        q.CorrectAnswer = kind == QuestionKinds.TrueFalse ? "True" : "";
    }

    private async Task SaveAsync()
    {
        if (busy || questions is null)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.SaveQuestionsAsync(teacherId, ItemId, questions);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                message = null;
                return;
            }

            formErrors = [];
            messageIsError = false;
            message = result.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
