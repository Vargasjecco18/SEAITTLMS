@page "/teacher/subjects"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@using SEAITT_LMS.Services
@inject CurrentUser Me
@inject TeachingService Teaching

<PageTitle>Courses · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Courses" IconName="book-open" />

@* The list of the courses is open: the Courses link of the menu stops going back to a course (wwwroot/app.js). *@
<span data-last-course="" hidden></span>

<PageWithAside Show="calendar,tocheck">@Body</PageWithAside>

@code {
    // The cards and the list both share the page with the widgets at the right (calendar, what to check); a wide list scrolls sideways inside its own box.
    private RenderFragment Body => @<text>

@if (cards is null)
{
    <p class="muted">Loading…</p>
}
else if (cards.Count == 0)
{
    <Card>
        <EmptyState IconName="book-open" Title="No courses yet">
            <p>The administrator gives each teacher their courses (Users Management, Teachers, Courses). They will show up here.</p>
        </EmptyState>
    </Card>
}
else
{
    <div class="bar">
        @* The chips and the switch are plain links: the page opens again with the choice in its address. *@
        <nav class="chips" aria-label="Show the courses that are">
            <a class="chip @(filter is null ? "on" : "")" href="@Url(null, view)">All <span class="n">@cards.Count</span></a>
            <a class="chip @(filter == "enrolled" ? "on" : "")" href="@Url("enrolled", view)">Enrolled <span class="n">@cards.Count(c => !c.IsCompleted)</span></a>
            <a class="chip @(filter == "completed" ? "on" : "")" href="@Url("completed", view)">Completed <span class="n">@cards.Count(c => c.IsCompleted)</span></a>
        </nav>

        <nav class="views" aria-label="View">
            <a class="view @(view == "cards" ? "on" : "")" href="@Url(filter, "cards", true)" title="Cards" aria-label="Cards"><Icon Name="layout-grid" Size="18" /></a>
            <a class="view @(view == "list" ? "on" : "")" href="@Url(filter, "list", true)" title="List" aria-label="List"><Icon Name="list" Size="18" /></a>
        </nav>
    </div>

    @if (shown.Count == 0)
    {
        <Card>
            <EmptyState IconName="search-x" Title="@(filter == "completed" ? "No completed courses yet" : "No courses you are teaching right now")">
                <p>@(filter == "completed" ? "A course is completed when its term is over." : "")</p>
                <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Secondary">Show all courses</ButtonLink>
            </EmptyState>
        </Card>
    }
    else if (view == "list")
    {
        <Card>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Course</th>
                            <th scope="col">Section</th>
                            <th scope="col" class="col-more">Students</th>
                            <th scope="col">Modules</th>
                            <th scope="col">Assignments</th>
                            <th scope="col">To check</th>
                            <th scope="col" class="col-actions"><span class="sr-only">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var card in shown)
                        {
                            <tr>
                                <td>
                                    <span class="name">@card.SubjectName</span>
                                    @if (card.Meets is not null) { <span class="sub">@card.Meets</span> }
                                </td>
                                <td>@card.SectionLabel</td>
                                <td class="col-more">@card.Students</td>
                                <td class="progress-cell">
                                    @if (card.ModulesTotal == 0)
                                    {
                                        <span class="muted">No modules yet</span>
                                    }
                                    else
                                    {
                                        <span class="posted">@card.ModulesPosted of @card.ModulesTotal</span>
                                        <ProgressBar Percent="@(card.ModulesPosted * 100 / card.ModulesTotal)" Title="@($"{card.ModulesPosted} of {card.ModulesTotal} modules are posted")" />
                                    }
                                </td>
                                <td>
                                    @if (card.Activities + card.Quizzes + card.TaskPerformances == 0)
                                    {
                                        <span class="muted">No assignments yet</span>
                                    }
                                    else
                                    {
                                        <span title="@WorkTitle(card)">@WorkSummary(card)</span>
                                    }
                                </td>
                                <td>
                                    @if (card.ToGrade > 0)
                                    {
                                        @* The number is a button: it opens the assignments, quizzes and task performances to check, each one a link. *@
                                        <CourseWorkButton AssignmentId="card.AssignmentId" CourseName="@card.SubjectName" Text="@($"{card.ToGrade} to check")" Student="false" />
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td class="col-actions">
                                    <ButtonLink Href="@($"teacher/subjects/{card.AssignmentId}")" IconName="arrow-right" IconAfter="true" Small="true">Open</ButtonLink>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    }
    else
    {
        <div class="grid">
            @foreach (var card in shown)
            {
                <SubjectCard Name="@card.SubjectName" Cover="@StrandArt.For(card.StrandCode, card.StrandName)" CoverLabel="@card.StrandName"
                             Section="@card.SectionLabel" Meets="@card.Meets"
                             Modules="card.ModulesTotal" ModulesNote="@($"{card.ModulesPosted} posted")" Activities="card.Activities" Quizzes="card.Quizzes" TaskPerformances="card.TaskPerformances"
                             Href="@($"teacher/subjects/{card.AssignmentId}")">
                    @if (card.ToGrade > 0)
                    {
                        <Badge Tone="Tone.Warning">@card.ToGrade to check</Badge>
                    }
                </SubjectCard>
            }
        </div>
    }
}
</text>;

    [SupplyParameterFromQuery(Name = "show")] private string? Show { get; set; }

    [SupplyParameterFromQuery(Name = "view")] private string? ViewText { get; set; }

    [CascadingParameter] private HttpContext? Http { get; set; }

    private IReadOnlyList<TeacherSubjectCard>? cards;
    private string? filter;
    private List<TeacherSubjectCard> shown = [];
    private string view = "cards";

    protected override async Task OnParametersSetAsync()
    {
        view = ViewPreference.Resolve(Http, "subjects", ViewText, "cards", "list");
        var teacherId = await Me.GetTeacherIdAsync();
        cards = teacherId is { } id ? await Teaching.GetTeacherCardsAsync(id) : [];
        filter = Show is "enrolled" or "completed" ? Show : null;
        shown = cards.Where(c => filter is null || (filter == "completed") == c.IsCompleted).ToList();
    }

    /// <summary>"2 A · 1 Q · 1 TP": the assignments, quizzes and task performances (the short names the gradebook uses); the full words are in the title.</summary>
    private static string WorkSummary(TeacherSubjectCard card)
    {
        var parts = new List<string>();
        if (card.Activities > 0) { parts.Add($"{card.Activities} A"); }
        if (card.Quizzes > 0) { parts.Add($"{card.Quizzes} Q"); }
        if (card.TaskPerformances > 0) { parts.Add($"{card.TaskPerformances} TP"); }
        return string.Join(" · ", parts);
    }

    private static string WorkTitle(TeacherSubjectCard card)
    {
        var parts = new List<string>();
        if (card.Activities > 0) { parts.Add(card.Activities == 1 ? "1 assignment" : $"{card.Activities} assignments"); }
        if (card.Quizzes > 0) { parts.Add(card.Quizzes == 1 ? "1 quiz" : $"{card.Quizzes} quizzes"); }
        if (card.TaskPerformances > 0) { parts.Add(card.TaskPerformances == 1 ? "1 task performance" : $"{card.TaskPerformances} task performances"); }
        return string.Join(" · ", parts);
    }

    private static string Url(string? show, string view, bool explicitView = false)
    {
        var parts = new List<string>();
        if (show is not null)
        {
            parts.Add("show=" + show);
        }

        // The Cards / List buttons always say the view (explicitView): a link to Cards must say so, or the view remembered by the browser (List) would come back.
        if (view == "list" || explicitView)
        {
            parts.Add("view=" + view);
        }

        return "teacher/subjects" + (parts.Count == 0 ? "" : "?" + string.Join('&', parts));
    }
}
