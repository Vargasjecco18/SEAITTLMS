@page "/teacher/subjects"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@using SEAITT_LMS.Services
@inject CurrentUser Me
@inject TeachingService Teaching

<PageTitle>Subjects · SEAITT e-LMS</PageTitle>

<PageHeader Title="Subjects" Subtitle="The subjects you teach. Open one to see its modules, activities, quizzes and task performances." IconName="book-open" />

<PageWithAside Show="calendar,todo,tocheck">

@if (cards is null)
{
    <p class="muted">Loading…</p>
}
else if (cards.Count == 0)
{
    <Card>
        <EmptyState IconName="book-open" Title="No subjects yet">
            <p>The administrator gives each teacher their subjects (Users Management, Teachers, Subjects). They will show up here.</p>
        </EmptyState>
    </Card>
}
else
{
    @if (sections.Count > 1)
    {
        <nav class="chips" aria-label="Show the subjects of">
            <a class="chip @(Section is null ? "on" : "")" href="teacher/subjects">All</a>
            @foreach (var label in sections)
            {
                <a class="chip @(string.Equals(Section, label, StringComparison.Ordinal) ? "on" : "")" href="teacher/subjects?section=@Uri.EscapeDataString(label)">@label</a>
            }
        </nav>
    }

    <div class="grid">
        @foreach (var card in shown)
        {
            <SubjectCard Name="@card.SubjectName" Tag="@card.SectionLabel" Subtitle="@(card.Schedule is null ? null : card.Schedule + " schedule")" Href="@($"teacher/subjects/{card.AssignmentId}")">
                <Badge Tone="@(card.ModulesTotal == 0 ? Tone.Neutral : Tone.Info)">@card.ModulesPosted of @card.ModulesTotal @(card.ModulesTotal == 1 ? "module" : "modules") posted</Badge>
                @if (card.ToGrade > 0)
                {
                    <Badge Tone="Tone.Warning">@card.ToGrade to check</Badge>
                }
            </SubjectCard>
        }
    </div>
}
</PageWithAside>

@code {
    [SupplyParameterFromQuery(Name = "section")] private string? Section { get; set; }

    private IReadOnlyList<TeacherSubjectCard>? cards;
    private List<string> sections = [];
    private List<TeacherSubjectCard> shown = [];

    protected override async Task OnParametersSetAsync()
    {
        var teacherId = await Me.GetTeacherIdAsync();
        cards = teacherId is { } id ? await Teaching.GetTeacherCardsAsync(id) : [];
        sections = cards.Select(c => c.SectionLabel).Distinct().ToList();
        shown = cards.Where(c => Section is null || c.SectionLabel == Section).ToList();
    }
}
