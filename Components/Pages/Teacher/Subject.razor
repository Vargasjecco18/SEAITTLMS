@page "/teacher/subjects/{AssignmentId:int}"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ModuleService Modules
@inject AttachmentService Files
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>@(subject is null ? "Course" : $"{subject.SubjectName} · {subject.SectionLabel}") · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh Seconds="60" />

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (subject is null)
{
    <Card>
        <EmptyState IconName="book-open" Title="Course not found" IsPage="true">
            <p>This course is not one of yours, or it was removed.</p>
            <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Secondary">Back to your courses</ButtonLink>
        </EmptyState>
    </Card>
}
else
{
    @* Two sections can have the same course, so the section is part of the title. *@
    <PageHeader Title="@($"{subject.SubjectName} · {subject.SectionLabel}")"
                IconName="book-open">
        <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Ghost" IconName="chevron-left">All courses</ButtonLink>
        <AddItemMenu Choice="true" Label="Add activities" Modules="AddMenuModules" OnPick="PickNew" />
    </PageHeader>

    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    @* The second menu of the course (modules, assignments, quizzes, task performances) next to its content. *@
    @if (shownKind is { } listKind)
    {
        <CourseLayout Teacher="subject" Selected="@CourseMenu.KeyOf(listKind)">
        <Card Title="@CourseMenuBuilder.Label(listKind)" IconName="@SubjectStyle.KindIcon(listKind)">
            @{
                var listed = subject.Modules.Where(m => !m.IsSyllabus || m.Items.Any(i => i.Kind == listKind))
                    .SelectMany(m => m.Items.Where(i => i.Kind == listKind).Select(i => (Module: m, Item: i))).ToList();
            }
            <div class="kind-head">
                <p class="muted">@(listed.Count == 0 ? $"No {ItemKinds.Plural(listKind).ToLowerInvariant()} in this course yet." : $"All the {ItemKinds.Plural(listKind).ToLowerInvariant()} of the course, handout by handout.")</p>
                @if (ItemKinds.All.Contains(listKind))
                {
                    <AddItemMenu @key="@($"{listKind}-{AddQuery}")" Kind="@listKind" Label="@($"Add {ItemKinds.Display(listKind).ToLowerInvariant()}")" Modules="AddMenuModules" OnPick="PickNew" StartOpen="@(AddQuery == "1")" />
                }
            </div>
            @if (listed.Count > 0)
            {
                <ul class="items kind-list">
                    @foreach (var (module, item) in listed)
                    {
                        <li class="item">
                            <div class="item-main">
                                <a class="item-title" href="teacher/items/@item.Id">@item.Title</a>
                                <div class="item-meta">
                                    <span><Icon Name="layers" Size="14" /> @module.Title</span>
                                    @if (item.DueAtUtc is { } listDue)
                                    {
                                        <span><Icon Name="calendar-clock" Size="14" /> Due @PhilippineTime.FormatDateTime(listDue)</span>
                                    }
                                    else
                                    {
                                        <span>No due date</span>
                                    }
                                    <span>@item.MaxScore.ToString("0.##") points</span>
                                    @if (item.Kind == ItemKinds.Quiz && IsFileQuiz(item))
                                    {
                                        <span><Icon Name="file-text" Size="14" /> File quiz · no questions</span>
                                    }
                                    else if (item.Kind == ItemKinds.Quiz)
                                    {
                                        <span>@item.Questions @(item.Questions == 1 ? "question" : "questions")</span>
                                        @if (item.TimeLimitMinutes is { } minutes)
                                        {
                                            <span><Icon Name="timer" Size="14" /> @minutes min</span>
                                        }
                                        @if (item.AntiCheat)
                                        {
                                            <span title="Warns after @item.MaxViolations leaves of the quiz, copies, pastes, prints or screenshots"><Icon Name="shield-check" Size="14" /> Anti-cheat on</span>
                                        }
                                    }
                                    <Badge Tone="@(module.State == Visibility.Posted ? Tone.Success : module.State == Visibility.Scheduled ? Tone.Warning : Tone.Neutral)">@(module.State == Visibility.Draft ? "Draft handout" : module.State == Visibility.Scheduled ? "Handout scheduled" : "Posted")</Badge>
                                </div>
                            </div>
                            <div class="item-side">
                                <span class="handed" title="Handed in of the students in this course">@item.Submitted / @item.Students handed in</span>
                                @if (item.Kind != ItemKinds.Quiz && item.Submitted - item.Graded > 0)
                                {
                                    <Badge Tone="Tone.Warning">@(item.Submitted - item.Graded) to check</Badge>
                                }
                                @if (item.Flagged > 0)
                                {
                                    <Badge Tone="Tone.Danger"><Icon Name="flag" Size="12" /> @item.Flagged flagged</Badge>
                                }
                            </div>
                            <div class="item-actions">
                                @if (item.Kind == ItemKinds.Quiz && !IsFileQuiz(item))
                                {
                                    <ButtonLink Href="@($"teacher/items/{item.Id}/questions")" Variant="ButtonVariant.Secondary" Small="true" IconName="list-checks">Questions</ButtonLink>
                                }
                                <ButtonLink Href="@($"teacher/items/{item.Id}")" Variant="ButtonVariant.Secondary" Small="true" IconName="eye">Open</ButtonLink>
                                <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="pencil" Title="Edit" OnClick="() => OpenEditItem(module, item)" />
                                <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="trash-2" Title="Delete" OnClick="() => AskDeleteItem(item)" />
                            </div>
                        </li>
                    }
                </ul>
            }
        </Card>
        </CourseLayout>
    }
    else
    {
        @* The first page of the course counts as being in the course: the Courses link of the menu comes back here (wwwroot/app.js). *@
        <span data-last-course="@($"teacher/subjects/{AssignmentId}")" hidden></span>
        @* The first page of a course: only the syllabus and the modules, one row each (the title, how far the class has read, the Slides and Module buttons and the state), with the Course Menu at the left. *@
        <CourseLayout Teacher="subject">
        <p class="hint-line">
            <Icon Name="eye-off" Size="16" />
            <span>Handouts from the provider are <strong>drafts</strong>. Students see them when you post them.</span>
        </p>

        @if (subject.Modules.All(m => m.IsExamSet))
        {
            <Card>
                <EmptyState IconName="layers" Title="No handouts yet">
                    <p>A handout is a lesson with its files. The academic provider sends the syllabus and the handouts of this course.</p>
                </EmptyState>
            </Card>
        }
        else
        {
            <Card Title="Syllabus and handouts" IconName="layers">
                <ul class="course-rows">
                    @for (var n = 0; n < subject.Modules.Count; n++)
                    {
                        var module = subject.Modules[n];
                        if (module.IsExamSet)
                        {
                            continue;
                        }

                        var number = subject.Modules.Take(n + 1).Count(m => !m.IsSyllabus && !m.IsExamSet);
                        var progress = ProgressOf(module);
                        var moduleHref = $"teacher/subjects/{AssignmentId}/modules/{module.Id}";
                        <li class="course-row @module.State.ToLowerInvariant()" data-module="@module.Id">
                            @* The title opens the module; under it, at the left of what the module has (its activities), how far the class has got (50 for the slides, 50 for the module). In the middle: the Slides
                               (when there are slides) and Handout buttons. At the right: when it appears (press it to change the time) and Hide from students. *@
                            <a class="row-open" href="@moduleHref">
                                <span class="row-number">@if (module.IsSyllabus) { <Icon Name="book-marked" Size="18" /> } else { @number }</span>
                                <span class="row-text">
                                    <span class="row-title">@module.Title</span>
                                    <span class="row-meta">
                                        <span class="row-progress"><ProgressBar Percent="progress.Percent" Title="@progress.Text" /></span>
                                        @if (module.IsSyllabus)
                                        {
                                            <Badge Tone="Tone.Info">Syllabus</Badge>
                                        }
                                        else
                                        {
                                            <span class="count-chip">@ModuleSummary(module)</span>
                                        }
                                    </span>
                                </span>
                            </a>
                            <span class="row-buttons">
                                @if (module.HasSlides)
                                {
                                    <ButtonLink Href="@($"{moduleHref}?slides=1")" Variant="ButtonVariant.Secondary" Small="true" IconName="presentation">Slides</ButtonLink>
                                }
                                <ButtonLink Href="@moduleHref" Small="true" IconName="book-open">@(module.IsSyllabus ? "Syllabus" : "Handout")</ButtonLink>
                            </span>
                            <span class="row-status">
                                <span class="when">
                                    <button type="button" class="when-chip @module.State.ToLowerInvariant()" aria-haspopup="dialog" aria-expanded="@(statusModule?.Id == module.Id ? "true" : "false")" title="Change the time it appears"
                                            @onclick="() => ToggleStatus(module)">
                                        <Icon Name="calendar-clock" Size="14" />
                                        @if (module.State == Visibility.Posted)
                                        {
                                            <span>Posted @PhilippineTime.FormatDate(module.VisibleFromUtc!.Value)</span>
                                        }
                                        else if (module.State == Visibility.Scheduled)
                                        {
                                            <span>Scheduled for @PhilippineTime.FormatDateTime(module.VisibleFromUtc!.Value)</span>
                                        }
                                        else
                                        {
                                            <span>Draft · hidden</span>
                                        }
                                        <Icon Name="pencil" Size="13" />
                                    </button>
                                    @if (statusModule?.Id == module.Id)
                                    {
                                        <div class="when-scrim" @onclick="CloseStatus"></div>
                                        <div class="when-pop" role="dialog" aria-label="@($"When {module.Title} appears")">
                                            <label class="when-label" for="@($"when-{module.Id}")">Time it appears <small>(Philippine time)</small></label>
                                            <input id="@($"when-{module.Id}")" type="datetime-local" value="@scheduleText" @onchange="SetSchedule" />
                                            <p class="when-hint">@(module.State == Visibility.Posted ? "It is posted. Change the time it appeared, or choose a later time to hide it until then." : module.State == Visibility.Scheduled ? "It appears by itself at that time. The students are told." : "The students can't see it yet. Choose a time, or post it now.")</p>
                                            <FormErrors Errors="formErrors" />
                                            <div class="when-actions">
                                                @if (module.State != Visibility.Posted)
                                                {
                                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="send" Disabled="busy" OnClick="PostStatusAsync">Post now</Button>
                                                }
                                                <Button Small="true" IconName="calendar-clock" Disabled="busy" OnClick="SaveScheduleAsync">Save time</Button>
                                            </div>
                                        </div>
                                    }
                                </span>
                                @if (module.State != Visibility.Draft)
                                {
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="eye-off" Title="@($"Hide {module.Title} from the students")" Disabled="busy" OnClick="() => HideRowAsync(module)">Hide from students</Button>
                                }
                            </span>
                        </li>
                    }
                </ul>
            </Card>
        }
        </CourseLayout>
    }
}

@* ===== Item: add or edit ===== *@
<Modal Open="itemForm is not null" Title="@ItemModalTitle" OnClose="CloseItemForm" Large="true">
    @if (itemForm is not null)
    {
        <EditForm Model="itemForm" OnValidSubmit="SaveItemAsync">
            <FormErrors Errors="formErrors" />
            @if (editingItemId is null)
            {
                <p class="from-excel"><Button Small="true" Variant="ButtonVariant.Ghost" IconName="file-spreadsheet" OnClick="OpenExcelFromForm">Fill many in a sheet instead (Add activities)</Button></p>
            }

            <Field For="i-title" Label="Title" Required="true">
                <InputText id="i-title" @bind-Value="itemForm.Title" maxlength="200" autocomplete="off" />
            </Field>
            <Field For="i-text" Label="Instructions">
                <InputTextArea id="i-text" @bind-Value="itemForm.Instructions" rows="5" />
            </Field>
            @if (itemForm.Kind != ItemKinds.Quiz || QuizIsAFile)
            {
                <Field For="i-score" Label="Highest score" Required="true">
                    <InputNumber id="i-score" @bind-Value="itemForm.MaxScore" />
                </Field>
            }
            <div class="two">
                <Field For="i-from" Label="Appears on" Hint="Leave empty to show it with its handout.">
                    <input id="i-from" type="datetime-local" value="@itemForm.VisibleText" @onchange="SetVisible" />
                </Field>
                <Field For="i-due" Label="Due date" Hint="Philippine time. Leave empty for no due date.">
                    <input id="i-due" type="datetime-local" value="@itemForm.DueText" @onchange="SetDue" />
                </Field>
            </div>

            <AttachmentPicker @ref="itemPicker" @key="itemFormKey" Title="@(itemForm.Kind == ItemKinds.Quiz ? "File of the quiz (optional)" : "Files")" Existing="@FilesOf(itemFiles, editingItemId)" OnChanged="FilesChanged" />

            @if (itemForm.Kind == ItemKinds.Quiz)
            {
                @if (QuizIsAFile)
                {
                    <p class="file-quiz-note" role="status">
                        <Icon Name="file-text" Size="16" />
                        <span>This quiz is a <strong>file</strong>, so it has <strong>no questions</strong>. The students send their answers as a file and you give the score. Take the file off to write questions instead.</span>
                    </p>
                }

                <QuizSettings IdPrefix="i" Note="@(QuizIsAFile ? "The time limit and the anti-cheating watch only work for a quiz with questions." : "You write the questions after saving. The quiz is worth the total of the points of its questions.")"
                              @bind-TimeLimit="itemForm.TimeLimit" @bind-MaxViolations="itemForm.MaxViolations" @bind-AntiCheat="itemForm.AntiCheat"
                              @bind-ShuffleQuestions="itemForm.ShuffleQuestions" @bind-ShuffleOptions="itemForm.ShuffleOptions" @bind-ShowResult="itemForm.ShowResult" />
            }

            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseItemForm">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : itemForm.Kind == ItemKinds.Quiz && editingItemId is null && !QuizIsAFile ? "Save and write questions" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Add activities: the Excel template and import for the seatwork, assignments, quizzes and task performances of all the modules ===== *@
<ActivitiesSheetDialog Open="activitiesOpen" CourseName="@(subject?.SubjectName ?? "")" Modules="SheetModules" StartModule="@activitiesStartModule" OnImport="ImportActivitiesAsync" OnClose="CloseActivities" />

@* ===== Add quiz: the quiz is made with its questions, written in a sheet ===== *@
<QuestionsSheetDialog Open="quizSheetOpen" Heading="@($"Add quiz · {subject?.SubjectName}")" Subject="quiz" Existing="noQuestions" Errors="quizErrors" Busy="busy"
                      SaveBlocked="@(quizModuleId == 0 || string.IsNullOrWhiteSpace(quizTitle))"
                      SaveStep="The quiz is made with these questions, in the handout you chose. Set its due date, its time limit and the anti-cheating watch afterwards, with Edit on the quiz."
                      OnSave="SaveQuizAsync" OnClose="CloseQuizSheet">
    <HeaderContent>
        <Field For="quiz-module" Label="Handout" Required="true">
            <select id="quiz-module" @bind="quizModuleId">
                <option value="0">Choose a handout</option>
                @foreach (var option in SheetModules)
                {
                    <option value="@option.Id">@option.Label</option>
                }
            </select>
        </Field>
        <Field For="quiz-title" Label="Title of the quiz" Required="true">
            <input id="quiz-title" type="text" maxlength="200" autocomplete="off" placeholder="Quiz 1: Debits and credits" @bind="quizTitle" @bind:event="oninput" />
        </Field>
    </HeaderContent>
</QuestionsSheetDialog>

@* ===== Delete ===== *@
<Modal Open="deleteTarget is not null" Title="@(deleteTarget?.Title ?? "")" OnClose="CloseDelete">
    @if (deleteTarget is not null)
    {
        <p class="dialog-text">@deleteTarget.Text <strong>This can't be undone.</strong></p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="DeleteAsync">Delete</Button>
        </div>
    }
</Modal>

@code {
    private sealed class ItemForm
    {
        public string Kind { get; set; } = ItemKinds.Activity;
        public string Title { get; set; } = "";
        public string? Instructions { get; set; }
        public decimal MaxScore { get; set; } = 100;
        public string DueText { get; set; } = "";
        public string VisibleText { get; set; } = "";
        public int? TimeLimit { get; set; }
        public bool ShuffleQuestions { get; set; } = true;
        public bool ShuffleOptions { get; set; } = true;
        public bool AntiCheat { get; set; } = true;
        public int MaxViolations { get; set; } = 3;
        public bool ShowResult { get; set; } = true;
    }

    private sealed record DeleteTarget(string Title, string Text, int Id);

    [Parameter] public int AssignmentId { get; set; }

    /// <summary>The tab of the second menu: assignments, quizzes or tasks (the modules when empty).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    /// <summary>"1" when the person came from "Add seatwork" (and so on) in the menu of the course: the Add menu of the list is open.</summary>
    [SupplyParameterFromQuery(Name = "add")] public string? AddQuery { get; set; }

    private string? shownKind => CourseMenu.KindOfKey(Tab);

    private int teacherId;
    private bool loaded;
    private TeacherSubject? subject;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    private ItemForm? itemForm;
    private int? editingItemId;
    private int itemModuleId;

    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> moduleFiles = new Dictionary<int, IReadOnlyList<AttachmentRow>>();
    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> itemFiles = new Dictionary<int, IReadOnlyList<AttachmentRow>>();
    private AttachmentPicker? itemPicker;
    private int itemFormKey;

    private TeacherModule? statusModule;
    private string scheduleText = "";

    private DeleteTarget? deleteTarget;

    /// <summary>A quiz that has a file has no questions: the students answer with a file and the teacher gives the score.</summary>
    private bool QuizIsAFile => itemForm?.Kind == ItemKinds.Quiz && (itemPicker?.HasFiles ?? FilesOf(itemFiles, editingItemId).Count > 0);

    private void FilesChanged() { }

    /// <summary>The page where the module is read inside the system, with the file pressed shown (a file the browser can't show is saved instead).</summary>
    private string? ReaderHref(int moduleId, AttachmentRow file) => file.CanPreview ? $"teacher/subjects/{AssignmentId}/modules/{moduleId}?file={file.Id}" : null;

    // ---------------------------------------------------------------- Add activities (the sheet of the course, inside the system)

    private bool activitiesOpen;
    private string? activitiesStartModule;

    /// <summary>The modules of the course (not the syllabus, not the box of the exams) as the sheet lists them, with the label the rows find them by.</summary>
    private IReadOnlyList<AddMenuModule> SheetModules => subject is null ? [] :
        [.. subject.Modules.Where(m => !m.IsSyllabus && !m.IsExamSet).Select((m, n) => new AddMenuModule(m.Id, AddItemMenuLabels.ModuleLabel(n + 1, m.Title)))];

    /// <summary>Opens the sheet; the first rows start in the module the teacher came from (when there is one).</summary>
    private Task OpenActivitiesAsync(int? fromModuleId = null)
    {
        if (subject is null)
        {
            return Task.CompletedTask;
        }

        activitiesStartModule = fromModuleId is { } id ? SheetModules.FirstOrDefault(m => m.Id == id)?.Label : null;
        activitiesOpen = true;
        return Task.CompletedTask;
    }

    private void CloseActivities() => activitiesOpen = false;

    /// <summary>The module a row of the workbook names: its title, its label ("Module 2: Ledgers") or just "Module 2".</summary>
    private TeacherModule? ModuleNamed(string name)
    {
        var modules = subject?.Modules.Where(m => !m.IsSyllabus && !m.IsExamSet).ToList() ?? [];
        name = name.Trim();
        return modules.FirstOrDefault(m => string.Equals(m.Title.Trim(), name, StringComparison.OrdinalIgnoreCase))
            ?? modules.Select((m, n) => (Module: m, Label: AddItemMenuLabels.ModuleLabel(n + 1, m.Title))).FirstOrDefault(x => string.Equals(x.Label, name, StringComparison.OrdinalIgnoreCase)).Module
            ?? modules.FirstOrDefault(m => m.Title.StartsWith(name + ":", StringComparison.OrdinalIgnoreCase) || m.Title.StartsWith(name + " ", StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Every row of the sheet is saved like the box saves one item, in the module the row names, so the same rules hold; the questions of a quiz and the files follow it.</summary>
    private async Task<ItemImportSummary> ImportActivitiesAsync(IReadOnlyList<ActivityToSave> list)
    {
        var userId = await UserIdAsync();
        var missing = new List<string>();
        var ready = new List<ActivityToSave>();
        foreach (var entry in list)
        {
            if (ModuleNamed(entry.Work.Module) is null)
            {
                missing.Add($"{entry.Sheet}, row {entry.Row} ({entry.Work.Input.Title}): this course has no handout called \"{entry.Work.Module}\".");
            }
            else
            {
                ready.Add(entry);
            }
        }

        var summary = await ActivityImport.RunAsync(ready,
            work => Modules.SaveItemAsync(teacherId, ModuleNamed(work.Module)!.Id, null, work.Input),
            (id, questions) => Modules.SaveQuestionsAsync(teacherId, id, questions),
            (id, files) => Files.AddAsync(userId, new AttachmentOwner(AttachmentOwnerKind.Item, id), files));
        await LoadAsync();
        return summary with { Errors = [.. missing, .. summary.Errors] };
    }

    private async Task OpenExcelFromForm()
    {
        itemForm = null;
        await OpenActivitiesAsync();
    }

    /// <summary>A quiz that has a file and no questions: the students answer with a file, so there is no question editor for it.</summary>
    private bool IsFileQuiz(TeacherItem item) => item.Kind == ItemKinds.Quiz && item.Questions == 0 && FilesOf(itemFiles, item.Id).Count > 0;

    private string ItemModalTitle => itemForm is null ? "" : editingItemId is null ? $"Add {ItemKinds.Display(itemForm.Kind).ToLowerInvariant()}" : $"Edit {ItemKinds.Display(itemForm.Kind).ToLowerInvariant()}";

    protected override async Task OnParametersSetAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        subject = teacherId == 0 ? null : await Modules.GetTeacherSubjectAsync(teacherId, AssignmentId);
        var all = subject?.Modules ?? [];
        moduleFiles = await Files.ListForAsync(AttachmentOwnerKind.Module, all.Select(m => m.Id).ToList());
        itemFiles = await Files.ListForAsync(AttachmentOwnerKind.Item, all.SelectMany(m => m.Items).Select(i => i.Id).ToList());
    }

    private static IReadOnlyList<AttachmentRow> FilesOf(IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> map, int? id) =>
        id is { } key && map.TryGetValue(key, out var list) ? list : [];

    /// <summary>Saves the files chosen in a form for the module or item with this number: new ones are attached, the ones taken off are removed. Returns what went wrong.</summary>
    private async Task<List<string>> ApplyFilesAsync(AttachmentPicker? picker, AttachmentOwner owner, bool slides = false)
    {
        var problems = new List<string>();
        if (picker is null)
        {
            return problems;
        }

        var removed = await Files.RemoveAsync(await UserIdAsync(), [.. picker.Removed]);
        if (!removed.Succeeded)
        {
            problems.AddRange(removed.Errors);
        }

        var added = await Files.AddAsync(await UserIdAsync(), owner, picker.Pending, slides: slides);
        if (!added.Succeeded)
        {
            problems.AddRange(added.Errors);
        }

        return problems;
    }

    private async Task<int> UserIdAsync() => (await Me.GetAsync())?.UserId ?? 0;

    private void Say(ServiceResult result, string? fallback = null)
    {
        messageIsError = !result.Succeeded;
        message = result.Succeeded ? result.Message ?? fallback : string.Join(" ", result.Errors);
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- modules

    private void OpenStatus(TeacherModule module)
    {
        formErrors = [];
        statusModule = module;
        // the time it appears now (posted, or scheduled); a draft starts from tomorrow
        var suggestion = module.VisibleFromUtc ?? Clock.GetUtcNow().UtcDateTime.AddDays(1);
        scheduleText = PhilippineTime.ToInputValue(suggestion);
    }

    private void CloseStatus() => statusModule = null;

    private void ToggleStatus(TeacherModule module)
    {
        if (statusModule?.Id == module.Id)
        {
            CloseStatus();
        }
        else
        {
            OpenStatus(module);
        }
    }

    /// <summary>The Hide from students button of a row: the module goes back to a draft at once.</summary>
    private Task HideRowAsync(TeacherModule module)
    {
        statusModule = module;
        return HideStatusAsync();
    }

    private async Task PostStatusAsync()
    {
        if (statusModule is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.PostModuleAsync(teacherId, statusModule.Id, null);
            if (!result.Succeeded)
            {
