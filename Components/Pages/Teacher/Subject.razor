    // ---------------------------------------------------------------- items

    /// <summary>How far the class has got in a module (the average of the students; the ones who did not open it count 0): 50 for the slides, 50 for the module, and 100 for the module when it has no slides.</summary>
    private static (int Percent, string Text) ProgressOf(TeacherModule module) =>
        (module.Progress, module.HasSlides ? $"The class is at {module.Progress}% on average: half is the slides they saw, half is opening the handout" : $"The class is at {module.Progress}% on average: the handout, which has no slides, is all of it");

    /// <summary>"2 assignments · 1 quiz" under the title of a closed module.</summary>
    private static string ModuleSummary(TeacherModule module)
    {
        var parts = new List<string>();
        foreach (var kind in ItemKinds.Listed)
        {
            var count = module.Items.Count(i => i.Kind == kind);
            if (count > 0)
            {
                parts.Add($"{count} {(count == 1 ? ItemKinds.Display(kind).ToLowerInvariant() : ItemKinds.Plural(kind).ToLowerInvariant())}");
            }
        }

        return parts.Count == 0 ? "Nothing in it yet" : string.Join(" · ", parts);
    }

    /// <summary>The modules the Add menu offers (the syllabus has no assignments).</summary>
    private IReadOnlyList<AddMenuModule> AddMenuModules => subject is null ? [] :
        [.. subject.Modules.Where(m => !m.IsSyllabus).Select((m, n) => new AddMenuModule(m.Id, AddItemMenuLabels.ModuleLabel(n + 1, m.Title)))];

    // ---------------------------------------------------------------- Add quiz (the questions of a new quiz, in a sheet)

    private bool quizSheetOpen;
    private int quizModuleId;
    private string quizTitle = "";
    private IReadOnlyList<string> quizErrors = [];
    private static readonly IReadOnlyList<QuestionInput> noQuestions = [];

    private void OpenQuizSheet(int moduleId)
    {
        quizModuleId = SheetModules.Any(m => m.Id == moduleId) ? moduleId : SheetModules.Count == 1 ? SheetModules[0].Id : 0;
        quizTitle = "";
        quizErrors = [];
        quizSheetOpen = true;
    }

    private void CloseQuizSheet()
    {
        quizSheetOpen = false;
        quizErrors = [];
    }

    /// <summary>A new quiz and its questions in one step: the quiz is made in the handout, then the questions are written; when they can't be, the quiz is taken out again.</summary>
    private async Task SaveQuizAsync(IReadOnlyList<QuestionInput> questions)
    {
        if (busy)
        {
            return;
        }

        var title = quizTitle.Trim();
        if (quizModuleId == 0 || title.Length == 0)
        {
            quizErrors = [quizModuleId == 0 ? "Choose the handout of the quiz." : "Write the title of the quiz."];
            return;
        }

        busy = true;
        quizErrors = [];
        try
        {
            var made = await Modules.SaveItemAsync(teacherId, quizModuleId, null, new ItemInput { Kind = ItemKinds.Quiz, Title = title, MaxScore = questions.Sum(q => q.Points) });
            if (!made.Succeeded || made.Id is not { } quizId)
            {
                quizErrors = [.. made.Errors];
                return;
            }

            var written = await Modules.SaveQuestionsAsync(teacherId, quizId, questions);
            if (!written.Succeeded)
            {
                await Modules.DeleteItemAsync(teacherId, quizId);
                quizErrors = [.. written.Errors];
                return;
            }

            quizSheetOpen = false;
            message = $"The quiz {title} was added with {(questions.Count == 1 ? "1 question" : $"{questions.Count} questions")}.";
            messageIsError = false;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PickNew(AddMenuPick pick)
    {
        if (pick.Kind == AddItemMenuLabels.ExcelKind && pick.ModuleId == 0)
        {
            // "Add activities" at the top of the course: the sheet, not tied to one module.
            await OpenActivitiesAsync();
            return;
        }

        if (pick.Kind == ItemKinds.Quiz && pick.ModuleId == 0)
        {
            // "Add quiz" at the top of the course: the questions in a sheet; the handout is chosen inside it.
            OpenQuizSheet(0);
            return;
        }

        if (subject?.Modules.FirstOrDefault(m => m.Id == pick.ModuleId) is { } module)
        {
            if (pick.Kind == AddItemMenuLabels.ExcelKind)
            {
                await OpenActivitiesAsync(module.Id);
            }
            else if (pick.Kind == ItemKinds.Quiz)
            {
                // A quiz is made by writing its questions.
                OpenQuizSheet(module.Id);
            }
            else
            {
                OpenNewItem(module, pick.Kind);
            }
        }
    }

    private void OpenNewItem(TeacherModule module, string kind)
    {
        formErrors = [];
        editingItemId = null;
        itemModuleId = module.Id;
        itemFormKey++;
        itemForm = new ItemForm { Kind = kind, MaxScore = kind == ItemKinds.TaskPerformance ? 100 : 50 };
    }

    private async Task OpenEditItem(TeacherModule module, TeacherItem item)
    {
        if (module.FromProvider)
        {
            await Modules.MarkDeliveryOpenedAsync(teacherId, module.Id);
        }

        formErrors = [];
        editingItemId = item.Id;
        itemModuleId = module.Id;
        itemFormKey++;
        itemForm = new ItemForm
        {
            Kind = item.Kind, Title = item.Title, Instructions = item.Instructions, MaxScore = item.MaxScore,
            DueText = PhilippineTime.ToInputValue(item.DueAtUtc), VisibleText = PhilippineTime.ToInputValue(item.VisibleFromUtc),
            TimeLimit = item.TimeLimitMinutes, ShuffleQuestions = item.ShuffleQuestions, ShuffleOptions = item.ShuffleOptions,
            AntiCheat = item.AntiCheat, MaxViolations = item.MaxViolations, ShowResult = item.ShowResult,
        };
    }

    private void CloseItemForm() => itemForm = null;

    // The date boxes are written out (not @bind) because their text is converted by PhilippineTime, not by Blazor.
    private void SetDue(ChangeEventArgs e) => itemForm!.DueText = e.Value?.ToString() ?? "";

    private void SetVisible(ChangeEventArgs e) => itemForm!.VisibleText = e.Value?.ToString() ?? "";

    private void SetSchedule(ChangeEventArgs e) => scheduleText = e.Value?.ToString() ?? "";

    private async Task SaveItemAsync()
    {
        if (itemForm is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var input = new ItemInput
            {
                Kind = itemForm.Kind, Title = itemForm.Title, Instructions = itemForm.Instructions, MaxScore = itemForm.MaxScore,
                DueAtUtc = PhilippineTime.FromInputValue(itemForm.DueText), VisibleFromUtc = PhilippineTime.FromInputValue(itemForm.VisibleText),
                TimeLimitMinutes = itemForm.TimeLimit, ShuffleQuestions = itemForm.ShuffleQuestions, ShuffleOptions = itemForm.ShuffleOptions,
                AntiCheat = itemForm.AntiCheat, MaxViolations = itemForm.MaxViolations, ShowResult = itemForm.ShowResult,
            };
            var wasNew = editingItemId is null;
            var quizIsAFile = QuizIsAFile;
            var result = await Modules.SaveItemAsync(teacherId, itemModuleId, editingItemId, input);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            var fileProblems = result.Id is { } savedItemId ? await ApplyFilesAsync(itemPicker, new AttachmentOwner(AttachmentOwnerKind.Item, savedItemId)) : [];
            itemForm = null;
            if (wasNew && input.Kind == ItemKinds.Quiz && !quizIsAFile && result.Id is { } quizId && fileProblems.Count == 0)
            {
                Navigation.NavigateTo($"teacher/items/{quizId}/questions");
                return;
            }

            Say(result);
            if (fileProblems.Count > 0)
            {
                messageIsError = true;
                message = $"{result.Message} But the files: {string.Join(" ", fileProblems)}";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- delete

    private void AskDeleteItem(TeacherItem item)
    {
        var handed = item.Submitted;
        deleteTarget = new DeleteTarget($"Delete this {ItemKinds.Display(item.Kind).ToLowerInvariant()}?",
            handed == 0
                ? $"\"{item.Title}\" will be deleted."
                : $"\"{item.Title}\" will be deleted with the {handed} {(handed == 1 ? "answer" : "answers")} the students handed in and their scores.",
            item.Id);
    }

    private void CloseDelete() => deleteTarget = null;

    private async Task DeleteAsync()
    {
        if (deleteTarget is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.DeleteItemAsync(teacherId, deleteTarget.Id);
            deleteTarget = null;
            Say(result);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
