@page "/teacher/subjects/{AssignmentId:int}"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ModuleService Modules
@inject AttachmentService Files
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>@(subject is null ? "Course" : $"{subject.SubjectName} · {subject.SectionLabel}") · SEAITT Legazpi LMS</PageTitle>

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (subject is null)
{
    <Card>
        <EmptyState IconName="book-open" Title="Course not found" IsPage="true">
            <p>This course is not one of yours, or it was removed.</p>
            <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Secondary">Back to your courses</ButtonLink>
        </EmptyState>
    </Card>
}
else
{
    @* Two sections can have the same course, so the section is part of the title. *@
    <PageHeader Title="@($"{subject.SubjectName} · {subject.SectionLabel}")"
                IconName="book-open">
        <ButtonLink Href="teacher/subjects" Variant="ButtonVariant.Ghost" IconName="chevron-left">All courses</ButtonLink>
        <AddItemMenu Modules="AddMenuModules" OnPick="PickNew" />
    </PageHeader>

    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    @* The second menu of the course (modules, assignments, quizzes, task performances) next to its content. *@
    <CourseLayout PageHref="@($"teacher/subjects/{AssignmentId}")" Selected="@(shownKind is null ? "" : CourseMenu.KeyOf(shownKind))" ModuleCount="@subject.Modules.Count(m => !m.IsSyllabus)" Counts="KindCounts" Extra="MenuLinks">
    @if (shownKind is { } listKind)
    {
        <Card Title="@ItemKinds.Plural(listKind)" IconName="@SubjectStyle.KindIcon(listKind)">
            @{
                var listed = subject.Modules.Where(m => !m.IsSyllabus || m.Items.Any(i => i.Kind == listKind))
                    .SelectMany(m => m.Items.Where(i => i.Kind == listKind).Select(i => (Module: m, Item: i))).ToList();
            }
            <div class="kind-head">
                <p class="muted">@(listed.Count == 0 ? $"No {ItemKinds.Plural(listKind).ToLowerInvariant()} in this course yet." : $"All the {ItemKinds.Plural(listKind).ToLowerInvariant()} of the course, module by module.")</p>
                <AddItemMenu Kind="@listKind" Label="@($"Add {ItemKinds.Display(listKind).ToLowerInvariant()}")" Modules="AddMenuModules" OnPick="PickNew" />
            </div>
            @if (listed.Count > 0)
            {
                <ul class="items kind-list">
                    @foreach (var (module, item) in listed)
                    {
                        <li class="item">
                            <div class="item-main">
                                <a class="item-title" href="teacher/items/@item.Id">@item.Title</a>
                                <div class="item-meta">
                                    <span><Icon Name="layers" Size="14" /> @module.Title</span>
                                    @if (item.DueAtUtc is { } listDue)
                                    {
                                        <span><Icon Name="calendar-clock" Size="14" /> Due @PhilippineTime.FormatDateTime(listDue)</span>
                                    }
                                    else
                                    {
                                        <span>No due date</span>
                                    }
                                    <span>@item.MaxScore.ToString("0.##") points</span>
                                    <Badge Tone="@(module.State == Visibility.Posted ? Tone.Success : module.State == Visibility.Scheduled ? Tone.Warning : Tone.Neutral)">@(module.State == Visibility.Draft ? "Draft module" : module.State == Visibility.Scheduled ? "Module scheduled" : "Posted")</Badge>
                                </div>
                            </div>
                            <div class="item-side">
                                <span class="handed" title="Handed in of the students in this course">@item.Submitted / @item.Students handed in</span>
                                @if (item.Kind != ItemKinds.Quiz && item.Submitted - item.Graded > 0)
                                {
                                    <Badge Tone="Tone.Warning">@(item.Submitted - item.Graded) to check</Badge>
                                }
                            </div>
                            <div class="item-actions">
                                <ButtonLink Href="@($"teacher/items/{item.Id}")" Variant="ButtonVariant.Secondary" Small="true" IconName="eye">Open</ButtonLink>
                                <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="pencil" Title="Edit" OnClick="() => OpenEditItem(module, item)" />
                                <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="trash-2" Title="Delete" OnClick="() => AskDeleteItem(item)" />
                            </div>
                        </li>
                    }
                </ul>
            }
        </Card>
    }
    else
    {
    <p class="hint-line">
        <Icon Name="eye-off" Size="16" />
        <span>The modules the academic provider sends you are <strong>drafts</strong>: students can't see them until you post them. Change the text and the due dates, then post a module now, or schedule the time it appears.</span>
    </p>

    @if (subject.Modules.Count == 0)
    {
        <Card>
            <EmptyState IconName="layers" Title="No modules yet">
                <p>A module is a lesson with its assignments, quizzes and task performances. The academic provider sends the modules of this course.</p>
            </EmptyState>
        </Card>
    }
    else
    {
        <div class="modules">
            @for (var n = 0; n < subject.Modules.Count; n++)
            {
                var module = subject.Modules[n];
                var number = subject.Modules.Take(n + 1).Count(m => !m.IsSyllabus);
                var moduleId = module.Id;
                var isOpen = openModules.Contains(moduleId);
                <section class="module @module.State.ToLowerInvariant() @(isOpen ? "open" : "")" aria-label="@(module.IsSyllabus ? "Syllabus" : $"Module {number}")">
                    @* A click on the title opens the syllabus or the module: its text, its files and its assignments, quizzes and task performances. *@
                    <header class="module-head">
                        <button type="button" class="module-toggle" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@($"module-{moduleId}")" @onclick="() => ToggleModule(moduleId)">
                            <span class="chevron" aria-hidden="true"><Icon Name="@(isOpen ? "chevron-down" : "chevron-right")" Size="18" /></span>
                            <span class="module-number">@if (module.IsSyllabus) { <Icon Name="book-marked" Size="18" /> } else { @number }</span>
                            <span class="module-heading">
                                <span class="module-name">@module.Title</span>
                                <span class="module-state">
                                    @if (module.IsSyllabus)
                                    {
                                        <Badge Tone="Tone.Info">Syllabus</Badge>
                                    }
                                    @if (module.FromProvider)
                                    {
                                        <Badge Tone="Tone.Info">From the academic provider</Badge>
                                    }
                                    @if (module.State == Visibility.Posted)
                                    {
                                        <Badge Tone="Tone.Success">Posted @PhilippineTime.FormatDate(module.VisibleFromUtc!.Value)</Badge>
                                    }
                                    else if (module.State == Visibility.Scheduled)
                                    {
                                        <Badge Tone="Tone.Warning">Scheduled for @PhilippineTime.FormatDateTime(module.VisibleFromUtc!.Value)</Badge>
                                    }
                                    else
                                    {
                                        <Badge>Draft · hidden from students</Badge>
                                    }
                                    @if (!module.IsSyllabus)
                                    {
                                        <span class="count-chip">@ModuleSummary(module)</span>
                                    }
                                </span>
                            </span>
                        </button>

                        <div class="module-actions">
                            @if (module.State != Visibility.Posted)
                            {
                                <Button Small="true" IconName="send" OnClick="() => PostNowAsync(module)">Post now</Button>
                                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="calendar-clock" OnClick="() => OpenSchedule(module)">@(module.State == Visibility.Scheduled ? "Change time" : "Schedule")</Button>
                            }

                            @if (module.State != Visibility.Draft)
                            {
                                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="eye-off" OnClick="() => HideAsync(module)">Hide</Button>
                            }

                            <ButtonLink Small="true" Variant="ButtonVariant.Secondary" IconName="book-open" Href="@($"teacher/subjects/{AssignmentId}/modules/{module.Id}")">Open</ButtonLink>
                            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" OnClick="() => OpenEditModule(module)">Edit</Button>
                        </div>
                    </header>

                    @if (isOpen)
                    {
                    <div class="module-body" id="@($"module-{moduleId}")">
                    @if (!string.IsNullOrWhiteSpace(module.Description))
                    {
                        <p class="module-description">@module.Description</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(module.Body) || !string.IsNullOrWhiteSpace(module.LinkUrl))
                    {
                        <p class="module-lesson">
                            <Icon Name="file-text" Size="16" />
                            @if (!string.IsNullOrWhiteSpace(module.Body))
                            {
                                <span>Lesson text (@module.Body.Length.ToString("N0") characters)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(module.LinkUrl))
                            {
                                <a href="@module.LinkUrl" target="_blank" rel="noopener noreferrer"><Icon Name="link" Size="14" /> Link</a>
                            }
                        </p>
                    }

                    @{
                        var allModuleFiles = FilesOf(moduleFiles, module.Id);
                    }
                    <AttachmentList Items="allModuleFiles.Where(f => !f.IsSlides).ToList()" PageHref="@(f => ReaderHref(module.Id, f))" Label="@($"Files of {module.Title}")" />
                    @if (allModuleFiles.Any(f => f.IsSlides))
                    {
                        <h3 class="slides-title"><Icon Name="presentation" Size="16" /> Slides</h3>
                        <AttachmentList Items="allModuleFiles.Where(f => f.IsSlides).ToList()" PageHref="@(f => ReaderHref(module.Id, f))" Label="@($"Slides of {module.Title}")" />
                    }

                    <div class="groups">
                        @foreach (var kind in ItemKinds.Listed.Where(k => k == ItemKinds.Exam ? module.Items.Any(i => i.Kind == k) : !module.IsSyllabus || module.Items.Any(i => i.Kind == k)))
                        {
                            var items = module.Items.Where(i => i.Kind == kind).ToList();
                            <div class="group">
                                <div class="group-head">
                                    <h3><Icon Name="@SubjectStyle.KindIcon(kind)" Size="18" /> @ItemKinds.Plural(kind) <span class="count">@items.Count</span></h3>
                                    <span class="group-actions">
                                        <Button Small="true" Variant="ButtonVariant.Ghost" IconName="file-spreadsheet" Title="Template, import and export in Excel" OnClick="() => OpenExcel(module, kind)">Excel</Button>
                                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => OpenNewItem(module, kind)">Add @ItemKinds.Display(kind).ToLowerInvariant()</Button>
                                    </span>
                                </div>

                                @if (items.Count == 0)
                                {
                                    <p class="none">None yet.</p>
                                }
                                else
                                {
                                    <ul class="items">
                                        @foreach (var item in items)
                                        {
                                            <li class="item">
                                                <div class="item-main">
                                                    <a class="item-title" href="teacher/items/@item.Id">@item.Title</a>
                                                    <div class="item-meta">
                                                        @if (item.DueAtUtc is { } due)
                                                        {
                                                            <span title="@PhilippineTime.FormatDateTime(due)"><Icon Name="calendar-clock" Size="14" /> Due @PhilippineTime.FormatDateTime(due)</span>
                                                        }
                                                        else
                                                        {
                                                            <span>No due date</span>
                                                        }
                                                        <span>@item.MaxScore.ToString("0.##") points</span>
                                                        @if (item.Kind == ItemKinds.Quiz && IsFileQuiz(item))
                                                        {
                                                            <span><Icon Name="file-text" Size="14" /> File quiz · no questions</span>
                                                        }
                                                        else if (item.Kind == ItemKinds.Quiz)
                                                        {
                                                            <span>@item.Questions @(item.Questions == 1 ? "question" : "questions")</span>
                                                            @if (item.TimeLimitMinutes is { } minutes)
                                                            {
                                                                <span><Icon Name="timer" Size="14" /> @minutes min</span>
                                                            }
                                                            @if (item.AntiCheat)
                                                            {
                                                                <span title="Warns after @item.MaxViolations leaves of the quiz, copies, pastes, prints or screenshots"><Icon Name="shield-check" Size="14" /> Anti-cheat on</span>
                                                            }
                                                        }
                                                        @if (item.State == Visibility.Scheduled && item.VisibleFromUtc is { } appears)
                                                        {
                                                            <Badge Tone="Tone.Warning">Appears @PhilippineTime.FormatDateTime(appears)</Badge>
                                                        }
                                                    </div>
                                                    <AttachmentList Items="FilesOf(itemFiles, item.Id)" Label="@($"Files of {item.Title}")" />
                                                </div>
                                                <div class="item-side">
                                                    <span class="handed" title="Handed in of the students in this course">@item.Submitted / @item.Students handed in</span>
                                                    @if (item.Kind != ItemKinds.Quiz && item.Submitted - item.Graded > 0)
                                                    {
                                                        <Badge Tone="Tone.Warning">@(item.Submitted - item.Graded) to check</Badge>
                                                    }
                                                    @if (item.Flagged > 0)
                                                    {
                                                        <Badge Tone="Tone.Danger"><Icon Name="flag" Size="12" /> @item.Flagged flagged</Badge>
                                                    }
                                                </div>
                                                <div class="item-actions">
                                                    @if (item.Kind == ItemKinds.Quiz && !IsFileQuiz(item))
                                                    {
                                                        <ButtonLink Href="@($"teacher/items/{item.Id}/questions")" Variant="ButtonVariant.Secondary" Small="true" IconName="list-checks">Questions</ButtonLink>
                                                    }
                                                    <ButtonLink Href="@($"teacher/items/{item.Id}")" Variant="ButtonVariant.Secondary" Small="true" IconName="eye">Open</ButtonLink>
                                                    <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="pencil" Title="Edit" OnClick="() => OpenEditItem(module, item)" />
                                                    <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="trash-2" Title="Delete" OnClick="() => AskDeleteItem(item)" />
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                    </div>
                    }
                </section>
            }
        </div>
    }
    }
    </CourseLayout>
}

@* ===== Module: add or edit ===== *@
<Modal Open="editingModule is not null" Title="Edit module" OnClose="CloseModuleForm">
    @if (editingModule is not null)
    {
        <ModuleEditor @key="editingModule.Id" TeacherId="teacherId" Module="editingModule" Files="FilesOf(moduleFiles, editingModule.Id)" OnSaved="ModuleSavedAsync" OnCancel="CloseModuleForm" />
    }
</Modal>

@* ===== Item: add or edit ===== *@
<Modal Open="itemForm is not null" Title="@ItemModalTitle" OnClose="CloseItemForm" Large="true">
    @if (itemForm is not null)
    {
        <EditForm Model="itemForm" OnValidSubmit="SaveItemAsync">
            <FormErrors Errors="formErrors" />
            @if (editingItemId is null)
            {
                <p class="from-excel"><Button Small="true" Variant="ButtonVariant.Ghost" IconName="file-spreadsheet" OnClick="OpenExcelFromForm">Fill many from an Excel file instead</Button></p>
            }

            <Field For="i-title" Label="Title" Required="true">
                <InputText id="i-title" @bind-Value="itemForm.Title" maxlength="200" autocomplete="off" />
            </Field>
            <Field For="i-text" Label="Instructions">
                <InputTextArea id="i-text" @bind-Value="itemForm.Instructions" rows="5" />
            </Field>
            @if (itemForm.Kind != ItemKinds.Quiz || QuizIsAFile)
            {
                <Field For="i-score" Label="Highest score" Required="true">
                    <InputNumber id="i-score" @bind-Value="itemForm.MaxScore" />
                </Field>
            }
            <div class="two">
                <Field For="i-from" Label="Appears on" Hint="Leave empty to show it with its module.">
                    <input id="i-from" type="datetime-local" value="@itemForm.VisibleText" @onchange="SetVisible" />
                </Field>
                <Field For="i-due" Label="Due date" Hint="Philippine time. Leave empty for no due date.">
                    <input id="i-due" type="datetime-local" value="@itemForm.DueText" @onchange="SetDue" />
                </Field>
            </div>

            <AttachmentPicker @ref="itemPicker" @key="itemFormKey" Title="@(itemForm.Kind == ItemKinds.Quiz ? "File of the quiz (optional)" : "Files")" Existing="@FilesOf(itemFiles, editingItemId)" OnChanged="FilesChanged" />

            @if (itemForm.Kind == ItemKinds.Quiz)
            {
                @if (QuizIsAFile)
                {
                    <p class="file-quiz-note" role="status">
                        <Icon Name="file-text" Size="16" />
                        <span>This quiz is a <strong>file</strong>, so it has <strong>no questions</strong>. The students send their answers as a file and you give the score. Take the file off to write questions instead.</span>
                    </p>
                }

                <QuizSettings IdPrefix="i" Note="@(QuizIsAFile ? "The time limit and the anti-cheating watch only work for a quiz with questions." : "You write the questions after saving. The quiz is worth the total of the points of its questions.")"
                              @bind-TimeLimit="itemForm.TimeLimit" @bind-MaxViolations="itemForm.MaxViolations" @bind-AntiCheat="itemForm.AntiCheat"
                              @bind-ShuffleQuestions="itemForm.ShuffleQuestions" @bind-ShuffleOptions="itemForm.ShuffleOptions" @bind-ShowResult="itemForm.ShowResult" />
            }

            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseItemForm">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : itemForm.Kind == ItemKinds.Quiz && editingItemId is null && !QuizIsAFile ? "Save and write questions" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Excel: template, import, export of the assignments, quizzes or task performances of a module ===== *@
<ItemExcelDialog Open="excelModule is not null" Kind="@excelKind" ModuleTitle="@(excelModule?.Title ?? "")" Existing="ExcelExisting" OnImport="ImportItemsAsync" OnClose="CloseExcel" />
<ActivitiesExcelDialog Open="activitiesModule is not null" ModuleTitle="@(activitiesModule?.Title ?? "")" Existing="activitiesExisting" OnImport="ImportActivitiesAsync" OnClose="CloseActivities" />

@* ===== Schedule ===== *@
<Modal Open="scheduleModule is not null" Title="Schedule the module" OnClose="CloseSchedule">
    @if (scheduleModule is not null)
    {
        <p class="dialog-text"><strong>@scheduleModule.Title</strong> stays hidden until the time you choose, then appears for the students by itself and they are told.</p>
        <FormErrors Errors="formErrors" />
        <Field For="s-at" Label="Appears on" Required="true" Hint="Philippine time.">
            <input id="s-at" type="datetime-local" value="@scheduleText" @onchange="SetSchedule" />
        </Field>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseSchedule">Cancel</Button>
            <Button IconName="calendar-clock" Disabled="busy" OnClick="SaveScheduleAsync">Schedule</Button>
        </div>
    }
</Modal>

@* ===== Delete ===== *@
<Modal Open="deleteTarget is not null" Title="@(deleteTarget?.Title ?? "")" OnClose="CloseDelete">
    @if (deleteTarget is not null)
    {
        <p class="dialog-text">@deleteTarget.Text <strong>This can't be undone.</strong></p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="DeleteAsync">Delete</Button>
        </div>
    }
</Modal>

@code {
    private sealed class ItemForm
    {
        public string Kind { get; set; } = ItemKinds.Activity;
        public string Title { get; set; } = "";
        public string? Instructions { get; set; }
        public decimal MaxScore { get; set; } = 100;
        public string DueText { get; set; } = "";
        public string VisibleText { get; set; } = "";
        public int? TimeLimit { get; set; }
        public bool ShuffleQuestions { get; set; } = true;
        public bool ShuffleOptions { get; set; } = true;
        public bool AntiCheat { get; set; } = true;
        public int MaxViolations { get; set; } = 3;
        public bool ShowResult { get; set; } = true;
    }

    private sealed record DeleteTarget(string Title, string Text, int Id);

    [Parameter] public int AssignmentId { get; set; }

    /// <summary>The tab of the second menu: assignments, quizzes or tasks (the modules when empty).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string? shownKind => CourseMenu.KindOfKey(Tab);

    private IReadOnlyDictionary<string, int> KindCounts => ItemKinds.Listed.ToDictionary(k => k, k => subject?.Modules.Sum(m => m.Items.Count(i => i.Kind == k)) ?? 0);

    private IReadOnlyList<CourseMenuLink> MenuLinks =>
    [
        new("Gradebook", "clipboard-list", $"teacher/gradebook?subject={AssignmentId}"),
        new("Attendance", "calendar-check", $"teacher/attendance?subject={AssignmentId}"),
    ];

    private int teacherId;
    private bool loaded;
    private TeacherSubject? subject;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    private TeacherModule? editingModule;

    private ItemForm? itemForm;
    private int? editingItemId;
    private int itemModuleId;

    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> moduleFiles = new Dictionary<int, IReadOnlyList<AttachmentRow>>();
    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> itemFiles = new Dictionary<int, IReadOnlyList<AttachmentRow>>();
    private AttachmentPicker? itemPicker;
    private int itemFormKey;

    private TeacherModule? scheduleModule;
    private string scheduleText = "";

    private DeleteTarget? deleteTarget;

    /// <summary>A quiz that has a file has no questions: the students answer with a file and the teacher gives the score.</summary>
    private bool QuizIsAFile => itemForm?.Kind == ItemKinds.Quiz && (itemPicker?.HasFiles ?? FilesOf(itemFiles, editingItemId).Count > 0);

    private void FilesChanged() { }

    /// <summary>The page where the module is read inside the system, with the file pressed shown (a file the browser can't show is saved instead).</summary>
    private string? ReaderHref(int moduleId, AttachmentRow file) => file.CanPreview ? $"teacher/subjects/{AssignmentId}/modules/{moduleId}?file={file.Id}" : null;

    // ---------------------------------------------------------------- Excel

    private TeacherModule? excelModule;
    private string excelKind = ItemKinds.Activity;

    private IReadOnlyList<ItemExportRow> ExcelExisting => excelModule is null ? [] :
        [.. excelModule.Items.Where(i => i.Kind == excelKind).Select(i => new ItemExportRow(i.Title, i.Instructions, i.MaxScore, i.VisibleFromUtc, i.DueAtUtc, i.TimeLimitMinutes))];

    private void OpenExcel(TeacherModule module, string kind)
    {
        excelModule = module;
        excelKind = kind;
    }

    private void CloseExcel() => excelModule = null;

    // ---- the workbook of activities (assignments, quizzes with their questions, task performances) of a module

    private TeacherModule? activitiesModule;
    private IReadOnlyList<ActivityExportItem> activitiesExisting = [];

    private async Task OpenActivitiesAsync(TeacherModule module)
    {
        var list = new List<ActivityExportItem>();
        foreach (var i in module.Items.Where(i => ItemKinds.All.Contains(i.Kind)))
        {
            var questions = i.Kind == ItemKinds.Quiz ? await Modules.GetQuestionsAsync(teacherId, i.Id) ?? [] : [];
            list.Add(new ActivityExportItem(i.Kind, new ItemExportRow(i.Title, i.Instructions, i.MaxScore, i.VisibleFromUtc, i.DueAtUtc, i.TimeLimitMinutes), questions, [.. FilesOf(itemFiles, i.Id).Select(f => f.Name)]));
        }

        activitiesExisting = list;
        activitiesModule = module;
    }

    private void CloseActivities() => activitiesModule = null;

    /// <summary>Every row of the workbook is saved like the box saves one item, so the same rules hold; the questions of a quiz and the files follow it.</summary>
    private async Task<ItemImportSummary> ImportActivitiesAsync(IReadOnlyList<ActivityToSave> list)
    {
        var moduleId = activitiesModule?.Id ?? 0;
        var userId = await UserIdAsync();
        var summary = await ActivityImport.RunAsync(list,
            input => Modules.SaveItemAsync(teacherId, moduleId, null, input),
            (id, questions) => Modules.SaveQuestionsAsync(teacherId, id, questions),
            (id, files) => Files.AddAsync(userId, new AttachmentOwner(AttachmentOwnerKind.Item, id), files));
        if (moduleId != 0)
        {
            openModules.Add(moduleId);
        }

        await LoadAsync();
        return summary;
    }

    private void OpenExcelFromForm()
    {
        if (itemForm is null || subject?.Modules.FirstOrDefault(m => m.Id == itemModuleId) is not { } module)
        {
            return;
        }

        var kind = itemForm.Kind;
        itemForm = null;
        OpenExcel(module, kind);
    }

    /// <summary>Every row of the Excel file is saved like the box saves one item, so the same rules hold (title, score, dates).</summary>
    private async Task<ItemImportSummary> ImportItemsAsync(IReadOnlyList<ItemInput> inputs)
    {
        var moduleId = excelModule?.Id ?? 0;
        var created = 0;
        var problems = new List<string>();
        foreach (var input in inputs)
        {
            var saved = await Modules.SaveItemAsync(teacherId, moduleId, null, input);
            if (saved.Succeeded)
            {
                created++;
            }
            else
            {
                problems.Add($"{input.Title}: {string.Join(" ", saved.Errors)}");
            }
        }

        if (moduleId != 0)
        {
            openModules.Add(moduleId);
        }

        await LoadAsync();
        return new ItemImportSummary(created, problems);
    }

    /// <summary>A quiz that has a file and no questions: the students answer with a file, so there is no question editor for it.</summary>
    private bool IsFileQuiz(TeacherItem item) => item.Kind == ItemKinds.Quiz && item.Questions == 0 && FilesOf(itemFiles, item.Id).Count > 0;

    private string ItemModalTitle => itemForm is null ? "" : editingItemId is null ? $"Add {ItemKinds.Display(itemForm.Kind).ToLowerInvariant()}" : $"Edit {ItemKinds.Display(itemForm.Kind).ToLowerInvariant()}";

    protected override async Task OnParametersSetAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        subject = teacherId == 0 ? null : await Modules.GetTeacherSubjectAsync(teacherId, AssignmentId);
        var all = subject?.Modules ?? [];
        moduleFiles = await Files.ListForAsync(AttachmentOwnerKind.Module, all.Select(m => m.Id).ToList());
        itemFiles = await Files.ListForAsync(AttachmentOwnerKind.Item, all.SelectMany(m => m.Items).Select(i => i.Id).ToList());
    }

    private static IReadOnlyList<AttachmentRow> FilesOf(IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> map, int? id) =>
        id is { } key && map.TryGetValue(key, out var list) ? list : [];

    /// <summary>Saves the files chosen in a form for the module or item with this number: new ones are attached, the ones taken off are removed. Returns what went wrong.</summary>
    private async Task<List<string>> ApplyFilesAsync(AttachmentPicker? picker, AttachmentOwner owner, bool slides = false)
    {
        var problems = new List<string>();
        if (picker is null)
        {
            return problems;
        }

        var removed = await Files.RemoveAsync(await UserIdAsync(), [.. picker.Removed]);
        if (!removed.Succeeded)
        {
            problems.AddRange(removed.Errors);
        }

        var added = await Files.AddAsync(await UserIdAsync(), owner, picker.Pending, slides: slides);
        if (!added.Succeeded)
        {
            problems.AddRange(added.Errors);
        }

        return problems;
    }

    private async Task<int> UserIdAsync() => (await Me.GetAsync())?.UserId ?? 0;

    private void Say(ServiceResult result, string? fallback = null)
    {
        messageIsError = !result.Succeeded;
        message = result.Succeeded ? result.Message ?? fallback : string.Join(" ", result.Errors);
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- modules

    private async Task OpenEditModule(TeacherModule module)
    {
        if (module.FromProvider)
        {
            await Modules.MarkDeliveryOpenedAsync(teacherId, module.Id);
        }

        formErrors = [];
        editingModule = module;
    }

    private void CloseModuleForm() => editingModule = null;

    private async Task ModuleSavedAsync(ModuleEditor.EditorResult result)
    {
        editingModule = null;
        messageIsError = !result.Ok;
        message = result.Message;
        await LoadAsync();
    }

    private async Task PostNowAsync(TeacherModule module)
    {
        Say(await Modules.PostModuleAsync(teacherId, module.Id, null));
        await LoadAsync();
    }

    private async Task HideAsync(TeacherModule module)
    {
        Say(await Modules.HideModuleAsync(teacherId, module.Id));
        await LoadAsync();
    }

    private void OpenSchedule(TeacherModule module)
    {
        formErrors = [];
        scheduleModule = module;
        var suggestion = module.VisibleFromUtc is { } at && at > Clock.GetUtcNow().UtcDateTime
            ? at
            : Clock.GetUtcNow().UtcDateTime.AddDays(1);
        scheduleText = PhilippineTime.ToInputValue(suggestion);
    }

    private void CloseSchedule() => scheduleModule = null;

    private async Task SaveScheduleAsync()
    {
        if (scheduleModule is null || busy)
        {
            return;
        }

        var at = PhilippineTime.FromInputValue(scheduleText);
        if (at is null || at <= Clock.GetUtcNow().UtcDateTime.AddMinutes(1))
        {
            formErrors = ["Pick a date and time in the future."];
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.PostModuleAsync(teacherId, scheduleModule.Id, at);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            scheduleModule = null;
            Say(result);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- items

    private readonly HashSet<int> openModules = [];

    private void ToggleModule(int id)
    {
        if (!openModules.Remove(id))
        {
            openModules.Add(id);
        }
    }

    /// <summary>"2 assignments · 1 quiz" under the title of a closed module.</summary>
    private static string ModuleSummary(TeacherModule module)
    {
        var parts = new List<string>();
        foreach (var kind in ItemKinds.Listed)
        {
            var count = module.Items.Count(i => i.Kind == kind);
            if (count > 0)
            {
                parts.Add($"{count} {(count == 1 ? ItemKinds.Display(kind).ToLowerInvariant() : ItemKinds.Plural(kind).ToLowerInvariant())}");
            }
        }

        return parts.Count == 0 ? "Nothing in it yet" : string.Join(" · ", parts);
    }

    /// <summary>The modules the Add menu offers (the syllabus has no assignments).</summary>
    private IReadOnlyList<AddMenuModule> AddMenuModules => subject is null ? [] :
        [.. subject.Modules.Where(m => !m.IsSyllabus).Select((m, n) => new AddMenuModule(m.Id, AddItemMenuLabels.ModuleLabel(n + 1, m.Title)))];

    private async Task PickNew(AddMenuPick pick)
    {
        if (subject?.Modules.FirstOrDefault(m => m.Id == pick.ModuleId) is { } module)
        {
            if (pick.Kind == AddItemMenuLabels.ExcelKind)
            {
                await OpenActivitiesAsync(module);
            }
            else
            {
                OpenNewItem(module, pick.Kind);
            }
        }
    }

    private void OpenNewItem(TeacherModule module, string kind)
    {
        openModules.Add(module.Id);
        formErrors = [];
        editingItemId = null;
        itemModuleId = module.Id;
        itemFormKey++;
        itemForm = new ItemForm { Kind = kind, MaxScore = kind == ItemKinds.TaskPerformance ? 100 : 50 };
    }

    private async Task OpenEditItem(TeacherModule module, TeacherItem item)
    {
        if (module.FromProvider)
        {
            await Modules.MarkDeliveryOpenedAsync(teacherId, module.Id);
        }

        formErrors = [];
        editingItemId = item.Id;
        itemModuleId = module.Id;
        itemFormKey++;
        itemForm = new ItemForm
        {
            Kind = item.Kind, Title = item.Title, Instructions = item.Instructions, MaxScore = item.MaxScore,
            DueText = PhilippineTime.ToInputValue(item.DueAtUtc), VisibleText = PhilippineTime.ToInputValue(item.VisibleFromUtc),
            TimeLimit = item.TimeLimitMinutes, ShuffleQuestions = item.ShuffleQuestions, ShuffleOptions = item.ShuffleOptions,
            AntiCheat = item.AntiCheat, MaxViolations = item.MaxViolations, ShowResult = item.ShowResult,
        };
    }

    private void CloseItemForm() => itemForm = null;

    // The date boxes are written out (not @bind) because their text is converted by PhilippineTime, not by Blazor.
    private void SetDue(ChangeEventArgs e) => itemForm!.DueText = e.Value?.ToString() ?? "";

    private void SetVisible(ChangeEventArgs e) => itemForm!.VisibleText = e.Value?.ToString() ?? "";

    private void SetSchedule(ChangeEventArgs e) => scheduleText = e.Value?.ToString() ?? "";

    private async Task SaveItemAsync()
    {
        if (itemForm is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var input = new ItemInput
            {
                Kind = itemForm.Kind, Title = itemForm.Title, Instructions = itemForm.Instructions, MaxScore = itemForm.MaxScore,
                DueAtUtc = PhilippineTime.FromInputValue(itemForm.DueText), VisibleFromUtc = PhilippineTime.FromInputValue(itemForm.VisibleText),
                TimeLimitMinutes = itemForm.TimeLimit, ShuffleQuestions = itemForm.ShuffleQuestions, ShuffleOptions = itemForm.ShuffleOptions,
                AntiCheat = itemForm.AntiCheat, MaxViolations = itemForm.MaxViolations, ShowResult = itemForm.ShowResult,
            };
            var wasNew = editingItemId is null;
            var quizIsAFile = QuizIsAFile;
            var result = await Modules.SaveItemAsync(teacherId, itemModuleId, editingItemId, input);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            var fileProblems = result.Id is { } savedItemId ? await ApplyFilesAsync(itemPicker, new AttachmentOwner(AttachmentOwnerKind.Item, savedItemId)) : [];
            itemForm = null;
            if (wasNew && input.Kind == ItemKinds.Quiz && !quizIsAFile && result.Id is { } quizId && fileProblems.Count == 0)
            {
                Navigation.NavigateTo($"teacher/items/{quizId}/questions");
                return;
            }

            Say(result);
            if (fileProblems.Count > 0)
            {
                messageIsError = true;
                message = $"{result.Message} But the files: {string.Join(" ", fileProblems)}";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- delete

    private void AskDeleteItem(TeacherItem item)
    {
        var handed = item.Submitted;
        deleteTarget = new DeleteTarget($"Delete this {ItemKinds.Display(item.Kind).ToLowerInvariant()}?",
            handed == 0
                ? $"\"{item.Title}\" will be deleted."
                : $"\"{item.Title}\" will be deleted with the {handed} {(handed == 1 ? "answer" : "answers")} the students handed in and their scores.",
            item.Id);
    }

    private void CloseDelete() => deleteTarget = null;

    private async Task DeleteAsync()
    {
        if (deleteTarget is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Modules.DeleteItemAsync(teacherId, deleteTarget.Id);
            deleteTarget = null;
            Say(result);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
