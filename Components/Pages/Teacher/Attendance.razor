@page "/teacher/attendance"
@attribute [Authorize(Roles = AppRoles.Teacher)]
@rendermode InteractiveServer
@using System.Globalization
@inject CurrentUser Me
@inject TeachingService Teaching
@inject AttendanceService AttendanceBook
@inject TimeProvider Clock

<PageTitle>Attendance · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Attendance" IconName="calendar-check" />

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (subjects.Count == 0)
{
    <Card>
        <EmptyState IconName="book-open" Title="No courses yet">
            <p>The administrator gives each teacher their courses. Attendance can be taken once you have one.</p>
        </EmptyState>
    </Card>
}
else
{
    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    <Card Title="Mark attendance" IconName="user-check">
        <div class="pick">
            <Field For="a-subject" Label="Course">
                <select id="a-subject" value="@subjectId" @onchange="SubjectChanged">
                    @foreach (var s in subjects)
                    {
                        <option value="@s.AssignmentId" selected="@(s.AssignmentId == subjectId)">@s.SubjectName · @s.SectionLabel</option>
                    }
                </select>
            </Field>
            <Field For="a-date" Label="Date">
                <input id="a-date" type="date" value="@date.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" @onchange="DateChanged" />
            </Field>
        </div>

        @if (sheet is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (sheet.Rows.Count == 0)
        {
            <EmptyState IconName="users" Title="No students in this course yet">
                <p>Students appear here once the registrar has enrolled them in this section with this course.</p>
            </EmptyState>
        }
        else
        {
            <div class="sheet-head">
                <span class="sheet-date">@PhilippineTime.FormatLongDate(new DateTimeOffset(date.ToDateTime(TimeOnly.MinValue), TimeSpan.FromHours(8)))@(sheet.Saved ? " · saved before" : "")</span>
                <span class="tally" aria-live="polite">
                    <Badge Tone="Tone.Success">@Count(AttendanceStatus.Present) present</Badge>
                    <Badge Tone="Tone.Warning">@Count(AttendanceStatus.Late) late</Badge>
                    <Badge Tone="Tone.Danger">@Count(AttendanceStatus.Absent) absent</Badge>
                    @if (Unmarked > 0) { <Badge>@Unmarked not marked</Badge> }
                </span>
                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="check-check" OnClick="MarkAllPresent">Mark all present</Button>
            </div>

            <ul class="students">
                @foreach (var row in sheet.Rows)
                {
                    var student = row;
                    var current = marks.GetValueOrDefault(student.StudentId);
                    <li>
                        <div class="who">
                            <Avatar Name="@student.Name" Size="34" />
                            <div><span class="name">@student.Name</span><span class="sub">@student.Lrn</span></div>
                        </div>
                        <div class="choices" role="radiogroup" aria-label="@($"Attendance of {student.Name}")">
                            @foreach (var status in AttendanceStatus.All)
                            {
                                var choice = status;
                                <button type="button" role="radio" aria-checked="@(current == choice ? "true" : "false")" class="choice @choice.ToLowerInvariant() @(current == choice ? "on" : "")" @onclick="() => Mark(student.StudentId, choice)">@choice</button>
                            }
                        </div>
                    </li>
                }
            </ul>

            <FormErrors Errors="formErrors" />
            <div class="actions">
                <Button IconName="circle-check" Disabled="@(busy || marks.Count == 0)" OnClick="SaveAsync">@(busy ? "Saving…" : "Save attendance")</Button>
            </div>
        }
    </Card>

    <Card Title="Attendance summary" IconName="chart-column">
        @if (summary is null || summary.Rows.Count == 0)
        {
            <p class="muted">No students yet.</p>
        }
        else if (summary.DaysRecorded == 0)
        {
            <p class="muted">Nothing was marked yet. The summary appears after the first day is saved.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Student</th>
                            <th scope="col" class="num">Present</th>
                            <th scope="col" class="num">Late</th>
                            <th scope="col" class="num">Absent</th>
                            <th scope="col" class="num">Attendance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in summary.Rows)
                        {
                            <tr>
                                <td>@r.Name</td>
                                <td class="num">@r.Present</td>
                                <td class="num">@r.Late</td>
                                <td class="num">@r.Absent</td>
                                <td class="num">@if (r.Percent is { } p) { <Badge Tone="@(p < AttendanceService.LowAttendancePercent ? Tone.Danger : p < 90 ? Tone.Warning : Tone.Success)">@p.ToString("0.#")%</Badge> } else { <span class="muted">—</span> }</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">Class (@summary.DaysRecorded @(summary.DaysRecorded == 1 ? "day" : "days") marked)</th>
                            <td class="num">@summary.Rows.Sum(r => r.Present)</td>
                            <td class="num">@summary.Rows.Sum(r => r.Late)</td>
                            <td class="num">@summary.Rows.Sum(r => r.Absent)</td>
                            <td class="num">@(summary.ClassPercent is { } c ? $"{c:0.#}%" : "—")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <p class="note">Attendance is the days present or late divided by the days marked. Below @AttendanceService.LowAttendancePercent.ToString("0")% is shown in red.</p>
        }
    </Card>
}

@code {
    [SupplyParameterFromQuery(Name = "subject")] private int? SubjectQuery { get; set; }

    private int teacherId;
    private bool loaded;
    private IReadOnlyList<TeacherSubjectCard> subjects = [];
    private int subjectId;
    private DateOnly today;
    private DateOnly date;
    private AttendanceSheet? sheet;
    private AttendanceSummary? summary;
    private readonly Dictionary<int, string?> marks = [];
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    protected override async Task OnInitializedAsync()
    {
        today = PhilippineTime.Today(Clock);
        date = today;
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        subjects = teacherId == 0 ? [] : await Teaching.GetTeacherCardsAsync(teacherId);
        subjectId = subjects.Any(s => s.AssignmentId == SubjectQuery) ? SubjectQuery!.Value : subjects.FirstOrDefault()?.AssignmentId ?? 0;
        await LoadAsync();
        loaded = true;
    }

    private int Count(string status) => marks.Values.Count(v => v == status);

    private int Unmarked => sheet is null ? 0 : sheet.Rows.Count(r => string.IsNullOrEmpty(marks.GetValueOrDefault(r.StudentId)));

    private void ClearMessage() => message = null;

    private async Task LoadAsync()
    {
        marks.Clear();
        formErrors = [];
        sheet = subjectId == 0 ? null : await AttendanceBook.GetSheetAsync(teacherId, subjectId, date);
        summary = subjectId == 0 ? null : await AttendanceBook.GetSummaryAsync(teacherId, subjectId);
        if (sheet is not null)
        {
            foreach (var row in sheet.Rows.Where(r => r.Status is not null))
            {
                marks[row.StudentId] = row.Status;
            }
        }
    }

    private async Task SubjectChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            subjectId = id;
            message = null;
            await LoadAsync();
        }
    }

    private async Task DateChanged(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var picked))
        {
            date = picked > today ? today : picked;
            message = null;
            await LoadAsync();
        }
    }

    private void Mark(int studentId, string status) => marks[studentId] = status;

    private void MarkAllPresent()
    {
        if (sheet is null)
        {
            return;
        }

        foreach (var row in sheet.Rows)
        {
            marks[row.StudentId] = AttendanceStatus.Present;
        }
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await AttendanceBook.SaveSheetAsync(teacherId, subjectId, date, marks);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            messageIsError = false;
            message = result.Message;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
