@page "/registrar/withdrawals"
@attribute [Authorize(Roles = AppRoles.Registrar)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject StudentLifecycleService Lifecycle

<PageTitle>Withdrawals · SEAITT e-LMS</PageTitle>

<PageHeader Title="Withdrawals" Subtitle="Students who want to leave school before finishing. Answer their requests, or withdraw a student yourself." IconName="user-x" />

<Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

<div class="layout">
    <Card Title="@($"Requests ({requests.Count(r => r.Status == WithdrawalStatus.Pending)} waiting)")" IconName="inbox">
        @if (requests.Count == 0)
        {
            <EmptyState IconName="inbox" Title="No requests">
                <p>When a student asks to withdraw, the request shows up here.</p>
            </EmptyState>
        }
        else
        {
            <ul class="requests">
                @foreach (var r in requests)
                {
                    var request = r;
                    <li class="request @request.Status.ToLowerInvariant()">
                        <div class="request-head">
                            <div>
                                <span class="name">@request.StudentName</span>
                                <span class="sub">@request.Lrn@(request.Placement is null ? "" : " · " + request.Placement) · @PhilippineTime.FormatDateTime(request.RequestedAtUtc)</span>
                            </div>
                            <Badge Tone="@StatusTone(request.Status)">@request.Status</Badge>
                        </div>
                        <blockquote>@request.Reason</blockquote>
                        @if (request.Status == WithdrawalStatus.Pending)
                        {
                            <div class="request-actions">
                                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="circle-x" OnClick="() => Ask(request, false)">Decline</Button>
                                <Button Small="true" Variant="ButtonVariant.Danger" IconName="circle-check" OnClick="() => Ask(request, true)">Approve withdrawal</Button>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(request.DecisionNote))
                        {
                            <p class="note">Your note: @request.DecisionNote</p>
                        }
                    </li>
                }
            </ul>
        }
    </Card>

    <Card Title="Withdraw a student" IconName="user-x">
        <p class="lead">Use this when a student tells you in person. Type the LRN, check the name and write the reason.</p>
        <form class="find" @onsubmit="FindAsync">
            <Field For="w-lrn" Label="LRN" Class="grow">
                <input id="w-lrn" type="text" class="input" inputmode="numeric" maxlength="12" autocomplete="off" placeholder="12 digits" @bind="lrn" />
            </Field>
            <div class="find-button"><Button Type="submit" Variant="ButtonVariant.Secondary" IconName="search">Find</Button></div>
        </form>

        @if (searched && found is null)
        {
            <p class="error" role="alert">No student has this LRN.</p>
        }
        else if (found is not null)
        {
            <div class="found">
                <strong>@found.Name</strong>
                <span class="sub">@found.Lrn@(found.Placement is null ? "" : " · " + found.Placement)</span>
                @if (found.Status != StudentStatus.Active)
                {
                    <Badge Tone="Tone.Warning">Already @found.Status.ToLowerInvariant()</Badge>
                }
            </div>

            @if (found.Status == StudentStatus.Active)
            {
                <FormErrors Errors="formErrors" />
                <Field For="w-why" Label="Reason" Required="true" Hint="At least 10 characters.">
                    <textarea id="w-why" rows="3" maxlength="300" value="@reason" @onchange="e => reason = e.Value?.ToString() ?? string.Empty"></textarea>
                </Field>
                <div class="actions">
                    <Button Variant="ButtonVariant.Danger" IconName="user-x" Disabled="busy" OnClick="() => confirmDirect = true">Withdraw this student</Button>
                </div>
            }
        }
    </Card>
</div>

@* ===== answer a request ===== *@
<Modal Open="target is not null" Title="@(approving ? "Approve the withdrawal?" : "Decline the request?")" OnClose="CloseAnswer">
    @if (target is not null)
    {
        @if (approving)
        {
            <p class="dialog-text"><strong>@target.StudentName</strong> will be withdrawn and archived: the enrollment is dropped and the <strong>sign-in is switched off</strong>. The guidance counselor is told.</p>
        }
        else
        {
            <p class="dialog-text">The student is told that the request was declined, with your note.</p>
        }

        <FormErrors Errors="formErrors" />
        <Field For="d-note" Label="@(approving ? "Note (optional)" : "Why is it declined?")" Required="@(!approving)">
            <textarea id="d-note" rows="3" maxlength="500" value="@note" @onchange="e => note = e.Value?.ToString() ?? string.Empty"></textarea>
        </Field>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseAnswer">Cancel</Button>
            <Button Variant="@(approving ? ButtonVariant.Danger : ButtonVariant.Primary)" IconName="@(approving ? "circle-check" : "circle-x")" Disabled="busy" OnClick="AnswerAsync">@(approving ? "Approve" : "Decline")</Button>
        </div>
    }
</Modal>

@* ===== withdraw directly ===== *@
<Modal Open="confirmDirect" Title="Withdraw this student?" OnClose="() => confirmDirect = false">
    @if (found is not null)
    {
        <p class="dialog-text"><strong>@found.Name</strong> will be withdrawn and archived: the enrollment is dropped and the <strong>sign-in is switched off</strong>. An administrator can restore the account later.</p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="() => confirmDirect = false">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" IconName="user-x" Disabled="busy" OnClick="DirectAsync">@(busy ? "Withdrawing…" : "Withdraw")</Button>
        </div>
    }
</Modal>

@code {
    private int userId;
    private IReadOnlyList<WithdrawalRow> requests = [];
    private WithdrawalRow? target;
    private bool approving;
    private string note = "";
    private string lrn = "";
    private bool searched;
    private StudentSummary? found;
    private string reason = "";
    private bool confirmDirect;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    protected override async Task OnInitializedAsync()
    {
        userId = (await Me.GetAsync())?.UserId ?? 0;
        await LoadAsync();
    }

    private void ClearMessage() => message = null;

    private async Task LoadAsync() => requests = await Lifecycle.ListRequestsAsync(false);

    private static Tone StatusTone(string status) => status switch
    {
        WithdrawalStatus.Approved => Tone.Success,
        WithdrawalStatus.Declined => Tone.Neutral,
        _ => Tone.Warning,
    };

    private void Ask(WithdrawalRow request, bool approve)
    {
        formErrors = [];
        target = request;
        approving = approve;
        note = "";
    }

    private void CloseAnswer() => target = null;

    private async Task AnswerAsync()
    {
        if (target is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Lifecycle.DecideAsync(target.Id, approving, note, userId);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            target = null;
            messageIsError = false;
            message = result.Message;
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task FindAsync()
    {
        formErrors = [];
        found = await Lifecycle.FindStudentAsync(lrn);
        searched = true;
    }

    private async Task DirectAsync()
    {
        if (found is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Lifecycle.WithdrawAsync(found.StudentId, reason, userId);
            confirmDirect = false;
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            messageIsError = false;
            message = result.Message;
            found = null;
            searched = false;
            lrn = "";
            reason = "";
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
