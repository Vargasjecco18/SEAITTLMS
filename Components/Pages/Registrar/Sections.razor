@page "/registrar/sections"
@attribute [Authorize(Roles = AppRoles.Registrar)]
@rendermode InteractiveServer
@using SEAITT_LMS.Components.Pages.Coordinator.Setup

<PageTitle>Class sections · SEAITT Legazpi LMS</PageTitle>

@* All the class sections (Grade 11 and Grade 12), to look at: the academic coordinator makes them. *@
