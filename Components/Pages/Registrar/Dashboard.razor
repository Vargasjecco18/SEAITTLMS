@page "/registrar"
@attribute [Authorize(Roles = AppRoles.Registrar)]
@using Microsoft.EntityFrameworkCore
@using SEAITT_LMS.Data
@using SEAITT_LMS.Data.Queries
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TimeProvider Clock

<PageTitle>Registrar · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Registrar dashboard"
            IconName="clipboard-check" />

@if (overview is not null)
{
    <section aria-labelledby="numbers-title">
        <h2 id="numbers-title" class="section-title">At a glance</h2>

        <div class="stats">
            <StatCard Label="Enrolled this term" Value="@overview.EnrolledThisTerm" IconName="clipboard-check" Accent="AccentColor.Blue" />
            <StatCard Label="Enrolled today" Value="@overview.EnrolledToday" IconName="user-plus" Accent="AccentColor.Green" />
            <StatCard Label="Students in the system" Value="@overview.StudentsTotal" IconName="graduation-cap" Accent="AccentColor.Violet" />
            <StatCard Label="Sections with students" Value="@SectionsWithStudents" IconName="users" Accent="AccentColor.Amber" Hint="@($"of {overview.SectionsThisYear:N0} sections this school year")" />
        </div>
    </section>

    @* The four cards after "At a glance": Not enrolled and the latest enrollments on top, the students by strand and by section below. *@
    <div class="quad">
        <Card Title="Not enrolled" IconName="user-x" Class="not-enrolled">
                @if (overview.NotEnrolled is not { Term: not null } notEnrolled)
                {
                    <p class="note">No term is set up yet.</p>
                }
                else if (notEnrolled.Total == 0)
                {
                    <EmptyState IconName="circle-check" Title="Everybody is enrolled">
                        <p>Every student at school is enrolled for the @notEnrolled.Term!.Label.</p>
                    </EmptyState>
                }
                else
                {
                    <p class="not-enrolled-head">
                        <strong>@notEnrolled.Total.ToString("N0")</strong>
                        <span>@(notEnrolled.Total == 1 ? "student is" : "students are") not enrolled for the @notEnrolled.Term!.Label</span>
                    </p>
                    <ul class="people">
                        @foreach (var student in notEnrolled.Items)
                        {
                            <li>
                                <Avatar Name="@student.Name" Size="32" />
                                <span class="people-text">
                                    <span class="people-name">@student.Name</span>
                                    <span class="people-sub">@(student.LastPlacement is null ? "Never enrolled" : $"Was in {student.LastPlacement}") · LRN @student.Lrn</span>
                                </span>
                                <a class="people-action" href="registrar/enrollments?lrn=@student.Lrn&term=@notEnrolled.Term!.Id">Enroll</a>
                            </li>
                        }
                    </ul>
                    @if (notEnrolled.Total > notEnrolled.Items.Count)
                    {
                        <p class="see-all"><a href="registrar/student-accounts?next=none">See the students <Icon Name="arrow-right" Size="16" /></a></p>
                    }
                }
            </Card>

        <Card Title="Latest enrollments" IconName="list">
        @if (overview.Recent.Count == 0)
        {
            <EmptyState IconName="clipboard-list" Title="No enrollments yet">
                <p>Enrolled students will show up here.</p>
                <ButtonLink Href="registrar/enrollments" IconName="user-plus">Enroll the first student</ButtonLink>
            </EmptyState>
        }
        else
        {
            <div class="table-in-card">
                <EnrollmentTable Rows="overview.Recent" />
            </div>
            <p class="see-all"><a href="registrar/student-accounts">See all student accounts <Icon Name="arrow-right" Size="16" /></a></p>
        }
    </Card>

        <Card Title="By strand" IconName="layers">
                @if (overview.ByStrand.Count == 0)
                {
                    <EmptyState IconName="layers" Title="No strands yet" />
                }
                else
                {
                    <ul class="bars">
                        @foreach (var strand in overview.ByStrand)
                        {
                            <li>
                                <div class="bar-label">
                                    <span class="bar-name">@strand.Code <span class="bar-sub">@strand.Track</span></span>
                                    <strong>@strand.Count</strong>
                                </div>
                                <div class="bar-track"><div class="bar-fill" style="width: @(Percent(strand.Count, maxStrand))%"></div></div>
                            </li>
                        }
                    </ul>
                }
            </Card>

        <Card Title="By section" IconName="users">
                @if (overview.BySection is not { Count: > 0 })
                {
                    <EmptyState IconName="users" Title="No sections yet" />
                }
                else
                {
                    var withStudents = overview.BySection.Where(s => s.Count > 0).ToList();
                    var empty = overview.BySection.Count - withStudents.Count;
                    <ul class="bars sections">
                        @foreach (var row in withStudents)
                        {
                            <li>
                                <div class="bar-label">
                                    <span class="bar-name">@row.Label</span>
                                    <strong>@row.Count</strong>
                                </div>
                                <div class="bar-track"><div class="bar-fill" style="width: @(Percent(row.Count, maxSection))%"></div></div>
                            </li>
                        }
                    </ul>
                    @if (withStudents.Count == 0)
                    {
                        <p class="empty-note">No student is in a section yet.</p>
                    }

                    @if (empty > 0)
                    {
                        <p class="empty-note">@empty @(empty == 1 ? "more section has" : "more sections have") no students yet.</p>
                    }
                }
            </Card>
    </div>
}

@code {
    private RegistrarOverview? overview;
    private int maxStrand;
    private int maxSection;

    private int SectionsWithStudents => overview?.BySection?.Count(s => s.Count > 0) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // Today starts at midnight in the Philippines (UTC+8).
        var startOfToday = new DateTimeOffset(PhilippineTime.Now(Clock).Date, TimeSpan.FromHours(8)).UtcDateTime;

        await using var db = await DbFactory.CreateDbContextAsync();
        overview = await RegistrarOverview.LoadAsync(db, startOfToday);
        maxStrand = overview.ByStrand.Select(s => s.Count).DefaultIfEmpty(0).Max();
        maxSection = (overview.BySection ?? []).Select(s => s.Count).DefaultIfEmpty(0).Max();
    }

    private static int Percent(int value, int max) => max == 0 ? 0 : Math.Max(value == 0 ? 0 : 3, value * 100 / max);
}
