@page "/registrar/enrollments"
@attribute [Authorize(Roles = AppRoles.Registrar)]
@rendermode InteractiveServer
@using System.Security.Claims
@using SEAITT_LMS.Services
@inject EnrollmentService Enrollment
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject ApplicationService Applications

<PageTitle>Enrollment · SEAITT Legazpi LMS</PageTitle>

<div class="screen-only">
    <PageHeader Title="Enrollment"
                IconName="user-plus">
        @* The students the admission office accepted: press one and the form is filled with what they wrote in the application. *@
        <Button Variant="ButtonVariant.Secondary" IconName="user-check" OnClick="OpenAcceptedAsync">Accepted students</Button>
    </PageHeader>
</div>

@if (lookups is null)
{
    <p class="loading">Loading…</p>
}
else if (lookups.Terms.Count == 0 || lookups.Tracks.Count == 0 || lookups.Strands.Count == 0)
{
    <Card>
        <EmptyState IconName="triangle-alert" Title="The school setup is not ready" Tone="Tone.Warning">
            <p>There must be a term, a track and a strand before students can be enrolled.</p>
        </EmptyState>
    </Card>
}
else if (receipt is not null)
{
    @* ===== Done: what was enrolled, and the login to hand over ===== *@
    @* On paper only the enrollment form is printed (EnrollmentPrintSheet), not this card. *@
    <EnrollmentPrintSheet Receipt="receipt" />
    <div class="screen-only">
    <Card Class="receipt">
        <div class="receipt-head">
            <span class="receipt-icon"><Icon Name="circle-check" Size="30" /></span>
            <div>
                <h2>@receipt.FullName is enrolled</h2>
                <p>@receipt.Term of @receipt.SchoolYear · Grade @receipt.GradeLevel</p>
            </div>
        </div>

        <dl class="details">
            <div><dt>LRN</dt><dd>@receipt.Lrn</dd></div>
            <div><dt>Phone</dt><dd>@(receipt.PhoneNumber ?? "Not given")</dd></div>
            <div><dt>Track</dt><dd>@receipt.Track</dd></div>
            <div><dt>Strand</dt><dd>@receipt.Strand</dd></div>
            <div><dt>Section</dt><dd>@receipt.Section</dd></div>
            <div class="wide">
                <dt>Courses</dt>
                <dd>
                    @if (receipt.Subjects.Count == 0)
                    {
                        <span class="muted">None</span>
                    }
                    else
                    {
                        <ul class="subject-chips">
                            @for (var i = 0; i < receipt.Subjects.Count; i++)
                            {
                                <li>@receipt.Subjects[i]</li>
                            }
                        </ul>
                    }
                </dd>
            </div>
        </dl>

        <div class="login-box">
            @if (receipt.NewAccount)
            {
                <h3><Icon Name="key-round" Size="18" /> Sign-in details for the student</h3>
                <dl>
                    <div><dt>Email</dt><dd class="mono" id="login-email">@receipt.Email</dd></div>
                    <div><dt>Password</dt><dd class="mono" id="login-password">@receipt.Password</dd></div>
                </dl>
                <p class="hint">Give these to the student. Anyone who knows the last name and the LRN can work out the password, so tell the student to keep it private.</p>
            }
            else
            {
                <h3><Icon Name="info" Size="18" /> The student already has an account</h3>
                <p class="hint">Nothing changed there. They sign in with <span class="mono">@receipt.Email</span> and the password they already have.</p>
            }
        </div>

        <div class="actions no-print">
            <Button Variant="ButtonVariant.Primary" IconName="user-plus" OnClick="EnrollAnother">Enroll another student</Button>
            @if (receipt.NewAccount)
            {
                <Button Variant="ButtonVariant.Secondary" IconName="@(copied ? "circle-check" : "file-text")" OnClick="CopyLoginAsync">@(copied ? "Copied" : "Copy the login")</Button>
            }
            <Button Variant="ButtonVariant.Secondary" IconName="list" OnClick="PrintAsync">Print</Button>
            <ButtonLink Href="registrar" Variant="ButtonVariant.Ghost">Back to the dashboard</ButtonLink>
        </div>
    </Card>
    </div>
}
else
{
    <div class="screen-only">
    <EditForm Model="form" OnSubmit="SubmitAsync" class="enroll-form" novalidate>

        <FormErrors Errors="errors" />

        <div class="grid enroll-grid">
            <Card Title="Student" IconName="graduation-cap" Class="area-student">
                @StudentFields("")
            </Card>

            @* The sign-in details are under the student's card, at the left, and always there: the courses that appear in the card at the right do not move them. Under them: Print Enrollment and Enroll student. *@
            <Card Title="Sign-in details" IconName="key-round" Class="area-signin">
                @if (existing is not null)
                {
                    <p>This student already has an account: <span class="mono">@existing.Email</span>.</p>
                    <p class="muted">Their password does not change.</p>
                }
                else if (Preview is { } preview)
                {
                    <dl class="preview">
                        <div><dt>Email</dt><dd class="mono" id="preview-email">@preview.Email</dd></div>
                        <div><dt>Password</dt><dd class="mono" id="preview-password">@preview.Password</dd></div>
                    </dl>
                    <p class="hint">Made from the last name and the last 6 digits of the LRN. They are created when you press Enroll student.</p>
                }
                else
                {
                    <p class="muted">Type the LRN and the last name and the student's email and password appear here.</p>
                }
            </Card>

            <div class="area-actions">
                <Button Type="button" Variant="ButtonVariant.Secondary" IconName="list" OnClick="PrintAsync">Print Enrollment</Button>
                <Button Type="submit" Variant="ButtonVariant.Primary" IconName="user-plus" Disabled="busy">@(busy ? "Enrolling…" : "Enroll student")</Button>
            </div>

            <Card Title="Enrollment" IconName="clipboard-list" Class="area-enroll">
                @* The term is set by the calendar (the first day and the last day of each term): the registrar does not choose it. *@
                <Field For="term" Label="Term" Hint="Set by itself from the first day and the last day of the term.">
                    <input id="term" readonly value="@TermText(form.TermId)" />
                </Field>

                <div class="two">
                    <Field For="grade" Label="Grade level" Required="true">
                        <select id="grade" required @bind="form.GradeLevel" @bind:after="OnPlacementChangedAsync">
                            <option value="11">Grade 11</option>
                            <option value="12">Grade 12</option>
                        </select>
                    </Field>
                    <Field For="track" Label="Track" Required="true" Error="@FieldError("track")">
                        <select id="track" required @bind="form.TrackId" @bind:after="OnTrackChangedAsync">
                            <option value="0">Choose a track</option>
                            @foreach (var track in lookups.Tracks)
                            {
                                <option value="@track.Id">@track.Code</option>
                            }
                        </select>
                    </Field>
                </div>

                <Field For="strand" Label="Strand" Required="true" Error="@FieldError("strand")">
                    <select id="strand" required disabled="@(form.TrackId == 0)" @bind="form.StrandId" @bind:after="OnStrandChangedAsync">
                        <option value="0">@(form.TrackId == 0 ? "Choose a track first" : "Choose a strand")</option>
                        @foreach (var strand in StrandsOfTrack)
                        {
                            <option value="@strand.Id">@strand.Code@(string.Equals(strand.Name, strand.Code, StringComparison.OrdinalIgnoreCase) ? "" : $" ({strand.Name})")</option>
                        }
                    </select>
                </Field>

                <Field For="section" Label="Section" Required="true" Hint="@SectionHint" Error="@FieldError("section")">
                        <select id="section" required @bind="form.SectionName" @bind:after="OnSectionChangedAsync">
                            <option value="">Choose</option>
                            @foreach (var load in SectionLoads)
                            {
                                <option value="@load.Name" disabled="@load.IsFull">@load.Name@(form.StrandId == 0 ? "" : $" · {load.Text}")@(load.IsFull ? " (full)" : "")</option>
                            }
                            @if (form.StrandId != 0)
                            {
                                <option value="@AddSectionChoice">+ Add a section…</option>
                            }
                        </select>
                </Field>
                @if (addingSection)
                {
                    <div class="add-section" role="group" aria-label="Add a section">
                        <input id="new-section-name" type="text" maxlength="50" autocomplete="off" placeholder="Name, like C" aria-label="Name of the new section" @bind="newSectionName" @bind:event="oninput" />
                        <Button Small="true" IconName="plus" Disabled="busy" OnClick="AddSectionAsync">Add section</Button>
                        <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="() => addingSection = false">Cancel</Button>
                    </div>
                }

                @if (strandShifted)
                {
                    <p class="shift-note" role="status"><Icon Name="info" Size="16" /> The student changes strand, so the student starts again in Grade 11.</p>
                }

                @* The subjects are not picked: the strand decides them (the academic coordinator sets them in the academic setup). The student gets all of them: what they are, the units and, once the section is chosen, when each one meets. *@
                <div class="courses-block">
                    <h3 class="courses-title">Courses</h3>
                    <p class="subjects-note">
                        <Icon Name="book-open" Size="16" />
                        @if (form.StrandId == 0)
                        {
                            <span>The student gets all the courses of the strand for the term. Choose a strand to see them.</span>
                        }
                        else if (plan.Count == 0)
                        {
                            <span>No courses are set for this strand, grade level and term yet. The student is enrolled without courses.</span>
                        }
                        else
                        {
                            <span>The student gets all @plan.Count courses of this strand for the term.</span>
                        }
                    </p>
                    @if (plan.Count > 0)
                    {
                        <div class="table-wrap">
                            <table class="plan" id="plan">
                                <thead>
                                    <tr>
                                        <th scope="col">Course</th>
                                        <th scope="col">Code</th>
                                        <th scope="col" class="num">Units</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in plan)
                                    {
                                        <tr>
                                            <td>@course.Name</td>
                                            <td class="mono">@course.Code</td>
                                            <td class="num">@course.Units.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2">Total: @(plan.Count == 1 ? "1 course" : $"{plan.Count} courses")</td>
                                        <td class="num">@plan.Sum(c => c.Units).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </Card>
        </div>
    </EditForm>
    </div>

    @* The paper that is printed for this student: Print Enrollment opens the print preview of the browser at once (no box before it). What is on the paper is the form of EnrollmentPrintSheet. *@
    <EnrollmentPrintSheet Receipt="DraftReceipt" />
}

<Modal Open="acceptedOpen" Title="Accepted students" Large="true" OnClose="CloseAccepted">
    @if (acceptedOpen)
    {
        <p class="dialog-text">The students the admission office accepted and who are not enrolled yet. Press <strong>Use</strong> and the form of the enrollment is filled with their LRN, names, phone number, grade level, track and strand. Choose the section and enroll them.</p>
        <FormErrors Errors="acceptedErrors" />
        @if (accepted is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (accepted.Count == 0)
        {
            <EmptyState IconName="user-check" Title="Nobody is waiting">
                <p>When the admission office accepts an application, the student is listed here.</p>
            </EmptyState>
        }
        else
        {
            <div class="table-wrap">
                <table class="accepted-table" aria-label="Accepted students">
                    <thead><tr><th scope="col">Student</th><th scope="col">LRN</th><th scope="col">Track · Strand</th><th scope="col">Reference</th><th scope="col"><span class="sr-only">Use</span></th></tr></thead>
                    <tbody>
                        @foreach (var row in accepted)
                        {
                            var chosen = row;
                            <tr data-app="@chosen.Reference">
                                <td><strong>@chosen.Name</strong></td>
                                <td class="mono">@(chosen.Lrn ?? "—")</td>
                                <td>@chosen.Track · @chosen.Strand · Grade @chosen.GradeLevel</td>
                                <td class="mono">@chosen.Reference</td>
                                <td><Button Small="true" IconName="arrow-right" OnClick="() => UseAcceptedAsync(chosen)">Use</Button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="import-actions"><Button Variant="ButtonVariant.Ghost" OnClick="CloseAccepted">Close</Button></div>
    }
</Modal>

@code {
    private sealed class Form
    {
        public string Lrn { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string MiddleName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string NameExtension { get; set; } = "";
        public byte GradeLevel { get; set; } = 11;
        public int TermId { get; set; }
        public int TrackId { get; set; }
        public int StrandId { get; set; }
        public string SectionName { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
    }

    /// <summary>The boxes about the student. They are on the page and again in the box of the enrolling student: the same values, a prefix for the ids.</summary>
    private RenderFragment StudentFields(string p) => @<text>
        <Field For="@(p + "lrn")" Label="LRN" Required="true" Hint="The 12 digits of the Learner Reference Number." Error="@FieldError("lrn")">
            <input id="@(p + "lrn")" type="text" inputmode="numeric" data-digits maxlength="12" pattern="[0-9]{12}" autocomplete="off" required
                   title="12 digits" @bind="LrnValue" @bind:event="oninput" @bind:after="OnLrnChangedAsync" />
        </Field>

        @if (existing is not null)
        {
            <div class="notice" role="status">
                <Icon Name="info" Size="18" />
                <div>
                    <strong>@existing.FullName already has an account.</strong>
                    <span>This adds a new enrollment. The name and the sign-in details stay as they are.</span>
                    @if (existing.LastPlacement is not null)
                    {
                        <span>The grade level, track and strand are the ones of the last enrollment. Choose the section.</span>
                    }
                    @if (existing.EnrolledTermIds.Contains(form.TermId))
                    {
                        <span class="warn">This student is already enrolled for the selected term.</span>
                    }
                </div>
            </div>
        }

        <Field For="@(p + "first-name")" Label="First name" Required="true" Error="@FieldError("first-name")">
            <input id="@(p + "first-name")" type="text" maxlength="100" autocomplete="off" required readonly="@(existing is not null)" class="cap" data-letters
                   @bind="FirstNameValue" @onblur="WriteNamesWithCapitals" />
        </Field>
        <Field For="@(p + "middle-name")" Label="Middle name">
            <input id="@(p + "middle-name")" type="text" maxlength="100" autocomplete="off" readonly="@(existing is not null)" class="cap" data-letters
                   @bind="MiddleNameValue" @onblur="WriteNamesWithCapitals" />
        </Field>
        <Field For="@(p + "last-name")" Label="Last name" Required="true" Error="@FieldError("last-name")">
            <input id="@(p + "last-name")" type="text" maxlength="100" autocomplete="off" required readonly="@(existing is not null)" class="cap" data-letters
                   @bind="LastNameValue" @bind:event="oninput" @onblur="WriteNamesWithCapitals" />
        </Field>
        <Field For="@(p + "name-extension")" Label="Name extension" Hint="Optional: Jr., Sr., III ...">
            <input id="@(p + "name-extension")" type="text" maxlength="10" autocomplete="off" placeholder="Jr." class="cap" data-letters
                   readonly="@(existing is not null)" @bind="NameExtensionValue" @onblur="WriteNamesWithCapitals" />
        </Field>
        <Field For="@(p + "phone")" Label="Phone number" Hint="Optional. Digits only, like 09171234567.">
            <input id="@(p + "phone")" type="tel" inputmode="numeric" data-digits maxlength="12" autocomplete="off" placeholder="09XXXXXXXXX"
                   readonly="@(existing?.PhoneNumber is not null)" @bind="PhoneValue" />
        </Field>
    </text>;


    /// <summary>What the paper shows before the student is enrolled: the form as it is now (the number of the enrollment is not made yet).</summary>
    private EnrollmentReceipt DraftReceipt
    {
        get
        {
            var term = lookups?.Terms.FirstOrDefault(t => t.Id == form.TermId);
            var track = lookups?.Tracks.FirstOrDefault(t => t.Id == form.TrackId);
            var strand = lookups?.Strands.FirstOrDefault(t => t.Id == form.StrandId);
            var name = existing?.FullName ?? string.Join(' ', new[] { NameCase.Title(form.FirstName), NameCase.Title(form.MiddleName), NameCase.Title(form.LastName), NameCase.Title(form.NameExtension) }.Where(n => n.Length > 0));
            var login = Preview;
            return new EnrollmentReceipt(
                0, existing?.StudentId ?? 0, name, form.Lrn, term?.SchoolYear ?? "", term?.Name ?? "", form.GradeLevel,
                track?.Code ?? "", strand?.Code ?? "", form.SectionName,
                [.. plan.Select(c => c.Name)], existing is null, existing?.Email ?? login?.Email ?? "", existing is null ? login?.Password : null,
                string.IsNullOrWhiteSpace(form.PhoneNumber) ? null : form.PhoneNumber, [.. plan.Select(c => c.Units)]);
        }
    }

    private readonly Form form = new();
    private EnrollmentLookups? lookups;
    private ExistingStudent? existing;
    private IReadOnlyList<SubjectOption> subjects = [];
    private IReadOnlyList<CoursePlanRow> plan = [];
    private IReadOnlyList<SectionLoad> sectionLoads = [];
    private bool strandShifted;
    private byte defaultGrade = 11;

    /// <summary>A to C, and the sections with another name that this strand and grade level already have, each with how many students it has.</summary>
    private IEnumerable<SectionLoad> SectionLoads => sectionLoads.Count > 0
        ? sectionLoads
        : SectionNames.Choices.Select(n => new SectionLoad(n, 0, Enrollment.SectionCapacity));

    private string SectionHint => form.StrandId != 0 && sectionLoads.FirstOrDefault(l => l.Name == form.SectionName) is { } load
        ? $"Section {load.Name} has {load.Text}. {(load.IsFull ? "It is full." : load.SeatsLeft == 1 ? "1 seat is left." : $"{load.SeatsLeft} seats are left.")}"
        : $"Choose the section, or add one. A section can have {Enrollment.SectionCapacity} students.";
    private List<string> errors = [];
    private EnrollmentReceipt? receipt;
    private bool busy;
    private bool copied;
    private int reloadVersion;

    // The name boxes show the student's own name (read-only) when the LRN belongs to a student who already has an account.
    // They use @bind, which keeps what is typed while the page is being refreshed, even when typing fast.
    private string FirstNameValue
    {
        get => existing?.FirstName ?? form.FirstName;
        set { form.FirstName = NameCase.KeepLetters(value); boxProblems.Remove("first-name"); }
    }

    private string MiddleNameValue
    {
        get => existing?.MiddleName ?? form.MiddleName;
        set => form.MiddleName = NameCase.KeepLetters(value);
    }

    private string LastNameValue
    {
        get => existing?.LastName ?? form.LastName;
        set { form.LastName = NameCase.KeepLetters(value); boxProblems.Remove("last-name"); }
    }

    private string NameExtensionValue
    {
        get => existing?.NameExtension ?? form.NameExtension;
        set => form.NameExtension = NameCase.KeepLetters(value);
    }

    // The LRN has digits only (the box drops the rest as it is typed; this keeps it when the box was not able to).
    private string LrnValue
    {
        get => form.Lrn;
        set { form.Lrn = NameCase.KeepDigits(value); boxProblems.Remove("lrn"); }
    }

    // A student who already has a number shows it (read-only); otherwise what is typed is kept and saved with the enrollment.
    private string PhoneValue
    {
        get => existing?.PhoneNumber is { } stored ? SEAITT_LMS.Auth.PhoneNumbers.ToLocal(stored) : form.PhoneNumber;
        set => form.PhoneNumber = NameCase.KeepDigits(value);
    }

    /// <summary>When a name box is left, the names are written with capital letters (juan dela cruz -> Juan Dela Cruz). The service does it again when it saves.</summary>
    private void WriteNamesWithCapitals()
    {
        form.FirstName = NameCase.Title(form.FirstName);
        form.MiddleName = NameCase.Title(form.MiddleName);
        form.LastName = NameCase.Title(form.LastName);
        form.NameExtension = NameCase.Title(form.NameExtension);
    }

    private IEnumerable<StrandOption> StrandsOfTrack => lookups!.Strands.Where(s => s.TrackId == form.TrackId);

    /// <summary>The login the student will get, once the LRN and the last name are typed. Not for students who already have one.</summary>
    private StudentLogin? Preview =>
        existing is null && form.Lrn.Length == 12 && form.Lrn.All(char.IsAsciiDigit) && !string.IsNullOrWhiteSpace(form.LastName)
            ? Enrollment.PreviewLogin(form.LastName, form.Lrn)
            : null;

    // The student list links here with ?lrn=...&term=... to enroll a student who is not enrolled yet.
    [SupplyParameterFromQuery(Name = "lrn")] private string? LrnQuery { get; set; }

    [SupplyParameterFromQuery(Name = "term")] private string? TermQuery { get; set; }

    private string TermText(int termId) => lookups?.Terms.FirstOrDefault(t => t.Id == termId) is { } term ? $"{term.SchoolYear} · {term.Name}{(term.IsCurrent ? " (current)" : "")}" : "No term is running";

    protected override async Task OnInitializedAsync()
    {
        lookups = await Enrollment.GetLookupsAsync();
        form.TermId = (lookups.Terms.FirstOrDefault(t => t.IsCurrent) ?? lookups.Terms.FirstOrDefault())?.Id ?? 0;

        if (int.TryParse(TermQuery, out var termId) && lookups.Terms.Any(t => t.Id == termId))
        {
            form.TermId = termId;
        }

        if (LrnQuery is { Length: 12 } lrn && lrn.All(char.IsAsciiDigit))
        {
            form.Lrn = lrn;
            existing = await Enrollment.FindStudentAsync(lrn);
            await ApplyPlacementAsync();
        }
    }

    /// <summary>
    /// A student who is enrolled again starts from where they were: the grade level (one more when the term is in a newer school year),
    /// the track and strand, and the section they had, which the registrar can change.
    /// </summary>
    private async Task ApplyPlacementAsync()
    {
        if (existing?.LastPlacement is not { } last)
        {
            return;
        }

        var termYear = lookups!.Terms.FirstOrDefault(t => t.Id == form.TermId)?.SchoolYear;
        form.GradeLevel = defaultGrade = termYear is not null && termYear != last.SchoolYear ? (byte)Math.Min(12, last.GradeLevel + 1) : last.GradeLevel;
        strandShifted = false;

        var strand = lookups.Strands.FirstOrDefault(s => s.Id == last.StrandId);
        if (strand is null)
        {
            // The strand is not offered any more: the registrar chooses.
            await ReloadChoicesAsync();
            return;
        }

        form.TrackId = strand.TrackId;
        form.StrandId = strand.Id;
        form.SectionName = ""; // the section is chosen again every term
        await ReloadChoicesAsync();
    }

    private async Task OnLrnChangedAsync()
    {
        var lrn = form.Lrn;
        var found = await Enrollment.FindStudentAsync(lrn);

        // An answer for an LRN that was changed again while it was being looked up is not the answer any more.
        if (lrn == form.Lrn)
        {
            existing = found;
            await ApplyPlacementAsync();
        }
    }

    private async Task OnTrackChangedAsync()
    {
        boxProblems.Remove("track");
        boxProblems.Remove("strand");
        form.StrandId = 0;
        await ReloadChoicesAsync();
    }

    private async Task OnStrandChangedAsync()
    {
        boxProblems.Remove("strand");
        // A student who goes to another strand starts again in Grade 11 (the grade level of the last strand comes back if the old strand is chosen again).
        if (existing?.LastPlacement is { } last && form.StrandId != 0)
        {
            strandShifted = form.StrandId != last.StrandId;
            form.GradeLevel = strandShifted ? (byte)11 : defaultGrade;
        }

        await ReloadChoicesAsync();
    }

    private async Task OnPlacementChangedAsync() => await ReloadChoicesAsync();

    private const string AddSectionChoice = "__add";

    private bool addingSection;
    private string newSectionName = "";

    private async Task OnSectionChangedAsync()
    {
        boxProblems.Remove("section");
        // "+ Add a section…" is not a section: it opens the little box to type the name of a new one.
        if (form.SectionName == AddSectionChoice)
        {
            form.SectionName = "";
            addingSection = true;
            newSectionName = "";
            return;
        }

        await ReloadChoicesAsync();
    }

    private async Task AddSectionAsync()
    {
        busy = true;
        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            var signedIn = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);
            var result = !signedIn ? ServiceResult.Fail("Please sign in again.") : await Enrollment.AddSectionAsync(userId, form.TermId, form.StrandId, form.GradeLevel, newSectionName);
            if (result.Succeeded)
            {
                addingSection = false;
                errors = [];
                var added = string.Join(' ', newSectionName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
                form.SectionName = added.Length == 1 ? added.ToUpperInvariant() : added;
                await ReloadChoicesAsync();
            }
            else
            {
                errors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>The subjects and the existing sections depend on the term, grade level and strand.</summary>
    private async Task ReloadChoicesAsync()
    {
        var version = ++reloadVersion;

        if (form.StrandId == 0 || form.TermId == 0)
        {
            subjects = [];
            plan = [];
            sectionLoads = [];
            return;
        }

        var curriculum = await Enrollment.GetCurriculumAsync(form.StrandId, form.GradeLevel, form.TermId);
        var sections = await Enrollment.GetSectionLoadsAsync(form.TermId, form.StrandId, form.GradeLevel);
        var coursePlan = await Enrollment.GetCoursePlanAsync(form.TermId, form.StrandId, form.GradeLevel);

        // The choices changed again while this was loading: the newer load shows its own result.
        if (version != reloadVersion)
        {
            return;
        }

        subjects = curriculum;
        plan = coursePlan;
        sectionLoads = sections;
        if (sections.FirstOrDefault(l => l.Name == form.SectionName)?.IsFull == true)
        {
            form.SectionName = "";
        }
    }

    private async Task SubmitAsync()
    {
        if (busy)
        {
            return;
        }

        // The boxes that are empty or not right are shown first, on the boxes themselves: a red line under each, the message at the top, and the cursor goes to the first one.
        if (!await CheckBoxesAsync())
        {
            return;
        }

        busy = true;
        errors = [];

        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            _ = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);

            var request = new EnrollmentRequest(
                form.Lrn,
                existing?.FirstName ?? form.FirstName,
                existing?.MiddleName ?? form.MiddleName,
                existing?.LastName ?? form.LastName,
                form.GradeLevel, form.TermId, form.TrackId, form.StrandId,
                form.SectionName,
                form.PhoneNumber,
                existing?.NameExtension ?? form.NameExtension);

            var result = await Enrollment.EnrollAsync(request, userId);
            if (result.Succeeded)
            {
                receipt = result.Receipt;
                copied = false;

                // the application the form was filled from is Enrolled now
                if (receipt is not null)
                {
                    await Applications.MarkEnrolledAsync(applicationId, receipt.StudentId);
                }

                applicationId = null;
            }
            else
            {
                errors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>The boxes with a problem (the id of the box without its prefix, and what is wrong), shown on the form.</summary>
    private readonly Dictionary<string, string> boxProblems = [];

    private static readonly string[] BoxOrder = ["lrn", "first-name", "last-name", "track", "strand", "section"];

    private string? FieldError(string box) => boxProblems.GetValueOrDefault(box);

    /// <summary>Looks at the boxes that are needed. Nothing is sent while one has a problem.</summary>
    private async Task<bool> CheckBoxesAsync()
    {
        boxProblems.Clear();
        var lrn = (form.Lrn ?? "").Trim();
        if (lrn.Length == 0)
        {
            boxProblems["lrn"] = "Enter the LRN.";
        }
        else if (lrn.Length != 12 || !lrn.All(char.IsAsciiDigit))
        {
            boxProblems["lrn"] = "The LRN has to be exactly 12 digits.";
        }

        if (existing is null)
        {
            if (string.IsNullOrWhiteSpace(form.FirstName))
            {
                boxProblems["first-name"] = "Enter the first name.";
            }

            if (string.IsNullOrWhiteSpace(form.LastName))
            {
                boxProblems["last-name"] = "Enter the last name.";
            }
        }

        if (form.TrackId == 0)
        {
            boxProblems["track"] = "Choose the track.";
        }

        if (form.StrandId == 0)
        {
            boxProblems["strand"] = form.TrackId == 0 ? "Choose a track first, then the strand." : "Choose the strand.";
        }

        if (string.IsNullOrWhiteSpace(form.SectionName))
        {
            boxProblems["section"] = "Choose the section.";
        }

        if (boxProblems.Count == 0)
        {
            return true;
        }

        errors = [.. BoxOrder.Where(boxProblems.ContainsKey).Select(b => boxProblems[b])];
        try
        {
            await JS.InvokeVoidAsync("seaitt.focusField", BoxOrder.First(boxProblems.ContainsKey));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // the page is closing: nothing to focus
        }

        return false;
    }

    /// <summary>Back to an empty student, keeping the choices that usually stay the same for the next one.</summary>
    private void EnrollAnother()
    {
        receipt = null;
        existing = null;
        errors = [];
        form.Lrn = "";
        form.FirstName = "";
        form.MiddleName = "";
        form.LastName = "";
        form.NameExtension = "";
        form.PhoneNumber = "";
    }

    private async Task CopyLoginAsync()
    {
        if (receipt is { NewAccount: true })
        {
            copied = await JS.InvokeAsync<bool>("seaitt.copyText", $"Email: {receipt.Email}\nPassword: {receipt.Password}");
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("seaitt.print");

    // ---------- the students the admission office accepted
    private bool acceptedOpen;
    private IReadOnlyList<ApplicationRow>? accepted;
    private IReadOnlyList<string> acceptedErrors = [];
    private int? applicationId;

    private async Task OpenAcceptedAsync()
    {
        acceptedOpen = true;
        acceptedErrors = [];
        accepted = null;
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _ = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);
        accepted = await Applications.ListAcceptedAsync(userId);
    }

    private void CloseAccepted() => acceptedOpen = false;

    /// <summary>Fills the form from an accepted application: LRN, names, name extension, phone number, grade level, track and strand. The section is chosen by the registrar.</summary>
    private async Task UseAcceptedAsync(ApplicationRow row)
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _ = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);
        var fill = await Applications.GetFillAsync(userId, row.Id);
        if (fill is null)
        {
            acceptedErrors = ["This application is not accepted any more."];
            return;
        }

        applicationId = fill.Id;
        form.Lrn = fill.Lrn ?? "";
        form.FirstName = fill.FirstName;
        form.MiddleName = fill.MiddleName ?? "";
        form.LastName = fill.LastName;
        form.NameExtension = fill.Suffix ?? "";
        form.PhoneNumber = fill.Phone;
        form.GradeLevel = fill.GradeLevel;
        form.TrackId = fill.TrackId;
        form.StrandId = fill.StrandId;
        form.SectionName = "";
        existing = null;
        boxProblems.Clear();
        errors = [];
        acceptedOpen = false;

        // a student who has an account already (the same LRN) is found, as when the LRN is typed
        if (form.Lrn.Length == 12)
        {
            existing = await Enrollment.FindStudentAsync(form.Lrn);
        }

        await ReloadChoicesAsync();
    }
}
