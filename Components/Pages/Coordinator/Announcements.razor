@page "/coordinator/announcements"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject AnnouncementService Service
@inject CalendarService Calendars
@inject TimeProvider Clock

<PageTitle>Announcements · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Announcements" IconName="megaphone">
    <Button Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" OnClick="ExportAsync" Disabled="@(rows is null || rows.Count == 0)">Export to Excel</Button>
    <Button Variant="ButtonVariant.Secondary" IconName="table" OnClick="OpenSheet">Announcements sheet</Button>
    <Button IconName="plus" OnClick="() => OpenAdd(null)">New announcement</Button>
</PageHeader>

<Notice Message="@message" IsError="messageIsError" OnDismiss="ClearMessage" />

<PillTabs Items="Tabs" Selected="@filter" SelectedChanged="FilterChanged" Label="Kinds of announcements" />

<div class="view-tools">
    <div class="view-switch" role="group" aria-label="How to see the announcements">
        <button type="button" class="@(view == "calendar" ? "on" : "")" aria-pressed="@(view == "calendar" ? "true" : "false")" @onclick='() => view = "calendar"'><Icon Name="calendar-days" Size="16" /> Calendar</button>
        <button type="button" class="@(view == "list" ? "on" : "")" aria-pressed="@(view == "list" ? "true" : "false")" @onclick='() => view = "list"'><Icon Name="list" Size="16" /> List</button>
    </div>

    @if (view == "calendar")
    {
        <div class="month-controls" role="group" aria-label="Month">
            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevron-left" OnClick="() => MoveMonth(-1)">Previous</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" OnClick="GoToday">Today</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevron-right" IconAfter="true" OnClick="() => MoveMonth(1)">Next</Button>
            <strong class="month-name">@anchor.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong>
        </div>
        <Button Small="true" Variant="ButtonVariant.Ghost" IconName="flag" OnClick="OpenDeletedHolidays">Deleted holidays (@deletedHolidays.Count)</Button>
        <p class="muted calendar-hint">Double click a day to add an announcement on it. Press a holiday to delete it.</p>
    }
</div>

@if (rows is null)
{
    <p class="muted">Loading…</p>
}
else if (view == "calendar")
{
    <div class="ann-month" role="grid" aria-label="@anchor.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)">
        @foreach (var name in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
        {
            <div class="dow" role="columnheader">@name</div>
        }

        @foreach (var day in MonthDays)
        {
            var onDay = OnDay(day);
            <div class="ann-cell @(day.Month != anchor.Month ? "other" : "") @(day == today ? "today" : "")" role="gridcell" data-day="@day.ToString("yyyy-MM-dd")"
                 aria-label="@day.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture)" @ondblclick="() => OpenAdd(day)">
                <span class="num">@day.Day</span>
                @{
                    var holidaysOn = HolidaysOn(day);
                }
                <ul class="chips">
                    @foreach (var holiday in holidaysOn)
                    {
                        <li>
                            <button type="button" class="chip holiday" title="@($"{holiday.Name} · {holiday.Kind}")" @onclick="() => viewingHoliday = holiday" @ondblclick:stopPropagation="true">
                                <Icon Name="flag" Size="12" /> <span>@holiday.Name</span>
                            </button>
                        </li>
                    }

                    @foreach (var row in onDay.Take(Math.Max(0, 3 - holidaysOn.Count)))
                    {
                        <li>
                            <button type="button" class="chip @row.Category" title="@row.Title" @onclick="() => viewing = row" @ondblclick:stopPropagation="true">
                                <Icon Name="@AnnouncementCategories.Icon(row.Category)" Size="12" /> <span>@row.Title</span>
                            </button>
                        </li>
                    }

                    @if (onDay.Count > Math.Max(0, 3 - holidaysOn.Count))
                    {
                        <li><button type="button" class="more-chip" @onclick="() => listDay = day" @ondblclick:stopPropagation="true">+@(onDay.Count - Math.Max(0, 3 - holidaysOn.Count)) more</button></li>
                    }
                </ul>
            </div>
        }
    </div>
}
else if (Shown.Count == 0)
{
    <Card>
        <EmptyState IconName="megaphone" Title="@(rows.Count == 0 ? "No announcement yet" : "Nothing in this part")">
            <p>@(rows.Count == 0 ? "Write a notice about an exam, a holiday, the semester break, a teachers' meeting or anything else." : "There is no announcement of this kind.")</p>
        </EmptyState>
    </Card>
}
else
{
    <div class="notices">
        @foreach (var row in Shown)
        {
            <AnnouncementCard Item="row" Today="today" OnEdit="OpenEdit" OnDelete="OpenDelete" />
        }
    </div>
}

@* One announcement, from the calendar: the card with its Edit and Delete buttons. *@
<Modal Open="viewing is not null" Title="@(viewing?.Title ?? "Announcement")" OnClose="CloseViewing">
    @if (viewing is not null)
    {
        <AnnouncementCard Item="viewing" Today="today" OnEdit="EditFromView" OnDelete="DeleteFromView" />
    }
</Modal>

@* A holiday of the Philippines: the academic coordinator can delete it from the calendars of all the years. *@
<Modal Open="viewingHoliday is not null" Title="@(viewingHoliday?.Name ?? "Holiday")" Centered="true" OnClose="CloseHoliday">
    @if (viewingHoliday is { } hol)
    {
        <p class="dialog-text"><Icon Name="flag" Size="16" /> <strong>@hol.Day.ToString("dddd, MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</strong> · @hol.Kind@(hol.Estimated ? " · the day can change" : "")</p>
        <p class="dialog-text">Delete it and it is taken off the calendar of everybody, <strong>in all the years</strong>. You can bring it back later from <em>Deleted holidays</em>.</p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseHoliday">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="() => DeleteHolidayAsync(hol.Name)">@(busy ? "Deleting…" : "Delete in all years")</Button>
        </div>
    }
</Modal>

<Modal Open="deletedOpen" Title="Deleted holidays" Centered="true" OnClose="CloseDeletedHolidays">
    @if (deletedOpen)
    {
        @if (deletedHolidays.Count == 0)
        {
            <p class="muted">No holiday was deleted.</p>
        }
        else
        {
            <ul class="deleted-list">
                @foreach (var name in deletedHolidays)
                {
                    var shown = name;
                    <li><span><Icon Name="flag" Size="14" /> @shown</span> <Button Small="true" Variant="ButtonVariant.Secondary" IconName="undo-2" Disabled="busy" OnClick="() => RestoreHolidayAsync(shown)">Bring it back</Button></li>
                }
            </ul>
        }

        <div class="modal-actions"><Button Variant="ButtonVariant.Ghost" OnClick="CloseDeletedHolidays">Close</Button></div>
    }
</Modal>

@* All the announcements of one day, when it has more than the cell shows. *@
<Modal Open="listDay is not null" Title="@(listDay is { } d ? d.ToString("dddd, MMMM d", System.Globalization.CultureInfo.InvariantCulture) : "")" OnClose="CloseDayList">
    @if (listDay is { } day)
    {
        <ul class="day-list">
            @foreach (var holiday in HolidaysOn(day))
            {
                <li><button type="button" class="chip holiday" @onclick="() => { listDay = null; viewingHoliday = holiday; }"><Icon Name="flag" Size="12" /> <span>@holiday.Name</span></button></li>
            }

            @foreach (var row in OnDay(day))
            {
                <li><button type="button" class="chip @row.Category" @onclick="() => { listDay = null; viewing = row; }"><Icon Name="@AnnouncementCategories.Icon(row.Category)" Size="12" /> <span>@row.Title</span></button></li>
            }
        </ul>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Secondary" IconName="plus" OnClick="() => { listDay = null; OpenAdd(day); }">Add one on this day</Button>
        </div>
    }
</Modal>

<Modal Open="form is not null" Title="@(form?.Id is null ? "New announcement" : "Edit announcement")" OnClose="CloseForm">
    @if (form is not null)
    {
        <EditForm Model="form" OnSubmit="SaveAsync">
            <FormErrors Errors="errors" />

            <fieldset class="kinds">
                <legend>What is it about?</legend>
                <div class="kind-grid" role="radiogroup" aria-label="What the announcement is about">
                    @foreach (var category in AnnouncementCategories.All)
                    {
                        var c = category;
                        <button type="button" role="radio" aria-checked="@(form.Category == c ? "true" : "false")" class="kind @c @(form.Category == c ? "on" : "")" @onclick="() => PickCategory(c)">
                            <Icon Name="@AnnouncementCategories.Icon(c)" Size="18" />
                            <span>@AnnouncementCategories.DisplayPlural(c)</span>
                        </button>
                    }
                </div>
            </fieldset>

            <Field For="a-title" Label="Title" Required="true">
                <input id="a-title" maxlength="@AnnouncementService.MaxTitleLength" autocomplete="off" @bind="form.Title" />
            </Field>
            <Field For="a-body" Label="Announcement" Required="true" Hint="@($"Up to {AnnouncementService.MaxBodyLength} characters.")">
                <textarea id="a-body" rows="5" maxlength="@AnnouncementService.MaxBodyLength" @bind="form.Body"></textarea>
            </Field>

            <Field For="a-audience" Label="For" Required="true" Hint="@(form.Category == AnnouncementCategories.TeachersMeeting ? "A teachers' meeting is for the teachers." : null)">
                <select id="a-audience" @bind="form.Audience" disabled="@(form.Category == AnnouncementCategories.TeachersMeeting)">
                    <option value="@AnnouncementAudiences.Everyone">Everybody (staff, teachers and students)</option>
                    <option value="@AnnouncementAudiences.Students">The students</option>
                    <option value="@AnnouncementAudiences.Teachers">The teachers</option>
                    <option value="@AnnouncementAudiences.Staff">The staff</option>
                    <option value="@AnnouncementAudiences.StaffTeachers">The staff and the teachers</option>
                </select>
            </Field>

            <div class="two">
                <Field For="a-start" Label="Start" Hint="Optional. The first day it is about.">
                    <input id="a-start" type="date" @bind="form.StartsOn" />
                </Field>

                <Field For="a-until" Label="End" Hint="Optional. Empty: until you delete it.">
                    <input id="a-until" type="date" @bind="form.ExpiresOn" />
                </Field>
            </div>
            <p class="hint-line">The people it is for get a notification, and see the days from Start to End in their calendar.</p>
            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseForm">Cancel</Button>
                <Button Type="submit" IconName="send" Disabled="busy">@(busy ? "Saving…" : form.Id is null ? "Post" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

<Modal Open="deleting is not null" Title="Delete this announcement?" OnClose="CloseDelete">
    @if (deleting is not null)
    {
        <p>You are about to delete <strong>@deleting.Title</strong>. People will not see it any more. <strong>This can't be undone.</strong></p>
        <FormErrors Errors="errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="DeleteAsync">@(busy ? "Deleting…" : "Delete")</Button>
        </div>
    }
</Modal>

@* Several announcements written in a sheet, like the questions of a quiz: Title, Message, About, For, Start and End in a row. *@
<AnnouncementsSheetDialog Open="sheetOpen" Today="today" Busy="busy" Errors="sheetErrors" OnPost="PostSheetAsync" OnClose="CloseSheet" />

@code {
    [Inject] private FileDownloads Downloads { get; set; } = null!;

    private async Task ExportAsync() => await Downloads.SaveAsync(AnnouncementSheets.FileName("Announcements"), AnnouncementSheets.Export(rows ?? []));

    private bool sheetOpen;
    private IReadOnlyList<string> sheetErrors = [];

    private void OpenSheet()
    {
        sheetErrors = [];
        sheetOpen = true;
    }

    private void CloseSheet() => sheetOpen = false;

    /// <summary>Every row is posted like the box posts one (the same rules, the same notification to the people it is for). The rows that could not be posted stay in the sheet with the reason.</summary>
    private async Task<IReadOnlyList<int>> PostSheetAsync(IReadOnlyList<AnnouncementInput> inputs)
    {
        var posted = new List<int>();
        var problems = new List<string>();
        if (busy || me is null)
        {
            return posted;
        }

        busy = true;
        try
        {
            for (var place = 0; place < inputs.Count; place++)
            {
                var saved = await Service.SaveAsync(me, inputs[place]);
                if (saved.Succeeded)
                {
                    posted.Add(place);
                }
                else
                {
                    problems.Add($"{inputs[place].Title}: {string.Join(" ", saved.Errors)}");
                }
            }

            sheetErrors = problems;
            await LoadAsync();
            if (problems.Count == 0)
            {
                sheetOpen = false;
                messageIsError = false;
                message = $"{posted.Count} announcement{(posted.Count == 1 ? " was" : "s were")} posted.";
            }
        }
        finally
        {
            busy = false;
        }

        // The sheet called this directly (not through a button of this page), so the page is drawn again here: the sheet closes, the list shows the new announcements.
        StateHasChanged();
        return posted;
    }

    private CurrentUserInfo? me;
    private IReadOnlyList<AnnouncementView>? rows;
    private AnnouncementInput? form;
    private AnnouncementView? deleting;
    private List<string> errors = [];
    private string? message;
    private bool messageIsError;
    private bool busy;
    private DateOnly today;
    private string filter = "all";
    private string view = "calendar";
    private DateOnly anchor;
    private AnnouncementView? viewing;
    private DateOnly? listDay;
    private IReadOnlyList<Holiday> holidays = [];
    private IReadOnlyList<string> deletedHolidays = [];
    private Holiday? viewingHoliday;
    private bool deletedOpen;

    private List<Holiday> HolidaysOn(DateOnly day) => [.. holidays.Where(h => h.Day == day)];

    private async Task LoadHolidaysAsync()
    {
        var days = MonthDays.ToList();
        holidays = days.Count == 0 ? [] : await Calendars.GetHolidaysAsync(days[0], days[^1]);
        deletedHolidays = await Calendars.GetDeletedHolidaysAsync();
    }

    private void CloseHoliday() => viewingHoliday = null;

    private async Task OpenDeletedHolidays()
    {
        deletedHolidays = await Calendars.GetDeletedHolidaysAsync();
        deletedOpen = true;
    }

    private void CloseDeletedHolidays() => deletedOpen = false;

    private async Task DeleteHolidayAsync(string name) => await SetHolidayAsync(name, true);

    private async Task RestoreHolidayAsync(string name) => await SetHolidayAsync(name, false);

    private async Task SetHolidayAsync(string name, bool deleted)
    {
        if (busy || me is null)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Calendars.SetHolidayDeletedAsync(me.UserId, name, deleted);
            messageIsError = !result.Succeeded;
            message = result.Succeeded ? result.Message : string.Join(" ", result.Errors);
            viewingHoliday = null;
            await LoadHolidaysAsync();
            if (deletedHolidays.Count == 0)
            {
                deletedOpen = false;
            }
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>The weeks of the month on the screen: from the Sunday on or before the 1st to the Saturday on or after the last day.</summary>
    private IEnumerable<DateOnly> MonthDays
    {
        get
        {
            var first = new DateOnly(anchor.Year, anchor.Month, 1);
            var last = first.AddMonths(1).AddDays(-1);
            var from = first.AddDays(-(int)first.DayOfWeek);
            var to = last.AddDays(6 - (int)last.DayOfWeek);
            for (var day = from; day <= to; day = day.AddDays(1))
            {
                yield return day;
            }
        }
    }

    /// <summary>The announcements (of the kind chosen above) that are about a day: every day from its Start to its End; with only one of them that day; with none, the day it was posted.</summary>
    private List<AnnouncementView> OnDay(DateOnly day) => [.. Shown.Where(a =>
    {
        var first = a.StartsOn ?? a.ExpiresOn ?? PhilippineTime.DayOf(a.CreatedAtUtc);
        var last = a.ExpiresOn ?? a.StartsOn ?? first;
        return first <= day && day <= last;
    })];

    private async Task MoveMonth(int by)
    {
        anchor = anchor.AddMonths(by);
        await LoadHolidaysAsync();
    }

    private async Task GoToday()
    {
        anchor = new DateOnly(today.Year, today.Month, 1);
        await LoadHolidaysAsync();
    }

    private void CloseViewing() => viewing = null;

    private void CloseDayList() => listDay = null;

    private void EditFromView(AnnouncementView row)
    {
        viewing = null;
        OpenEdit(row);
    }

    private void DeleteFromView(AnnouncementView row)
    {
        viewing = null;
        OpenDelete(row);
    }

    private IReadOnlyList<PillTabs.Tab> Tabs =>
    [
        new("all", "All", "megaphone", rows?.Count),
        .. AnnouncementCategories.All.Select(c => new PillTabs.Tab(c, AnnouncementCategories.DisplayPlural(c), AnnouncementCategories.Icon(c), rows?.Count(r => r.Category == c))),
    ];

    private IReadOnlyList<AnnouncementView> Shown => rows is null ? [] : filter == "all" ? rows : rows.Where(r => r.Category == filter).ToList();

    private void FilterChanged(string? key) => filter = key ?? "all";

    private void PickCategory(string category)
    {
        form!.Category = category;
        if (category == AnnouncementCategories.TeachersMeeting)
        {
            form.Audience = AnnouncementAudiences.Teachers;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        today = PhilippineTime.Today(Clock);
        anchor = new DateOnly(today.Year, today.Month, 1);
        me = await Me.GetInAreaAsync(AppRoles.AcademicCoordinator);
        if (me is null)
        {
            return;
        }

        await LoadAsync();
        await LoadHolidaysAsync();
    }

    private async Task LoadAsync() => rows = me is null ? [] : await Service.ListManagedAsync(me);

    private void ClearMessage() => message = null;

    /// <summary>The box that writes a new announcement; opened from a day of the calendar (double click) it starts on that day.</summary>
    private void OpenAdd(DateOnly? day)
    {
        errors = [];
        form = new AnnouncementInput();
        if (day is { } on)
        {
            form.StartsOn = on;
            form.ExpiresOn = on >= today ? on : null;
        }
    }

    private void OpenEdit(AnnouncementView row)
    {
        errors = [];
        form = new AnnouncementInput { Id = row.Id, Title = row.Title, Body = row.Body, Audience = row.Audience, Category = row.Category, StartsOn = row.StartsOn, ExpiresOn = row.ExpiresOn };
    }

    private void CloseForm() => form = null;

    private async Task SaveAsync()
    {
        if (busy || me is null)
        {
            return;
        }

        busy = true;
        errors = [];
        try
        {
            var result = await Service.SaveAsync(me, form!);
            if (result.Succeeded)
            {
                message = result.Message;
                messageIsError = false;
                form = null;
                await LoadAsync();
            }
            else
            {
                errors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenDelete(AnnouncementView row)
    {
        errors = [];
        deleting = row;
    }

    private void CloseDelete() => deleting = null;

    private async Task DeleteAsync()
    {
        if (busy || me is null)
        {
            return;
        }

        busy = true;
        errors = [];
        try
        {
            var result = await Service.DeleteAsync(me, deleting!.Id);
            if (result.Succeeded)
            {
                message = result.Message;
                messageIsError = false;
                deleting = null;
                await LoadAsync();
            }
            else
            {
                errors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }
}
