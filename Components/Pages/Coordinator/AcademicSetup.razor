@page "/coordinator/academic-setup"
@page "/coordinator/academic-setup/{TabKey}"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@using SEAITT_LMS.Components.Pages.Coordinator.Setup
@using SEAITT_LMS.Services
@inject SchoolSetupService Setup
@inject SetupWorkbookService Workbook
@inject CurrentUser Me
@inject FileDownloads Downloads
@inject IJSRuntime JS

<PageTitle>Academic setup · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Academic setup" IconName="school">
    <Button Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" OnClick="ExportAsync">Export to Excel</Button>
    <Button Variant="ButtonVariant.Secondary" IconName="upload" OnClick="OpenExcelAsync">Template and import (Excel)</Button>
</PageHeader>

<Notice Message="@message" IsError="false" OnDismiss="ClearMessage" />

<div class="setup">
    <form class="setup-search" role="search" @onsubmit="() => { }">
        <SearchField Id="setup-search" @bind-Value="search" Live="true" SubmitText="" Placeholder="Search a school year, a track, a strand, a course or a section" AriaLabel="Search the academic setup" />
    </form>

    @* Three steps, all on one page. Every box in them is ready to type in: a change is saved when the box is left. A new key makes the steps read their rows again (after an import). *@
    <div @key="reloadKey" class="steps">
        <section class="step" id="step-calendar" aria-labelledby="step-calendar-title">
            <header class="step-bar">
                <span class="step-num">1</span>
                <h2 id="step-calendar-title" class="step-name"><Icon Name="calendar-range" Size="20" /> School years and terms</h2>
                <span class="step-hint">The running school year and the next two, with three terms each</span>
                <span class="count">@CountOf("calendar")</span>
            </header>
            <div class="step-body">
                <CalendarStep Search="@search" OnChanged="ReloadCountsAsync" Version="changes" />
            </div>
        </section>

        <section class="step" id="step-curriculum" aria-labelledby="step-curriculum-title">
            <header class="step-bar">
                <span class="step-num">2</span>
                <h2 id="step-curriculum-title" class="step-name"><Icon Name="layers" Size="20" /> Tracks, strands and courses</h2>
                <span class="step-hint">A track has strands, a strand has its courses</span>
                <span class="count">@CountOf("curriculum")</span>
            </header>
            <div class="step-body">
                <CurriculumStep Search="@search" OnChanged="ReloadCountsAsync" Version="changes" />
            </div>
        </section>

        <section class="step" id="step-sections" aria-labelledby="step-sections-title">
            <header class="step-bar">
                <span class="step-num">3</span>
                <h2 id="step-sections-title" class="step-name"><Icon Name="users" Size="20" /> Sections and class schedule</h2>
                <span class="step-hint">A and B for each strand and grade level</span>
                <span class="count">@CountOf("sections")</span>
            </header>
            <div class="step-body">
                <SectionsStep Search="@search" OnChanged="ReloadCountsAsync" Version="changes" />
            </div>
        </section>
    </div>
</div>

<SheetImportDialog Open="excelOpen" Title="Academic setup in Excel"
                   Lead="One workbook has a sheet for the school years, terms, tracks, strands, courses, the courses of each strand, sections, the hours of the day and the class schedule. Fill in the template, or export what the school has, change it and import it again."
                   Single="row was" Plural="rows were" Added="saved" RowLabel="Sheet and row" PreviewHint="The rows with a problem are left out; the reason is on its line. A row that needs something that is not there yet (a school year, a strand) says so after the import."
                   TemplateName="@SetupSheets.FileName("Template")" Template="SetupSheets.Template"
                   Export="ExportBytes" ExportName="@SetupSheets.FileName("Academic setup")" ExportLabel="Export what the school has" ExportCount="@(snapshot?.Total ?? 0)"
                   Read="ReadSheet" OnImport="ImportSheetAsync" OnClose="CloseExcel" />

@code {
    [Parameter] public string? TabKey { get; set; }

    private SetupCounts? counts;
    private int reloadKey;
    private string? message;
    private bool excelOpen;
    private SetupSnapshot? snapshot;
    private string search = "";

    protected override async Task OnParametersSetAsync()
    {
        counts ??= await Setup.GetCountsAsync();

        // An address like academic-setup/sections goes to that step (the old names of the steps still work).
        var wanted = (TabKey ?? "").ToLowerInvariant() switch
        {
            "school-years" or "terms" or "calendar" => "calendar",
            "tracks" or "strands" or "subjects" or "curriculum" => "curriculum",
            "sections" => "sections",
            _ => null,
        };
        if (wanted is not null && scrolledTo != wanted)
        {
            scrolledTo = wanted;
            scrollTo = wanted;
        }
    }

    private string? scrolledTo;
    private string? scrollTo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollTo is { } key)
        {
            scrollTo = null;
            await JS.InvokeVoidAsync("seaitt.goToId", $"step-{key}");
        }
    }

    private int changes;

    /// <summary>Something was saved or deleted in one step: the numbers are read again, and the other steps read their lists again (a new strand is a choice in Sections).</summary>
    private async Task ReloadCountsAsync()
    {
        counts = await Setup.GetCountsAsync();
        changes++;
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- the Excel workbook of the whole setup

    private async Task ExportAsync()
    {
        var all = await Workbook.GetSnapshotAsync();
        await Downloads.SaveAsync(SetupSheets.FileName("Academic setup"), SetupSheets.Export(all));
    }

    private async Task OpenExcelAsync()
    {
        snapshot = await Workbook.GetSnapshotAsync();
        excelOpen = true;
    }

    private void CloseExcel() => excelOpen = false;

    private byte[] ExportBytes() => SetupSheets.Export(snapshot ?? SetupSnapshot.Empty);

    private static SheetImportDialog.SheetPreview ReadSheet(byte[] data)
    {
        var book = SetupSheets.Parse(data);
        return new SheetImportDialog.SheetPreview([.. book.Lines.Select(l => new SheetImportDialog.SheetPreviewRow(l.Place, l.Title, l.IsReady ? null : string.Join(" ", l.Errors)))], book.FileError);
    }

    /// <summary>The rows without problems are saved by the same rules as the steps; then the steps and their numbers are read again.</summary>
    private async Task<ItemImportSummary> ImportSheetAsync(byte[] data)
    {
        var user = await Me.GetAsync();
        if (user is null)
        {
            return new ItemImportSummary(0, ["Sign in again to import."]);
        }

        var result = await Workbook.ImportAsync(SetupSheets.Parse(data), user.UserId);
        await ReloadCountsAsync();
        reloadKey++;
        if (result.Saved > 0)
        {
            message = $"The academic setup was updated from the workbook ({result.Saved} {(result.Saved == 1 ? "row" : "rows")}).";
        }

        return new ItemImportSummary(result.Saved, result.Errors);
    }

    private string CountOf(string key) => counts is null ? "" : key switch
    {
        "calendar" => $"{counts.SchoolYears} {(counts.SchoolYears == 1 ? "school year" : "school years")} · {counts.Terms} {(counts.Terms == 1 ? "term" : "terms")}",
        "curriculum" => $"{counts.Tracks} {(counts.Tracks == 1 ? "track" : "tracks")} · {counts.Strands} {(counts.Strands == 1 ? "strand" : "strands")} · {counts.Subjects} {(counts.Subjects == 1 ? "course" : "courses")}",
        "sections" => $"{counts.Sections} {(counts.Sections == 1 ? "section" : "sections")} · {counts.CourseTimes} {(counts.CourseTimes == 1 ? "class time" : "class times")}",
        _ => "",
    };
}
