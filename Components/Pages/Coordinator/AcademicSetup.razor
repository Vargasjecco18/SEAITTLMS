@page "/coordinator/academic-setup"
@page "/coordinator/academic-setup/{TabKey}"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@using SEAITT_LMS.Components.Pages.Coordinator.Setup
@using SEAITT_LMS.Services
@inject SchoolSetupService Setup
@inject SetupWorkbookService Workbook
@inject CurrentUser Me
@inject FileDownloads Downloads
@inject NavigationManager Navigation

<PageTitle>Academic setup · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Academic setup" IconName="school">
    @* One button for the Excel file of the whole setup. *@
    <details class="pop excel-pop">
        <summary class="excel-button"><Icon Name="file-spreadsheet" Size="16" /> <span>Excel</span> <Icon Name="chevron-down" Size="14" /></summary>
        <div class="excel-panel">
            <button type="button" class="excel-item" @onclick="ExportAsync"><Icon Name="download" Size="16" /> Export to Excel</button>
            <button type="button" class="excel-item" @onclick="OpenExcelAsync"><Icon Name="upload" Size="16" /> Template and import (Excel)</button>
        </div>
    </details>
</PageHeader>

<Notice Message="@message" IsError="false" OnDismiss="ClearMessage" />

@* The menu of the school folds to its icons on this page by itself (wwwroot/app.js looks for this marker). The button of the tabs below hides only the tabs. *@
<span data-side-rail hidden></span>

<div class="setup-shell @(menuHidden ? "is-compact" : "")">
    @* The parts of the setup, one at a time (the tabs at the left). The class sections have their own place in the menu of the school. *@
    <nav class="setup-tabs" aria-label="Parts of the academic setup">
        <button type="button" class="tabs-toggle" aria-expanded="@(menuHidden ? "false" : "true")" title="@(menuHidden ? "Show the tabs" : "Hide the tabs")" @onclick="() => menuHidden = !menuHidden">
            <Icon Name="@(menuHidden ? "panel-left-open" : "panel-left-close")" Size="18" /> <span class="tab-label">@(menuHidden ? "Show tabs" : "Hide tabs")</span>
        </button>

        <a class="tab @(tab == "school-years" ? "on" : "")" title="School years" href="coordinator/academic-setup/school-years" aria-current="@(tab == "school-years" ? "page" : null)">
            <span class="tab-icon"><Icon Name="calendar-range" Size="18" /></span>
            <span class="tab-text"><strong>School years</strong><small>@CountOf("school-years")</small></span>
            <span class="tab-chevron" aria-hidden="true"><Icon Name="@(tab == "school-years" ? "chevron-down" : "chevron-right")" Size="16" /></span>
        </a>
        @if (tab == "school-years" && lookups is not null)
        {
            <ul class="tab-sub" aria-label="School years">
                @foreach (var year in lookups.Years)
                {
                    <li><a href="@($"coordinator/academic-setup/school-years#sy-{year.Id}")">@year.Name</a></li>
                }
            </ul>
        }
        <a class="tab @(tab == "curriculum" ? "on" : "")" title="Tracks, strands and courses" href="coordinator/academic-setup/curriculum" aria-current="@(tab == "curriculum" ? "page" : null)">
            <span class="tab-icon"><Icon Name="layers" Size="18" /></span>
            <span class="tab-text"><strong>Tracks, strands and courses</strong><small>@CountOf("curriculum")</small></span>
            <span class="tab-chevron" aria-hidden="true"><Icon Name="@(tab == "curriculum" ? "chevron-down" : "chevron-right")" Size="16" /></span>
        </a>
        @if (tab == "curriculum" && lookups is not null)
        {
            <ul class="tab-sub" aria-label="Tracks and strands">
                @foreach (var t in lookups.Tracks)
                {
                    <li>
                        <a class="sub-track @(TrackQuery == t.Id && StrandQuery is null ? "on" : "")" href="@($"coordinator/academic-setup/curriculum?track={t.Id}")">@t.Code</a>
                        <ul>
                            @foreach (var st in lookups.Strands.Where(x => x.Track == t.Code))
                            {
                                <li><a class="@(StrandQuery == st.Id ? "on" : "")" href="@($"coordinator/academic-setup/curriculum?track={t.Id}&strand={st.Id}")" title="@st.Name">@st.Code</a></li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        }
        <a class="tab @(tab == "sections" ? "on" : "")" title="Class sections" href="coordinator/academic-setup/sections" aria-current="@(tab == "sections" ? "page" : null)">
            <span class="tab-icon"><Icon Name="users" Size="18" /></span>
            <span class="tab-text"><strong>Class sections</strong><small>@CountOf("sections")</small></span>
            <span class="tab-chevron" aria-hidden="true"><Icon Name="@(tab == "sections" ? "chevron-down" : "chevron-right")" Size="16" /></span>
        </a>
        @if (tab == "sections")
        {
            @* A multilevel list: the grade level, inside it the strands and inside each strand its sections (the grade level that is chosen is the one that is open). *@
            <ul class="tab-sub" aria-label="Grade levels, strands and sections">
                @foreach (var grade in new[] { 11, 12 })
                {
                    var open = (GradeQuery == 12 ? 12 : 11) == grade;
                    <li>
                        <a class="sub-track @(open ? "on" : "")" href="@($"coordinator/academic-setup/sections?grade={grade}")" aria-expanded="@(open ? "true" : "false")">Grade @grade</a>
                        @if (open && lookups is not null)
                        {
                            <ul aria-label="@($"Strands of grade {grade}")">
                                @foreach (var st in lookups.Strands)
                                {
                                    var names = SectionNamesOf(grade, st.Code);
                                    <li>
                                        <a class="sub-track" href="@($"coordinator/academic-setup/sections?grade={grade}#strand-{st.Code}")" title="@st.Name">@st.Code</a>
                                        <ul class="tab-names" aria-label="@($"Sections of {st.Code}")">
                                            @foreach (var name in names)
                                            {
                                                <li><a href="@($"coordinator/academic-setup/sections?grade={grade}#sec-{grade}-{st.Code}-{name}")" title="@($"Section {name} of {st.Code}")">@name</a></li>
                                            }
                                        </ul>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }
    </nav>

    <div class="setup-main">
        <div class="setup-top">
            <form class="setup-search" role="search" @onsubmit="() => { }">
                <SearchField Id="setup-search" @bind-Value="search" Live="true" SubmitText="" Placeholder="@SearchHint" AriaLabel="Search the academic setup" />
            </form>
            @if (Lead.Length > 0)
            {
                <p class="setup-lead">@Lead</p>
            }
        </div>

        @* A new key makes the part read its rows again (after an import). *@
        <div @key="@($"{tab}-{reloadKey}")" class="setup-panel" id="@($"step-{tab}")">
            @switch (tab)
            {
                case "curriculum":
                    <CurriculumStep Search="@search" OnChanged="ReloadCountsAsync" Version="changes" InitialTrack="TrackQuery" InitialStrand="StrandQuery" />
                    break;
                case "sections":
                    <SectionsStep Search="@search" OnChanged="ReloadCountsAsync" Version="changes" InitialGrade="GradeQuery" />
                    break;
                default:
                    <CalendarStep Search="@search" OnChanged="ReloadCountsAsync" Version="changes" />
                    break;
            }
        </div>
    </div>
</div>

<SheetImportDialog Open="excelOpen" Title="Academic setup in Excel"
                   Lead="One workbook has a sheet for the school years, terms, tracks, strands, courses, the courses of each strand, and sections. Fill in the template, or export what the school has, change it and import it again."
                   Single="row was" Plural="rows were" Added="saved" RowLabel="Sheet and row" PreviewHint="The rows with a problem are left out; the reason is on its line. A row that needs something that is not there yet (a school year, a strand) says so after the import."
                   TemplateName="@SetupSheets.FileName("Template")" Template="SetupSheets.Template"
                   Export="ExportBytes" ExportName="@SetupSheets.FileName("Academic setup")" ExportLabel="Export what the school has" ExportCount="@(snapshot?.Total ?? 0)"
                   Read="ReadSheet" OnImport="ImportSheetAsync" OnClose="CloseExcel" />

@code {
    [Parameter] public string? TabKey { get; set; }

    /// <summary>What the dropdown of a tab asks for: a track, a strand, a class.</summary>
    [SupplyParameterFromQuery(Name = "track")] private int? TrackQuery { get; set; }

    [SupplyParameterFromQuery(Name = "strand")] private int? StrandQuery { get; set; }

    [SupplyParameterFromQuery(Name = "grade")] private int? GradeQuery { get; set; }

    private SetupLookups? lookups;
    private IReadOnlyList<SectionRow> sectionRows = [];

    /// <summary>The sections a strand has at a grade level in the school years that are not over (A, B, C ...), for the list under the Class sections tab.</summary>
    private IEnumerable<string> SectionNamesOf(int grade, string strandCode) =>
        sectionRows.Where(r => r.GradeLevel == grade && r.StrandCode == strandCode).Select(r => r.Name).Distinct().Order(StringComparer.OrdinalIgnoreCase);

    private SetupCounts? counts;
    private int reloadKey;
    private string? message;
    private bool excelOpen;
    private SetupSnapshot? snapshot;
    private string search = "";
    private string tab = "school-years";
    private bool menuHidden;

    protected override async Task OnParametersSetAsync()
    {
        counts ??= await Setup.GetCountsAsync();
        lookups ??= await Setup.GetLookupsAsync();

        // An address like academic-setup/curriculum goes to that part (the old names of the parts still work; the sections have a page of their own now).
        var wanted = (TabKey ?? "").ToLowerInvariant() switch
        {
            "school-years" or "terms" or "calendar" or "" => "school-years",
            "tracks" or "strands" or "subjects" or "curriculum" => "curriculum",
            "sections" => "sections",
            _ => "school-years",
        };

        if (wanted != tab)
        {
            tab = wanted;
            search = "";
        }

        // The sections under the Class sections tab (its list of grade level, strand and sections).
        sectionRows = tab == "sections" ? await Setup.ListSectionsAsync() : [];
    }

    private string SearchHint => tab switch
    {
        "curriculum" => "Search a track, a strand or a course",
        "sections" => "Search a strand, a section or an adviser",
        _ => "Search a school year or a term",
    };

    private string Lead => tab switch
    {
        "curriculum" => "",
        "sections" => "Each class has its strands, and each strand its sections. Press a card for the adviser and the students.",
        _ => "The school year now and the next two, with three terms each.",
    };

    private int changes;

    /// <summary>Something was saved or deleted in one step: the numbers are read again, and the other steps read their lists again (a new strand is a choice in Sections).</summary>
    private async Task ReloadCountsAsync()
    {
        counts = await Setup.GetCountsAsync();
        lookups = await Setup.GetLookupsAsync();
        changes++;
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- the Excel workbook of the whole setup

    private async Task ExportAsync()
    {
        var all = await Workbook.GetSnapshotAsync();
        await Downloads.SaveAsync(SetupSheets.FileName("Academic setup"), SetupSheets.Export(all));
    }

    private async Task OpenExcelAsync()
    {
        snapshot = await Workbook.GetSnapshotAsync();
        excelOpen = true;
    }

    private void CloseExcel() => excelOpen = false;

    private byte[] ExportBytes() => SetupSheets.Export(snapshot ?? SetupSnapshot.Empty);

    private static SheetImportDialog.SheetPreview ReadSheet(byte[] data)
    {
        var book = SetupSheets.Parse(data);
        return new SheetImportDialog.SheetPreview([.. book.Lines.Select(l => new SheetImportDialog.SheetPreviewRow(l.Place, l.Title, l.IsReady ? null : string.Join(" ", l.Errors)))], book.FileError);
    }

    /// <summary>The rows without problems are saved by the same rules as the steps; then the steps and their numbers are read again.</summary>
    private async Task<ItemImportSummary> ImportSheetAsync(byte[] data)
    {
        var user = await Me.GetAsync();
        if (user is null)
        {
            return new ItemImportSummary(0, ["Sign in again to import."]);
        }

        var result = await Workbook.ImportAsync(SetupSheets.Parse(data), user.UserId);
        await ReloadCountsAsync();
        reloadKey++;
        if (result.Saved > 0)
        {
            message = $"The academic setup was updated from the workbook ({result.Saved} {(result.Saved == 1 ? "row" : "rows")}).";
        }

        return new ItemImportSummary(result.Saved, result.Errors);
    }

    private string CountOf(string key) => counts is null ? "" : key switch
    {
        "school-years" => $"{counts.SchoolYears} {(counts.SchoolYears == 1 ? "school year" : "school years")} · {counts.Terms} {(counts.Terms == 1 ? "term" : "terms")}",
        "curriculum" => $"{counts.Tracks} {(counts.Tracks == 1 ? "track" : "tracks")} · {counts.Strands} {(counts.Strands == 1 ? "strand" : "strands")} · {counts.Subjects} {(counts.Subjects == 1 ? "course" : "courses")}",
        "sections" => $"{counts.Sections} {(counts.Sections == 1 ? "section" : "sections")}",
        _ => "",
    };
}
