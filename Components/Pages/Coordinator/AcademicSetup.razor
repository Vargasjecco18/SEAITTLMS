@page "/coordinator/academic-setup"
@page "/coordinator/academic-setup/{TabKey}"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@using SEAITT_LMS.Components.Pages.Coordinator.Setup
@using SEAITT_LMS.Services
@inject SchoolSetupService Setup
@inject SetupWorkbookService Workbook
@inject CurrentUser Me
@inject FileDownloads Downloads
@inject IJSRuntime JS

<PageTitle>Academic setup · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Academic setup" IconName="school">
    <Button Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" OnClick="ExportAsync">Export to Excel</Button>
    <Button Variant="ButtonVariant.Secondary" IconName="upload" OnClick="OpenExcelAsync">Template and import (Excel)</Button>
</PageHeader>

<Notice Message="@message" IsError="false" OnDismiss="ClearMessage" />

<div class="setup">
    <p class="setup-lead">Everything the school needs is here, in order. <strong>Press a name to open it</strong>: you see what is inside and the fields to add something new. Press <strong>Edit</strong> on a line to change it.</p>

    @* Each step is a dropdown: the page stays short, and a step reads its lines only when it is open. A new key makes the open steps read their rows again (after an import). *@
    <div @key="reloadKey" class="steps">
        @foreach (var (t, place) in Tabs.Select((t, i) => (t, i + 1)))
        {
            var isOpen = openSteps.Contains(t.Key);
            <section class="step @(isOpen ? "open" : "")" id="@($"step-{t.Key}")">
                <h2 class="step-title">
                    <button type="button" class="step-head" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="@($"step-{t.Key}-body")" @onclick="() => ToggleStep(t.Key)">
                        <span class="step-num">@place</span>
                        <Icon Name="@t.Icon" Size="20" />
                        <span class="step-name">@t.Label</span>
                        <span class="step-hint">@t.Hint</span>
                        <span class="count">@CountOf(t.Key)</span>
                        <span class="step-chevron" aria-hidden="true"><Icon Name="@(isOpen ? "chevron-up" : "chevron-down")" Size="18" /></span>
                    </button>
                </h2>
                @if (isOpen)
                {
                    <div class="step-body" id="@($"step-{t.Key}-body")">
                        @switch (t.Key)
                        {
                            case "school-years":
                                <SchoolYearsTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                            case "terms":
                                <TermsTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                            case "tracks":
                                <TracksTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                            case "strands":
                                <StrandsTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                            case "subjects":
                                <SubjectsTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                            case "sections":
                                <SectionsTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                            case "class-schedule":
                                <ScheduleTab OnChanged="ReloadCountsAsync" Version="changes" />
                                break;
                        }
                    </div>
                }
            </section>
        }
    </div>
</div>

<SheetImportDialog Open="excelOpen" Title="Academic setup in Excel"
                   Lead="One workbook has a sheet for the school years, terms, tracks, strands, courses, the courses of each strand, sections, the hours of the day and the class schedule. Fill in the template, or export what the school has, change it and import it again."
                   Single="row was" Plural="rows were" Added="saved" RowLabel="Sheet and row" PreviewHint="The rows with a problem are left out; the reason is on its line. A row that needs something that is not there yet (a school year, a strand) says so after the import."
                   TemplateName="@SetupSheets.FileName("Template")" Template="SetupSheets.Template"
                   Export="ExportBytes" ExportName="@SetupSheets.FileName("Academic setup")" ExportLabel="Export what the school has" ExportCount="@(snapshot?.Total ?? 0)"
                   Read="ReadSheet" OnImport="ImportSheetAsync" OnClose="CloseExcel" />

@code {
    private sealed record SetupTab(string Key, string Label, string Icon, string Hint);

    private static readonly SetupTab[] Tabs =
    [
        new("school-years", "School years", "calendar-range", "Like 2026-2027"),
        new("terms", "Terms", "calendar-days", "1st term, 2nd term ..."),
        new("tracks", "Tracks", "layers", "Academic, Technical-Professional"),
        new("strands", "Strands", "layout-grid", "And the courses of each"),
        new("subjects", "Courses", "book-open", "The subjects"),
        new("sections", "Sections", "users", "And the students in them"),
        new("class-schedule", "Class schedule", "clock", "Days and hours of each course"),
    ];

    // The steps that are open. The step the address names (academic-setup/sections) is open at the start.
    private readonly HashSet<string> openSteps = [];

    private void ToggleStep(string key)
    {
        if (!openSteps.Remove(key))
        {
            openSteps.Add(key);
        }
    }

    [Parameter] public string? TabKey { get; set; }

    private SetupCounts? counts;
    private int reloadKey;
    private string? message;
    private bool excelOpen;
    private SetupSnapshot? snapshot;

    protected override async Task OnParametersSetAsync()
    {
        counts ??= await Setup.GetCountsAsync();

        // An address like academic-setup/sections opens that step (the links of the menu use them).
        if (Tabs.FirstOrDefault(t => string.Equals(t.Key, TabKey, StringComparison.OrdinalIgnoreCase)) is { } wanted && openedFor != wanted.Key)
        {
            openedFor = wanted.Key;
            openSteps.Add(wanted.Key);
            scrollTo = wanted.Key;
        }
    }

    private string? openedFor;
    private string? scrollTo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollTo is { } key)
        {
            scrollTo = null;
            await JS.InvokeVoidAsync("seaitt.goToId", $"step-{key}");
        }
    }

    private int changes;

    /// <summary>Something was saved or deleted in one step: the numbers are read again, and the other steps read their lists again (a new school year is a choice in Terms and Sections).</summary>
    private async Task ReloadCountsAsync()
    {
        counts = await Setup.GetCountsAsync();
        changes++;
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- the Excel workbook of the whole setup

    private async Task ExportAsync()
    {
        var all = await Workbook.GetSnapshotAsync();
        await Downloads.SaveAsync(SetupSheets.FileName("Academic setup"), SetupSheets.Export(all));
    }

    private async Task OpenExcelAsync()
    {
        snapshot = await Workbook.GetSnapshotAsync();
        excelOpen = true;
    }

    private void CloseExcel() => excelOpen = false;

    private byte[] ExportBytes() => SetupSheets.Export(snapshot ?? SetupSnapshot.Empty);

    private static SheetImportDialog.SheetPreview ReadSheet(byte[] data)
    {
        var book = SetupSheets.Parse(data);
        return new SheetImportDialog.SheetPreview([.. book.Lines.Select(l => new SheetImportDialog.SheetPreviewRow(l.Place, l.Title, l.IsReady ? null : string.Join(" ", l.Errors)))], book.FileError);
    }

    /// <summary>The rows without problems are saved by the same rules as the tabs; then the tabs and their numbers are read again.</summary>
    private async Task<ItemImportSummary> ImportSheetAsync(byte[] data)
    {
        var user = await Me.GetAsync();
        if (user is null)
        {
            return new ItemImportSummary(0, ["Sign in again to import."]);
        }

        var result = await Workbook.ImportAsync(SetupSheets.Parse(data), user.UserId);
        await ReloadCountsAsync();
        reloadKey++;
        if (result.Saved > 0)
        {
            message = $"The academic setup was updated from the workbook ({result.Saved} {(result.Saved == 1 ? "row" : "rows")}).";
        }

        return new ItemImportSummary(result.Saved, result.Errors);
    }

    private string CountOf(string key) => counts is null ? "" : key switch
    {
        "school-years" => counts.SchoolYears.ToString(),
        "terms" => counts.Terms.ToString(),
        "tracks" => counts.Tracks.ToString(),
        "strands" => counts.Strands.ToString(),
        "subjects" => counts.Subjects.ToString(),
        "sections" => counts.Sections.ToString(),
        "class-schedule" => counts.CourseTimes.ToString(),
        _ => "",
    };
}
