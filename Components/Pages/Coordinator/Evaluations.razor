@page "/coordinator/evaluations"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject EvaluationService Service
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>Teacher evaluation · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Teacher evaluation"
            IconName="clipboard-check">
    <ButtonLink Href="coordinator/analytics" Variant="ButtonVariant.Secondary" IconName="chart-column">Analytics</ButtonLink>
    <Button IconName="plus" Disabled="busy" OnClick="OpenSheetAsync">New evaluation</Button>
</PageHeader>

<Notice Message="@message" IsError="true" OnDismiss="ClearMessage" />

<Card>
    @if (rows is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (rows.Count == 0)
    {
        <EmptyState IconName="clipboard-check" Title="No evaluation yet">
            <p>A new evaluation starts with the usual questions about a teacher. You change them, choose the teachers' courses and the due date, and send it. The students are told and answer in their dashboard.</p>
            <Button IconName="plus" Disabled="busy" OnClick="OpenSheetAsync">New evaluation</Button>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Evaluation</th>
                        <th scope="col">Status</th>
                        <th scope="col">Due</th>
                        <th scope="col">Answers</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td>
                                <a class="name" href="coordinator/evaluations/@row.Id">@row.Title</a>
                                <span class="sub">@row.Questions @(row.Questions == 1 ? "question" : "questions")@(row.State == EvaluationStates.Draft ? "" : $" · {row.Courses} {(row.Courses == 1 ? "course" : "courses")}")</span>
                            </td>
                            <td><Badge Tone="@StateTone(row.State)">@row.State</Badge></td>
                            <td>
                                @if (row.DueAtUtc is { } due)
                                {
                                    <span>@PhilippineTime.FormatDateTime(due)</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                @if (row.State == EvaluationStates.Draft)
                                {
                                    <span class="muted">Not sent yet</span>
                                }
                                else
                                {
                                    <div class="rate" title="@row.Responses of @row.Expected answered">
                                        <span class="rate-bar"><span class="rate-fill" style="width: @(Math.Min(100, row.RatePercent))%"></span></span>
                                        <span>@row.Responses / @row.Expected · @row.RatePercent%</span>
                                    </div>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <ButtonLink Href="@($"coordinator/evaluations/{row.Id}")" IconName="arrow-right" IconAfter="true" Small="true">Open</ButtonLink>
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="copy" Disabled="busy" Title="@($"Make a copy of {row.Title}")" OnClick="() => CopyAsync(row.Id)">Copy</Button>
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" Disabled="busy" Title="@($"Export {row.Title} to Excel")" OnClick="() => ExportAsync(row.Id)">Excel</Button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

@* The questions of a new evaluation are written in a sheet, like the questions of a quiz: its title and instructions above, a row for each question. *@
<EvaluationSheetDialog Open="sheetOpen" Heading="New evaluation" Existing="DefaultQuestions" Busy="busy" Errors="sheetErrors" SaveBlocked="@(newTitle.Trim().Length == 0)"
                       SaveStep="The evaluation is made as a draft. Open it to choose the teachers' courses and the due date, then send it." OnSave="SaveSheetAsync" OnClose="CloseSheet">
    <HeaderContent>
        <Field Label="Title" For="new-eval-title" Required="true">
            <input id="new-eval-title" type="text" maxlength="200" autocomplete="off" @bind="newTitle" @bind:event="oninput" />
        </Field>
        <Field Label="Instructions for the students" For="new-eval-instructions">
            <input id="new-eval-instructions" type="text" maxlength="2000" autocomplete="off" @bind="newInstructions" @bind:event="oninput" />
        </Field>
    </HeaderContent>
</EvaluationSheetDialog>

@code {
    [Inject] private FileDownloads Downloads { get; set; } = null!;

    private async Task ExportAsync(int id)
    {
        if (await Service.GetAsync(id) is { } detail)
        {
            await Downloads.SaveAsync(EvaluationSheets.FileName(detail.Title), EvaluationSheets.Export(detail));
        }
    }

    private static IReadOnlyList<EvaluationQuestionInput> DefaultQuestions => EvaluationService.DefaultQuestions;

    private bool sheetOpen;
    private string newTitle = "";
    private string newInstructions = EvaluationService.DefaultInstructions;
    private IReadOnlyList<string> sheetErrors = [];

    private async Task OpenSheetAsync()
    {
        newTitle = await Service.DefaultTitleAsync();
        newInstructions = EvaluationService.DefaultInstructions;
        sheetErrors = [];
        sheetOpen = true;
    }

    private void CloseSheet() => sheetOpen = false;

    /// <summary>Makes a new draft evaluation with the title, the instructions and the questions of the sheet, then opens it.</summary>
    private async Task SaveSheetAsync(IReadOnlyList<EvaluationQuestionInput> questions)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            sheetErrors = [];
            var me = await Me.GetAsync();
            var result = me is null
                ? ServiceResult.Fail("Please sign in again.")
                : await Service.CreateWithQuestionsAsync(me.UserId, newTitle, newInstructions, questions);
            if (!result.Succeeded || result.Id is not { } id)
            {
                sheetErrors = [.. result.Errors];
                return;
            }

            sheetOpen = false;
            Navigation.NavigateTo($"coordinator/evaluations/{id}");
        }
        finally
        {
            busy = false;
        }
    }

    private IReadOnlyList<EvaluationRow>? rows;
    private string? message;
    private bool busy;

    protected override async Task OnInitializedAsync() => rows = await Service.ListAsync();

    private void ClearMessage() => message = null;

    private static Tone StateTone(string state) => state switch
    {
        EvaluationStates.Open => Tone.Success,
        EvaluationStates.Closed => Tone.Neutral,
        _ => Tone.Warning,
    };

    private async Task CopyAsync(int id)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var me = await Me.GetAsync();
            var result = me is null ? ServiceResult.Fail("Please sign in again.") : await Service.CopyAsync(me.UserId, id);
            if (!result.Succeeded || result.Id is not { } copyId)
            {
                message = string.Join(" ", result.Errors);
                return;
            }

            // The copy opens as a draft, ready to be changed and sent.
            Navigation.NavigateTo($"coordinator/evaluations/{copyId}");
        }
        finally
        {
            busy = false;
        }
    }
}
