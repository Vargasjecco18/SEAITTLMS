@page "/coordinator/evaluations"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject EvaluationService Service
@inject NavigationManager Navigation
@inject TimeProvider Clock

<PageTitle>Teacher evaluation · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Teacher evaluation"
            IconName="clipboard-check">
    <ButtonLink Href="coordinator/analytics" Variant="ButtonVariant.Secondary" IconName="chart-column">Analytics</ButtonLink>
    <Button Variant="ButtonVariant.Secondary" IconName="upload" OnClick="OpenExcel">Template and import (Excel)</Button>
    <Button IconName="plus" Disabled="busy" OnClick="CreateAsync">New evaluation</Button>
</PageHeader>

<Notice Message="@message" IsError="true" OnDismiss="ClearMessage" />

<Card>
    @if (rows is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (rows.Count == 0)
    {
        <EmptyState IconName="clipboard-check" Title="No evaluation yet">
            <p>A new evaluation starts with the usual questions about a teacher. You change them, choose the teachers' courses and the due date, and send it. The students are told and answer in their dashboard.</p>
            <Button IconName="plus" Disabled="busy" OnClick="CreateAsync">New evaluation</Button>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Evaluation</th>
                        <th scope="col">Status</th>
                        <th scope="col">Due</th>
                        <th scope="col">Answers</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td>
                                <a class="name" href="coordinator/evaluations/@row.Id">@row.Title</a>
                                <span class="sub">@row.Questions @(row.Questions == 1 ? "question" : "questions")@(row.State == EvaluationStates.Draft ? "" : $" · {row.Courses} {(row.Courses == 1 ? "course" : "courses")}")</span>
                            </td>
                            <td><Badge Tone="@StateTone(row.State)">@row.State</Badge></td>
                            <td>
                                @if (row.DueAtUtc is { } due)
                                {
                                    <span>@PhilippineTime.FormatDateTime(due)</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                @if (row.State == EvaluationStates.Draft)
                                {
                                    <span class="muted">Not sent yet</span>
                                }
                                else
                                {
                                    <div class="rate" title="@row.Responses of @row.Expected answered">
                                        <span class="rate-bar"><span class="rate-fill" style="width: @(Math.Min(100, row.RatePercent))%"></span></span>
                                        <span>@row.Responses / @row.Expected · @row.RatePercent%</span>
                                    </div>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <ButtonLink Href="@($"coordinator/evaluations/{row.Id}")" IconName="arrow-right" IconAfter="true" Small="true">Open</ButtonLink>
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="copy" Disabled="busy" Title="@($"Make a copy of {row.Title}")" OnClick="() => CopyAsync(row.Id)">Copy</Button>
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" Disabled="busy" Title="@($"Export {row.Title} to Excel")" OnClick="() => ExportAsync(row.Id)">Excel</Button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

<SheetImportDialog Open="excelOpen" Title="Evaluation in Excel" Lead="Fill in the template with the title, the instructions, the due date and the questions, then import it: a new draft evaluation is made. Open it to choose the teachers' courses and send it."
                   Single="evaluation was" Plural="evaluations were" Added="made as a draft" RowLabel="Part" PreviewHint="Take out what is marked and import again." TemplateName="@EvaluationSheets.FileName("Template")" Template="EvaluationSheets.Template"
                   Read="ReadSheet" OnImport="ImportSheetAsync" OnClose="CloseExcel" />

@code {
    [Inject] private FileDownloads Downloads { get; set; } = null!;

    private bool excelOpen;

    private void OpenExcel() => excelOpen = true;

    private void CloseExcel() => excelOpen = false;

    private async Task ExportAsync(int id)
    {
        if (await Service.GetAsync(id) is { } detail)
        {
            await Downloads.SaveAsync(EvaluationSheets.FileName(detail.Title), EvaluationSheets.Export(detail));
        }
    }

    private static SheetImportDialog.SheetPreview ReadSheet(byte[] data)
    {
        var parsed = EvaluationSheets.Parse(data);
        if (parsed.FileError is not null)
        {
            return new SheetImportDialog.SheetPreview([], parsed.FileError);
        }

        if (parsed.Errors.Count > 0)
        {
            return new SheetImportDialog.SheetPreview([.. parsed.Errors.Select(p => new SheetImportDialog.SheetPreviewRow("Problem", parsed.Details?.Title ?? "", p))], null);
        }

        return new SheetImportDialog.SheetPreview(
        [
            new SheetImportDialog.SheetPreviewRow("Evaluation", parsed.Details!.Title, null),
            new SheetImportDialog.SheetPreviewRow("Questions", parsed.Questions.Count == 1 ? "1 question" : $"{parsed.Questions.Count} questions", null),
        ], null);
    }

    /// <summary>Makes a new draft evaluation with the details and the questions of the workbook.</summary>
    private async Task<ItemImportSummary> ImportSheetAsync(byte[] data)
    {
        var parsed = EvaluationSheets.Parse(data);
        var me = await Me.GetAsync();
        if (parsed.Errors.Count > 0 || parsed.Details is null || me is null)
        {
            return new ItemImportSummary(0, parsed.Errors.Count > 0 ? parsed.Errors : ["Please sign in again."]);
        }

        var created = await Service.CreateAsync(me.UserId);
        if (!created.Succeeded || created.Id is not { } id)
        {
            return new ItemImportSummary(0, created.Errors);
        }

        var problems = new List<string>();
        var details = await Service.SaveAsync(me.UserId, id, parsed.Details);
        if (!details.Succeeded)
        {
            problems.AddRange(details.Errors);
        }

        var questions = await Service.SaveQuestionsAsync(me.UserId, id, parsed.Questions);
        if (!questions.Succeeded)
        {
            problems.AddRange(questions.Errors);
        }

        rows = await Service.ListAsync();
        return new ItemImportSummary(1, problems);
    }

    private IReadOnlyList<EvaluationRow>? rows;
    private string? message;
    private bool busy;

    protected override async Task OnInitializedAsync() => rows = await Service.ListAsync();

    private void ClearMessage() => message = null;

    private static Tone StateTone(string state) => state switch
    {
        EvaluationStates.Open => Tone.Success,
        EvaluationStates.Closed => Tone.Neutral,
        _ => Tone.Warning,
    };

    private async Task CopyAsync(int id)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var me = await Me.GetAsync();
            var result = me is null ? ServiceResult.Fail("Please sign in again.") : await Service.CopyAsync(me.UserId, id);
            if (!result.Succeeded || result.Id is not { } copyId)
            {
                message = string.Join(" ", result.Errors);
                return;
            }

            // The copy opens as a draft, ready to be changed and sent.
            Navigation.NavigateTo($"coordinator/evaluations/{copyId}");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task CreateAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var me = await Me.GetAsync();
            var result = me is null ? ServiceResult.Fail("Please sign in again.") : await Service.CreateAsync(me.UserId);
            if (!result.Succeeded || result.Id is not { } id)
            {
                message = string.Join(" ", result.Errors);
                return;
            }

            Navigation.NavigateTo($"coordinator/evaluations/{id}");
        }
        finally
        {
            busy = false;
        }
    }
}
