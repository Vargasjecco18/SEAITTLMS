@page "/coordinator/sections"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@using SEAITT_LMS.Components.Pages.Coordinator.Setup

<PageTitle>Sections · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Sections" IconName="users">
    <ButtonLink Href="coordinator/academic-setup" Variant="ButtonVariant.Ghost" IconName="school">Academic setup</ButtonLink>
    <ButtonLink Href="coordinator/class-schedule" IconName="calendar-clock">Open the class schedule</ButtonLink>
</PageHeader>

@* The sections of each school year (A and B for each strand and grade level). A double click on a section opens its adviser and its students; the class schedule is its own page. *@
<form class="sections-search" role="search" @onsubmit="() => { }">
    <SearchField Id="sections-search" @bind-Value="search" Live="true" SubmitText="" Placeholder="Search a section, a strand or an adviser" AriaLabel="Search the sections" />
</form>

<SectionsStep Search="@search" />

@code {
    private string search = "";
}
