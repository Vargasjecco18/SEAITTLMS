@inherits SetupTabBase
@inject SystemSettingsService SystemSettings
@inject TimeProvider Clock

@* The class sections: a tab for each class (grade level), the strands inside it, and the sections (A and B) of each strand as cards. Press a card to choose its adviser and see its students. *@
<div class="sections-step">
    <FormErrors Errors="Errors" />
    <p class="saved-line" role="status" aria-live="polite">@(Message ?? "")</p>

    @if (rows is null || lookups is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="sections-top">
            <PillTabs Items="ClassTabs" Selected="@gradeTab" SelectedChanged="key => gradeTab = key ?? gradeTab" Label="Class" />
            <label class="year-pick">
                <span>School year</span>
                <select class="ghost" aria-label="School year" @bind="yearId">
                    @foreach (var year in ActiveYears)
                    {
                        <option value="@year.Id">@year.Name</option>
                    }
                </select>
            </label>
            <form class="capacity" @onsubmit="SaveCapacityAsync">
                <label for="sec-capacity">Students in one section (the limit)</label>
                <input id="sec-capacity" type="number" class="ghost narrow limit-box" min="1" max="100" @bind="capacity" />
                <Button Type="submit" Small="true" Variant="ButtonVariant.Secondary" IconName="save" Disabled="Busy">Save limit</Button>
            </form>
        </div>

        @if (StrandsShown.Count == 0)
        {
            <EmptyState IconName="search-x" Title="No section matches" />
        }

        @foreach (var strand in StrandsShown)
        {
            var tone = ToneOf(strand);
            <section class="strand-block" data-strand="@strand.Code" aria-label="@($"Grade {Grade} {strand.Code}")">
                <header class="strand-head">
                    <h3>@strand.Code <small>@strand.Name</small></h3>
                </header>
                <div class="section-cards">
                    @foreach (var name in NamesOf(strand))
                    {
                        var row = RowOf(strand, name);
                        @if (row is not null)
                        {
                            <article class="section-card" role="button" tabindex="0" data-section="@row.Label" title="Adviser and students of @row.Label"
                                     @onclick="() => dialogSection = row" @onkeydown="e => OnCardKey(e, row)">
                                <span class="card-icon tone-@tone"><Icon Name="@IconOf(strand)" Size="26" /></span>
                                <span class="card-text">
                                    <strong class="card-title">Grade @row.GradeLevel - @row.StrandCode</strong>
                                    <span class="card-sub">Section @row.Name</span>
                                    <span class="card-meta">
                                        <span><Icon Name="presentation" Size="14" /> @(row.Adviser ?? "No adviser")</span>
                                        <span><Icon Name="users" Size="14" /> @(row.Students == 1 ? "1 student" : $"{row.Students} students")</span>
                                    </span>
                                </span>
                                <button type="button" class="card-delete" title="@($"Delete {row.Label}")" aria-label="@($"Delete {row.Label}")" @onclick="() => OpenDelete(row)" @onclick:stopPropagation="true">
                                    <Icon Name="trash-2" Size="16" />
                                </button>
                                <span class="card-chevron" aria-hidden="true"><Icon Name="chevron-right" Size="20" /></span>
                            </article>
                        }
                        else
                        {
                            <button type="button" class="section-card add-card" data-add="@($"{Grade}-{strand.Code}-{name}")" disabled="@Busy" @onclick="() => AddAsync(strand, name)">
                                <span class="card-icon add-icon"><Icon Name="plus" Size="26" /></span>
                                <span class="card-text">
                                    <strong class="card-title">Add section @name</strong>
                                    <span class="card-sub">Grade @Grade - @strand.Code</span>
                                </span>
                            </button>
                        }
                    }
                </div>
            </section>
        }

        @if (PastRows.Count > 0)
        {
            <details class="ended">
                <summary>Sections of school years that are over (@PastRows.Count)</summary>
                <p class="muted">Kept for the records, with their students.</p>
                <ul class="ended-list">
                    @foreach (var row in PastRows)
                    {
                        <li><span class="name">@row.Label</span> <span class="muted">@row.SchoolYear · @row.Students @(row.Students == 1 ? "student" : "students")</span></li>
                    }
                </ul>
            </details>
        }
    }
</div>

<SectionDialog Section="dialogSection" OnClose="CloseDialogAsync" />

<Modal Open="deleting is not null" Title="Delete this section?" OnClose="CloseDelete">
    @if (deleting is not null)
    {
        <p class="delete-text">You are about to delete the section <strong>@deleting.Label</strong> (@deleting.SchoolYear). <strong>This can't be undone.</strong></p>
        <FormErrors Errors="Errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="Busy" OnClick="DeleteAsync">@(Busy ? "Deleting…" : "Delete")</Button>
        </div>
    }
</Modal>

@code {
    /// <summary>What is typed in the search box of the page.</summary>
    [Parameter] public string? Search { get; set; }

    private IReadOnlyList<SectionRow>? rows;
    private SetupLookups? lookups;
    private SectionRow? deleting;
    private SectionRow? dialogSection;
    private int capacity;
    private int yearId;
    private string gradeTab = "11";

    /// <summary>The class the dropdown of the tab asked for (the address has ?grade=12).</summary>
    [Parameter] public int? InitialGrade { get; set; }

    private int? askedGrade;

    protected override void OnParametersSet()
    {
        if (InitialGrade != askedGrade)
        {
            askedGrade = InitialGrade;
            if (InitialGrade is 11 or 12)
            {
                gradeTab = InitialGrade.ToString()!;
            }
        }
    }
    private System.Threading.Timer? fade;

    private int Grade => gradeTab == "12" ? 12 : 11;

    private DateOnly Today => PhilippineTime.Today(Clock);

    private IEnumerable<YearOption> ActiveYears => (lookups?.Years ?? []).Where(y => y.EndDate >= Today).OrderBy(y => y.StartDate);

    private HashSet<int> ActiveYearIds => ActiveYears.Select(y => y.Id).ToHashSet();

    private IReadOnlyList<SectionRow> YearRows => rows is null ? [] : [.. rows.Where(r => r.SchoolYearId == yearId)];

    private IReadOnlyList<PillTabs.Tab> ClassTabs =>
    [
        new("11", "Grade 11", "graduation-cap", YearRows.Count(r => r.GradeLevel == 11)),
        new("12", "Grade 12", "graduation-cap", YearRows.Count(r => r.GradeLevel == 12)),
    ];

    private bool Matches(SectionRow r) => string.IsNullOrWhiteSpace(Search)
        || r.Label.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) || (r.Adviser?.Contains(Search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    /// <summary>The strands that show in this class tab: all of them, or (when something is searched) the ones with a section that matches or a name that matches.</summary>
    private IReadOnlyList<StrandChoice> StrandsShown
    {
        get
        {
            var all = (lookups?.Strands ?? []).OrderBy(s => s.Track).ThenBy(s => s.Code).ToList();
            if (string.IsNullOrWhiteSpace(Search))
            {
                return all;
            }

            var query = Search.Trim();
            return [.. all.Where(s => s.Code.Contains(query, StringComparison.OrdinalIgnoreCase) || s.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                                      || YearRows.Any(r => r.StrandId == s.Id && r.GradeLevel == Grade && Matches(r)))];
        }
    }

    /// <summary>A and B for each strand; a section that has another name (made before) keeps its card.</summary>
    private IEnumerable<string> NamesOf(StrandChoice strand) =>
        SectionNames.Choices.Concat(YearRows.Where(r => r.StrandId == strand.Id && r.GradeLevel == Grade).Select(r => r.Name).Where(n => !SectionNames.Choices.Contains(n))).Distinct();

    private SectionRow? RowOf(StrandChoice strand, string name) => YearRows.FirstOrDefault(r => r.StrandId == strand.Id && r.GradeLevel == Grade && r.Name == name);

    private IReadOnlyList<SectionRow> PastRows => rows is null ? [] : [.. rows.Where(r => !ActiveYearIds.Contains(r.SchoolYearId)).OrderByDescending(r => r.SchoolYear).ThenBy(r => r.GradeLevel).ThenBy(r => r.StrandCode).ThenBy(r => r.Name)];

    private int IndexOf(StrandChoice strand) => Math.Max(0, (lookups?.Strands ?? []).OrderBy(s => s.Track).ThenBy(s => s.Code).ToList().FindIndex(s => s.Id == strand.Id));

    private static readonly string[] Icons = ["book-open", "layers", "graduation-cap", "school", "layout-grid", "building-2"];

    private string IconOf(StrandChoice strand) => Icons[IndexOf(strand) % Icons.Length];

    private int ToneOf(StrandChoice strand) => IndexOf(strand) % 4;

    private async Task OnCardKey(KeyboardEventArgs e, SectionRow row)
    {
        if (e.Key is "Enter" or " ")
        {
            dialogSection = row;
        }

        await Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        capacity = SystemSettings.Current.SectionCapacity;
        await LoadAsync();
    }

    protected override Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        lookups = await Setup.GetLookupsAsync();
        rows = await Setup.ListSectionsAsync();
        if (yearId == 0 || ActiveYears.All(y => y.Id != yearId))
        {
            yearId = ActiveYears.FirstOrDefault(y => y.StartDate <= Today && Today <= y.EndDate)?.Id ?? ActiveYears.FirstOrDefault()?.Id ?? 0;
        }
    }

    private void Faded()
    {
        fade?.Dispose();
        fade = new System.Threading.Timer(_ => _ = InvokeAsync(() => { Message = null; StateHasChanged(); }), null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan);
    }

    private async Task AddAsync(StrandChoice strand, string name)
    {
        var input = new SectionInput { SchoolYearId = yearId, StrandId = strand.Id, GradeLevel = Grade, Name = name };
        var result = await RunAsync(userId => Setup.SaveSectionAsync(input, userId));
        await LoadAsync();
        if (result.Succeeded)
        {
            Faded();
        }
    }

    private async Task SaveCapacityAsync()
    {
        var result = await RunAsync(userId => SystemSettings.SaveSectionCapacityAsync(userId, capacity));
        if (!result.Succeeded)
        {
            capacity = SystemSettings.Current.SectionCapacity;
        }
    }

    private async Task CloseDialogAsync()
    {
        dialogSection = null;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private void OpenDelete(SectionRow row)
    {
        Errors = [];
        deleting = row;
    }

    private void CloseDelete() => deleting = null;

    private async Task DeleteAsync()
    {
        var result = await RunAsync(userId => Setup.DeleteSectionAsync(deleting!.Id, userId));
        if (result.Succeeded)
        {
            deleting = null;
            await LoadAsync();
        }
    }
}
