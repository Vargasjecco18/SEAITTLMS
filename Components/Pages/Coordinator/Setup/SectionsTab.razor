@inherits SetupTabBase

<Card>
    <div class="tab-head">
        <p class="grow">The sections of a school year, like 11-BUSSENT-A. A section has a name, a grade level and a strand: <strong>the schedule (AM, MID or PM) is not part of it</strong>, it belongs to each course (see the Class schedule tab). The registrar also makes a section the first time a student is enrolled in it. Teachers get a section's courses under <strong>Users Management</strong>.</p>
        <Button IconName="plus" Disabled="@(lookups is { Years.Count: 0 } or { Strands.Count: 0 })" OnClick="OpenAdd">Add section</Button>
    </div>

    <Notice Message="@Message" IsError="MessageIsError" OnDismiss="ClearMessage" />

    <form class="filter-bar" role="search" @onsubmit="() => { }">
        <SearchField Id="sec-search" @bind-Value="search" Live="true" Class="full" SubmitText="" Placeholder="Section or adviser" AriaLabel="Search sections" />
        <Field For="sec-year" Label="School year">
            <select id="sec-year" @bind="yearFilter">
                <option value="0">All school years</option>
                @foreach (var year in lookups?.Years ?? [])
                {
                    <option value="@year.Id">@year.Name</option>
                }
            </select>
        </Field>
        <Field For="sec-grade" Label="Grade level">
            <select id="sec-grade" @bind="gradeFilter">
                <option value="0">All grade levels</option>
                <option value="11">Grade 11</option>
                <option value="12">Grade 12</option>
            </select>
        </Field>
        <Field For="sec-strand" Label="Strand">
            <select id="sec-strand" @bind="strandFilter">
                <option value="0">All strands</option>
                @foreach (var strand in lookups?.Strands ?? [])
                {
                    <option value="@strand.Id">@strand.Code</option>
                }
            </select>
        </Field>
        <span class="filter-count">@(Shown.Count == 1 ? "1 section" : $"{Shown.Count:N0} sections")</span>
    </form>

    @if (rows is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (Shown.Count == 0)
    {
        <EmptyState IconName="@(rows.Count == 0 ? "users" : "search-x")" Title="@(rows.Count == 0 ? "No section yet" : "No section matches")" />
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Section</th>
                        <th scope="col" class="col-more">School year</th>
                        <th scope="col" class="col-more">Adviser</th>
                        <th scope="col">Students</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Shown)
                    {
                        <tr>
                            <td class="name nowrap">@row.Label</td>
                            <td class="col-more nowrap">@row.SchoolYear</td>
                            <td class="col-more">@(row.Adviser ?? "—")</td>
                            <td>@row.Students</td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" Title="@($"Edit {row.Label}")" OnClick="() => OpenEdit(row)">Edit</Button>
                                    <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true" Title="@($"Delete {row.Label}")" OnClick="() => OpenDelete(row)" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

<Modal Open="form is not null" Title="@(form?.Id is null ? "Add section" : "Edit section")" OnClose="CloseForm" Large="true">
    @if (form is not null && lookups is not null)
    {
        <EditForm Model="form" OnSubmit="SaveAsync">
            <FormErrors Errors="Errors" />
            @if (locked)
            {
                <p class="note-box">Students or teachers are in this section, so only its name and its adviser can change.</p>
            }

            <Field For="n-year" Label="School year" Required="true">
                <select id="n-year" disabled="@locked" @bind="form.SchoolYearId">
                    <option value="0">Choose a school year</option>
                    @foreach (var year in lookups.Years)
                    {
                        <option value="@year.Id">@year.Name</option>
                    }
                </select>
            </Field>
            <div class="two">
                <Field For="n-grade" Label="Grade level" Required="true">
                    <select id="n-grade" disabled="@locked" @bind="form.GradeLevel">
                        <option value="11">Grade 11</option>
                        <option value="12">Grade 12</option>
                    </select>
                </Field>
                <Field For="n-strand" Label="Strand" Required="true">
                    <select id="n-strand" disabled="@locked" @bind="form.StrandId">
                        <option value="0">Choose a strand</option>
                        @foreach (var strand in lookups.Strands)
                        {
                            <option value="@strand.Id">@strand.Code</option>
                        }
                    </select>
                </Field>
            </div>
            <div class="two">
                <Field For="n-name" Label="Section name" Required="true" Hint="Like A.">
                    <input id="n-name" maxlength="50" autocomplete="off" @bind="form.Name" />
                </Field>
            </div>
            <Field For="n-adviser-search" Label="Adviser" Hint="Optional. Look at the grade level, the track and the courses of each teacher, and choose one.">
                <div class="adviser-picker">
                    <input id="n-adviser-search" type="search" class="adviser-search" form="no-form" autocomplete="off" placeholder="Search a teacher, a grade level, a track or a course"
                           @bind="adviserSearch" @bind:event="oninput" />
                    <div class="adviser-table-wrap">
                        <table class="adviser-table" id="n-adviser">
                            <thead>
                                <tr>
                                    <th scope="col"><span class="sr-only">Choose</span></th>
                                    <th scope="col">Teacher</th>
                                    <th scope="col">Grade level</th>
                                    <th scope="col">Track</th>
                                    <th scope="col">Courses</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="@(adviserId == 0 ? "picked" : "")" @onclick="() => adviserId = 0">
                                    <td><input type="radio" name="adviser" aria-label="No adviser" checked="@(adviserId == 0)" @onchange="() => adviserId = 0" /></td>
                                    <td colspan="4" class="muted">No adviser</td>
                                </tr>
                                @foreach (var teacher in AdviserChoices)
                                {
                                    var id = teacher.Id;
                                    <tr class="@(adviserId == id ? "picked" : "")" @onclick="() => adviserId = id">
                                        <td><input type="radio" name="adviser" aria-label="@($"Choose {teacher.Name}")" checked="@(adviserId == id)" @onchange="() => adviserId = id" /></td>
                                        <td class="a-name">@teacher.Name</td>
                                        <td class="nowrap">@(teacher.GradeLevel ?? "—")</td>
                                        <td class="nowrap">@(teacher.Track ?? "—")</td>
                                        <td class="a-courses">@(teacher.Courses is { Count: > 0 } courses ? string.Join(", ", courses) : "No course yet")</td>
                                    </tr>
                                }
                                @if (!AdviserChoices.Any())
                                {
                                    <tr><td></td><td colspan="4" class="muted">No teacher matches.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </Field>
            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseForm">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="Busy">@(Busy ? "Saving…" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

<Modal Open="deleting is not null" Title="Delete this section?" OnClose="CloseDelete">
    @if (deleting is not null)
    {
        <p class="delete-text">You are about to delete the section <strong>@deleting.Label</strong> (@deleting.SchoolYear). <strong>This can't be undone.</strong></p>
        <FormErrors Errors="Errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="Busy" OnClick="DeleteAsync">@(Busy ? "Deleting…" : "Delete")</Button>
        </div>
    }
</Modal>

@code {
    private IReadOnlyList<SectionRow>? rows;
    private SetupLookups? lookups;
    private SectionInput? form;
    private SectionRow? deleting;
    private bool locked;
    private int adviserId;
    private string adviserSearch = "";

    /// <summary>The teachers the adviser can be chosen from, narrowed by what is typed (the name, the grade level, the track or a course); the chosen one always stays in the list.</summary>
    private IEnumerable<TeacherChoice> AdviserChoices => (lookups?.Teachers ?? [])
        .Where(t => t.Id == adviserId
            || string.IsNullOrWhiteSpace(adviserSearch)
            || adviserSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).All(w => t.SearchText.Contains(w, StringComparison.OrdinalIgnoreCase)));
    private string search = "";
    private int yearFilter;
    private int gradeFilter;
    private int strandFilter;

    private IReadOnlyList<SectionRow> Shown =>
        rows is null ? [] : rows.Where(r => (yearFilter == 0 || r.SchoolYearId == yearFilter)
            && (gradeFilter == 0 || r.GradeLevel == gradeFilter)
            && (strandFilter == 0 || r.StrandId == strandFilter)
            && (string.IsNullOrWhiteSpace(search)
                || r.Label.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
                || (r.Adviser?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)))
            .OrderByDescending(r => r.SchoolYear).ThenBy(r => r.GradeLevel).ThenBy(r => r.StrandCode).ThenBy(r => r.Name)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        lookups = await Setup.GetLookupsAsync();
        rows = await Setup.ListSectionsAsync();
    }

    private async Task ReloadAsync() => rows = await Setup.ListSectionsAsync();

    private void OpenAdd()
    {
        Errors = [];
        locked = false;
        adviserId = 0;
        adviserSearch = "";
        form = new SectionInput { SchoolYearId = lookups?.Years.FirstOrDefault()?.Id ?? 0 };
    }

    private void OpenEdit(SectionRow row)
    {
        Errors = [];
        locked = row.Students > 0 || row.Teachers > 0;
        adviserId = row.AdviserTeacherId ?? 0;
        adviserSearch = "";
        form = new SectionInput
        {
            Id = row.Id, SchoolYearId = row.SchoolYearId, StrandId = row.StrandId, GradeLevel = row.GradeLevel,
            Name = row.Name, AdviserTeacherId = row.AdviserTeacherId,
        };
    }

    private void CloseForm() => form = null;

    private async Task SaveAsync()
    {
        form!.AdviserTeacherId = adviserId == 0 ? null : adviserId;
        var result = await RunAsync(userId => Setup.SaveSectionAsync(form!, userId));
        if (result.Succeeded)
        {
            form = null;
            await ReloadAsync();
        }
    }

    private void OpenDelete(SectionRow row)
    {
        Errors = [];
        deleting = row;
    }

    private void CloseDelete() => deleting = null;

    private async Task DeleteAsync()
    {
        var result = await RunAsync(userId => Setup.DeleteSectionAsync(deleting!.Id, userId));
        if (result.Succeeded)
        {
            deleting = null;
            await ReloadAsync();
        }
    }
}
