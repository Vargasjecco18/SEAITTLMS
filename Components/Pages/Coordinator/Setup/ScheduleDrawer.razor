@inherits SetupTabBase
@inject CourseScheduleService Times

@* Every class schedule of the school year, on a panel that slides in from the right. It only shows; the class schedule page is where the classes are put in their places. *@
<div class="drawer-shade @(Open ? "open" : "")" @onclick="CloseAsync" aria-hidden="true"></div>
<aside class="drawer @(Open ? "open" : "")" id="all-schedules" role="dialog" aria-modal="false" aria-label="All class schedules" aria-hidden="@(Open ? "false" : "true")" inert="@(!Open)">
    <header class="drawer-head">
        <h2><Icon Name="calendar-clock" Size="20" /> All class schedules</h2>
        <button type="button" class="drawer-close" aria-label="Close the class schedules" title="Close" @onclick="CloseAsync"><Icon Name="x" Size="20" /></button>
    </header>

    <div class="drawer-tools">
        <SearchField Id="drawer-search" @bind-Value="search" Live="true" SubmitText="" Placeholder="Search a section, a course, a room or a teacher" AriaLabel="Search the class schedules" />
        <Field For="drawer-term" Label="Term">
            <select id="drawer-term" @bind="term">
                <option value="0">All terms</option>
                @for (var n = 1; n <= SchoolCalendar.TermsPerYear; n++)
                {
                    <option value="@n">@SchoolCalendar.TermName(n)</option>
                }
            </select>
        </Field>
    </div>

    <div class="drawer-body">
        @if (Loading)
        {
            <p class="muted">Loading…</p>
        }
        else if (Groups.Count == 0)
        {
            <p class="muted">@(placed.Count == 0 ? "No class has a day and a time yet. Open the class schedule to put the courses in their places." : "Nothing matches.")</p>
        }
        else
        {
            @foreach (var group in Groups)
            {
                <section class="drawer-section" data-section="@group.Key">
                    <h3>@group.Key <span class="count">@group.Count() @(group.Count() == 1 ? "class" : "classes")</span></h3>
                    <ul>
                        @foreach (var c in group)
                        {
                            <li>
                                <span class="d-course">@c.Course</span>
                                <span class="d-when">@c.Days · @ClassTime.Format(c.Start) – @ClassTime.Format(c.End)</span>
                                <span class="d-where">@(c.RoomName ?? "No room")</span>
                                @if (c.Teacher is not null)
                                {
                                    <span class="d-teacher">@c.Teacher</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
        }
    </div>
</aside>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<PlacedClass> placed = [];
    private string search = "";
    private int term;
    private bool wasOpen;

    private bool Loading { get; set; }

    private IReadOnlyList<IGrouping<string, PlacedClass>> Groups => placed
        .Where(c => term == 0 || c.TermNumber == term)
        .Where(c => string.IsNullOrWhiteSpace(search)
            || $"{c.SectionLabel} {c.Course} {c.RoomName} {c.Teacher}".Contains(search.Trim(), StringComparison.OrdinalIgnoreCase))
        .GroupBy(c => c.SectionLabel).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase).ToList();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (Open && !wasOpen)
        {
            wasOpen = true;
            Loading = true;
            var sections = await Times.ListSectionsAsync();
            var year = sections.FirstOrDefault(s => s.CurrentYear)?.SchoolYearId ?? sections.FirstOrDefault()?.SchoolYearId ?? 0;
            placed = year == 0 ? [] : await Times.ListPlacedAsync(-1, year);
            Loading = false;
        }
        else if (!Open)
        {
            wasOpen = false;
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
