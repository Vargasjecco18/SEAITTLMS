@inherits SetupTabBase

@* The tracks, their strands and the courses of each strand, as three cards side by side: press a track and its strands show in the next card, press a strand and its courses show
   in the last one. Every box is ready to type in: a change is saved when the box is left. Each card has a search box. *@
<div class="curriculum-step">
    <FormErrors Errors="Errors" />
    <p class="saved-line" role="status" aria-live="polite">@(Message ?? "")</p>

    @if (tracks is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        var track = CurrentTrack;
        var strandList = StrandsShown(track);
        var strand = CurrentStrand(strandList);
        <div class="cols">
            @* ---------------- the tracks ---------------- *@
            <section class="col col-tracks" aria-label="Tracks">
                <header class="col-head">
                    <h3>Tracks</h3>
                    <span class="col-count">@tracks.Count</span>
                    <label class="col-search"><Icon Name="search" Size="15" /><input id="track-search" type="search" placeholder="Search" aria-label="Search the tracks" maxlength="60" autocomplete="off" @bind="trackSearch" @bind:event="oninput" /></label>
                </header>
                <ul class="col-list" role="listbox" aria-label="Tracks">
                    @foreach (var t in ShownTracks)
                    {
                        <li class="row @(track?.Id == t.Id ? "on" : "")" role="option" aria-selected="@(track?.Id == t.Id ? "true" : "false")" data-track="@t.Code" @onclick="() => SelectTrack(t.Id)">
                            <input class="ghost code" aria-label="@($"Code of the track {t.Code}")" maxlength="20" value="@t.Code" @key="@($"tc-{t.Id}-{stamp}")"
                                   @onchange="e => SaveTrackAsync(t, code: e.Value?.ToString())" />
                            <input class="ghost grow" aria-label="@($"Name of the track {t.Code}")" maxlength="100" value="@t.Name" @key="@($"tm-{t.Id}-{stamp}")"
                                   @onchange="e => SaveTrackAsync(t, name: e.Value?.ToString())" />
                            <span class="meta">@t.Strands</span>
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true" Title="@($"Delete the track {t.Code}")" OnClick='() => OpenDelete(t.Id, t.Code, "track")' />
                        </li>
                    }

                    @if (!ShownTracks.Any())
                    {
                        <li class="none">@(tracks.Count == 0 ? "No track yet." : "Nothing matches.")</li>
                    }
                </ul>
                <div class="add-row" role="group" aria-label="Add a track">
                    <input class="ghost code" placeholder="Code" aria-label="Code of the new track" maxlength="20" autocomplete="off" @bind="newTrack.Code" @bind:event="oninput" />
                    <input class="ghost grow" placeholder="Add a track" aria-label="Name of the new track" maxlength="100" autocomplete="off" @bind="newTrack.Name" @bind:event="oninput" />
                    <Button Small="true" IconName="plus" Disabled="Busy" OnClick="AddTrackAsync">Add track</Button>
                </div>
            </section>

            @* ---------------- the strands of the track ---------------- *@
            <section class="col col-strands" aria-label="Strands">
                <header class="col-head">
                    <h3>Strands <small>@(track?.Code)</small></h3>
                    <span class="col-count">@strandList.Count</span>
                    <label class="col-search"><Icon Name="search" Size="15" /><input id="strand-search" type="search" placeholder="Search" aria-label="Search the strands" maxlength="60" autocomplete="off" @bind="strandSearch" @bind:event="oninput" /></label>
                </header>
                @if (track is null)
                {
                    <p class="col-empty">Choose a track.</p>
                }
                else
                {
                    <ul class="col-list" role="listbox" aria-label="@($"Strands of {track.Code}")">
                        @foreach (var st in strandList)
                        {
                            <li class="row @(strand?.Id == st.Id ? "on" : "")" role="option" aria-selected="@(strand?.Id == st.Id ? "true" : "false")" data-strand="@st.Code" @onclick="() => SelectStrand(st.Id)">
                                <input class="ghost code" aria-label="@($"Code of the strand {st.Code}")" maxlength="20" value="@st.Code" @key="@($"sc-{st.Id}-{stamp}")"
                                       @onchange="e => SaveStrandAsync(st, code: e.Value?.ToString())" />
                                <input class="ghost grow" aria-label="@($"Name of the strand {st.Code}")" maxlength="150" value="@st.Name" @key="@($"sm-{st.Id}-{stamp}")"
                                       @onchange="e => SaveStrandAsync(st, name: e.Value?.ToString())" />
                                <label class="offered" title="Switch it off for a strand that is not offered now. The registrar can't enroll students in it.">
                                    <input type="checkbox" aria-label="@($"{st.Code} is offered")" checked="@st.IsActive" @key="@($"sa-{st.Id}-{stamp}")"
                                           @onchange="e => SaveStrandAsync(st, active: (bool?)e.Value)" /> <span>Offered</span>
                                </label>
                                <span class="meta">@st.Subjects</span>
                                <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true" Title="@($"Delete the strand {st.Code}")" OnClick='() => OpenDelete(st.Id, st.Code, "strand")' />
                            </li>
                        }

                        @if (strandList.Count == 0)
                        {
                            <li class="none">@(Searching ? "Nothing matches." : "No strand yet.")</li>
                        }
                    </ul>
                    var newStrand = NewStrandOf(track.Id);
                    <div class="add-row" role="group" aria-label="@($"Add a strand to {track.Code}")">
                        <input class="ghost code" placeholder="Code" aria-label="@($"Code of the new strand of {track.Code}")" maxlength="20" autocomplete="off" @bind="newStrand.Code" @bind:event="oninput" />
                        <input class="ghost grow" placeholder="Add a strand" aria-label="@($"Name of the new strand of {track.Code}")" maxlength="150" autocomplete="off" @bind="newStrand.Name" @bind:event="oninput" />
                        <Button Small="true" IconName="plus" Disabled="Busy" OnClick="() => AddStrandAsync(track, newStrand)">Add strand</Button>
                    </div>
                }
            </section>

            @* ---------------- the courses of the strand ---------------- *@
            <section class="col col-courses" aria-label="Courses">
                <header class="col-head">
                    <h3>Courses <small>@(strand?.Code)</small></h3>
                    <span class="col-count">@(strand is null ? 0 : CoursesShown(strand).Count())</span>
                    <label class="col-search"><Icon Name="search" Size="15" /><input id="course-search" type="search" placeholder="Search" aria-label="Search the courses" maxlength="60" autocomplete="off" @bind="courseSearch" @bind:event="oninput" /></label>
                </header>
                @if (strand is null)
                {
                    <p class="col-empty">Choose a strand.</p>
                }
                else
                {
                    var lines = CoursesShown(strand).ToList();
                    <div class="course-columns" aria-hidden="true">
                        <span class="cc-code">Code</span>
                        <span class="cc-name">Course</span>
                        <span class="cc-units">Units offered</span>
                    </div>
                    <div class="col-list courses-box">
                        @foreach (var group in lines.GroupBy(l => (l.GradeLevel, l.TermNumber)).OrderBy(g => g.Key.GradeLevel).ThenBy(g => g.Key.TermNumber))
                        {
                            <section class="course-group" aria-label="@($"Grade {group.Key.GradeLevel}, term {group.Key.TermNumber} of {strand.Code}")">
                                <h4>Grade @group.Key.GradeLevel · @SchoolCalendar.TermName(group.Key.TermNumber)</h4>
                                <ul class="courses">
                                    @foreach (var line in group)
                                    {
                                        <li class="course" data-course="@line.SubjectCode">
                                            <input class="ghost code" aria-label="@($"Code of {line.SubjectName}")" maxlength="30" value="@line.SubjectCode" @key="@($"cc-{line.SubjectId}-{stamp}")"
                                                   @onchange="e => SaveCourseAsync(line, code: e.Value?.ToString())" />
                                            <input class="ghost grow" aria-label="@($"Name of {line.SubjectName}")" maxlength="150" value="@line.SubjectName" @key="@($"cn-{line.SubjectId}-{stamp}")"
                                                   @onchange="e => SaveCourseAsync(line, name: e.Value?.ToString())" />
                                            <input class="ghost units" type="number" min="0.5" max="12" step="0.5" aria-label="@($"Units of {line.SubjectName}")" value="@line.Units.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" @key="@($"cu-{line.SubjectId}-{stamp}")"
                                                   @onchange="e => SaveCourseAsync(line, units: e.Value?.ToString())" />
                                            <Button Small="true" Variant="ButtonVariant.Ghost" IconName="x" IconOnly="true" Title="@($"Take {line.SubjectName} out of {strand.Code}")" OnClick="() => AskRemoveCourse(strand, line)" />
                                        </li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (lines.Count == 0)
                        {
                            <p class="none">@(Searching ? "Nothing matches." : "No courses yet. Add the first one below.")</p>
                        }
                    </div>

                    var add = AddOf(strand.Id);
                    <div class="add-row add-course" role="group" aria-label="@($"Add a course to {strand.Code}")">
                        <select class="ghost grow" aria-label="@($"Course to add to {strand.Code}")" @onchange="e => add.SubjectId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0">
                            <option value="0" selected="@(add.SubjectId == 0)">A new course…</option>
                            @foreach (var pick in activeSubjects)
                            {
                                <option value="@pick.Id" selected="@(add.SubjectId == pick.Id)">@pick.Name</option>
                            }
                        </select>
                        @if (add.SubjectId == 0)
                        {
                            <input class="ghost code" placeholder="Code" aria-label="@($"Code of the new course for {strand.Code}")" maxlength="30" autocomplete="off" @bind="add.Code" @bind:event="oninput" />
                            <input class="ghost grow wide" placeholder="Name of the new course" aria-label="@($"Name of the new course for {strand.Code}")" maxlength="150" autocomplete="off" @bind="add.Name" @bind:event="oninput" />
                        }
                        <select class="ghost narrow" aria-label="@($"Grade level of the new course for {strand.Code}")" @bind="add.Grade">
                            <option value="11">Grade 11</option>
                            <option value="12">Grade 12</option>
                        </select>
                        <select class="ghost narrow" aria-label="@($"Term of the new course for {strand.Code}")" @bind="add.Term">
                            @for (var n = 1; n <= SchoolCalendar.TermsPerYear; n++)
                            {
                                <option value="@n">@SchoolCalendar.TermName(n)</option>
                            }
                        </select>
                        <Button Small="true" IconName="plus" Disabled="Busy" OnClick="() => AddCourseAsync(strand, add)">Add course</Button>
                    </div>
                }
            </section>
        </div>
    }
</div>

<Modal Open="removingCourse is not null" Title="Take this course out of the strand?" OnClose="CloseRemoveCourse">
    @if (removingCourse is { } rc)
    {
        <p class="delete-text"><strong>@rc.Line.SubjectName</strong> will be taken out of <strong>@rc.Strand.Code</strong> (Grade @rc.Line.GradeLevel, @SchoolCalendar.TermName(rc.Line.TermNumber)). The course stays in the other strands that have it.</p>
        <FormErrors Errors="Errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseRemoveCourse">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="x" Disabled="Busy" OnClick="RemoveCourseConfirmedAsync">@(Busy ? "Taking out…" : "Take it out")</Button>
        </div>
    }
</Modal>

<Modal Open="deleting is not null" Title="@($"Delete this {deleting?.Kind}?")" OnClose="CloseDelete">
    @if (deleting is not null)
    {
        <p class="delete-text">You are about to delete the @deleting.Kind <strong>@deleting.Code</strong>. <strong>This can't be undone.</strong></p>
        <FormErrors Errors="Errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="Busy" OnClick="DeleteAsync">@(Busy ? "Deleting…" : "Delete")</Button>
        </div>
    }
</Modal>

@code {
    private sealed record DeleteTarget(int Id, string Code, string Kind);

    private sealed class AddState
    {
        public int SubjectId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public int Grade { get; set; } = 11;
        public int Term { get; set; } = 1;
    }

    private sealed class NewNode
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }

    /// <summary>What is typed in the search box of the page.</summary>
    [Parameter] public string? Search { get; set; }

    private IReadOnlyList<TrackRow>? tracks;
    private IReadOnlyList<StrandRow> strands = [];
    private IReadOnlyList<CurriculumLine> curriculum = [];
    private Dictionary<int, SubjectRow> subjects = [];
    private List<SubjectRow> activeSubjects = [];
    private readonly Dictionary<int, AddState> adds = [];
    private readonly Dictionary<int, NewNode> newStrands = [];
    private readonly NewNode newTrack = new();
    private string trackSearch = "";
    private string strandSearch = "";
    private string courseSearch = "";
    private int? selectedTrackId;
    private int? selectedStrandId;
    private DeleteTarget? deleting;
    private int stamp;
    private System.Threading.Timer? fade;

    private string PageSearch => (Search ?? "").Trim();

    private bool Searching => PageSearch.Length > 0 || !string.IsNullOrWhiteSpace(trackSearch) || !string.IsNullOrWhiteSpace(strandSearch) || !string.IsNullOrWhiteSpace(courseSearch);

    private static bool Has(string? text, string query) => text?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false;

    private void SelectTrack(int id)
    {
        if (selectedTrackId != id)
        {
            selectedTrackId = id;
            selectedStrandId = null;
        }
    }

    private void SelectStrand(int id) => selectedStrandId = id;

    /// <summary>The tracks that the search keeps: the ones whose own words match, or that have a strand or a course that matches the page search.</summary>
    private IEnumerable<TrackRow> ShownTracks => (tracks ?? []).Where(t =>
        (string.IsNullOrWhiteSpace(trackSearch) || Has(t.Code, trackSearch.Trim()) || Has(t.Name, trackSearch.Trim()))
        && (PageSearch.Length == 0 || Has(t.Code, PageSearch) || Has(t.Name, PageSearch) || StrandsOfTrack(t.Id).Any(s => StrandMatchesPage(s))));

    private TrackRow? CurrentTrack => ShownTracks.FirstOrDefault(t => t.Id == selectedTrackId) ?? ShownTracks.FirstOrDefault();

    private IEnumerable<StrandRow> StrandsOfTrack(int trackId) => strands.Where(s => s.TrackId == trackId);

    private bool StrandMatchesPage(StrandRow s) =>
        PageSearch.Length == 0 || Has(s.Code, PageSearch) || Has(s.Name, PageSearch) || curriculum.Any(l => l.StrandId == s.Id && (Has(l.SubjectName, PageSearch) || Has(l.SubjectCode, PageSearch)));

    private IReadOnlyList<StrandRow> StrandsShown(TrackRow? track) => track is null ? [] :
        [.. StrandsOfTrack(track.Id).Where(s => StrandMatchesPage(s) && (string.IsNullOrWhiteSpace(strandSearch) || Has(s.Code, strandSearch.Trim()) || Has(s.Name, strandSearch.Trim())
                                                                      || curriculum.Any(l => l.StrandId == s.Id && (Has(l.SubjectName, strandSearch.Trim()) || Has(l.SubjectCode, strandSearch.Trim())))))];

    private StrandRow? CurrentStrand(IReadOnlyList<StrandRow> shown) => shown.FirstOrDefault(s => s.Id == selectedStrandId) ?? shown.FirstOrDefault();

    /// <summary>The courses of a strand that the search keeps (a strand that matches by itself shows all its courses).</summary>
    private IEnumerable<CurriculumLine> CoursesShown(StrandRow strand)
    {
        var all = curriculum.Where(l => l.StrandId == strand.Id);
        var page = PageSearch;
        if (page.Length > 0 && !(Has(strand.Code, page) || Has(strand.Name, page)))
        {
            all = all.Where(l => Has(l.SubjectName, page) || Has(l.SubjectCode, page));
        }

        var own = courseSearch.Trim();
        return own.Length == 0 ? all : all.Where(l => Has(l.SubjectName, own) || Has(l.SubjectCode, own));
    }

    private AddState AddOf(int strandId)
    {
        if (!adds.TryGetValue(strandId, out var add))
        {
            adds[strandId] = add = new AddState();
        }

        return add;
    }

    private NewNode NewStrandOf(int trackId)
    {
        if (!newStrands.TryGetValue(trackId, out var node))
        {
            newStrands[trackId] = node = new NewNode();
        }

        return node;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        tracks = await Setup.ListTracksAsync();
        strands = await Setup.ListStrandsAsync();
        curriculum = await Setup.GetFullCurriculumAsync();
        var all = await Setup.ListSubjectsAsync();
        subjects = all.ToDictionary(s => s.Id);
        activeSubjects = [.. all.Where(s => s.IsActive).OrderBy(s => s.Name)];
    }

    private async Task DoAsync(Func<int, Task<ServiceResult>> save)
    {
        var result = await RunAsync(save);
        await LoadAsync();

        // A change that was refused puts the old value back in the box.
        stamp++;
        if (result.Succeeded)
        {
            fade?.Dispose();
            fade = new System.Threading.Timer(_ => _ = InvokeAsync(() => { Message = null; StateHasChanged(); }), null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan);
        }
    }

    // ---- tracks
    private Task SaveTrackAsync(TrackRow track, string? code = null, string? name = null) =>
        DoAsync(userId => Setup.SaveTrackAsync(new TrackInput { Id = track.Id, Code = code ?? track.Code, Name = name ?? track.Name, IsActive = track.IsActive }, userId));

    private async Task AddTrackAsync()
    {
        var input = new TrackInput { Code = newTrack.Code, Name = newTrack.Name };
        var result = await RunAsync(userId => Setup.SaveTrackAsync(input, userId));
        if (result.Succeeded)
        {
            newTrack.Code = "";
            newTrack.Name = "";
            if (result.Id is { } id)
            {
                selectedTrackId = id;
                selectedStrandId = null;
            }
        }

        await LoadAsync();
        stamp++;
    }

    // ---- strands
    private Task SaveStrandAsync(StrandRow strand, string? code = null, string? name = null, bool? active = null) =>
        DoAsync(userId => Setup.SaveStrandAsync(new StrandInput { Id = strand.Id, Code = code ?? strand.Code, Name = name ?? strand.Name, TrackId = strand.TrackId, IsActive = active ?? strand.IsActive }, userId));

    private async Task AddStrandAsync(TrackRow track, NewNode node)
    {
        var input = new StrandInput { Code = node.Code, Name = string.IsNullOrWhiteSpace(node.Name) ? node.Code : node.Name, TrackId = track.Id };
        var result = await RunAsync(userId => Setup.SaveStrandAsync(input, userId));
        if (result.Succeeded)
        {
            node.Code = "";
            node.Name = "";
            selectedTrackId = track.Id;
            if (result.Id is { } id)
            {
                selectedStrandId = id;
            }
        }

        await LoadAsync();
        stamp++;
    }

    // ---- courses
    private Task SaveCourseAsync(CurriculumLine line, string? code = null, string? name = null, string? units = null)
    {
        var subject = subjects.GetValueOrDefault(line.SubjectId);
        var parsed = decimal.TryParse(units, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var u) ? u : line.Units;
        var input = new SubjectInput
        {
            Id = line.SubjectId, Code = code ?? line.SubjectCode, Name = name ?? line.SubjectName, Description = subject?.Description, IsActive = line.IsActive, Units = parsed,
        };
        return DoAsync(userId => Setup.SaveSubjectAsync(input, userId));
    }

    private async Task AddCourseAsync(StrandRow strand, AddState add)
    {
        var subjectId = add.SubjectId;
        var result = await RunAsync(async userId =>
        {
            if (subjectId == 0)
            {
                var created = await Setup.SaveSubjectAsync(new SubjectInput { Code = add.Code, Name = add.Name, IsActive = true, Units = 3 }, userId);
                if (!created.Succeeded)
                {
                    return created;
                }

                subjectId = created.Id ?? 0;
                if (subjectId == 0)
                {
                    return ServiceResult.Fail("The course was saved, but it could not be added to the strand. Pick it from the list.");
                }
            }

            return await Setup.AddCurriculumSubjectAsync(strand.Id, add.Grade, add.Term, subjectId, userId);
        });

        if (result.Succeeded)
        {
            add.SubjectId = 0;
            add.Code = "";
            add.Name = "";
        }

        await LoadAsync();
        stamp++;
    }

    private sealed record RemoveCourseTarget(StrandRow Strand, CurriculumLine Line);

    private RemoveCourseTarget? removingCourse;

    private void AskRemoveCourse(StrandRow strand, CurriculumLine line)
    {
        Errors = [];
        removingCourse = new RemoveCourseTarget(strand, line);
    }

    private void CloseRemoveCourse() => removingCourse = null;

    private async Task RemoveCourseConfirmedAsync()
    {
        if (removingCourse is not { } target)
        {
            return;
        }

        await DoAsync(userId => Setup.RemoveCurriculumSubjectAsync(target.Strand.Id, target.Line.GradeLevel, target.Line.TermNumber, target.Line.SubjectId, userId));
        removingCourse = null;
    }

    // ---- deleting a track or a strand
    private void OpenDelete(int id, string code, string kind)
    {
        Errors = [];
        deleting = new DeleteTarget(id, code, kind);
    }

    private void CloseDelete() => deleting = null;

    private async Task DeleteAsync()
    {
        var target = deleting!;
        var result = await RunAsync(userId => target.Kind == "track" ? Setup.DeleteTrackAsync(target.Id, userId) : Setup.DeleteStrandAsync(target.Id, userId));
        if (result.Succeeded)
        {
            deleting = null;
            await LoadAsync();
            stamp++;
        }
    }
}
