@inherits SetupTabBase

@* Step 2: the tracks, their strands and the courses of each strand, as a list in three levels. Press a track to see its strands, press a strand to see its courses.
   Every box is ready to type in: a change is saved when the box is left. The search box finds a strand or a course and opens the way to it. *@
<div class="curriculum-step">
    <FormErrors Errors="Errors" />
    <p class="saved-line" role="status" aria-live="polite">@(Message ?? "")</p>

    <div class="tree-tools">
        <SearchField Id="tree-search" @bind-Value="treeSearch" Live="true" SubmitText="" Placeholder="Search a track, a strand or a course" AriaLabel="Search tracks, strands and courses" Class="tree-search" />
        <span class="filter-count">@Summary</span>
        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevrons-down" OnClick="ExpandAll">Open all</Button>
        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevrons-up" OnClick="CollapseAll">Close all</Button>
    </div>

    @if (tracks is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <ul class="tree" role="tree" aria-label="Tracks, strands and courses">
            @foreach (var track in ShownTracks)
            {
                var trackOpen = IsOpen("t" + track.Id);
                var strands = StrandsOf(track.Id);
                <li class="node track" role="treeitem" aria-expanded="@(trackOpen ? "true" : "false")" data-track="@track.Code">
                    <div class="node-row">
                        <button type="button" class="chevron" aria-label="@($"{(trackOpen ? "Close" : "Open")} the track {track.Code}")" @onclick='() => Toggle("t" + track.Id)'>
                            <Icon Name="@(trackOpen ? "chevron-down" : "chevron-right")" Size="18" />
                        </button>
                        <Icon Name="layers" Size="18" />
                        <input class="cell code" aria-label="@($"Code of the track {track.Code}")" maxlength="20" value="@track.Code" @key="@($"tc-{track.Id}-{stamp}")"
                               @onchange="e => SaveTrackAsync(track, code: e.Value?.ToString())" />
                        <input class="cell grow" aria-label="@($"Name of the track {track.Code}")" maxlength="100" value="@track.Name" @key="@($"tm-{track.Id}-{stamp}")"
                               @onchange="e => SaveTrackAsync(track, name: e.Value?.ToString())" />
                        <span class="count">@track.Strands @(track.Strands == 1 ? "strand" : "strands")</span>
                        <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true" Title="@($"Delete the track {track.Code}")" OnClick='() => OpenDelete(track.Id, track.Code, "track")' />
                    </div>

                    @if (trackOpen)
                    {
                        <ul class="children" role="group">
                            @foreach (var strand in strands)
                            {
                                var strandOpen = IsOpen("s" + strand.Id);
                                var lines = LinesOf(strand.Id);
                                <li class="node strand" role="treeitem" aria-expanded="@(strandOpen ? "true" : "false")" data-strand="@strand.Code">
                                    <div class="node-row">
                                        <button type="button" class="chevron" aria-label="@($"{(strandOpen ? "Close" : "Open")} the strand {strand.Code}")" @onclick='() => Toggle("s" + strand.Id)'>
                                            <Icon Name="@(strandOpen ? "chevron-down" : "chevron-right")" Size="18" />
                                        </button>
                                        <Icon Name="layout-grid" Size="18" />
                                        <input class="cell code" aria-label="@($"Code of the strand {strand.Code}")" maxlength="20" value="@strand.Code" @key="@($"sc-{strand.Id}-{stamp}")"
                                               @onchange="e => SaveStrandAsync(strand, code: e.Value?.ToString())" />
                                        <input class="cell grow" aria-label="@($"Name of the strand {strand.Code}")" maxlength="150" value="@strand.Name" @key="@($"sm-{strand.Id}-{stamp}")"
                                               @onchange="e => SaveStrandAsync(strand, name: e.Value?.ToString())" />
                                        <label class="offered" title="Switch it off for a strand that is not offered now. The registrar can't enroll students in it.">
                                            <input type="checkbox" aria-label="@($"{strand.Code} is offered")" checked="@strand.IsActive" @key="@($"sa-{strand.Id}-{stamp}")"
                                                   @onchange="e => SaveStrandAsync(strand, active: (bool?)e.Value)" /> Offered
                                        </label>
                                        <span class="count">@strand.Subjects @(strand.Subjects == 1 ? "course" : "courses")</span>
                                        <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true" Title="@($"Delete the strand {strand.Code}")" OnClick='() => OpenDelete(strand.Id, strand.Code, "strand")' />
                                    </div>

                                    @if (strandOpen)
                                    {
                                        <div class="children courses-box">
                                            @foreach (var group in lines.GroupBy(l => (l.GradeLevel, l.TermNumber)).OrderBy(g => g.Key.GradeLevel).ThenBy(g => g.Key.TermNumber))
                                            {
                                                <section class="course-group" aria-label="@($"Grade {group.Key.GradeLevel}, term {group.Key.TermNumber} of {strand.Code}")">
                                                    <h4>Grade @group.Key.GradeLevel · @SchoolCalendar.TermName(group.Key.TermNumber)</h4>
                                                    <ul class="courses">
                                                        @foreach (var line in group)
                                                        {
                                                            var subject = subjects.GetValueOrDefault(line.SubjectId);
                                                            var others = StrandsUsing(line.SubjectId, strand.Id);
                                                            <li class="course" data-course="@line.SubjectCode">
                                                                <input class="cell code" aria-label="@($"Code of {line.SubjectName}")" maxlength="30" value="@line.SubjectCode" @key="@($"cc-{line.SubjectId}-{stamp}")"
                                                                       @onchange="e => SaveCourseAsync(line, code: e.Value?.ToString())" />
                                                                <input class="cell grow" aria-label="@($"Name of {line.SubjectName}")" maxlength="150" value="@line.SubjectName" @key="@($"cn-{line.SubjectId}-{stamp}")"
                                                                       @onchange="e => SaveCourseAsync(line, name: e.Value?.ToString())" />
                                                                <input class="cell units" type="number" min="0.5" max="12" step="0.5" aria-label="@($"Units of {line.SubjectName}")" value="@line.Units.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)" @key="@($"cu-{line.SubjectId}-{stamp}")"
                                                                       @onchange="e => SaveCourseAsync(line, units: e.Value?.ToString())" />
                                                                @if (others > 0)
                                                                {
                                                                    <span class="shared" title="A change of this course is a change in the other strands that take it too.">+@others @(others == 1 ? "strand" : "strands")</span>
                                                                }
                                                                <Button Small="true" Variant="ButtonVariant.Ghost" IconName="x" IconOnly="true" Title="@($"Take {line.SubjectName} out of {strand.Code}")" OnClick="() => RemoveCourseAsync(strand.Id, line)" />
                                                            </li>
                                                        }
                                                    </ul>
                                                </section>
                                            }

                                            @if (!lines.Any() && string.IsNullOrWhiteSpace(EffectiveSearch))
                                            {
                                                <p class="muted">No courses yet. Add the first one below.</p>
                                            }

                                            @if (string.IsNullOrWhiteSpace(EffectiveSearch))
                                            {
                                                var add = AddOf(strand.Id);
                                                <div class="add-row" role="group" aria-label="@($"Add a course to {strand.Code}")">
                                                    <select class="cell" aria-label="@($"Course to add to {strand.Code}")" @onchange="e => add.SubjectId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0">
                                                        <option value="0" selected="@(add.SubjectId == 0)">A new course…</option>
                                                        @foreach (var pick in activeSubjects)
                                                        {
                                                            <option value="@pick.Id" selected="@(add.SubjectId == pick.Id)">@pick.Name</option>
                                                        }
                                                    </select>
                                                    @if (add.SubjectId == 0)
                                                    {
                                                        <input class="cell code" placeholder="Code" aria-label="@($"Code of the new course for {strand.Code}")" maxlength="30" autocomplete="off" @bind="add.Code" @bind:event="oninput" />
                                                        <input class="cell grow" placeholder="Name of the new course" aria-label="@($"Name of the new course for {strand.Code}")" maxlength="150" autocomplete="off" @bind="add.Name" @bind:event="oninput" />
                                                    }
                                                    <select class="cell narrow" aria-label="@($"Grade level of the new course for {strand.Code}")" @bind="add.Grade">
                                                        <option value="11">Grade 11</option>
                                                        <option value="12">Grade 12</option>
                                                    </select>
                                                    <select class="cell narrow" aria-label="@($"Term of the new course for {strand.Code}")" @bind="add.Term">
                                                        @for (var n = 1; n <= SchoolCalendar.TermsPerYear; n++)
                                                        {
                                                            <option value="@n">@SchoolCalendar.TermName(n)</option>
                                                        }
                                                    </select>
                                                    <Button Small="true" IconName="plus" Disabled="Busy" OnClick="() => AddCourseAsync(strand, add)">Add course</Button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </li>
                            }

                            @if (string.IsNullOrWhiteSpace(EffectiveSearch))
                            {
                                var newStrand = NewStrandOf(track.Id);
                                <li class="add-row" role="group" aria-label="@($"Add a strand to {track.Code}")">
                                    <input class="cell code" placeholder="Code" aria-label="@($"Code of the new strand of {track.Code}")" maxlength="20" autocomplete="off" @bind="newStrand.Code" @bind:event="oninput" />
                                    <input class="cell grow" placeholder="Name of the new strand" aria-label="@($"Name of the new strand of {track.Code}")" maxlength="150" autocomplete="off" @bind="newStrand.Name" @bind:event="oninput" />
                                    <Button Small="true" IconName="plus" Disabled="Busy" OnClick="() => AddStrandAsync(track, newStrand)">Add strand</Button>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }

            @if (!ShownTracks.Any())
            {
                <li class="muted none">@(tracks.Count == 0 ? "No track yet. Add the first one below." : "Nothing matches.")</li>
            }
        </ul>

        @if (string.IsNullOrWhiteSpace(EffectiveSearch))
        {
            <div class="add-row add-track" role="group" aria-label="Add a track">
                <input class="cell code" placeholder="Code" aria-label="Code of the new track" maxlength="20" autocomplete="off" @bind="newTrack.Code" @bind:event="oninput" />
                <input class="cell grow" placeholder="Name of the new track" aria-label="Name of the new track" maxlength="100" autocomplete="off" @bind="newTrack.Name" @bind:event="oninput" />
                <Button Small="true" IconName="plus" Disabled="Busy" OnClick="AddTrackAsync">Add track</Button>
            </div>
        }
    }
</div>

<Modal Open="deleting is not null" Title="@($"Delete this {deleting?.Kind}?")" OnClose="CloseDelete">
    @if (deleting is not null)
    {
        <p class="delete-text">You are about to delete the @deleting.Kind <strong>@deleting.Code</strong>. <strong>This can't be undone.</strong></p>
        <FormErrors Errors="Errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="Busy" OnClick="DeleteAsync">@(Busy ? "Deleting…" : "Delete")</Button>
        </div>
    }
</Modal>

@code {
    private sealed record DeleteTarget(int Id, string Code, string Kind);

    private sealed class AddState
    {
        public int SubjectId { get; set; }
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public int Grade { get; set; } = 11;
        public int Term { get; set; } = 1;
    }

    private sealed class NewNode
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
    }

    /// <summary>What is typed in the search box of the page.</summary>
    [Parameter] public string? Search { get; set; }

    private IReadOnlyList<TrackRow>? tracks;
    private IReadOnlyList<StrandRow> strands = [];
    private IReadOnlyList<CurriculumLine> curriculum = [];
    private Dictionary<int, SubjectRow> subjects = [];
    private List<SubjectRow> activeSubjects = [];
    private readonly HashSet<string> open = [];
    private readonly Dictionary<int, AddState> adds = [];
    private readonly Dictionary<int, NewNode> newStrands = [];
    private readonly NewNode newTrack = new();
    private string treeSearch = "";
    private DeleteTarget? deleting;
    private int stamp;
    private System.Threading.Timer? fade;

    private string EffectiveSearch => string.IsNullOrWhiteSpace(treeSearch) ? (Search ?? "").Trim() : treeSearch.Trim();

    private bool Searching => !string.IsNullOrWhiteSpace(EffectiveSearch);

    private bool IsOpen(string key) => Searching || open.Contains(key);

    private void Toggle(string key)
    {
        if (!open.Remove(key))
        {
            open.Add(key);
        }
    }

    private void ExpandAll()
    {
        foreach (var t in tracks ?? [])
        {
            open.Add("t" + t.Id);
        }

        foreach (var s in strands)
        {
            open.Add("s" + s.Id);
        }
    }

    private void CollapseAll() => open.Clear();

    private AddState AddOf(int strandId)
    {
        if (!adds.TryGetValue(strandId, out var add))
        {
            adds[strandId] = add = new AddState();
        }

        return add;
    }

    private NewNode NewStrandOf(int trackId)
    {
        if (!newStrands.TryGetValue(trackId, out var node))
        {
            newStrands[trackId] = node = new NewNode();
        }

        return node;
    }

    private static bool Has(string? text, string query) => text?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false;

    private IEnumerable<CurriculumLine> LinesOf(int strandId)
    {
        var all = curriculum.Where(l => l.StrandId == strandId);
        if (!Searching)
        {
            return all;
        }

        // A strand that matches by itself shows all its courses; otherwise only the courses that match.
        var strand = strands.FirstOrDefault(s => s.Id == strandId);
        var query = EffectiveSearch;
        return strand is not null && (Has(strand.Code, query) || Has(strand.Name, query)) ? all : all.Where(l => Has(l.SubjectName, query) || Has(l.SubjectCode, query));
    }

    private IEnumerable<StrandRow> StrandsOf(int trackId)
    {
        var inTrack = strands.Where(s => s.TrackId == trackId);
        if (!Searching)
        {
            return inTrack;
        }

        var track = tracks?.FirstOrDefault(t => t.Id == trackId);
        var query = EffectiveSearch;
        if (track is not null && (Has(track.Code, query) || Has(track.Name, query)))
        {
            return inTrack;
        }

        return inTrack.Where(s => Has(s.Code, query) || Has(s.Name, query) || curriculum.Any(l => l.StrandId == s.Id && (Has(l.SubjectName, query) || Has(l.SubjectCode, query))));
    }

    private IEnumerable<TrackRow> ShownTracks => (tracks ?? []).Where(t => !Searching || Has(t.Code, EffectiveSearch) || Has(t.Name, EffectiveSearch) || StrandsOf(t.Id).Any());

    private string Summary => tracks is null ? "" : $"{tracks.Count} {(tracks.Count == 1 ? "track" : "tracks")} · {strands.Count} {(strands.Count == 1 ? "strand" : "strands")} · {subjects.Count} {(subjects.Count == 1 ? "course" : "courses")}";

    private int StrandsUsing(int subjectId, int exceptStrandId) => curriculum.Where(l => l.SubjectId == subjectId && l.StrandId != exceptStrandId).Select(l => l.StrandId).Distinct().Count();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        tracks = await Setup.ListTracksAsync();
        strands = await Setup.ListStrandsAsync();
        curriculum = await Setup.GetFullCurriculumAsync();
        var all = await Setup.ListSubjectsAsync();
        subjects = all.ToDictionary(s => s.Id);
        activeSubjects = [.. all.Where(s => s.IsActive).OrderBy(s => s.Name)];
    }

    private async Task DoAsync(Func<int, Task<ServiceResult>> save)
    {
        var result = await RunAsync(save);
        await LoadAsync();

        // A change that was refused puts the old value back in the box.
        stamp++;
        if (result.Succeeded)
        {
            fade?.Dispose();
            fade = new System.Threading.Timer(_ => _ = InvokeAsync(() => { Message = null; StateHasChanged(); }), null, TimeSpan.FromSeconds(3), Timeout.InfiniteTimeSpan);
        }
    }

    // ---- tracks
    private Task SaveTrackAsync(TrackRow track, string? code = null, string? name = null) =>
        DoAsync(userId => Setup.SaveTrackAsync(new TrackInput { Id = track.Id, Code = code ?? track.Code, Name = name ?? track.Name, IsActive = track.IsActive }, userId));

    private async Task AddTrackAsync()
    {
        var input = new TrackInput { Code = newTrack.Code, Name = newTrack.Name };
        var result = await RunAsync(userId => Setup.SaveTrackAsync(input, userId));
        if (result.Succeeded)
        {
            newTrack.Code = "";
            newTrack.Name = "";
        }

        await LoadAsync();
        stamp++;
    }

    // ---- strands
    private Task SaveStrandAsync(StrandRow strand, string? code = null, string? name = null, bool? active = null) =>
        DoAsync(userId => Setup.SaveStrandAsync(new StrandInput { Id = strand.Id, Code = code ?? strand.Code, Name = name ?? strand.Name, TrackId = strand.TrackId, IsActive = active ?? strand.IsActive }, userId));

    private async Task AddStrandAsync(TrackRow track, NewNode node)
    {
        var input = new StrandInput { Code = node.Code, Name = string.IsNullOrWhiteSpace(node.Name) ? node.Code : node.Name, TrackId = track.Id };
        var result = await RunAsync(userId => Setup.SaveStrandAsync(input, userId));
        if (result.Succeeded)
        {
            node.Code = "";
            node.Name = "";
            open.Add("t" + track.Id);
            if (result.Id is { } id)
            {
                open.Add("s" + id);
            }
        }

        await LoadAsync();
        stamp++;
    }

    // ---- courses
    private Task SaveCourseAsync(CurriculumLine line, string? code = null, string? name = null, string? units = null)
    {
        var subject = subjects.GetValueOrDefault(line.SubjectId);
        var parsed = decimal.TryParse(units, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var u) ? u : line.Units;
        var input = new SubjectInput
        {
            Id = line.SubjectId, Code = code ?? line.SubjectCode, Name = name ?? line.SubjectName, Description = subject?.Description, IsActive = line.IsActive, Units = parsed,
        };
        return DoAsync(userId => Setup.SaveSubjectAsync(input, userId));
    }

    private async Task AddCourseAsync(StrandRow strand, AddState add)
    {
        var subjectId = add.SubjectId;
        var result = await RunAsync(async userId =>
        {
            if (subjectId == 0)
            {
                var created = await Setup.SaveSubjectAsync(new SubjectInput { Code = add.Code, Name = add.Name, IsActive = true, Units = 3 }, userId);
                if (!created.Succeeded)
                {
                    return created;
                }

                subjectId = created.Id ?? 0;
                if (subjectId == 0)
                {
                    return ServiceResult.Fail("The course was saved, but it could not be added to the strand. Pick it from the list.");
                }
            }

            return await Setup.AddCurriculumSubjectAsync(strand.Id, add.Grade, add.Term, subjectId, userId);
        });

        if (result.Succeeded)
        {
            add.SubjectId = 0;
            add.Code = "";
            add.Name = "";
        }

        await LoadAsync();
        stamp++;
    }

    private Task RemoveCourseAsync(int strandId, CurriculumLine line) =>
        DoAsync(userId => Setup.RemoveCurriculumSubjectAsync(strandId, line.GradeLevel, line.TermNumber, line.SubjectId, userId));

    // ---- deleting a track or a strand
    private void OpenDelete(int id, string code, string kind)
    {
        Errors = [];
        deleting = new DeleteTarget(id, code, kind);
    }

    private void CloseDelete() => deleting = null;

    private async Task DeleteAsync()
    {
        var target = deleting!;
        var result = await RunAsync(userId => target.Kind == "track" ? Setup.DeleteTrackAsync(target.Id, userId) : Setup.DeleteStrandAsync(target.Id, userId));
        if (result.Succeeded)
        {
            deleting = null;
            await LoadAsync();
            stamp++;
        }
    }
}
