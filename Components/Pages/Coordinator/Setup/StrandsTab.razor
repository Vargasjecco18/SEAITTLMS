@inherits SetupTabBase

<Card>
    <div class="tab-head">
        <p class="grow">The strands of each track and <strong>their courses</strong>. When a student is enrolled the courses are not chosen: the student gets all the courses of the strand for that grade level and term.</p>
    </div>

    <Notice Message="@Message" IsError="MessageIsError" OnDismiss="ClearMessage" />

    @* The fields are always on the page: fill them in and press the button. Edit on a row puts that row in them. *@
    @if (form is not null && lookups is not null)
    {
        <section class="entry" id="@EntryId" aria-label="@(form.Id is null ? "Add a strand" : "Change this strand")">
            <h3 class="entry-title">@(form.Id is null ? "Add a strand" : "Change this strand")</h3>
        <EditForm Model="form" OnSubmit="SaveAsync" class="entry-form">
            <FormErrors Errors="Errors" />
            <div class="two">
                <Field For="s-code" Label="Code" Required="true" Hint="Like BUSSENT.">
                    <input id="s-code" maxlength="20" autocomplete="off" @bind="form.Code" />
                </Field>
                <Field For="s-track" Label="Track" Required="true">
                    <select id="s-track" @bind="form.TrackId">
                        <option value="0">Choose a track</option>
                        @foreach (var track in lookups.Tracks)
                        {
                            <option value="@track.Id">@track.Code</option>
                        }
                    </select>
                </Field>
            </div>
            <Field For="s-name" Label="Name" Required="true">
                <input id="s-name" maxlength="150" autocomplete="off" @bind="form.Name" />
            </Field>

            <label class="switch">
                <input id="s-active" type="checkbox" @bind="form.IsActive" />
                <span>
                    <strong>The school offers this strand</strong>
                    <small>Switch it off for a strand that is not offered now. The registrar can't enroll students in it.</small>
                </span>
            </label>
            <div class="entry-actions">
                    @if (form.Id is not null)
                    {
                        <Button Variant="ButtonVariant.Ghost" OnClick="CloseForm">Cancel</Button>
                    }
                    <Button Type="submit" IconName="@(form.Id is null ? "plus" : "circle-check")" Disabled="Busy">@(Busy ? "Saving…" : form.Id is null ? "Add strand" : "Save changes")</Button>
                </div>
        </EditForm>
        </section>
    }

    @if (rows is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (rows.Count == 0)
    {
        <EmptyState IconName="layout-grid" Title="No strand yet"><p>Add a track first, then its strands.</p></EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Strand</th>
                        <th scope="col">Track</th>
                        <th scope="col" class="col-more">Courses</th>
                        <th scope="col" class="col-more">Sections</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td>
                                <span class="name">@row.Code</span>
                                @if (!string.Equals(row.Name, row.Code, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="sub">@row.Name</span>
                                }
                            </td>
                            <td class="nowrap">@row.Track</td>
                            <td class="col-more">@row.Subjects</td>
                            <td class="col-more">@row.Sections</td>
                            <td><Badge Tone="@(row.IsActive ? Tone.Success : Tone.Neutral)">@(row.IsActive ? "Offered" : "Not offered")</Badge></td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="book-open" Title="@($"The courses of {row.Code}")" OnClick="() => OpenCurriculumAsync(row)">Courses</Button>
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" Title="@($"Edit {row.Code}")" OnClick="() => OpenEdit(row)">Edit</Button>
                                    <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true" Title="@($"Delete {row.Code}")" OnClick="() => OpenDelete(row)" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

@* ===== The subjects of a strand (its curriculum) ===== *@
<Modal Open="curriculumOf is not null" Title="@($"Courses of {curriculumOf?.Code}")" OnClose="CloseCurriculum" Large="true">
    @if (curriculumOf is not null && lookups is not null)
    {
        <p class="note-box">
            These are the courses every student of <strong>@curriculumOf.Code</strong> gets in a term of a grade level. Students who are
            enrolled already keep the courses they have; students enrolled from now on get these.
        </p>

        <FormErrors Errors="Errors" />

        <div class="two">
            <Field For="c-grade" Label="Grade level">
                <select id="c-grade" @bind="grade">
                    <option value="11">Grade 11</option>
                    <option value="12">Grade 12</option>
                </select>
            </Field>
            <Field For="c-term" Label="Term">
                <select id="c-term" @bind="termNumber">
                    @foreach (var number in lookups.TermNumbers)
                    {
                        <option value="@number">@TermName(number)</option>
                    }
                </select>
            </Field>
        </div>

        @if (SubjectsShown.Count == 0)
        {
            <p class="muted">No courses yet for grade @grade, @TermName(termNumber).</p>
        }
        else
        {
            <ul class="curriculum">
                @foreach (var entry in SubjectsShown)
                {
                    <li>
                        <span>@entry.SubjectName <small>@entry.SubjectCode</small></span>
                        <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" Title="@($"Remove {entry.SubjectName}")" Disabled="Busy" OnClick="() => RemoveSubjectAsync(entry)">Remove</Button>
                    </li>
                }
            </ul>
        }

        <div class="add-row">
            <Field For="c-subject" Label="Add a course">
                <select id="c-subject" @bind="pickSubject">
                    <option value="0">Choose a course</option>
                    @foreach (var subject in SubjectsToAdd)
                    {
                        <option value="@subject.Id">@subject.Name</option>
                    }
                </select>
            </Field>
            <Button IconName="plus" Disabled="@(Busy || pickSubject == 0)" OnClick="AddSubjectAsync">Add</Button>
        </div>

        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseCurriculum">Close</Button>
        </div>
    }
</Modal>

<Modal Open="deleting is not null" Title="Delete this strand?" OnClose="CloseDelete">
    @if (deleting is not null)
    {
        <p class="delete-text">You are about to delete the strand <strong>@deleting.Code</strong> and its list of courses. <strong>This can't be undone.</strong></p>
        <FormErrors Errors="Errors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="Busy" OnClick="DeleteAsync">@(Busy ? "Deleting…" : "Delete")</Button>
        </div>
    }
</Modal>

@code {
    private IReadOnlyList<StrandRow>? rows;
    private SetupLookups? lookups;
    private StrandInput? form;
    private StrandRow? deleting;

    private StrandRow? curriculumOf;
    private IReadOnlyList<CurriculumEntry> curriculum = [];
    private int grade = 11;
    private int termNumber = 1;
    private int pickSubject;

    private IReadOnlyList<CurriculumEntry> SubjectsShown => curriculum.Where(c => c.GradeLevel == grade && c.TermNumber == termNumber).ToList();

    private IEnumerable<SubjectPick> SubjectsToAdd =>
        (lookups?.Subjects ?? []).Where(s => s.IsActive && SubjectsShown.All(c => c.SubjectId != s.Id));

    private static string TermName(int number) => number switch { 1 => "1st term", 2 => "2nd term", 3 => "3rd term", _ => $"{number}th term" };

    protected override async Task OnInitializedAsync()
    {
        lookups = await Setup.GetLookupsAsync();
        rows = await Setup.ListStrandsAsync();
        ResetForm();
    }

    private async Task ReloadAsync()
    {
        lookups = await Setup.GetLookupsAsync();
        rows = await Setup.ListStrandsAsync();
    }

    private void ResetForm()
    {
        Errors = [];
        form = new StrandInput { TrackId = lookups?.Tracks.FirstOrDefault()?.Id ?? 0 };
    }

    private async Task OpenEdit(StrandRow row)
    {
        Errors = [];
        form = new StrandInput { Id = row.Id, Code = row.Code, Name = row.Name, TrackId = row.TrackId, IsActive = row.IsActive };
        await ShowFormAsync();
    }

    private void CloseForm() => ResetForm();

    private async Task SaveAsync()
    {
        var result = await RunAsync(userId => Setup.SaveStrandAsync(form!, userId));
        if (result.Succeeded)
        {
            ResetForm();
            await ReloadAsync();
        }
    }

    private void OpenDelete(StrandRow row)
    {
        Errors = [];
        deleting = row;
    }

    private void CloseDelete() => deleting = null;

    private async Task DeleteAsync()
    {
        var result = await RunAsync(userId => Setup.DeleteStrandAsync(deleting!.Id, userId));
        if (result.Succeeded)
        {
            deleting = null;
            await ReloadAsync();
        }
    }

    // ---- the subjects of a strand
    private async Task OpenCurriculumAsync(StrandRow row)
    {
        Errors = [];
        Message = null;
        pickSubject = 0;
        curriculumOf = row;
        curriculum = await Setup.GetCurriculumAsync(row.Id);
    }

    private void CloseCurriculum()
    {
        curriculumOf = null;
        Message = null;
        Errors = [];
    }

    private async Task AddSubjectAsync()
    {
        var result = await RunAsync(userId => Setup.AddCurriculumSubjectAsync(curriculumOf!.Id, grade, termNumber, pickSubject, userId));
        if (result.Succeeded)
        {
            pickSubject = 0;
            curriculum = await Setup.GetCurriculumAsync(curriculumOf!.Id);
            rows = await Setup.ListStrandsAsync();
        }
    }

    private async Task RemoveSubjectAsync(CurriculumEntry entry)
    {
        var result = await RunAsync(userId => Setup.RemoveCurriculumSubjectAsync(curriculumOf!.Id, entry.GradeLevel, entry.TermNumber, entry.SubjectId, userId));
        if (result.Succeeded)
        {
            curriculum = await Setup.GetCurriculumAsync(curriculumOf!.Id);
            rows = await Setup.ListStrandsAsync();
        }
    }
}
