@inherits SetupTabBase
@inject CourseScheduleService Times

@* The class schedule: the hours of AM, MID and PM, and for each course of a section the schedule it is in, the days (MWF or TTH) and the time. One Save for the whole section. *@
<Card>
    <div class="tab-head">
        <p class="grow">
            The hours of the day:
            @foreach (var part in parts ?? [])
            {
                <span class="part-hours"><strong>@part.Code</strong> @part.Hours</span>
            }
            A class must be inside the hours of its schedule.
        </p>
        <Button Variant="ButtonVariant.Secondary" IconName="clock" Disabled="parts is null" OnClick="OpenHours">Edit the times of the day</Button>
    </div>

    <Notice Message="@Message" IsError="MessageIsError" OnDismiss="ClearMessage" />

    <div class="filter-bar">
        <Field For="cs-section" Label="Section" Class="schedule-section">
            <select id="cs-section" value="@sectionId" @onchange="SectionChanged">
                @foreach (var s in sections ?? [])
                {
                    <option value="@s.SectionId" selected="@(s.SectionId == sectionId)">@s.Text · @s.Scheduled of @s.Courses set</option>
                }
            </select>
        </Field>
        <div class="filter-actions save-all">
            <Button IconName="circle-check" Disabled="@(Busy || courses is null || courses.Count == 0)" OnClick="SaveAllAsync">@(Busy ? "Saving…" : "Save")</Button>
        </div>
    </div>

    <p class="muted how">Choose, for each course, the <strong>schedule</strong> (AM, MID or PM), the <strong>days</strong> (<strong>MWF</strong> is Monday, Wednesday, Friday; <strong>TTH</strong> is Tuesday, Thursday) and when the class <strong>starts and ends</strong>, then press <strong>Save</strong>. A course with nothing chosen has no class time. Two courses of a section can't meet at the same time in the same term, and a teacher can't have two classes at the same time.</p>

    <FormErrors Errors="Errors" />

    @if (sections is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (sections.Count == 0)
    {
        <EmptyState IconName="users" Title="No section yet"><p>Add a section in the Sections tab first.</p></EmptyState>
    }
    else if (courses is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (courses.Count == 0)
    {
        <EmptyState IconName="book-open" Title="This section has no courses"><p>Courses come from the curriculum of its strand (Strands tab).</p></EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table schedule-table">
                <thead>
                    <tr>
                        <th scope="col">Course</th>
                        <th scope="col" class="col-more">Term</th>
                        <th scope="col" class="col-more">Teacher</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Days</th>
                        <th scope="col">Starts</th>
                        <th scope="col">Ends</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in courses)
                    {
                        var edit = courseEdits[row.SubjectId];
                        <tr>
                            <td>
                                <span class="name">@row.Name</span>
                                @if (row.Meeting is { } m)
                                {
                                    <span class="sub">Now: @m.DescribeFull()</span>
                                }
                                else
                                {
                                    <span class="sub">No class time yet</span>
                                }
                            </td>
                            <td class="col-more nowrap">@row.TermName</td>
                            <td class="col-more">@(row.TeacherName ?? "—")</td>
                            <td>
                                <select aria-label="@($"Schedule of {row.Name}")" @onchange="e => SetPart(edit, e)">
                                    <option value="" selected="@(edit.PartId == "")">Choose</option>
                                    @foreach (var part in parts ?? [])
                                    {
                                        <option value="@part.ScheduleId" selected="@(edit.PartId == part.ScheduleId.ToString())">@part.Code</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <select aria-label="@($"Days of {row.Name}")" @onchange="e => SetDays(edit, e)">
                                    <option value="" selected="@(edit.Days == "")">Choose</option>
                                    <option value="MWF" selected="@(edit.Days == "MWF")">MWF</option>
                                    <option value="TTH" selected="@(edit.Days == "TTH")">TTH</option>
                                </select>
                            </td>
                            <td><input type="time" step="300" aria-label="@($"Start of {row.Name}")" value="@edit.Start" @onchange="e => SetStart(edit, e)" /></td>
                            <td><input type="time" step="300" aria-label="@($"End of {row.Name}")" value="@edit.End" @onchange="e => SetEnd(edit, e)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

<Modal Open="hours is not null" Title="The times of the day" OnClose="CloseHours">
    @if (hours is not null && parts is not null)
    {
        <form @onsubmit="SaveHoursAsync">
            <FormErrors Errors="Errors" />
            <p class="muted">A class must start and end inside the hours of its schedule. A shorter day that would leave a class outside it is refused.</p>
            <div class="day-parts">
                @foreach (var part in parts)
                {
                    var edit = hours[part.ScheduleId];
                    <div class="day-part">
                        <div class="day-part-name"><strong>@part.Code</strong> <span class="muted">@part.Name</span></div>
                        <Field For="@($"part-start-{part.ScheduleId}")" Label="Starts">
                            <input id="@($"part-start-{part.ScheduleId}")" type="time" step="300" value="@edit.Start" @onchange="e => SetStart(edit, e)" />
                        </Field>
                        <Field For="@($"part-end-{part.ScheduleId}")" Label="Ends">
                            <input id="@($"part-end-{part.ScheduleId}")" type="time" step="300" value="@edit.End" @onchange="e => SetEnd(edit, e)" />
                        </Field>
                    </div>
                }
            </div>
            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseHours">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="Busy">@(Busy ? "Saving…" : "Save the times of the day")</Button>
            </div>
        </form>
    }
</Modal>

@code {
    private sealed class TimeEdit
    {
        public string PartId { get; set; } = "";
        public string Days { get; set; } = "";
        public string Start { get; set; } = "";
        public string End { get; set; } = "";
    }

    private IReadOnlyList<DayPart>? parts;
    private Dictionary<int, TimeEdit>? hours;
    private IReadOnlyList<ScheduleSection>? sections;
    private IReadOnlyList<CourseTimeRow>? courses;
    private readonly Dictionary<int, TimeEdit> courseEdits = [];
    private int sectionId;

    protected override async Task OnInitializedAsync()
    {
        parts = await Times.GetDayPartsAsync();
        sections = await Times.ListSectionsAsync();
        sectionId = sections.FirstOrDefault()?.SectionId ?? 0;
        await LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        courses = sectionId == 0 ? [] : await Times.ListCoursesAsync(sectionId);
        courseEdits.Clear();
        foreach (var c in courses)
        {
            courseEdits[c.SubjectId] = c.Meeting is { } m
                ? new TimeEdit { PartId = c.ScheduleId?.ToString() ?? "", Days = m.Days, Start = ClassTime.Box(m.Start), End = ClassTime.Box(m.End) }
                : new TimeEdit();
        }
    }

    private async Task SectionChanged(ChangeEventArgs e)
    {
        sectionId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        Errors = [];
        Message = null;
        await LoadCoursesAsync();
    }

    // Choosing the schedule of a course that has no time yet starts the class at the beginning of that part of the day (an hour and a half long).
    private void SetPart(TimeEdit edit, ChangeEventArgs e)
    {
        edit.PartId = e.Value?.ToString() ?? "";
        if (edit.Start == "" && edit.End == "" && parts?.FirstOrDefault(p => p.ScheduleId.ToString() == edit.PartId) is { } part)
        {
            edit.Start = ClassTime.Box(part.Start);
            edit.End = ClassTime.Box(part.Start.AddHours(1.5));
        }
    }

    private static void SetDays(TimeEdit edit, ChangeEventArgs e) => edit.Days = e.Value?.ToString() ?? "";

    private static void SetStart(TimeEdit edit, ChangeEventArgs e) => edit.Start = e.Value?.ToString() ?? "";

    private static void SetEnd(TimeEdit edit, ChangeEventArgs e) => edit.End = e.Value?.ToString() ?? "";

    private async Task SaveAllAsync()
    {
        var inputs = (courses ?? []).Select(c =>
        {
            var edit = courseEdits[c.SubjectId];
            return new CourseTimeInput(
                c.SubjectId, int.TryParse(edit.PartId, out var part) ? part : null, string.IsNullOrEmpty(edit.Days) ? null : edit.Days,
                ClassTime.Parse(edit.Start), ClassTime.Parse(edit.End));
        }).ToList();

        var result = await RunAsync(userId => Times.SaveSectionAsync(userId, sectionId, inputs));
        if (result.Succeeded)
        {
            Errors = [];
            await LoadCoursesAsync();
            sections = await Times.ListSectionsAsync();
        }
        else
        {
            // The problems are listed above the table, and a pop-up says so too.
            Message = result.Errors.Count == 1 ? result.Errors[0] : $"{result.Errors.Count} problems: nothing was saved. They are listed above the table.";
            MessageIsError = true;
        }
    }

    private void OpenHours()
    {
        Errors = [];
        hours = (parts ?? []).ToDictionary(p => p.ScheduleId, p => new TimeEdit { Start = ClassTime.Box(p.Start), End = ClassTime.Box(p.End) });
    }

    private void CloseHours() => hours = null;

    private async Task SaveHoursAsync()
    {
        var inputs = new List<DayPartInput>();
        foreach (var p in parts ?? [])
        {
            var edit = hours![p.ScheduleId];
            if (ClassTime.Parse(edit.Start) is not { } start || ClassTime.Parse(edit.End) is not { } end)
            {
                Errors = [$"Choose when {p.Code} starts and when it ends."];
                return;
            }

            inputs.Add(new DayPartInput(p.ScheduleId, start, end));
        }

        var result = await RunAsync(userId => Times.SaveDayPartsAsync(userId, inputs));
        if (result.Succeeded)
        {
            hours = null;
            parts = await Times.GetDayPartsAsync();
            await LoadCoursesAsync();
        }
    }
}
