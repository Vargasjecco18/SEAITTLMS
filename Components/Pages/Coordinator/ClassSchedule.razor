@page "/coordinator/class-schedule"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using SEAITT_LMS.Components.Pages.Coordinator.Setup
@using SEAITT_LMS.Services
@inject CourseScheduleService Times
@inject SchoolSetupService Setup
@inject CurrentUser Me
@inject TimeProvider Clock
@inject IJSRuntime JS

<PageTitle>Class schedule · SEAITT Legazpi LMS</PageTitle>

@* The menu folds to its icons here: the week needs the room. *@
<span data-side-rail hidden></span>

<Notice Message="@message" IsError="messageIsError" OnDismiss="ClearMessage" />

<div class="schedule-page" id="schedule-root" @ref="root">
    <header class="bar">
        <h1><Icon Name="calendar-clock" Size="22" /> Class schedule</h1>

        <div class="bar-fields">
            <select id="cs-year" class="bar-select" aria-label="School year" @onchange="YearChangedAsync">
                @foreach (var y in years)
                {
                    <option value="@y.Id" selected="@(y.Id == yearId)">@y.Name</option>
                }
            </select>
            <select id="cs-term" class="bar-select" aria-label="Term" @onchange="TermChangedAsync">
                @foreach (var t in TermsOfYear)
                {
                    <option value="@t.TermNumber" selected="@(t.TermNumber == term)">@t.Name</option>
                }
            </select>

            @* The rooms: every room has its own schedule. *@
            <div class="room-picker">
                <button type="button" id="room-button" class="room-button" aria-haspopup="listbox" aria-expanded="@(roomMenu ? "true" : "false")" @onclick="() => roomMenu = !roomMenu">
                    <Icon Name="door-open" Size="18" /> <span>@RoomName</span> <Icon Name="chevron-down" Size="16" />
                </button>
                @if (roomMenu)
                {
                    <div class="room-menu" role="listbox" aria-label="Rooms">
                        @foreach (var room in rooms)
                        {
                            <button type="button" role="option" class="room-option @(roomId == room.Id ? "is-picked" : "")" aria-selected="@(roomId == room.Id ? "true" : "false")" data-room="@room.Id" @onclick="() => PickRoomAsync(room.Id)">
                                @room.Name <span class="count">@room.Classes</span>
                            </button>
                        }
                        <div class="room-actions">
                            @if (addingRoom)
                            {
                                <form class="add-room" @onsubmit="AddRoomAsync">
                                    <input id="new-room" class="cell" maxlength="50" autocomplete="off" placeholder="Name of the room" aria-label="Name of the new room" @bind="newRoom" @bind:event="oninput" />
                                    <Button Type="submit" Small="true" IconName="plus" Disabled="Busy">Add</Button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="room-action" id="add-room" @onclick="() => addingRoom = true"><Icon Name="plus" Size="16" /> Add room</button>
                            }

                            <button type="button" class="room-action danger" id="remove-room" disabled="@(roomId == 0)" @onclick="OpenRemoveRoom"><Icon Name="trash-2" Size="16" /> Remove room</button>
                        </div>
                    </div>
                }
            </div>

            @* Every class of every section and room, over all the screen. *@
            <Button Variant="ButtonVariant.Secondary" IconName="layout-list" OnClick="OpenAllAsync">View all class schedule</Button>
        </div>
    </header>

    <div class="body">
        <aside class="palette" aria-label="Sections and their courses">
            <SearchField Id="schedule-search" @bind-Value="search" Live="true" SubmitText="" Placeholder="Search a section" AriaLabel="Search a section" />
            <p class="palette-lead">Drag a course to a day and a time. Drag a class back here to take it off the week.</p>

            @if (sections.Count == 0)
            {
                <p class="muted">@(allSections.Count == 0 ? "No section yet. Add the sections in the academic setup first." : "No section matches.")</p>
            }

            @foreach (var sec in sections)
            {
                var open = IsOpen(sec.SectionId);
                var courses = CoursesOf(sec.SectionId);
                <section class="p-section" data-section="@sec.Label" @ondblclick="() => OpenDialogAsync(sec.SectionId)">
                    <button type="button" class="p-head" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleAsync(sec.SectionId)">
                        <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="16" />
                        <span class="p-name">@sec.Label</span>
                        @if (summaries.TryGetValue(sec.SectionId, out var sum))
                        {
                            <span class="p-room" title="@($"Room of {sec.Label}")"><Icon Name="door-open" Size="13" /> @sum.RoomText</span>
                            <span class="p-count @(sum.IsDone ? "is-done" : "")" title="Courses on the schedule">@sum.Placed of @sum.Total</span>
                        }
                    </button>
                    @if (open)
                    {
                        @if (courses is null)
                        {
                            <p class="muted">Loading…</p>
                        }
                        else if (courses.Count == 0)
                        {
                            <p class="muted">No course in @SchoolCalendar.TermName(term).</p>
                        }
                        else
                        {
                            var unplaced = courses.Where(c => c.Meeting is null || c.RoomId is null).ToList();
                            @if (unplaced.Count == 0)
                            {
                                <p class="muted all-placed"><Icon Name="circle-check" Size="14" /> Every course has its time.</p>
                            }

                            <ul class="p-courses">
                                @foreach (var c in unplaced)
                                {
                                    <li class="p-course @(c.Meeting is not null ? "is-placed" : "")" draggable="true" data-drag="@($"p:{sec.SectionId}:{c.SubjectId}")" data-course="@c.Name" title="Drag it to a day and a time">
                                        <Icon Name="grip-vertical" Size="14" />
                                        <span class="c-name">@c.Name</span>
                                        @if (c.Meeting is { } m)
                                        {
                                            <span class="c-when">@m.Days · @ClassTime.Label(m.Start) · needs a room</span>
                                        }
                                        else
                                        {
                                            <span class="c-when none">No time yet</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    }
                </section>
            }
        </aside>

        <div class="week-wrap">
            <div class="week" role="grid" aria-label="@($"Weekly schedule of {RoomName}")" data-room="@roomId">
                <div class="week-head" role="row">
                    <span class="corner" aria-hidden="true"></span>
                    @foreach (var (day, name) in Days)
                    {
                        <div class="day-head" role="columnheader">@name</div>
                    }
                </div>
                <div class="week-body">
                    <div class="time-col" aria-hidden="true">
                        @for (var slot = 0; slot < Slots; slot++)
                        {
                            var time = SlotTime(slot);
                            <div class="time-cell @(time.Minute == 0 ? "hour" : "half")">@(time.Minute == 0 ? ClassTime.Label(time) : "")</div>
                        }
                    </div>
                    @foreach (var (day, name) in Days)
                    {
                        <div class="day-col" role="gridcell" data-day="@day" aria-label="@name" style="--slots:@Slots">
                            @for (var slot = 0; slot < Slots; slot++)
                            {
                                <div class="slot @(SlotTime(slot).Minute == 0 ? "hour" : "half")" data-slot="@slot"></div>
                            }

                            @foreach (var block in BlocksOf(day))
                            {
                                var c = block.Class;
                                <div class="block kind-@(c.TermNumber % 6)" draggable="true" data-drag="@($"m:{c.SectionId}:{c.SubjectId}:{day}")" data-day="@day" data-block="@c.Course" data-section="@c.SectionLabel"
                                     style="top: calc(var(--row) * @block.Top); height: calc(var(--row) * @block.Height - 2px); left: @(block.Left)%; width: calc(@(block.Width)% - 2px);"
                                     @ondblclick="() => OpenDialogAsync(c.SectionId)" @ondblclick:stopPropagation="true"
                                     title="@($"{c.Course} · {c.SectionLabel} · {ClassTime.Label(c.Start)} – {ClassTime.Label(c.End)}")">
                                    <span class="b-course">@c.Course</span>
                                    <span class="b-section">@c.SectionLabel</span>
                                    <span class="b-time">@ClassTime.Label(c.Start) – @ClassTime.Label(c.End)</span>
                                    @if (c.Teacher is not null && block.Height >= 4)
                                    {
                                        <span class="b-teacher">@c.Teacher</span>
                                    }
                                    <div class="b-tools">
                                        <select class="b-length" aria-label="@($"Length of {c.Course} of {c.SectionLabel}")" @onchange="e => ChangeLengthAsync(c, day, e.Value?.ToString())">
                                            @foreach (var minutes in Lengths)
                                            {
                                                <option value="@minutes" selected="@(Minutes(c) == minutes)">@Hours(minutes)</option>
                                            }
                                        </select>
                                        <button type="button" class="b-remove" aria-label="@($"Take {c.Course} of {c.SectionLabel} off the schedule")" title="Take it off the schedule" @onclick="() => RemoveAsync(c)"><Icon Name="x" Size="14" /></button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            @if (rooms.Count == 0)
            {
                <p class="week-note">No room yet: press the Room box and add one.</p>
            }
        </div>
    </div>
</div>

<SectionDialog Section="dialogSection" OnClose="CloseDialogAsync" />

@* Every class of the school year and term, section by section, in a box over the screen with a little space at its sides. It is read only when it is opened. The grade level, the strand and
   the section are chosen from lists, so what is shown fits the box (no scrolling). *@
<Modal Open="allOpen" Title="@($"All class schedules · {TermName}")" Cover="true" OnClose="CloseAll">
    @if (allOpen)
    {
        <div class="all-wrap">
            <div class="all-tools">
                <select id="all-grade" class="bar-select" aria-label="Grade level" @onchange="e => { allGrade = e.Value?.ToString() ?? string.Empty; allStrand = string.Empty; allSection = string.Empty; }">
                    <option value="" selected="@(allGrade == "")">All grade levels</option>
                    <option value="11" selected="@(allGrade == "11")">Grade 11</option>
                    <option value="12" selected="@(allGrade == "12")">Grade 12</option>
                </select>
                <select id="all-strand" class="bar-select" aria-label="Strand" @onchange="e => { allStrand = e.Value?.ToString() ?? string.Empty; allSection = string.Empty; }">
                    <option value="" selected="@(allStrand == "")">All strands</option>
                    @foreach (var strand in AllStrands)
                    {
                        <option value="@strand" selected="@(allStrand == strand)">@strand</option>
                    }
                </select>
                <select id="all-section" class="bar-select" aria-label="Section" @onchange="e => allSection = e.Value?.ToString() ?? string.Empty">
                    <option value="" selected="@(allSection == "")">All sections</option>
                    @foreach (var name in AllSectionNames)
                    {
                        <option value="@name" selected="@(allSection == name)">Section @name</option>
                    }
                </select>
            </div>
            @if (AllShown.Count == 0)
            {
                <EmptyState IconName="search-x" Title="No class matches" />
            }
            else
            {
                <div class="all-grid">
                    @foreach (var group in AllShown)
                    {
                        <section class="all-section" aria-label="@group.Key">
                            <header class="all-head">
                                <span class="all-icon"><Icon Name="users" Size="18" /></span>
                                <h3>@group.Key</h3>
                                <span class="all-count">@group.Count() @(group.Count() == 1 ? "class" : "classes")</span>
                            </header>
                            <ul class="all-classes">
                                @foreach (var c in group.OrderBy(x => x.Days).ThenBy(x => x.Start))
                                {
                                    <li>
                                        <span class="all-time"><strong>@ClassTime.Label(c.Start)</strong><small>to @ClassTime.Label(c.End)</small></span>
                                        <span class="all-main">
                                            <span class="all-course">@c.Course</span>
                                            <span class="all-meta">
                                                <span class="all-days">@c.Days</span>
                                                <span><Icon Name="door-open" Size="13" /> @(c.RoomName ?? "No room")</span>
                                                <span><Icon Name="presentation" Size="13" /> @(c.Teacher ?? "No teacher yet")</span>
                                            </span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
        </div>
    }
</Modal>

<Modal Open="removingRoom" Title="Remove this room?" OnClose="CloseRemoveRoom">
    @if (removingRoom)
    {
        var room = rooms.FirstOrDefault(r => r.Id == roomId);
        <p class="delete-text">You are about to remove the room <strong>@room?.Name</strong>. @(room is { Classes: > 0 } ? $"Its {room.Classes} {(room.Classes == 1 ? "class keeps" : "classes keep")} the day and the time, and has no room." : "No class is in it.")</p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseRemoveRoom">Keep it</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="Busy" OnClick="RemoveRoomAsync">@(Busy ? "Removing…" : "Remove room")</Button>
        </div>
    }
</Modal>

@code {
    private const int FirstHour = 7;
    private const int LastHour = 18;
    private static readonly int Slots = (LastHour - FirstHour) * 2;

    private static readonly (int Day, string Name)[] Days = [(1, "Monday"), (2, "Tuesday"), (3, "Wednesday"), (4, "Thursday"), (5, "Friday")];
    private static readonly int[] Lengths = [60, 90, 120, 150, 180];

    private sealed record Block(PlacedClass Class, double Top, double Height, double Left, double Width);

    private ElementReference root;
    private DotNetObjectReference<ClassSchedule>? self;

    private IReadOnlyList<YearOption> years = [];
    private IReadOnlyList<ScheduleSection> allSections = [];
    private IReadOnlyList<RoomRow> rooms = [];
    private IReadOnlyList<PlacedClass> placed = [];
    private IReadOnlyList<TermRow> allTerms = [];
    private IReadOnlyDictionary<int, SectionTermSummary> summaries = new Dictionary<int, SectionTermSummary>();
    private bool allOpen;
    private string allGrade = "11";
    private string allStrand = "";
    private string allSection = "";
    private IReadOnlyList<PlacedClass> allClasses = [];
    private IReadOnlyList<SectionRow> sectionRows = [];
    private readonly Dictionary<int, IReadOnlyList<CourseTimeRow>> courseCache = [];
    private readonly HashSet<int> openSections = [];

    private int yearId;
    private int term = 1;
    private int roomId;
    private string search = "";
    private bool roomMenu;
    private bool addingRoom;
    private string newRoom = "";
    private bool removingRoom;
    private bool Busy;
    private string? message;
    private bool messageIsError;
    private SectionRow? dialogSection;
    private bool wired;

    private string RoomName => rooms.FirstOrDefault(r => r.Id == roomId)?.Name ?? "No room yet";

    private string TermName => allTerms.FirstOrDefault(t => t.SchoolYearId == yearId && t.TermNumber == term)?.Name ?? SchoolCalendar.TermName(term);

    /// <summary>The terms of the chosen school year that are not over (a term that ended is not in the list).</summary>
    private IEnumerable<TermRow> TermsOfYear
    {
        get
        {
            var today = PhilippineTime.Today(Clock);
            return allTerms.Where(t => t.SchoolYearId == yearId && t.EndDate >= today).OrderBy(t => t.TermNumber);
        }
    }

    /// <summary>Keeps the chosen term one of the terms in the list: the current one, or the first that is not over.</summary>
    private void EnsureTerm()
    {
        var open = TermsOfYear.ToList();
        if (open.Count > 0 && open.All(t => t.TermNumber != term))
        {
            term = (open.FirstOrDefault(t => t.IsCurrent) ?? open[0]).TermNumber;
        }
    }

    private IReadOnlyList<ScheduleSection> sections => allSections
        .Where(s => s.SchoolYearId == yearId && (string.IsNullOrWhiteSpace(search) || s.Label.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)))
        .OrderBy(s => summaries.TryGetValue(s.SectionId, out var sum) && sum.IsDone)   // a section with no course left to place goes to the bottom
        .ThenBy(s => s.GradeLevel).ThenBy(s => s.Label, StringComparer.OrdinalIgnoreCase).ToList();

    private static TimeOnly SlotTime(int slot) => new TimeOnly(FirstHour, 0).AddMinutes(slot * 30);

    protected override async Task OnInitializedAsync()
    {
        allSections = await Times.ListSectionsAsync();
        var today = PhilippineTime.Today(Clock);
        var lookups = await Setup.GetLookupsAsync();
        years = [.. lookups.Years.Where(y => y.EndDate >= today).OrderBy(y => y.StartDate)];
        yearId = years.FirstOrDefault(y => y.StartDate <= today && today <= y.EndDate)?.Id ?? years.FirstOrDefault()?.Id ?? 0;

        allTerms = await Setup.ListTermsAsync();
        term = allTerms.FirstOrDefault(t => t.IsCurrent && t.SchoolYearId == yearId)?.TermNumber ?? 1;
        if (term is < 1 or > SchoolCalendar.TermsPerYear)
        {
            term = 1;
        }

        EnsureTerm();

        sectionRows = await Setup.ListSectionsAsync();
        rooms = await Times.ListRoomsAsync();
        roomId = rooms.FirstOrDefault()?.Id ?? 0;
        summaries = yearId == 0 ? summaries : await Times.SummarizeTermAsync(yearId, term);
        if (sections.Count > 0)
        {
            openSections.Add(sections[0].SectionId);
        }

        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !wired)
        {
            wired = true;
            self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("seaitt.scheduleGrid.init", root, self);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
            }
        }
    }

    private async Task ReloadAsync()
    {
        allSections = await Times.ListSectionsAsync();
        rooms = await Times.ListRoomsAsync();
        if (rooms.All(r => r.Id != roomId))
        {
            roomId = rooms.FirstOrDefault()?.Id ?? 0;
        }

        placed = yearId == 0 || roomId == 0 ? [] : await Times.ListPlacedAsync(roomId, yearId, term);
        summaries = yearId == 0 ? new Dictionary<int, SectionTermSummary>() : await Times.SummarizeTermAsync(yearId, term);
        courseCache.Clear();
        foreach (var id in openSections.ToList())
        {
            courseCache[id] = await TermCoursesAsync(id);
        }
    }

    private async Task<IReadOnlyList<CourseTimeRow>> TermCoursesAsync(int sectionId) => [.. (await Times.ListCoursesAsync(sectionId)).Where(c => c.TermNumber == term)];

    private IReadOnlyList<CourseTimeRow>? CoursesOf(int sectionId) => courseCache.GetValueOrDefault(sectionId);

    private bool IsOpen(int sectionId) => openSections.Contains(sectionId) || !string.IsNullOrWhiteSpace(search) && sections.Count <= 3;

    private async Task ToggleAsync(int sectionId)
    {
        if (!openSections.Remove(sectionId))
        {
            openSections.Add(sectionId);
            courseCache[sectionId] = await TermCoursesAsync(sectionId);
        }

        await ReloadAsync();
    }

    private async Task YearChangedAsync(ChangeEventArgs e)
    {
        yearId = int.TryParse(e.Value?.ToString(), out var id) ? id : yearId;
        openSections.Clear();
        EnsureTerm();
        await ReloadAsync();
    }

    private async Task TermChangedAsync(ChangeEventArgs e)
    {
        term = int.TryParse(e.Value?.ToString(), out var n) ? n : term;
        await ReloadAsync();
    }

    private async Task PickRoomAsync(int id)
    {
        roomId = id;
        roomMenu = false;
        addingRoom = false;
        await ReloadAsync();
    }

    // ---- the rooms
    private async Task AddRoomAsync()
    {
        var result = await RunAsync(userId => Times.AddRoomAsync(userId, newRoom), quiet: true);
        if (result.Succeeded)
        {
            newRoom = "";
            addingRoom = false;
            rooms = await Times.ListRoomsAsync();
            var added = rooms.OrderByDescending(r => r.Id).FirstOrDefault();
            if (added is not null)
            {
                roomId = added.Id;
            }

            roomMenu = false;
            await ReloadAsync();
        }
    }

    private void OpenRemoveRoom()
    {
        if (roomId != 0)
        {
            removingRoom = true;
            roomMenu = false;
        }
    }

    private void CloseRemoveRoom() => removingRoom = false;

    private async Task RemoveRoomAsync()
    {
        var id = roomId;
        var result = await RunAsync(userId => Times.RemoveRoomAsync(userId, id));
        if (result.Succeeded)
        {
            removingRoom = false;
            await ReloadAsync();
        }
    }

    // ---- the classes on the grid
    private static int Minutes(PlacedClass c) => (int)(c.End - c.Start).TotalMinutes;

    private static string Hours(int minutes) => minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes / 60}.5 h";

    private IReadOnlyList<Block> BlocksOf(int day)
    {
        var list = placed.Where(c => MeetingDays.Has(c.Days, day)).OrderBy(c => c.Start).ThenBy(c => c.SectionLabel).ToList();

        // Classes at the same time (only possible without a room) stand side by side.
        var blocks = new List<Block>();
        var cluster = new List<PlacedClass>();
        var clusterEnd = TimeOnly.MinValue;
        void Flush()
        {
            var lanes = new List<TimeOnly>();
            var laneOf = new Dictionary<PlacedClass, int>();
            foreach (var c in cluster)
            {
                var lane = lanes.FindIndex(end => end <= c.Start);
                if (lane < 0)
                {
                    lanes.Add(c.End);
                    lane = lanes.Count - 1;
                }
                else
                {
                    lanes[lane] = c.End;
                }

                laneOf[c] = lane;
            }

            foreach (var c in cluster)
            {
                var top = (c.Start.Hour - FirstHour) * 2 + c.Start.Minute / 30.0;
                var height = Math.Max(1, (c.End - c.Start).TotalMinutes / 30.0);
                blocks.Add(new Block(c, top, height, laneOf[c] * 100.0 / lanes.Count, 100.0 / lanes.Count));
            }

            cluster.Clear();
        }

        foreach (var c in list)
        {
            if (cluster.Count > 0 && c.Start >= clusterEnd)
            {
                Flush();
            }

            cluster.Add(c);
            clusterEnd = cluster.Count == 1 ? c.End : (c.End > clusterEnd ? c.End : clusterEnd);
        }

        if (cluster.Count > 0)
        {
            Flush();
        }

        return blocks;
    }

    /// <summary>
    /// A course was dropped on a day at a half hour (the page's script says where). A course from the list is put on the week for the first time: it meets at that time on all the days of its pattern
    /// (Monday, Wednesday and Friday, or Tuesday and Thursday). A class that is already on the week is moved by itself: only the day that was dragged goes to the new place, and the other days stay.
    /// </summary>
    [JSInvokable]
    public async Task OnDrop(string payload, int day, int slot)
    {
        var parts = payload.Split(':');
        if (parts.Length < 3 || !int.TryParse(parts[1], out var sectionId) || !int.TryParse(parts[2], out var subjectId) || day is < 1 or > 5)
        {
            return;
        }

        var fromDay = parts.Length == 4 && parts[0] == "m" && int.TryParse(parts[3], out var from) ? from : 0;

        if (roomId == 0)
        {
            message = "Add a room first: press the Room box and Add room.";
            messageIsError = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        slot = Math.Clamp(slot, 0, Slots - 1);
        var moved = fromDay > 0 ? placed.FirstOrDefault(c => c.SectionId == sectionId && c.SubjectId == subjectId && MeetingDays.Has(c.Days, fromDay)) : null;
        var existing = moved ?? placed.FirstOrDefault(c => c.SectionId == sectionId && c.SubjectId == subjectId)
                       ?? (await Times.ListPlacedAsync(-1, yearId, 0)).FirstOrDefault(c => c.SectionId == sectionId && c.SubjectId == subjectId);
        var length = existing is null ? 60 : Math.Max(30, Minutes(existing));   // a course that is put on the week again starts as one hour (or as long as it was)
        var start = SlotTime(slot);
        var latestStart = new TimeOnly(LastHour, 0).AddMinutes(-length);
        if (start > latestStart)
        {
            start = latestStart;
        }

        await InvokeAsync(async () =>
        {
            int? room = moved?.RoomId ?? roomId;
            if (moved is not null)
            {
                await RunAsync(userId => Times.MoveDayAsync(userId, sectionId, subjectId, fromDay, day, room, start, start.AddMinutes(length)), quiet: true);
            }
            else
            {
                await RunAsync(userId => Times.PlaceAsync(userId, sectionId, subjectId, room, MeetingDays.PatternOf(day), start, start.AddMinutes(length)), quiet: true);
            }

            await ReloadAsync();
            StateHasChanged();
        });
    }

    /// <summary>A class of the week was dropped on the list of courses: the course goes back to its section (all its days leave the week) and is in the list again.</summary>
    [JSInvokable]
    public async Task OnDropBack(string payload)
    {
        var parts = payload.Split(':');
        if (parts.Length < 3 || parts[0] != "m" || !int.TryParse(parts[1], out var sectionId) || !int.TryParse(parts[2], out var subjectId))
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await RunAsync(userId => Times.ClearAsync(userId, sectionId, subjectId), quiet: true);
            openSections.Add(sectionId);
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ChangeLengthAsync(PlacedClass c, int day, string? value)
    {
        if (!int.TryParse(value, out var minutes))
        {
            return;
        }

        var end = c.Start.AddMinutes(minutes);
        if (end > new TimeOnly(LastHour, 0) || end <= c.Start)
        {
            message = $"A class ends at {ClassTime.Label(new TimeOnly(LastHour, 0))} at the latest.";
            messageIsError = true;
            await ReloadAsync();
            return;
        }

        // a class is a day of its own now: the length changes for the day of the block
        await RunAsync(userId => Times.MoveDayAsync(userId, c.SectionId, c.SubjectId, day, day, c.RoomId, c.Start, end), quiet: true);
        await ReloadAsync();
    }

    private async Task RemoveAsync(PlacedClass c)
    {
        await RunAsync(userId => Times.ClearAsync(userId, c.SectionId, c.SubjectId), quiet: true);
        await ReloadAsync();
    }

    // ---- all the class schedules (over all the screen)
    private async Task OpenAllAsync()
    {
        allClasses = yearId == 0 ? [] : await Times.ListPlacedAsync(-1, yearId, term);
        allGrade = "11";
        allStrand = AllStrands.FirstOrDefault() ?? string.Empty;
        allSection = string.Empty;
        allOpen = true;
    }

    private void CloseAll() => allOpen = false;

    /// <summary>"11-BUSSENT-A" is grade 11, the strand BUSSENT and the section A (a strand can have a dash in its code, so the first and the last parts are the grade and the section).</summary>
    private static (string Grade, string Strand, string Section) PartsOf(string label)
    {
        var parts = label.Split('-');
        return parts.Length < 3 ? (parts[0], label, "") : (parts[0], string.Join('-', parts[1..^1]), parts[^1]);
    }

    private IEnumerable<string> AllStrands => allClasses.Select(c => PartsOf(c.SectionLabel)).Where(p => allGrade == "" || p.Grade == allGrade).Select(p => p.Strand).Distinct().Order(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> AllSectionNames => allClasses.Select(c => PartsOf(c.SectionLabel))
        .Where(p => (allGrade == "" || p.Grade == allGrade) && (allStrand == "" || p.Strand == allStrand)).Select(p => p.Section).Distinct().Order(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<IGrouping<string, PlacedClass>> AllShown => [.. allClasses
        .Where(c =>
        {
            var p = PartsOf(c.SectionLabel);
            return (allGrade == "" || p.Grade == allGrade) && (allStrand == "" || p.Strand == allStrand) && (allSection == "" || p.Section == allSection);
        })
        .GroupBy(c => c.SectionLabel).OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)];

    // ---- the box of a section (adviser and students)
    private Task OpenDialogAsync(int sectionId)
    {
        dialogSection = sectionRows.FirstOrDefault(s => s.Id == sectionId);
        return Task.CompletedTask;
    }

    private async Task CloseDialogAsync()
    {
        dialogSection = null;
        sectionRows = await Setup.ListSectionsAsync();
    }

    // ---- helpers
    private void ClearMessage() => message = null;

    private async Task<ServiceResult> RunAsync(Func<int, Task<ServiceResult>> action, bool quiet = false)
    {
        if (Busy)
        {
            return ServiceResult.Fail("Please wait a moment.");
        }

        Busy = true;
        try
        {
            var me = await Me.GetAsync();
            var result = me is null ? ServiceResult.Fail("Please sign in again.") : await action(me.UserId);
            if (!result.Succeeded)
            {
                message = result.Errors.Count == 1 ? result.Errors[0] : string.Join(" ", result.Errors);
                messageIsError = true;
            }
            else if (!quiet)
            {
                message = result.Message;
                messageIsError = false;
            }

            return result;
        }
        finally
        {
            Busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (wired)
            {
                await JS.InvokeVoidAsync("seaitt.scheduleGrid.dispose");
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
        }

        self?.Dispose();
    }
}
