@* The binary, ranking and select-all questions of an evaluation: each with its options as bars (the share who chose it, or the average place). *@
<div class="others">
    @foreach (var r in Results)
    {
        <section class="other">
            <h4>@r.Text <small>@EvaluationQuestionKinds.Display(r.Kind) · @r.Answers @(r.Answers == 1 ? "answer" : "answers")@(string.IsNullOrWhiteSpace(r.Category) ? "" : " · " + r.Category)</small></h4>
            @if (r.Answers == 0)
            {
                <p class="muted">No answers yet.</p>
            }
            else
            {
                <ul class="bars">
                    @foreach (var o in r.Options)
                    {
                        var width = r.Kind == EvaluationQuestionKinds.Ranking
                            ? (o.Value is { } place ? (int)Math.Round((r.Options.Count + 1 - place) * 100m / r.Options.Count) : 0)
                            : (int)Math.Round(o.Value ?? 0);
                        <li>
                            <span class="bar-label">@o.Label</span>
                            <span class="dist"><span class="dist-fill r@(r.Kind == EvaluationQuestionKinds.Ranking ? 4 : o.Label == EvaluationQuestionKinds.No ? 2 : 5)" style="width: @(Math.Clamp(width, 0, 100))%"></span></span>
                            <span class="dist-n">
                                @if (r.Kind == EvaluationQuestionKinds.Ranking)
                                {
                                    @($"place {o.Value:0.0} · {o.Count} first")
                                }
                                else
                                {
                                    @($"{o.Count} ({o.Value:0.#}%)")
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<QuestionResult> Results { get; set; } = [];
}
