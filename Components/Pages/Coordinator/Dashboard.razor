@page "/coordinator"
@attribute [Authorize(Roles = AppRoles.AcademicCoordinator)]
@inject CurrentUser Me
@inject EvaluationService Evaluations
@inject AnnouncementService Announcements
@inject SchoolSetupService Setup
@inject TimeProvider Clock

<PageTitle>Dashboard · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

@{
    var now = PhilippineTime.Now(Clock);
}

<PageHeader Title="@($"{PhilippineTime.Greeting(now)}, {name ?? "coordinator"}")"
            IconName="layout-dashboard" />

@if (evaluations is not null && counts is not null)
{
    var open = evaluations.Where(e => e.State == EvaluationStates.Open).ToList();
    var drafts = evaluations.Count(e => e.State == EvaluationStates.Draft);
    var answers = evaluations.Sum(e => e.Responses);
    var expected = evaluations.Where(e => e.State == EvaluationStates.Open).Sum(e => e.Expected);
    var today = DateOnly.FromDateTime(now.DateTime);
    var active = notices?.Count(a => a.ExpiresOn is null || a.ExpiresOn >= today) ?? 0;

    <div class="stats">
        <StatCard Label="Open evaluations" Value="@open.Count" IconName="clipboard-check" Accent="AccentColor.Violet"
                  Hint="@(drafts == 0 ? "Students are answering" : $"{drafts} draft{(drafts == 1 ? "" : "s")}")" Href="coordinator/evaluations" />
        <StatCard Label="Answers received" Value="@answers" IconName="message-square" Accent="AccentColor.Green"
                  Hint="@(expected == 0 ? "None expected right now" : $"{expected:N0} expected in the open ones")" Href="coordinator/analytics" />
        <StatCard Label="Announcements" Value="@active" IconName="megaphone" Accent="AccentColor.Amber" Hint="Showing now" Href="coordinator/announcements" />
        <StatCard Label="Courses" Value="@counts.Subjects" IconName="book-open" Accent="AccentColor.Blue"
                  Hint="@($"{counts.Sections:N0} sections · {counts.Strands:N0} strands")" Href="coordinator/academic-setup" />
    </div>

    <div class="cards">
        <Card Title="Teacher evaluation" IconName="clipboard-check">
            @if (open.Count == 0)
            {
                <EmptyState IconName="clipboard-check" Title="No evaluation is open">
                    <p>Make a questionnaire about the teachers, send it to the students with a due date, and read their answers.</p>
                    <ButtonLink Href="coordinator/evaluations" IconName="plus">New evaluation</ButtonLink>
                </EmptyState>
            }
            else
            {
                <ul class="list">
                    @foreach (var e in open)
                    {
                        <li>
                            <a href="coordinator/evaluations/@e.Id">
                                <span class="list-title">@e.Title</span>
                                <span class="list-sub">Due @PhilippineTime.FormatDateTime(e.DueAtUtc!.Value) · @e.Responses of @e.Expected answered</span>
                                <span class="bar"><span class="bar-fill" style="width: @(Math.Min(100, e.RatePercent))%"></span></span>
                            </a>
                            <Badge Tone="@(e.RatePercent >= 75 ? Tone.Success : Tone.Warning)">@e.RatePercent%</Badge>
                        </li>
                    }
                </ul>
            }
            <p class="more"><a href="coordinator/analytics">Open the analytics <Icon Name="arrow-right" Size="14" /></a></p>
        </Card>

        <Card Title="Announcements" IconName="megaphone">
            @if (notices is null || notices.Count == 0)
            {
                <EmptyState IconName="megaphone" Title="No announcements yet">
                    <p>Write a notice for the students, the teachers or everybody.</p>
                    <ButtonLink Href="coordinator/announcements" IconName="plus">New announcement</ButtonLink>
                </EmptyState>
            }
            else
            {
                <ul class="list">
                    @foreach (var a in notices.Take(4))
                    {
                        <li>
                            <span class="list-text">
                                <span class="list-title">@a.Title</span>
                                <span class="list-sub">@a.Audience · @PhilippineTime.FormatDate(a.CreatedAtUtc)@(a.ExpiresOn is { } until ? $" · until {until:MMM d}" : "")</span>
                            </span>
                        </li>
                    }
                </ul>
            }
            <p class="more"><a href="coordinator/announcements">All the announcements <Icon Name="arrow-right" Size="14" /></a></p>
        </Card>
    </div>
}

@code {
    private string? name;
    private IReadOnlyList<EvaluationRow>? evaluations;
    private IReadOnlyList<AnnouncementView>? notices;
    private SetupCounts? counts;

    protected override async Task OnInitializedAsync()
    {
        var user = await Me.GetAsync();
        name = user?.Name.Split(' ').FirstOrDefault();
        evaluations = await Evaluations.ListAsync();
        notices = user is null ? [] : await Announcements.ListManagedAsync(user);
        counts = await Setup.GetCountsAsync();
    }
}
