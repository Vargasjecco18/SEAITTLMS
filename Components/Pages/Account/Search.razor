@page "/search"
@attribute [Authorize]
@inject SearchService SearchEngine
@inject CurrentUser Me

<PageTitle>Search · SEAITT e-LMS</PageTitle>

<PageHeader Title="Search" Subtitle="Subjects, people and pages you can open." IconName="search" />

<form class="box" method="get" action="search" role="search">
    <Icon Name="search" Size="20" Class="box-icon" />
    <input type="search" name="q" value="@Query" placeholder="What are you looking for?" aria-label="Search" autocomplete="off" autofocus />
    <button type="submit" class="go">Search</button>
</form>

@if (string.IsNullOrWhiteSpace(Query))
{
    <Card>
        <EmptyState IconName="search" Title="Type something to search">
            <p>Try the name of a subject, a person or a page.</p>
        </EmptyState>
    </Card>
}
else if (groups.Count == 0)
{
    <Card>
        <EmptyState IconName="search-x" Title="Nothing found">
            <p>Nothing matches “@Query”. Try another word.</p>
        </EmptyState>
    </Card>
}
else
{
    <div class="results">
        @foreach (var group in groups)
        {
            <Card Title="@group.Title">
                <ul class="hits">
                    @foreach (var hit in group.Hits)
                    {
                        <li>
                            <a href="@hit.Href">
                                <span class="hit-icon"><Icon Name="@hit.Icon" Size="18" /></span>
                                <span class="hit-text">
                                    <span class="hit-title">@hit.Title</span>
                                    @if (!string.IsNullOrEmpty(hit.Subtitle))
                                    {
                                        <span class="hit-sub">@hit.Subtitle</span>
                                    }
                                </span>
                                <Icon Name="chevron-right" Size="16" />
                            </a>
                        </li>
                    }
                </ul>
            </Card>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? Query { get; set; }

    private IReadOnlyList<SearchGroup> groups = [];

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Query) && await Me.GetAsync() is { } user)
        {
            groups = await SearchEngine.SearchAsync(user, Query);
        }
    }
}
