@rendermode InteractiveServer
@inject CurrentUser Me
@inject AnnouncementService Service
@inject TeachingService Teaching
@inject NavigationManager Navigation

@* "Announcement to my class", from the calendar of a teacher: the box that writes an announcement for the students of one of their courses (the students of that class are told, and see the
   days from Start to End in their calendar). A teacher no longer has a page of announcements in the menu: this is where they are written. *@
<Modal Open="loaded" Title="Announcement to my class" OnClose="Close">
    @if (loaded)
    {
        @if (courses.Count == 0)
        {
            <p class="dialog-text">You have no class yet. An announcement is written for one of your classes: when the administrator gives you a course, you can write to its students here.</p>
            <div class="actions"><Button Variant="ButtonVariant.Ghost" OnClick="Close">Close</Button></div>
        }
        else
        {
            <EditForm Model="form" OnSubmit="SaveAsync">
                <FormErrors Errors="errors" />
                @* Several classes can be chosen at once (round 41): one announcement is posted for each class that is ticked. *@
                <fieldset class="class-picks" aria-describedby="ca-class-hint">
                    <legend>Class <span class="req" aria-hidden="true">*</span></legend>
                    @if (courses.Count > 1)
                    {
                        <label class="class-pick all">
                            <input type="checkbox" id="ca-class-all" checked="@(picked.Count == courses.Count)" @onchange="e => PickAll(e.Value is true)" />
                            <span><strong>All my classes</strong></span>
                        </label>
                    }
                    @foreach (var c in courses)
                    {
                        var id = c.Id;
                        <label class="class-pick @(picked.Contains(id) ? "on" : "")">
                            <input type="checkbox" name="ca-class" value="@id" checked="@picked.Contains(id)" @onchange="e => Pick(id, e.Value is true)" />
                            <span>@c.SubjectName · @c.SectionLabel</span>
                        </label>
                    }
                    <small id="ca-class-hint" class="hint-line">Only the students of the classes you tick see it. @(picked.Count == 0 ? "Tick at least one class." : picked.Count == 1 ? "1 class is ticked." : $"{picked.Count} classes are ticked.")</small>
                </fieldset>
                <Field For="ca-title" Label="Title" Required="true">
                    <input id="ca-title" maxlength="@AnnouncementService.MaxTitleLength" autocomplete="off" @bind="form.Title" />
                </Field>
                <Field For="ca-body" Label="Announcement" Required="true" Hint="@($"Up to {AnnouncementService.MaxBodyLength} characters.")">
                    <textarea id="ca-body" rows="4" maxlength="@AnnouncementService.MaxBodyLength" @bind="form.Body"></textarea>
                </Field>
                <div class="two">
                    <Field For="ca-start" Label="Start" Hint="Optional. The first day it is about.">
                        <input id="ca-start" type="date" @bind="form.StartsOn" />
                    </Field>
                    <Field For="ca-until" Label="End" Hint="Optional. Empty: until you delete it.">
                        <input id="ca-until" type="date" @bind="form.ExpiresOn" />
                    </Field>
                </div>
                <p class="hint">The students of the class get a notification, and see the days from Start to End in their calendar.</p>
                <div class="actions">
                    <Button Variant="ButtonVariant.Ghost" OnClick="Close">Cancel</Button>
                    <Button Type="submit" IconName="send" Disabled="busy">@(busy ? "Saving…" : "Post")</Button>
                </div>
            </EditForm>
        }
    }
</Modal>

@code {
    [Parameter, EditorRequired] public string CloseUrl { get; set; } = "calendar";

    /// <summary>The day the box was opened from (the Start day), when there is one.</summary>
    [Parameter] public DateOnly? Day { get; set; }

    private bool loaded;
    private bool busy;
    private CurrentUserInfo? me;
    private IReadOnlyList<AssignmentRow> courses = [];
    private AnnouncementInput form = new();
    private List<string> errors = [];
    private readonly HashSet<int> picked = [];

    private void Pick(int id, bool on)
    {
        if (on)
        {
            picked.Add(id);
        }
        else
        {
            picked.Remove(id);
        }
    }

    private void PickAll(bool on)
    {
        picked.Clear();
        if (on)
        {
            foreach (var c in courses)
            {
                picked.Add(c.Id);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        me = await Me.GetAsync();
        if (me is not null && me.Role == AppRoles.Teacher)
        {
            courses = await Teaching.ListForTeacherUserAsync(me.UserId);
            form = new AnnouncementInput { Category = AnnouncementCategories.Other, Audience = AnnouncementAudiences.Students, StartsOn = Day };
            if (courses.Count == 1)
            {
                picked.Add(courses[0].Id);
            }
        }

        loaded = true;
    }

    private void Close() => Navigation.NavigateTo(CloseUrl);

    private async Task SaveAsync()
    {
        if (busy || me is null)
        {
            return;
        }

        if (picked.Count == 0)
        {
            errors = ["Tick at least one class."];
            return;
        }

        busy = true;
        errors = [];
        try
        {
            // One announcement for each class that is ticked; the first problem stops it (what was posted before stays posted).
            foreach (var id in courses.Select(c => c.Id).Where(picked.Contains).ToList())
            {
                var one = new AnnouncementInput
                {
                    Title = form.Title, Body = form.Body, Audience = form.Audience, Category = form.Category,
                    StartsOn = form.StartsOn, ExpiresOn = form.ExpiresOn, AssignmentId = id,
                };
                var result = await Service.SaveAsync(me, one);
                if (!result.Succeeded)
                {
                    var name = courses.First(c => c.Id == id);
                    errors = [.. result.Errors.Select(e => picked.Count > 1 ? $"{name.SubjectName} · {name.SectionLabel}: {e}" : e)];
                    return;
                }
            }

            Navigation.NavigateTo(CloseUrl);
        }
        finally
        {
            busy = false;
        }
    }
}
