@rendermode InteractiveServer
@inject CurrentUser Me
@inject AnnouncementService Service
@inject TeachingService Teaching
@inject NavigationManager Navigation

@* "Announcement to my class", from the calendar of a teacher: the box that writes an announcement for the students of one of their courses (the students of that class are told, and see the
   days from Start to End in their calendar). A teacher no longer has a page of announcements in the menu: this is where they are written. *@
<Modal Open="loaded" Title="Announcement to my class" OnClose="Close">
    @if (loaded)
    {
        @if (courses.Count == 0)
        {
            <p class="dialog-text">You have no class yet. An announcement is written for one of your classes: when the administrator gives you a course, you can write to its students here.</p>
            <div class="actions"><Button Variant="ButtonVariant.Ghost" OnClick="Close">Close</Button></div>
        }
        else
        {
            <EditForm Model="form" OnSubmit="SaveAsync">
                <FormErrors Errors="errors" />
                <Field For="ca-class" Label="Class" Required="true" Hint="Only the students of this class see it.">
                    <select id="ca-class" @bind="form.AssignmentId">
                        <option value="">Choose a class…</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.Id">@c.SubjectName · @c.SectionLabel</option>
                        }
                    </select>
                </Field>
                <Field For="ca-title" Label="Title" Required="true">
                    <input id="ca-title" maxlength="@AnnouncementService.MaxTitleLength" autocomplete="off" @bind="form.Title" />
                </Field>
                <Field For="ca-body" Label="Announcement" Required="true" Hint="@($"Up to {AnnouncementService.MaxBodyLength} characters.")">
                    <textarea id="ca-body" rows="4" maxlength="@AnnouncementService.MaxBodyLength" @bind="form.Body"></textarea>
                </Field>
                <div class="two">
                    <Field For="ca-start" Label="Start" Hint="Optional. The first day it is about.">
                        <input id="ca-start" type="date" @bind="form.StartsOn" />
                    </Field>
                    <Field For="ca-until" Label="End" Hint="Optional. Empty: until you delete it.">
                        <input id="ca-until" type="date" @bind="form.ExpiresOn" />
                    </Field>
                </div>
                <p class="hint">The students of the class get a notification, and see the days from Start to End in their calendar.</p>
                <div class="actions">
                    <Button Variant="ButtonVariant.Ghost" OnClick="Close">Cancel</Button>
                    <Button Type="submit" IconName="send" Disabled="busy">@(busy ? "Saving…" : "Post")</Button>
                </div>
            </EditForm>
        }
    }
</Modal>

@code {
    [Parameter, EditorRequired] public string CloseUrl { get; set; } = "calendar";

    /// <summary>The day the box was opened from (the Start day), when there is one.</summary>
    [Parameter] public DateOnly? Day { get; set; }

    private bool loaded;
    private bool busy;
    private CurrentUserInfo? me;
    private IReadOnlyList<AssignmentRow> courses = [];
    private AnnouncementInput form = new();
    private List<string> errors = [];

    protected override async Task OnInitializedAsync()
    {
        me = await Me.GetAsync();
        if (me is not null && me.Role == AppRoles.Teacher)
        {
            courses = await Teaching.ListForTeacherUserAsync(me.UserId);
            form = new AnnouncementInput { Category = AnnouncementCategories.Other, Audience = AnnouncementAudiences.Students, StartsOn = Day, AssignmentId = courses.Count == 1 ? courses[0].Id : null };
        }

        loaded = true;
    }

    private void Close() => Navigation.NavigateTo(CloseUrl);

    private async Task SaveAsync()
    {
        if (busy || me is null)
        {
            return;
        }

        busy = true;
        errors = [];
        try
        {
            var result = await Service.SaveAsync(me, form);
            if (result.Succeeded)
            {
                Navigation.NavigateTo(CloseUrl);
                return;
            }

            errors = result.Errors.ToList();
        }
        finally
        {
            busy = false;
        }
    }
}
