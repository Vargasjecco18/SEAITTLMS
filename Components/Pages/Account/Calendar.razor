@page "/calendar"
@attribute [Authorize(Roles = AppRoles.Student + "," + AppRoles.Teacher)]
@using System.Globalization
@inject CurrentUser Me
@inject CalendarService Events
@inject TimeProvider Clock

<PageTitle>Calendar · SEAITT e-LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Calendar" IconName="calendar-days">
    <nav class="controls" aria-label="Calendar controls">
        <ButtonLink Href="@Url(view, Step(-1))" Variant="ButtonVariant.Secondary" Small="true" IconName="chevron-left">Previous</ButtonLink>
        <ButtonLink Href="@Url(view, today)" Variant="ButtonVariant.Secondary" Small="true">Today</ButtonLink>
        <ButtonLink Href="@Url(view, Step(1))" Variant="ButtonVariant.Secondary" Small="true" IconName="chevron-right" IconAfter="true">Next</ButtonLink>
        <strong class="range-label" aria-live="polite">@Subtitle</strong>
        <span class="switch" role="group" aria-label="View">
            <a class="switch-link @(view == "month" ? "on" : "")" href="@Url("month", anchor)" aria-current="@(view == "month" ? "page" : null)">Month</a>
            <a class="switch-link @(view == "week" ? "on" : "")" href="@Url("week", anchor)" aria-current="@(view == "week" ? "page" : null)">Week</a>
        </span>
        <ButtonLink Href="@NewEventUrl" IconName="plus" Small="true">Add event</ButtonLink>
    </nav>
</PageHeader>

<PageWithAside Show="@AsideShow" Stacked="@(view == "week")">
    <ul class="legend" aria-label="Legend">
        @foreach (var kind in new[] { ItemKinds.Activity, ItemKinds.Quiz, ItemKinds.TaskPerformance, CalendarKinds.Module, CalendarKinds.Personal })
        {
            <li><span class="swatch @kind.ToLowerInvariant()"></span> @CalendarKinds.Label(kind)</li>
        }
        <li><span class="swatch late"></span> Overdue</li>
    </ul>

    @if (view == "month")
    {
        <div class="month" role="grid" aria-label="@anchor.ToString("MMMM yyyy", CultureInfo.InvariantCulture)">
            @foreach (var name in DayNames)
            {
                <div class="dow" role="columnheader">@name</div>
            }

            @foreach (var day in Days)
            {
                var onDay = EventsOn(day);
                <div class="cell @(day.Month != anchor.Month ? "other" : "") @(day == today ? "today" : "")" role="gridcell" data-day="@day.ToString("yyyy-MM-dd")">
                    <a class="num" href="@Url("week", day)" aria-label="@day.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)">@day.Day</a>
                    <ul class="chips">
                        @foreach (var e in onDay.Take(3))
                        {
                            <li>@Chip(e)</li>
                        }

                        @if (onDay.Count > 3)
                        {
                            <li><a class="more" href="@Url("week", day)">+@(onDay.Count - 3) more</a></li>
                        }
                    </ul>
                </div>
            }
        </div>
    }
    else
    {
        <div class="week">
            @foreach (var day in Days)
            {
                var onDay = EventsOn(day);
                <section class="column @(day == today ? "today" : "")" aria-label="@day.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)" data-day="@day.ToString("yyyy-MM-dd")">
                    <header>
                        <a class="date" href="@DayUrl(day)" aria-label="@($"{day.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)}: open the day")">
                            <span class="wd">@day.ToString("ddd", CultureInfo.InvariantCulture)</span>
                            <span class="wn">@day.Day</span>
                        </a>
                    </header>
                    @if (onDay.Count == 0)
                    {
                        <p class="empty">Nothing planned</p>
                    }
                    else
                    {
                        @* The day says what is on it (2 activities, 1 quiz ...); a click opens a box with each one as a link. *@
                        <a class="day-summary" href="@DayUrl(day)" aria-label="@($"{onDay.Count} on this day: open the day")">
                            @foreach (var g in Summary(onDay))
                            {
                                <span class="sum @g.Kind.ToLowerInvariant() @(g.Late ? "late" : "")"><Icon Name="@CalendarKinds.Icon(g.Kind)" Size="14" /> @g.Text</span>
                            }
                        </a>
                    }
                </section>
            }
        </div>
    }
</PageWithAside>

@* A teacher clicked an activity, quiz or task performance on the calendar: who handed it in, with the quiz's anti-cheating warnings. *@
@if (workItemId is { } workId)
{
    <CalendarWorkDialog @key="workId" ItemId="workId" CloseUrl="@Url(view, anchor)" />
}

@* A click on a day of the week: everything on that day, each one a link. *@
@if (openDay is { } dayToOpen)
{
    <CalendarDayDialog @key="@($"day-{dayToOpen:yyyy-MM-dd}")" Day="dayToOpen" View="@view" CloseUrl="@Url(view, anchor)" />
}

@* "Add event", or a click on an event of the person's own calendar: the box to write or change it. *@
@if (eventMode is not null)
{
    <CalendarEntryDialog @key="@($"event-{eventMode}-{editDay}")" EntryId="@(eventMode == "new" ? null : int.Parse(eventMode))" Day="@(editDay ?? NewEventDay)" View="@view" CloseUrl="@Url(view, anchor)" />
}

@* A teacher dragged an unassigned activity onto a day (or pressed "Set date"): the box to give it its due date and settings. *@
@if (editItemId is { } itemId)
{
    <ItemScheduleDialog @key="@($"{itemId}-{editDay}")" ItemId="itemId" Day="editDay" CloseUrl="@Url(view, anchor)" />
}

@code {
    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    [SupplyParameterFromQuery(Name = "view")] private string? ViewText { get; set; }

    [SupplyParameterFromQuery(Name = "date")] private string? DateText { get; set; }

    // A teacher's "unassigned activity" dropped on a day: ?edit=<item>&on=<day>.
    [SupplyParameterFromQuery(Name = "edit")] private string? EditText { get; set; }

    [SupplyParameterFromQuery(Name = "on")] private string? OnText { get; set; }

    // A click on a day of the week: ?day=<date>. An event of the person: ?event=new or ?event=<id>.
    [SupplyParameterFromQuery(Name = "day")] private string? DayText { get; set; }

    [SupplyParameterFromQuery(Name = "event")] private string? EventText { get; set; }

    // A teacher clicked a piece of work: ?work=<item>.
    [SupplyParameterFromQuery(Name = "work")] private string? WorkText { get; set; }

    private DateOnly today;
    private DateOnly anchor;
    private string view = "month";
    private DateOnly rangeStart;
    private int rangeDays;
    private IReadOnlyList<CalendarEvent> events = [];
    private bool isTeacher;
    private int? editItemId;
    private int? workItemId;
    private DateOnly? editDay;
    private DateOnly? openDay;
    private string? eventMode;

    /// <summary>The widgets at the right: a student's activities and then their due dates, or the teacher's unchecked activities and then the ones that have no due date yet.</summary>
    private string AsideShow => isTeacher ? "unchecked,unassigned" : "activities,upnext";

    private IEnumerable<DateOnly> Days => Enumerable.Range(0, rangeDays).Select(n => rangeStart.AddDays(n));

    private string Subtitle => view == "month"
        ? anchor.ToString("MMMM yyyy", CultureInfo.InvariantCulture)
        : $"{rangeStart.ToString("MMM d", CultureInfo.InvariantCulture)} – {rangeStart.AddDays(6).ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    protected override async Task OnParametersSetAsync()
    {
        today = PhilippineTime.Today(Clock);
        view = ViewText == "week" ? "week" : "month";
        anchor = DateOnly.TryParseExact(DateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) && parsed.Year is > 2000 and < 2100 ? parsed : today;

        if (view == "month")
        {
            var first = new DateOnly(anchor.Year, anchor.Month, 1);
            rangeStart = first.AddDays(-(int)first.DayOfWeek);
            var weeks = (int)Math.Ceiling(((int)first.DayOfWeek + DateTime.DaysInMonth(anchor.Year, anchor.Month)) / 7.0);
            rangeDays = weeks * 7;
        }
        else
        {
            rangeStart = anchor.AddDays(-(int)anchor.DayOfWeek);
            rangeDays = 7;
        }

        var user = await Me.GetAsync();
        isTeacher = user?.Role == AppRoles.Teacher;
        events = user is null ? [] : await Events.GetEventsAsync(user, rangeStart, rangeStart.AddDays(rangeDays - 1));

        editItemId = isTeacher && int.TryParse(EditText, out var itemId) && itemId > 0 ? itemId : null;
        workItemId = isTeacher && int.TryParse(WorkText, out var workId) && workId > 0 ? workId : null;
        editDay = DateOnly.TryParseExact(OnText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var on) && on.Year is > 2000 and < 2100 ? on : null;
        openDay = DateOnly.TryParseExact(DayText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) && day.Year is > 2000 and < 2100 ? day : null;
        eventMode = EventText == "new" ? "new" : int.TryParse(EventText, out var entryId) && entryId > 0 ? entryId.ToString() : null;
    }

    /// <summary>The day a new event starts on: today when it is on the page, else the first day of the page.</summary>
    private DateOnly NewEventDay => today >= rangeStart && today < rangeStart.AddDays(rangeDays) ? today : anchor;

    private string NewEventUrl => $"{Url(view, anchor)}&event=new&on={NewEventDay:yyyy-MM-dd}";

    private string DayUrl(DateOnly day) => $"{Url(view, anchor)}&day={day:yyyy-MM-dd}";

    private sealed record DaySummary(string Kind, string Text, bool Late);

    /// <summary>"2 activities", "1 quiz", "1 event" ... for the day, in the order of the legend.</summary>
    private static IEnumerable<DaySummary> Summary(IReadOnlyList<CalendarEvent> onDay)
    {
        foreach (var kind in new[] { ItemKinds.Activity, ItemKinds.Quiz, ItemKinds.TaskPerformance, CalendarKinds.Module, CalendarKinds.Personal })
        {
            var these = onDay.Where(e => e.Kind == kind).ToList();
            if (these.Count == 0)
            {
                continue;
            }

            var name = kind switch
            {
                ItemKinds.Activity => these.Count == 1 ? "activity" : "activities",
                ItemKinds.Quiz => these.Count == 1 ? "quiz" : "quizzes",
                ItemKinds.TaskPerformance => these.Count == 1 ? "task performance" : "task performances",
                CalendarKinds.Module => these.Count == 1 ? "module" : "modules",
                _ => these.Count == 1 ? "event" : "events",
            };
            yield return new DaySummary(kind, $"{these.Count} {name}", these.Any(e => e.Overdue));
        }
    }

    private List<CalendarEvent> EventsOn(DateOnly day) => events.Where(e => e.Day == day).ToList();

    /// <summary>The day to open for the Previous and Next buttons: a month or a week away.</summary>
    private DateOnly Step(int direction) => view == "month" ? new DateOnly(anchor.Year, anchor.Month, 1).AddMonths(direction) : anchor.AddDays(7 * direction);

    /// <summary>
    /// Where an event leads. A teacher's activity, quiz or task performance opens a box here with who handed it in (the key of
    /// those events is item-&lt;id&gt;); everything else goes to its own page.
    /// </summary>
    private string LinkOf(CalendarEvent e) =>
        e.Key.StartsWith("entry-", StringComparison.Ordinal) ? $"{Url(view, anchor)}&event={e.Key["entry-".Length..]}"
        : isTeacher && e.Key.StartsWith("item-", StringComparison.Ordinal) ? $"{Url(view, anchor)}&work={e.Key["item-".Length..]}" : e.Href!;

    private static string Url(string view, DateOnly date) => $"calendar?view={view}&date={date:yyyy-MM-dd}";

    private RenderFragment Chip(CalendarEvent e) => @<text>
        @if (e.Href is not null)
        {
            <a class="chip @e.Kind.ToLowerInvariant() @(e.Overdue ? "late" : "") @(e.Done ? "done" : "")" href="@LinkOf(e)" title="@e.Title · @e.Subtitle">@e.Title</a>
        }
        else
        {
            <span class="chip @e.Kind.ToLowerInvariant() @(e.Overdue ? "late" : "") @(e.Done ? "done" : "")" title="@e.Title">@e.Title</span>
        }
    </text>;
}
