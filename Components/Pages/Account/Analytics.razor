@page "/analytics"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.GuidanceCounselor + "," + AppRoles.Teacher + "," + AppRoles.AcademicProvider)]
@using System.Globalization
@inject CurrentUser Me
@inject AnalyticsService Reports
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Analytics · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="@Title" IconName="chart-column">
    @if (report is { Students: > 0 } && !custom)
    {
        <ButtonLink Href="analytics/export" Variant="ButtonVariant.Secondary" IconName="file-spreadsheet" data-enhance-nav="false" download>Export to Excel</ButtonLink>
    }
</PageHeader>

@if (report is null)
{
    <p class="muted">Loading…</p>
}
else if (report.Students == 0)
{
    <Card>
        <EmptyState IconName="chart-column" Title="Nothing to show yet">
            <p>@(report.SchoolWide ? "Numbers appear once students are enrolled and teachers give scores." : "Numbers appear once you have a course with students and scores.")</p>
        </EmptyState>
    </Card>
}
else if (Role == AppRoles.Admin)
{
    @* ===== The school: how the students do, by grade level and by strand ===== *@
    <div class="stats three">
        <StatCard Label="Students" Value="@report.Students" IconName="users" Accent="AccentColor.Blue" Hint="@report.ScopeText" />
        <StatCard Label="Average grade" Text="@(report.AverageGrade is { } avg ? $"{avg:0.#}%" : "—")" IconName="trending-up" Accent="AccentColor.Violet" Hint="@(report.AverageGrade is { } a2 ? GradeRules.Descriptor(a2) : "No grades yet")" />
        <StatCard Label="Open referrals" Value="@report.OpenReferrals" IconName="heart-handshake" Accent="AccentColor.Slate" Hint="With the guidance counselor" />
    </div>

    @if (activity is { Total: > 0 })
    {
        @* How the students use the LMS (the last 14 days): green active, yellow inactive, red never logged in. *@
        <div class="stats three" aria-label="Student activity">
            <StatCard Label="Active students" Value="@activity.Active" IconName="circle-check" Accent="AccentColor.Green" Hint="Visit the LMS, view handouts and answer activities" />
            <StatCard Label="Inactive students" Value="@activity.Inactive" IconName="clock" Accent="AccentColor.Amber" Hint="Not much visiting, viewing or answering" />
            <StatCard Label="Never logged in" Value="@activity.NeverLoggedIn" IconName="user-x" Accent="AccentColor.Rose" Hint="Never signed in to the LMS" />
        </div>

        <ChartRow>
            <Card Title="Active and inactive students" IconName="chart-pie">
                <PieChart Title="Students by how they use the LMS" Slices="ActivitySlices" CenterText="@activity.Total.ToString()" />
                <p class="note">@LmsRuleText</p>
            </Card>
            <Card Title="Students by grade" IconName="chart-column">
                <BarChart Title="Students by how they did" Items="BandBars" />
                <p class="note">All the students of the school, by the band of their average grade.</p>
            </Card>
        </ChartRow>
    }

    <section class="levels" aria-label="@report.BandsTitle">
        <h2><Icon Name="chart-bar" Size="20" /> @report.BandsTitle</h2>
        @Legend
        <div class="level-grid">
            @foreach (var g in report.Bands)
            {
                var total = Math.Max(1, g.Bands.Total);
                <article class="level">
                    <header><strong>@g.Label</strong><span>@g.Bands.Total @(g.Bands.Total == 1 ? "student" : "students")</span></header>
                    @StackOf(g)
                </article>
            }
        </div>
    </section>

    @* Round 35: the attendance, the primary concern categories and the solved concerns are the guidance counselor's; the administrator sees the grades. *@
    @* Round 41: "Performance by courses" (strand first, then a course, then its students) replaced "Students to follow up" (the Excel file still has the sheet LMS activity). *@
    <div class="board">
        <CoursePerformance />
        @PerformanceCard(report)
    </div>
}
else if (Role == AppRoles.GuidanceCounselor)
{
    @* ===== The guidance counselor: attendance and violations, and what helped ===== *@
    <div class="stats">
        <StatCard Label="Students with concerns" Value="@report.OpenReferrals" IconName="heart-handshake" Accent="AccentColor.Amber" Hint="Attendance or a violation" Href="guidance/referrals" />
        <StatCard Label="Attendance" Text="@(report.AttendanceRate is { } rate ? $"{rate:0.#}%" : "—")" IconName="calendar-check" Accent="@(report.AttendanceRate < AttendanceService.LowAttendancePercent ? AccentColor.Rose : AccentColor.Green)" Hint="Present or late" />
        <StatCard Label="Attendance concern" Value="@(report.ConcernStudents?.Count(c => c.Reason == ReferralReasons.LowAttendance) ?? 0)" IconName="triangle-alert" Accent="AccentColor.Rose" Hint="Students with low attendance" Href="guidance/referrals?show=concerns&reason=LowAttendance" />
        <StatCard Label="Violation concern" Value="@(report.ConcernStudents?.Count(c => c.Reason == ReferralReasons.Violation) ?? 0)" IconName="shield-alert" Accent="AccentColor.Violet" Hint="Students with a violation" Href="guidance/referrals?show=concerns&reason=Violation" />
    </div>

    <section class="concern-tiles" aria-label="@report.ConcernTitle">
        <h2><Icon Name="flag" Size="20" /> @report.ConcernTitle</h2>
        <div class="tiles">
            @{
                var concernTotal = Math.Max(1, report.Concerns.Sum(c => c.Count));
            }
            @foreach (var c in report.Concerns)
            {
                <article class="tile @c.Reason.ToLowerInvariant()">
                    <span class="tile-name">@ReferralReasons.Display(c.Reason)</span>
                    <strong>@c.Count</strong>
                    <span class="tile-bar"><i style="width: @(c.Count * 100 / concernTotal)%"></i></span>
                    <small>@(c.Count * 100 / concernTotal)% of the concerns</small>
                </article>
            }
        </div>
    </section>

    <ChartRow>
        <Card Title="Concerns by kind" IconName="chart-pie">
            <PieChart Title="Concerns by kind" Slices="ConcernSlices" CenterText="@report.Concerns.Sum(c => c.Count).ToString()" />
        </Card>
        <Card Title="Students absent, day by day" IconName="chart-column">
            <BarChart Title="Students absent by day" Items="AbsentBars" />
            <p class="note">The last days a teacher marked someone absent.</p>
        </Card>
    </ChartRow>

    <div class="board">
        @AttendanceCard(report)
        @ConcernStudentsCard(report)
        @AbsentHistoryCard(report)
    </div>
}
else
{
    @* ===== A teacher: the courses, then the students ===== *@
    <div class="stats">
        <StatCard Label="Students" Value="@report.Students" IconName="users" Accent="AccentColor.Blue" Hint="@report.ScopeText" />
        <StatCard Label="Average grade" Text="@(report.AverageGrade is { } avg ? $"{avg:0.#}%" : "—")" IconName="trending-up" Accent="AccentColor.Violet" Hint="@(report.AverageGrade is { } a2 ? GradeRules.Descriptor(a2) : "No grades yet")" />
        <StatCard Label="Failing" Value="@report.FailingStudents" IconName="triangle-alert" Accent="@(report.FailingStudents > 0 ? AccentColor.Rose : AccentColor.Green)" Hint="@($"Below {GradeRules.PassingPercent:0} in a course")" />
        <StatCard Label="At risk" Value="@report.AtRiskStudents" IconName="shield-alert" Accent="AccentColor.Amber" Hint="Near failing or missing work" />
    </div>

    <ChartRow>
        <Card Title="My students by grade" IconName="chart-pie">
            <PieChart Title="My students by the band of their grade" Slices="TeacherBandSlices" CenterText="@report.Bands.Sum(g => g.Bands.Total).ToString()" />
            <p class="note">Every student in every course counts once for each course.</p>
        </Card>
        <Card Title="Average grade by course" IconName="chart-column">
            <BarChart Title="Average grade by course" Items="CourseBars" Suffix="%" Full="100" />
        </Card>
    </ChartRow>

    <section class="my-courses" aria-label="My courses">
        <h2><Icon Name="book-open" Size="20" /> My courses <span class="count">@report.Performance.Count</span></h2>
        <div class="course-tiles">
            @foreach (var p in report.Performance)
            {
                <article class="course-tile">
                    <header>
                        <strong title="@p.Label">@p.Label</strong>
                        @if (p.Failing > 0)
                        {
                            <Badge Tone="Tone.Danger">@p.Failing failing</Badge>
                        }
                    </header>
                    <div class="meter-line">
                        <span>Average</span>
                        <span class="track"><i class="@Band(p.Average)" style="width: @Width(p.Average)%"></i></span>
                        <b>@(p.Average is { } a ? $"{a:0.#}%" : "—")</b>
                    </div>
                    <div class="meter-line">
                        <span>Attendance</span>
                        <span class="track"><i class="attendance" style="width: @Width(p.Attendance)%"></i></span>
                        <b>@(p.Attendance is { } at ? $"{at:0.#}%" : "—")</b>
                    </div>
                    <small>@p.Students @(p.Students == 1 ? "student" : "students")</small>
                </article>
            }
        </div>
    </section>

    <div class="board">
        <Card Title="@report.BandsTitle" IconName="chart-bar">
            @if (report.Bands.Count == 0 || report.Bands.All(b => b.Bands.Total == 0))
            {
                <p class="muted">No grades yet.</p>
            }
            else
            {
                @Legend
                <div class="stacks">
                    @foreach (var g in report.Bands)
                    {
                        <div class="stack-row">
                            <span class="stack-label" title="@g.Label">@g.Label</span>
                            @StackOf(g)
                            <span class="stack-total">@g.Bands.Total</span>
                        </div>
                    }
                </div>
            }
        </Card>
    </div>

    <TeacherStudents />
}

@code {
    private sealed record BandInfo(string Key, string Label, Func<BandCounts, int> Count);

    private static readonly BandInfo[] Bands =
    [
        new("outstanding", "Outstanding (90+)", b => b.Outstanding),
        new("verysat", "Very satisfactory (85–89)", b => b.VerySatisfactory),
        new("sat", "Satisfactory (80–84)", b => b.Satisfactory),
        new("fair", "Fairly satisfactory (70–79)", b => b.Fair),
        new("failing", "Below 70", b => b.Failing),
    ];

    private AnalyticsReport? report;
    private LmsActivity? activity;
    private string Role { get; set; } = "";
    private bool custom;

    [SupplyParameterFromQuery(Name = "area")] private string? AreaText { get; set; }

    private string Title => Role switch
    {
        AppRoles.Teacher => "My students",
        AppRoles.GuidanceCounselor => "Student concerns",
        _ => "Student analytics",
    };

    protected override async Task OnInitializedAsync()
    {
        var user = await Me.GetAsync();

        // A person with a role the administrator made up sees the analytics that were ticked for the role: the school (as the administrator sees it) or the guidance (attendance and concerns).
        var principal = (await AuthProvider.GetAuthenticationStateAsync()).User;
        if (user is not null && StaffAccess.IsCustom(principal))
        {
            custom = true;
            var pages = StaffAccess.PagesOf(principal);
            var as_ = AreaText == "guidance" && pages.Contains("analytics-guidance") ? AppRoles.GuidanceCounselor
                : pages.Contains("analytics-school") ? AppRoles.Admin
                : pages.Contains("analytics-guidance") ? AppRoles.GuidanceCounselor : "";
            user = as_.Length == 0 ? null : user with { Role = as_ };
        }

        Role = user?.Role ?? "";
        report = user is null ? null : await Reports.GetAsync(user);
        if (Role == AppRoles.Admin)
        {
            activity = await Reports.GetLmsActivityAsync();
        }
    }

    // ---------- the charts
    private static string LmsRuleText => $"Active (green): a score of {LmsActivityRules.ActiveFrom} or more in the last {LmsActivityRules.WindowDays} days. The score is visiting the LMS (up to 40: {LmsActivityRules.FullVisitDays} days of visits), viewing handouts (up to 30: {LmsActivityRules.FullHandouts}) and handing in activities (up to 30: {LmsActivityRules.FullAnswers}). Inactive (yellow): less than that. Never logged in (red): the student never signed in.";

    private IReadOnlyList<ChartSlice> ActivitySlices => activity is null ? [] :
    [
        new("Active", activity.Active, ChartColors.Green),
        new("Inactive", activity.Inactive, ChartColors.Yellow),
        new("Never logged in", activity.NeverLoggedIn, ChartColors.Red),
    ];

    private static readonly string[] BandColors = [ChartColors.Green, ChartColors.Teal, ChartColors.Blue, ChartColors.Yellow, ChartColors.Red];

    private IReadOnlyList<ChartSlice> BandBars => report is null ? [] :
        [.. Bands.Select((band, i) => new ChartSlice(band.Label, report.Bands.Sum(g => band.Count(g.Bands)), BandColors[i]))];

    private IReadOnlyList<ChartSlice> TeacherBandSlices => BandBars;

    private IReadOnlyList<ChartSlice> ConcernSlices => report is null ? [] :
        [.. report.Concerns.Select(c => new ChartSlice(ReferralReasons.Display(c.Reason), c.Count, c.Reason == ReferralReasons.Violation ? ChartColors.Violet : ChartColors.Orange))];

    private IReadOnlyList<ChartSlice> AbsentBars => report?.AbsentHistory is null ? [] :
        [.. report.AbsentHistory.Take(10).Reverse().Select(d => new ChartSlice(d.Day.ToString("MMM d", CultureInfo.InvariantCulture), d.Students.Count, ChartColors.Red, $"{d.Day:ddd, MMM d}: {d.Students.Count} absent"))];

    private IReadOnlyList<ChartSlice> CourseBars => report is null ? [] :
        [.. report.Performance.Where(p => p.Average is not null).Select((p, i) => new ChartSlice(p.Label, (double)p.Average!.Value, ChartColors.At(i)))];

    private RenderFragment Legend => @<ul class="legend" aria-label="Legend">
        @foreach (var band in Bands)
        {
            <li><span class="swatch @band.Key"></span> @band.Label</li>
        }
    </ul>;

    /// <summary>One row of colored parts: how many students are in each band of grades.</summary>
    private RenderFragment StackOf(GroupBands g) => @<div class="stack" role="img" aria-label="@($"{g.Label}: {g.Bands.Outstanding} outstanding, {g.Bands.VerySatisfactory} very satisfactory, {g.Bands.Satisfactory} satisfactory, {g.Bands.Fair} fair, {g.Bands.Failing} failing")">
        @foreach (var band in Bands)
        {
            var n = band.Count(g.Bands);
            @if (n > 0)
            {
                <span class="seg @band.Key" style="flex: @n 0 0" title="@band.Label: @n">@n</span>
            }
        }
    </div>;

    private RenderFragment PerformanceCard(AnalyticsReport r) => @<Card Title="@r.PerformanceTitle" IconName="layers">
        @if (r.Performance.Count == 0)
        {
            <p class="muted">Nothing to show yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">@(r.SchoolWide ? "Strand" : "Course")</th>
                            <th scope="col" class="num">Students</th>
                            <th scope="col">Average grade</th>
                            <th scope="col" class="num">Failing</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in r.Performance)
                        {
                            <tr>
                                <td>@p.Label</td>
                                <td class="num">@p.Students</td>
                                <td>
                                    <div class="cell-bar">
                                        <span class="track"><i class="@Band(p.Average)" style="width: @Width(p.Average)%"></i></span>
                                        <span>@(p.Average is { } a ? $"{a:0.#}%" : "—")</span>
                                    </div>
                                </td>
                                <td class="num">@if (p.Failing > 0) { <Badge Tone="Tone.Danger">@p.Failing</Badge> } else { <span class="muted">0</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>;

    private RenderFragment AttendanceCard(AnalyticsReport r) => @<Card Title="Attendance" IconName="calendar-check">
        @if (r.Attendance.Marks == 0)
        {
            <p class="muted">Attendance fills in as the teachers mark who came to class.</p>
        }
        else
        {
            var att = r.Attendance;
            <div class="att-top">
                <span class="att-rate">@(att.Rate is { } rt ? $"{rt:0.#}%" : "—")</span>
                <span class="att-counts">
                    <Badge Tone="Tone.Success">@att.Present.ToString("N0") present</Badge>
                    <Badge Tone="Tone.Warning">@att.Late.ToString("N0") late</Badge>
                    <Badge Tone="Tone.Danger">@att.Absent.ToString("N0") absent</Badge>
                </span>
            </div>
            <ul class="att-groups" aria-label="@(r.SchoolWide ? "Attendance by section" : "Attendance by course")">
                @foreach (var g in att.Groups)
                {
                    <li class="@(g.Rate < AttendanceService.LowAttendancePercent ? "low" : "")">
                        <span class="att-name" title="@g.Label">@g.Label</span>
                        <ProgressBar Percent="(int)Math.Round(g.Rate ?? 0m)" Title="@($"{g.Present} present, {g.Late} late, {g.Absent} absent")" />
                    </li>
                }
            </ul>
            <p class="note">Late counts as half. Below @AttendanceService.LowAttendancePercent.ToString("0") the line is marked.</p>
        }
    </Card>;

    /// <summary>The history of the students who were absent: one line for each school day (the last 30 days), that opens to the students and the courses they missed.</summary>
    private RenderFragment AbsentHistoryCard(AnalyticsReport r) => @<Card Title="Absent by day" IconName="calendar-x">
        @{
            var days = r.AbsentHistory ?? [];
        }
        @if (days.Count == 0)
        {
            <p class="muted">Nobody was marked absent in the last 30 days.</p>
        }
        else
        {
            <ul class="absent-days" aria-label="Students who were absent, day by day">
                @foreach (var d in days)
                {
                    <li>
                        <details>
                            <summary>
                                <span class="absent-day">@d.Day.ToString("ddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <Badge Tone="Tone.Danger">@d.Students.Count @(d.Students.Count == 1 ? "student" : "students") absent</Badge>
                            </summary>
                            <ul class="absent-people">
                                @foreach (var a in d.Students)
                                {
                                    <li>
                                        <a href="@($"guidance/referrals?q={Uri.EscapeDataString(a.Lrn)}")"><strong>@a.Name</strong></a>
                                        <span class="sub">@string.Join(", ", a.Courses)</span>
                                    </li>
                                }
                            </ul>
                        </details>
                    </li>
                }
            </ul>
            <p class="note">Only the days when a teacher marked someone absent are listed.</p>
        }
    </Card>;

    /// <summary>The students who have an attendance concern and the students who have a violation concern now, each with what was found.</summary>
    private RenderFragment ConcernStudentsCard(AnalyticsReport r) => @<Card Title="Students with a concern" IconName="heart-handshake">
        @{
            var list = r.ConcernStudents ?? [];
        }
        @if (list.Count == 0)
        {
            <p class="muted">No student has an attendance or a violation concern now.</p>
        }
        else
        {
            <div class="concern-groups">
                @foreach (var reason in new[] { ReferralReasons.LowAttendance, ReferralReasons.Violation })
                {
                    var of = list.Where(c => c.Reason == reason).ToList();
                    <section class="concern-group" aria-label="@ReferralReasons.Display(reason)">
                        <h3>@ReferralReasons.Display(reason) <span class="count">@of.Count</span></h3>
                        @if (of.Count == 0)
                        {
                            <p class="muted">None.</p>
                        }
                        else
                        {
                            <ul class="concern-people">
                                @foreach (var c in of.Take(8))
                                {
                                    <li>
                                        <a href="@($"guidance/referrals?show=concerns&q={Uri.EscapeDataString(c.Lrn)}")"><strong>@c.Name</strong></a>
                                        <span class="sub">@c.Detail</span>
                                    </li>
                                }
                            </ul>
                            @if (of.Count > 8)
                            {
                                <a class="more-link" href="@($"guidance/referrals?show=concerns&reason={reason}")">All @of.Count students</a>
                            }
                        }
                    </section>
                }
            </div>
        }
    </Card>;


    private static string Band(decimal? percent) => percent switch
    {
        null => "none",
        < GradeRules.PassingPercent => "bad",
        < GradeRules.AtRiskUntil => "warn",
        _ => "good",
    };

    private static string Width(decimal? percent) => Math.Clamp(percent ?? 0, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);
}
