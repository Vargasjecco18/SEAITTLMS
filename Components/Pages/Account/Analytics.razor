@page "/analytics"
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.GuidanceCounselor + "," + AppRoles.Teacher)]
@using System.Globalization
@inject CurrentUser Me
@inject AnalyticsService Reports

<PageTitle>Analytics · SEAITT e-LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Student analytics" IconName="chart-column" />

@if (report is null)
{
    <p class="muted">Loading…</p>
}
else if (report.Students == 0)
{
    <Card>
        <EmptyState IconName="chart-column" Title="Nothing to show yet">
            <p>@(report.SchoolWide ? "Numbers appear once students are enrolled and teachers give scores." : "Numbers appear once you have a course with students and scores.")</p>
        </EmptyState>
    </Card>
}
else
{
    <div class="stats">
        <StatCard Label="Students" Value="@report.Students" IconName="users" Accent="AccentColor.Blue" Hint="@report.ScopeText" />
        <StatCard Label="Average grade" Text="@(report.AverageGrade is { } avg ? $"{avg:0.#}%" : "—")" IconName="trending-up" Accent="AccentColor.Violet" Hint="@(report.AverageGrade is { } a2 ? GradeRules.Descriptor(a2) : "No grades yet")" />
        @if (Role != AppRoles.Teacher)
        {
            <StatCard Label="Attendance" Text="@(report.AttendanceRate is { } rate ? $"{rate:0.#}%" : "—")" IconName="calendar-check" Accent="@(report.AttendanceRate < AttendanceService.LowAttendancePercent ? AccentColor.Rose : AccentColor.Green)" Hint="Present or late" />
        }
        <StatCard Label="Failing" Value="@report.FailingStudents" IconName="triangle-alert" Accent="@(report.FailingStudents > 0 ? AccentColor.Rose : AccentColor.Green)" Hint="@($"Below {GradeRules.PassingPercent:0} in a course")" Href="@(report.SchoolWide && Role == AppRoles.GuidanceCounselor ? "guidance/students" : null)" />
        <StatCard Label="At risk" Value="@report.AtRiskStudents" IconName="shield-alert" Accent="AccentColor.Amber" Hint="Close to failing, or missing work" Href="@(report.SchoolWide && Role == AppRoles.GuidanceCounselor ? "guidance/students?kind=AtRisk" : null)" />
        <StatCard Label="Open referrals" Value="@report.OpenReferrals" IconName="heart-handshake" Accent="AccentColor.Slate" Hint="@(report.SchoolWide ? "With the guidance counselor" : "In your courses")" Href="@(Role == AppRoles.GuidanceCounselor ? "guidance/referrals" : null)" />
    </div>

    <div class="grid two">
        <Card Title="@report.BandsTitle" IconName="chart-bar">
            @if (report.Bands.Count == 0 || report.Bands.All(b => b.Bands.Total == 0))
            {
                <p class="muted">No grades yet.</p>
            }
            else
            {
                <ul class="legend" aria-label="Legend">
                    @foreach (var band in Bands)
                    {
                        <li><span class="swatch @band.Key"></span> @band.Label</li>
                    }
                </ul>
                <div class="stacks">
                    @foreach (var g in report.Bands)
                    {
                        var total = Math.Max(1, g.Bands.Total);
                        <div class="stack-row">
                            <span class="stack-label" title="@g.Label">@g.Label</span>
                            <div class="stack" role="img" aria-label="@($"{g.Label}: {g.Bands.Outstanding} outstanding, {g.Bands.VerySatisfactory} very satisfactory, {g.Bands.Satisfactory} satisfactory, {g.Bands.Fair} fair, {g.Bands.Failing} failing")">
                                @foreach (var band in Bands)
                                {
                                    var n = band.Count(g.Bands);
                                    @if (n > 0)
                                    {
                                        <span class="seg @band.Key" style="flex: @n 0 0" title="@band.Label: @n">@n</span>
                                    }
                                }
                            </div>
                            <span class="stack-total">@g.Bands.Total</span>
                        </div>
                    }
                </div>
            }
        </Card>

        @if (Role != AppRoles.Teacher)
        {
            <Card Title="Attendance" IconName="calendar-check">
                @if (report.Attendance.Marks == 0)
                {
                    <p class="muted">Attendance fills in as the teachers mark who came to class.</p>
                }
                else
                {
                    var att = report.Attendance;
                    <div class="att-top">
                        <span class="att-rate">@(att.Rate is { } r ? $"{r:0.#}%" : "—")</span>
                        <span class="att-counts">
                            <Badge Tone="Tone.Success">@att.Present.ToString("N0") present</Badge>
                            <Badge Tone="Tone.Warning">@att.Late.ToString("N0") late</Badge>
                            <Badge Tone="Tone.Danger">@att.Absent.ToString("N0") absent</Badge>
                        </span>
                    </div>
                    <ul class="att-groups" aria-label="@(report.SchoolWide ? "Attendance by section" : "Attendance by course")">
                        @foreach (var g in att.Groups)
                        {
                            <li class="@(g.Rate < AttendanceService.LowAttendancePercent ? "low" : "")">
                                <span class="att-name" title="@g.Label">@g.Label</span>
                                <ProgressBar Percent="(int)Math.Round(g.Rate ?? 0m)" Title="@($"{g.Present} present, {g.Late} late, {g.Absent} absent")" />
                            </li>
                        }
                    </ul>
                    <p class="note">Late counts as half. Below @AttendanceService.LowAttendancePercent.ToString("0") the line is marked.</p>
                }
            </Card>
        }

        @if (Role == AppRoles.Teacher)
        {
            @ConcernCard(report)
        }
    </div>

    <div class="grid two">
        @if (Role != AppRoles.Teacher)
        {
            @ConcernCard(report)
        }

        @if (report.SchoolWide)
        {
            <Card Title="Intervention effectiveness" IconName="heart-handshake">
                @if (report.Resolved == 0)
                {
                    <p class="muted">When the guidance counselor resolves a referral and says how it ended, the results show here.</p>
                }
                else
                {
                    var success = report.Improved * 100 / report.Resolved;
                    <div class="success">
                        <span class="success-number">@success%</span>
                        <span class="success-text">of @report.Resolved resolved @(report.Resolved == 1 ? "referral" : "referrals") improved</span>
                    </div>
                    <ul class="bars">
                        @foreach (var i in report.Interventions)
                        {
                            <li>
                                <span class="bar-name">@i.Intervention</span>
                                <span class="track"><i class="concern improved" style="width: @(i.Total == 0 ? 0 : i.Improved * 100 / i.Total)%"></i></span>
                                <span class="bar-value">@i.Improved / @i.Total</span>
                            </li>
                        }
                    </ul>
                }
            </Card>
        }
    </div>

    <Card Title="@report.PerformanceTitle" IconName="layers">
        @if (report.Performance.Count == 0)
        {
            <p class="muted">Nothing to show yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">@(report.SchoolWide ? "Strand" : "Course")</th>
                            <th scope="col" class="num">Students</th>
                            <th scope="col">Average grade</th>
                            <th scope="col" class="num">Attendance</th>
                            <th scope="col" class="num">Failing</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in report.Performance)
                        {
                            <tr>
                                <td>@p.Label</td>
                                <td class="num">@p.Students</td>
                                <td>
                                    <div class="cell-bar">
                                        <span class="track"><i class="@Band(p.Average)" style="width: @Width(p.Average)%"></i></span>
                                        <span>@(p.Average is { } a ? $"{a:0.#}%" : "—")</span>
                                    </div>
                                </td>
                                <td class="num">@(p.Attendance is { } at ? $"{at:0.#}%" : "—")</td>
                                <td class="num">@if (p.Failing > 0) { <Badge Tone="Tone.Danger">@p.Failing</Badge> } else { <span class="muted">0</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>
}

@code {
    private sealed record BandInfo(string Key, string Label, Func<BandCounts, int> Count);

    private static readonly BandInfo[] Bands =
    [
        new("outstanding", "Outstanding (90+)", b => b.Outstanding),
        new("verysat", "Very satisfactory (85–89)", b => b.VerySatisfactory),
        new("sat", "Satisfactory (80–84)", b => b.Satisfactory),
        new("fair", "Fairly satisfactory (70–79)", b => b.Fair),
        new("failing", "Below 70", b => b.Failing),
    ];

    private RenderFragment ConcernCard(AnalyticsReport report) => @<text>
        <Card Title="@report.ConcernTitle" IconName="flag">
            @{
                var maxConcern = Math.Max(1, report.Concerns.Max(c => c.Count));
            }
            @if (report.Concerns.All(c => c.Count == 0))
            {
                <p class="muted">None.</p>
            }
            else
            {
                <ul class="bars">
                    @foreach (var c in report.Concerns)
                    {
                        <li>
                            <span class="bar-name">@ReferralReasons.Display(c.Reason)</span>
                            <span class="track"><i class="concern @c.Reason.ToLowerInvariant()" style="width: @(c.Count * 100 / maxConcern)%"></i></span>
                            <span class="bar-value">@c.Count</span>
                        </li>
                    }
                </ul>
            }
        </Card>
    </text>;

    private AnalyticsReport? report;
    private string Role { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        var user = await Me.GetAsync();
        Role = user?.Role ?? "";
        report = user is null ? null : await Reports.GetAsync(user);
    }

    private static string Band(decimal? percent) => percent switch
    {
        null => "none",
        < GradeRules.PassingPercent => "bad",
        < GradeRules.AtRiskUntil => "warn",
        _ => "good",
    };

    private static string Width(decimal? percent) => Math.Clamp(percent ?? 0, 0, 100).ToString("0.#", CultureInfo.InvariantCulture);
}
