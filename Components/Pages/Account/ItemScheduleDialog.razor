@rendermode InteractiveServer
@inject CurrentUser Me
@inject ModuleService Modules
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* The box a teacher gets when an unassigned activity is dropped on a day of the calendar: its due date (the day it was dropped on)
   and the rest of its settings, also the quiz's anti-cheating watch. Saving puts it on the calendar; Cancel leaves it unassigned. *@
<Modal Open="loaded" Title="@(item is null ? "Not found" : $"Set the due date: {item.Title}")" OnClose="Cancel" Large="true">
    @if (item is null || form is null)
    {
        <p>This activity was not found. It may have been deleted, or it is not one of yours.</p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="Cancel">Close</Button>
        </div>
    }
    else
    {
        <p class="where">
            <Badge Tone="Tone.Info">@ItemKinds.Display(item.Kind)</Badge>
            <span>@item.SubjectName · @item.SectionLabel · @item.ModuleTitle</span>
        </p>

        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <FormErrors Errors="errors" />

            <div class="two">
                <Field For="d-due" Label="Due date" Required="true" Hint="Philippine time.">
                    <input id="d-due" type="datetime-local" value="@form.DueText" @onchange="e => form.DueText = e.Value?.ToString() ?? string.Empty" />
                </Field>
                <Field For="d-from" Label="Appears on" Hint="Leave empty to show it with its module.">
                    <input id="d-from" type="datetime-local" value="@form.VisibleText" @onchange="e => form.VisibleText = e.Value?.ToString() ?? string.Empty" />
                </Field>
            </div>

            <div class="two">
                <Field For="d-title" Label="Title" Required="true">
                    <InputText id="d-title" @bind-Value="form.Title" maxlength="200" autocomplete="off" />
                </Field>
                @if (item.Kind != ItemKinds.Quiz)
                {
                    <Field For="d-score" Label="Highest score" Required="true">
                        <InputNumber id="d-score" @bind-Value="form.MaxScore" />
                    </Field>
                }
            </div>
            <Field For="d-text" Label="Instructions">
                <InputTextArea id="d-text" @bind-Value="form.Instructions" rows="4" />
            </Field>

            @if (item.Kind == ItemKinds.Quiz)
            {
                <QuizSettings IdPrefix="d" Note="@(item.Questions == 0 ? "This quiz has no questions yet. Write them under its course; the due date is saved either way." : null)"
                              @bind-TimeLimit="form.TimeLimit" @bind-MaxViolations="form.MaxViolations" @bind-AntiCheat="form.AntiCheat"
                              @bind-ShuffleQuestions="form.ShuffleQuestions" @bind-ShuffleOptions="form.ShuffleOptions" @bind-ShowResult="form.ShowResult" />
            }

            <div class="modal-actions">
                <a class="more-link" href="teacher/subjects/@item.AssignmentId">Open in the course</a>
                <Button Variant="ButtonVariant.Ghost" OnClick="Cancel">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

@code {
    private sealed class Form
    {
        public string Title { get; set; } = "";
        public string? Instructions { get; set; }
        public decimal MaxScore { get; set; } = 100;
        public string DueText { get; set; } = "";
        public string VisibleText { get; set; } = "";
        public int? TimeLimit { get; set; }
        public bool ShuffleQuestions { get; set; } = true;
        public bool ShuffleOptions { get; set; } = true;
        public bool AntiCheat { get; set; } = true;
        public int MaxViolations { get; set; } = 3;
        public bool ShowResult { get; set; } = true;
    }

    [Parameter, EditorRequired] public int ItemId { get; set; }

    /// <summary>The day the item was dropped on. Empty when the teacher pressed "Set date": then it starts a week from today.</summary>
    [Parameter] public DateOnly? Day { get; set; }

    /// <summary>Where the calendar is again when the box is closed.</summary>
    [Parameter, EditorRequired] public string CloseUrl { get; set; } = "calendar";

    private ItemForEdit? item;
    private Form? form;
    private List<string> errors = [];
    private bool loaded;
    private bool busy;
    private int teacherId;

    protected override async Task OnInitializedAsync()
    {
        teacherId = await Me.GetTeacherIdAsync() ?? 0;
        item = teacherId == 0 ? null : await Modules.GetItemForEditAsync(teacherId, ItemId);
        if (item is not null)
        {
            // The due date: the day it was dropped on, at the time it had (or 5 PM). The time can be changed in the box.
            var day = Day ?? PhilippineTime.Today(Clock).AddDays(7);
            var time = item.DueAtUtc is { } due ? TimeOnly.FromDateTime(PhilippineTime.ToLocal(due)) : new TimeOnly(17, 0);
            form = new Form
            {
                Title = item.Title, Instructions = item.Instructions, MaxScore = item.MaxScore,
                DueText = $"{day:yyyy-MM-dd}T{time:HH:mm}",
                VisibleText = PhilippineTime.ToInputValue(item.VisibleFromUtc),
                TimeLimit = item.TimeLimitMinutes, ShuffleQuestions = item.ShuffleQuestions, ShuffleOptions = item.ShuffleOptions,
                AntiCheat = item.AntiCheat, MaxViolations = item.MaxViolations, ShowResult = item.ShowResult,
            };
        }

        loaded = true;
    }

    private void Cancel() => Navigation.NavigateTo(CloseUrl);

    private async Task SaveAsync()
    {
        if (busy || item is null || form is null)
        {
            return;
        }

        busy = true;
        errors = [];
        try
        {
            var input = new ItemInput
            {
                Kind = item.Kind, Title = form.Title, Instructions = form.Instructions, MaxScore = form.MaxScore,
                DueAtUtc = PhilippineTime.FromInputValue(form.DueText), VisibleFromUtc = PhilippineTime.FromInputValue(form.VisibleText),
                TimeLimitMinutes = form.TimeLimit, ShuffleQuestions = form.ShuffleQuestions, ShuffleOptions = form.ShuffleOptions,
                AntiCheat = form.AntiCheat, MaxViolations = form.MaxViolations, ShowResult = form.ShowResult,
            };
            if (input.DueAtUtc is null)
            {
                errors = ["Pick the due date and time."];
                return;
            }

            var result = await Modules.SaveItemAsync(teacherId, item.ModuleId, item.ItemId, input);
            if (!result.Succeeded)
            {
                errors = [.. result.Errors];
                return;
            }

            Navigation.NavigateTo(CloseUrl);
        }
        finally
        {
            busy = false;
        }
    }
}
