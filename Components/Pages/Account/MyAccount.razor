@page "/account"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using SEAITT_LMS.Data
@using SEAITT_LMS.Data.Queries
@using SEAITT_LMS.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TimeProvider Clock
@inject ReferralService Referrals

<PageTitle>My account · SEAITT e-LMS</PageTitle>

<PageHeader Title="@($"{PhilippineTime.Greeting(now)}, {account?.FirstName ?? name}!")"
            Subtitle="@PhilippineTime.FormatLongDate(now)"
            IconName="id-card" />

@if (AsideShow is { } show)
{
    <PageWithAside Show="@show">@Body</PageWithAside>
}
else
{
    @Body
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private DateTimeOffset now;
    private string name = "";
    private string email = "";
    private string role = "";
    private string roleName = "";
    private AccountDetails? account;
    private IReadOnlyList<PageEntry> shortcuts = [];
    private List<(string Label, string Icon, int Value, AccentColor Accent, string? Href)> glance = [];

    /// <summary>Students and teachers have the calendar and the to-do list at the right. The staff roles have no such column.</summary>
    private string? AsideShow => roleName switch
    {
        AppRoles.Student => "achievements,calendar,todo",
        AppRoles.Teacher => "tocheck,calendar,todo",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        now = PhilippineTime.Now(Clock);

        // What the sign-in cookie says is the fallback, in case the account can't be read from the database.
        var user = (await AuthState).User;
        name = user.Identity?.Name ?? "";
        email = user.FindFirstValue(ClaimTypes.Email) ?? "";
        roleName = user.FindFirstValue(ClaimTypes.Role) ?? "";
        role = AppRoles.DisplayName(roleName);
        shortcuts = PageDirectory.For(roleName).Where(p => p.Href != "account").ToList();

        await using var db = await DbFactory.CreateDbContextAsync();

        if (int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
        {
            account = await AccountDetails.LoadAsync(db, userId);
        }

        await LoadGlanceAsync(db);
    }

    /// <summary>A few numbers for the staff roles, who have no dashboard widgets at the right.</summary>
    private async Task LoadGlanceAsync(AppDbContext db)
    {
        switch (roleName)
        {
            case AppRoles.Admin:
                var admin = await AdminOverview.LoadAsync(db, Clock.GetUtcNow().UtcDateTime, 0);
                glance =
                [
                    ("Accounts", "users", admin.TotalAccounts, AccentColor.Blue, "admin/users"),
                    ("Cannot sign in", "lock-keyhole", admin.InactiveAccounts, admin.InactiveAccounts > 0 ? AccentColor.Amber : AccentColor.Green, "admin/users"),
                    ("Enrollments", "user-check", admin.Setup.Enrollments, AccentColor.Violet, null),
                ];
                break;

            case AppRoles.Registrar:
                var startOfToday = new DateTimeOffset(PhilippineTime.Now(Clock).Date, TimeSpan.FromHours(8)).UtcDateTime;
                var registrar = await RegistrarOverview.LoadAsync(db, startOfToday);
                glance =
                [
                    ("Enrolled this term", "clipboard-check", registrar.EnrolledThisTerm, AccentColor.Blue, "registrar/student-accounts"),
                    ("Enrolled today", "user-plus", registrar.EnrolledToday, AccentColor.Green, "registrar/enrollments"),
                    ("Students in the system", "graduation-cap", registrar.StudentsTotal, AccentColor.Violet, "registrar/student-accounts"),
                ];
                break;

            case AppRoles.GuidanceCounselor:
                var guidance = await Referrals.GetOverviewAsync();
                glance =
                [
                    ("New referrals", "flag", guidance.Open, guidance.Open > 0 ? AccentColor.Rose : AccentColor.Green, "guidance/referrals"),
                    ("In progress", "heart-handshake", guidance.InProgress, AccentColor.Blue, "guidance/referrals"),
                    ("Failing (below 70)", "triangle-alert", guidance.Failing, guidance.Failing > 0 ? AccentColor.Amber : AccentColor.Green, "guidance/students"),
                ];
                break;
        }
    }

    private RenderFragment Body => @<div class="layout">
        @if (glance.Count > 0)
        {
            <div class="stats">
                @foreach (var item in glance)
                {
                    <StatCard Label="@item.Label" Value="@item.Value" IconName="@item.Icon" Accent="@item.Accent" Href="@item.Href" />
                }
            </div>
        }

        <div class="cards">
            <Card Title="Your account" IconName="id-card">
                <div class="profile">
                    <Avatar Name="@(account?.FullName ?? name)" Size="56" />
                    <div class="profile-text">
                        <strong class="profile-name">@(account?.FullName ?? name)</strong>
                        <span class="profile-email">@(account?.Email ?? email)</span>
                        <Badge Tone="Tone.Info">@(account?.Role ?? role)</Badge>
                    </div>
                </div>

                @if (account is { Rows.Count: > 0 })
                {
                    <dl class="rows">
                        @foreach (var row in account.Rows)
                        {
                            <div class="row">
                                <dt>@row.Label</dt>
                                <dd>
                                    @if (row.Value is null)
                                    {
                                        <span class="unset">Not set yet</span>
                                    }
                                    else if (row.IsStatus)
                                    {
                                        <Badge Tone="@(row.Value == "Active" ? Tone.Success : Tone.Neutral)">@row.Value</Badge>
                                    }
                                    else
                                    {
                                        @row.Value
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                }
            </Card>

            <div class="column">
                <Card Title="Sign-in and security" IconName="shield-check">
                    <dl class="rows first">
                        <div class="row"><dt>Sign-in name</dt><dd>@(account?.Email ?? email)</dd></div>
                        <div class="row">
                            <dt>Account</dt>
                            <dd><Badge Tone="@(account is null || account.IsActive ? Tone.Success : Tone.Neutral)">@(account is null || account.IsActive ? "Active" : "Switched off")</Badge></dd>
                        </div>
                        <div class="row">
                            <dt>Last sign-in</dt>
                            <dd>@(account?.LastLoginAtUtc is { } last ? PhilippineTime.FormatDateTime(last) : "This is your first")</dd>
                        </div>
                        <div class="row">
                            <dt>Account made</dt>
                            <dd>@(account?.CreatedAtUtc is { } made ? PhilippineTime.FormatDate(made) : "—")</dd>
                        </div>
                    </dl>
                    <p class="note"><Icon Name="lock-keyhole" Size="16" /> Keep your password private. If you forget it, ask the administrator.</p>
                </Card>

                <Card Title="Appearance" IconName="sun">
                    <div class="choices" role="group" aria-label="Appearance">
                        <button type="button" class="choice" data-theme-choice="light"><Icon Name="sun" Size="18" /><span>Light</span></button>
                        <button type="button" class="choice" data-theme-choice="dark"><Icon Name="moon" Size="18" /><span>Night</span></button>
                        <button type="button" class="choice" data-theme-choice="auto"><Icon Name="monitor" Size="18" /><span>Auto</span></button>
                    </div>
                    <button type="button" class="switch" data-motion-toggle>
                        <span class="switch-text">
                            <strong>Animations</strong>
                            <small>Small movements when pages and menus open</small>
                        </span>
                        <span class="track" aria-hidden="true"><span class="thumb"></span></span>
                    </button>
                </Card>
            </div>
        </div>

        @if (shortcuts.Count > 0)
        {
            <Card Title="Go to" IconName="arrow-right">
                <ul class="shortcuts">
                    @foreach (var entry in shortcuts)
                    {
                        <li>
                            <a href="@entry.Href">
                                <span class="shortcut-icon"><Icon Name="@entry.Icon" Size="18" /></span>
                                <span class="shortcut-text">
                                    <strong>@entry.Title</strong>
                                    <small>@entry.Description</small>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </Card>
        }
    </div>;
}
