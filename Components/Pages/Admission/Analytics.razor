@page "/admission/analytics"
@attribute [Authorize(Roles = AppRoles.Admission)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ApplicationService Service

<PageTitle>Analytics · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Analytics" IconName="chart-column" />

@if (data is null)
{
    <p class="muted">Loading…</p>
}
else if (data.Counts.Total == 0)
{
    <Card>
        <EmptyState IconName="chart-column" Title="Nothing to show yet">
            <p>The numbers appear once students send their applications from the home page.</p>
        </EmptyState>
    </Card>
}
else
{
    <div class="stats">
        <StatCard Label="Applications" Value="@data.Counts.Total" IconName="inbox" Accent="AccentColor.Blue" Hint="All that were sent" />
        <StatCard Label="Waiting" Value="@data.Counts.Pending" IconName="clock" Accent="AccentColor.Amber" Hint="Pending" />
        <StatCard Label="Accepted" Value="@(data.Counts.Accepted + data.Counts.Enrolled)" IconName="circle-check" Accent="AccentColor.Green" Hint="@($"{data.Counts.Enrolled} already enrolled")" />
        <StatCard Label="Declined" Value="@data.Counts.Declined" IconName="circle-x" Accent="AccentColor.Rose" Hint="Not accepted" />
    </div>

    @* Two charts side by side, the same size: the pie of the states and the bars of the strands; under them the days and the places. *@
    <div class="board">
        <Card Title="Applications by state" IconName="chart-pie">
            <PieChart Title="Applications by state" Slices="StateSlices" CenterText="@data.Counts.Total.ToString()" />
        </Card>
        <Card Title="Applications by strand" IconName="chart-bar">
            <BarChart Title="Applications by strand" Items="StrandBars" />
        </Card>
        <Card Title="Applications in the last 14 days" IconName="calendar-days">
            <BarChart Title="Applications by day" Items="DayBars" />
        </Card>
        <Card Title="Where the students live" IconName="map-pin">
            <BarChart Title="Applications by city or municipality" Items="CityBars" />
        </Card>
    </div>
}

@code {
    private ApplicationAnalytics? data;

    protected override async Task OnInitializedAsync()
    {
        var me = await Me.GetAsync();
        data = me is null ? null : await Service.GetAnalyticsAsync(me.UserId);
    }

    private IReadOnlyList<ChartSlice> StateSlices =>
    [
        new("Pending", data!.Counts.Pending, ChartColors.Yellow),
        new("Accepted", data.Counts.Accepted, ChartColors.Green),
        new("Enrolled", data.Counts.Enrolled, ChartColors.Blue),
        new("Declined", data.Counts.Declined, ChartColors.Red),
    ];

    private IReadOnlyList<ChartSlice> StrandBars => [.. data!.ByStrand.Select((s, i) => new ChartSlice(s.Label, s.Count, ChartColors.At(i)))];

    private IReadOnlyList<ChartSlice> DayBars => [.. data!.ByDay.Select(d => new ChartSlice(d.Day.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture), d.Count, ChartColors.Blue))];

    private IReadOnlyList<ChartSlice> CityBars => [.. data!.ByCity.Select((c, i) => new ChartSlice(c.Label, c.Count, ChartColors.At(i + 2)))];
}
