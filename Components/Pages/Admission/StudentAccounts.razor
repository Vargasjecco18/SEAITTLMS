@page "/admission/student-accounts"
@attribute [Authorize(Roles = AppRoles.Admission)]
@using Microsoft.EntityFrameworkCore
@using SEAITT_LMS.Data
@using SEAITT_LMS.Data.Queries
@using SEAITT_LMS.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject EnrollmentService Enrollment
@inject ApplicationService Applications
@inject CurrentUser Me
@inject NavigationManager Navigation

<PageTitle>Student's Accounts · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<span data-side-rail hidden></span>

@* The students of the grade level of the admission officer, like the registrar's list but without the next term. The Info button opens the application the student sent and the papers they uploaded. *@
<PageHeader Title="@(grade is { } g ? $"Student's Accounts · Grade {g}" : "Student's Accounts")" IconName="graduation-cap" />

@if (lookups is not null && result is not null)
{
    <div class="stack">
        <Card>
            <form method="get" action="admission/student-accounts" class="filter-bar" role="search">
                <SearchField Id="q" Name="q" Static="true" Value="@Q" SubmitText="" Label="Search" Placeholder="Name or LRN" ClearHref="admission/student-accounts" />
                <Field For="term" Label="Term">
                    <select id="term" name="term">
                        <option value="">All terms</option>
                        @foreach (var term in lookups.Terms)
                        {
                            <option value="@term.Id" selected="@(Term == term.Id)">@term.SchoolYear · @term.Name</option>
                        }
                    </select>
                </Field>
                <Field For="strand" Label="Strand">
                    <select id="strand" name="strand">
                        <option value="">All strands</option>
                        @foreach (var strand in lookups.Strands)
                        {
                            <option value="@strand.Id" selected="@(Strand == strand.Id)">@strand.Code</option>
                        }
                    </select>
                </Field>
                <div class="filter-actions">
                    <Button Type="submit" IconName="search">Search</Button>
                    @if (!string.IsNullOrWhiteSpace(Q) || Term is not null || Strand is not null)
                    {
                        <ButtonLink Href="admission/student-accounts" Variant="ButtonVariant.Ghost">Clear</ButtonLink>
                    }
                </div>
            </form>
        </Card>

        <Card>
            @if (result.Items.Count == 0)
            {
                <EmptyState IconName="search-x" Title="No student here">
                    <p>@(string.IsNullOrWhiteSpace(Q) && Term is null && Strand is null ? "The students of your grade level are listed here once they are enrolled." : "Try another name, LRN or filter.")</p>
                </EmptyState>
            }
            else
            {
                <p class="result-count">@(result.Total == 1 ? "1 enrollment" : $"{result.Total:N0} enrollments")</p>
                <div class="table-in-card">
                    <EnrollmentTable Rows="result.Items" ShowTerm="false" ShowSubjects="true" ShowFinalGrade="true" ShowNextTerm="false" ShowPhone="true" InfoOnly="true" />
                </div>

                @if (result.PageCount > 1)
                {
                    <nav class="pager" aria-label="Pages">
                        @if (result.Page > 1)
                        {
                            <a class="pager-link" href="@PageUrl(result.Page - 1)"><Icon Name="chevron-left" Size="16" /> Previous</a>
                        }
                        <span class="pager-count">Page @result.Page of @result.PageCount</span>
                        @if (result.Page < result.PageCount)
                        {
                            <a class="pager-link" href="@PageUrl(result.Page + 1)">Next <Icon Name="chevron-right" Size="16" /></a>
                        }
                    </nav>
                }
            }
        </Card>
    </div>
}

@code {
    private const int PageSize = 20;

    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "term")] private string? TermText { get; set; }
    [SupplyParameterFromQuery(Name = "strand")] private string? StrandText { get; set; }
    [SupplyParameterFromQuery(Name = "page")] private string? PageText { get; set; }

    private int? Term => ParseNumber(TermText);
    private int? Strand => ParseNumber(StrandText);

    private static int? ParseNumber(string? text) => int.TryParse(text, out var number) && number > 0 ? number : null;

    private EnrollmentLookups? lookups;
    private EnrollmentPage? result;
    private int? grade;

    protected override async Task OnInitializedAsync()
    {
        var me = await Me.GetAsync();
        grade = me is null ? null : await Applications.GradeOfOfficerAsync(me.UserId);
        lookups = await Enrollment.GetLookupsAsync();

        await using var db = await DbFactory.CreateDbContextAsync();
        result = await EnrollmentList.LoadAsync(db, new EnrollmentFilter(Q, Term, Strand, null, grade), ParseNumber(PageText) ?? 1, PageSize, withFinalGrade: true);
    }

    private string PageUrl(int page) => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["page"] = page });
}
