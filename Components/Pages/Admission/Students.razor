@page "/admission/grade-{Grade:int}"
@attribute [Authorize(Roles = AppRoles.Admission)]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject CurrentUser Me
@inject AdmissionService Admission

<PageTitle>Grade @Grade Students · SEAITT Legazpi LMS</PageTitle>

@if (!allowed)
{
    <Card>
        <EmptyState IconName="user-plus" Title="Not your page" IsPage="true">
            <p>Your account records the students of another grade level, or none.</p>
        </EmptyState>
    </Card>
}
else
{
    @* Round 47: Grade N Students: a summary, the filters, and the students in a table with the strand, the section and the phone of each one. *@
    <PageHeader Title="@($"Grade {Grade} Students")" IconName="users">
        <Button IconName="plus" OnClick="OpenNew">Record a student</Button>
    </PageHeader>

    <Toast Message="@message" IsError="@messageIsError" Stamp="@messageStamp" OnDismiss="() => message = null" />

    <div class="tiles" id="admission-tiles">
        <div class="tile"><span class="tile-icon"><Icon Name="users" Size="20" /></span><span class="tile-text"><span class="tile-value">@all.Count</span><span class="tile-label">students recorded</span></span></div>
        <div class="tile"><span class="tile-icon ok"><Icon Name="circle-check" Size="20" /></span><span class="tile-text"><span class="tile-value">@all.Count(r => r.Enrolled)</span><span class="tile-label">enrolled by the registrar</span></span></div>
        <div class="tile"><span class="tile-icon wait"><Icon Name="clock" Size="20" /></span><span class="tile-text"><span class="tile-value">@all.Count(r => !r.Enrolled)</span><span class="tile-label">waiting to be enrolled</span></span></div>
        <div class="tile"><span class="tile-icon doc"><Icon Name="folder-open" Size="20" /></span><span class="tile-text"><span class="tile-value">@all.Sum(r => r.DocumentsReceived + r.OtherDocuments)</span><span class="tile-label">documents kept</span></span></div>
    </div>

    <Card>
        <form class="filter-bar" role="search" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
            <SearchField Id="adm-search" @bind-Value="searchText" Placeholder="Name or LRN" AriaLabel="Search the recorded students" OnClear="SearchAsync" />
            <select id="adm-state" class="input" aria-label="State" @bind="stateFilter" @bind:after="ApplyFilter">
                <option value="">All students</option>
                <option value="recorded">Waiting to be enrolled</option>
                <option value="enrolled">Enrolled</option>
            </select>
            <select id="adm-strand" class="input" aria-label="Strand" @bind="strandFilter" @bind:after="ApplyFilter">
                <option value="">All strands</option>
                @foreach (var strandCode in StrandCodes)
                {
                    <option value="@strandCode">@strandCode</option>
                }
            </select>
            <span class="count-note" id="adm-count">@rows.Count of @all.Count</span>
        </form>
        @if (rows.Count == 0)
        {
            <EmptyState IconName="user-plus" Title="@(all.Count == 0 ? "No student recorded yet" : "No student matches")">
                <p>@(all.Count == 0 ? "Press Record a student to write the first one." : "Try another name, strand or state.")</p>
            </EmptyState>
        }
        else
        {
            <div class="data-wrap">
                <table class="data-table" id="admission-table">
                    <thead>
                        <tr>
                            <th scope="col">Student</th>
                            <th scope="col">Strand</th>
                            <th scope="col">Section</th>
                            <th scope="col">Phone number</th>
                            <th scope="col">Documents</th>
                            <th scope="col">State</th>
                            <th scope="col"><span class="sr-only">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PageRows)
                        {
                            var r = row;
                            <tr data-lrn="@r.Lrn">
                                <td class="who">
                                    <strong>@r.FullName</strong>
                                    <span class="sub mono">@r.Lrn</span>
                                </td>
                                <td data-col="strand">@(r.Strand is { Length: > 0 } strand ? strand : "—")</td>
                                <td data-col="section">@(r.Section is { Length: > 0 } section ? section : "—")</td>
                                <td data-col="phone" class="mono">@(string.IsNullOrWhiteSpace(r.Phone) ? "—" : r.Phone)</td>
                                <td data-col="documents">
                                    <span class="doc-meter" title="@($"{r.DocumentsReceived} of {AdmissionDocumentKinds.All.Count} kinds of documents")">
                                        <span class="bar"><i style="width: @(r.DocumentsReceived * 100 / AdmissionDocumentKinds.All.Count)%"></i></span>
                                        <span class="meter-text">@r.DocumentsReceived / @AdmissionDocumentKinds.All.Count@(r.OtherDocuments > 0 ? $" +{r.OtherDocuments}" : "")</span>
                                    </span>
                                </td>
                                <td><Badge Tone="@(r.Enrolled ? Tone.Success : Tone.Info)">@(r.Enrolled ? "Enrolled" : "Recorded")</Badge></td>
                                <td>
                                    <div class="col-actions">
                                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="eye" Title="@($"View the information of {r.FullName}")" OnClick="() => OpenViewAsync(r)">View student info</Button>
                                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" OnClick="() => OpenEditAsync(r.Id)">Edit</Button>
                                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="folder-open" OnClick="() => OpenDocumentsAsync(r)">Documents</Button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (rows.Count > PageSize)
            {
                <Pager Page="pageNo" Total="rows.Count" PageSize="PageSize" Unit="students" OnPrevious="PreviousPage" OnNext="NextPage" />
            }
        }
    </Card>
}

@* Record and Edit: two columns, the student at the left and the parents and the guardian at the right. *@
<Modal Open="form is not null" Title="@(form?.Id is null ? $"Record a Grade {Grade} student" : "Edit the record")" Large="true" Wide="true" OnClose="CloseForm">
    @if (form is not null)
    {
        <FormErrors Errors="errors" />
        <div class="two-cols">
            <section class="col" aria-label="The student">
                <h3 class="part"><Icon Name="user" Size="16" /> The student</h3>
                <Field For="a-lrn" Label="LRN" Required="true" Hint="12 digits."><input id="a-lrn" type="text" inputmode="numeric" maxlength="12" data-digits autocomplete="off" @bind="form.Lrn" /></Field>
                <div class="pair">
                    <Field For="a-first" Label="First name" Required="true"><input id="a-first" type="text" maxlength="100" data-letters class="cap" autocomplete="off" @bind="form.FirstName" /></Field>
                    <Field For="a-middle" Label="Middle name"><input id="a-middle" type="text" maxlength="100" data-letters class="cap" autocomplete="off" @bind="form.MiddleName" /></Field>
                </div>
                <div class="pair">
                    <Field For="a-last" Label="Last name" Required="true"><input id="a-last" type="text" maxlength="100" data-letters class="cap" autocomplete="off" @bind="form.LastName" /></Field>
                    <Field For="a-ext" Label="Name extension">
                        <SelectOther Id="a-ext" AriaLabel="Name extension" Choices="PhilippineAddresses.SuffixChoices()" Placeholder="None" OtherPlaceholder="Type it" MaxLength="10" Letters="false" @bind-Value="ExtText" />
                    </Field>
                </div>
                <div class="pair">
                    <Field For="a-sex" Label="Sex">
                        <select id="a-sex" @bind="sexText">
                            <option value="">—</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="PreferNotToSay">Prefer not to say</option>
                        </select>
                    </Field>
                    <Field For="a-phone" Label="Phone number" Hint="Optional. Digits only."><input id="a-phone" type="tel" inputmode="numeric" data-digits maxlength="12" autocomplete="off" @bind="form.PhoneNumber" /></Field>
                </div>
                <div class="pair">
                    <Field For="a-track" Label="Track" Hint="The track the student wants.">
                        <select id="a-track" value="@(form.TrackId?.ToString() ?? "")" @onchange="TrackChosen">
                            <option value="">Not chosen yet</option>
                            @foreach (var t in tracks)
                            {
                                <option value="@t.Id" selected="@(form.TrackId == t.Id)">@t.Code</option>
                            }
                        </select>
                    </Field>
                    <Field For="a-strand" Label="Strand" Hint="The strands of the track.">
                        <select id="a-strand" @bind="strandText">
                            <option value="">Not chosen yet</option>
                            @foreach (var group in StrandChoices.GroupBy(s => s.TrackCode))
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var s in group)
                                    {
                                        <option value="@s.Id">@s.Code</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </Field>
                </div>
                <Field For="a-email" Label="Email address" Hint="Optional."><input id="a-email" type="email" maxlength="150" autocomplete="off" @bind="form.Email" /></Field>
                <Field For="a-school" Label="Previous school" Hint="Schools of Albay. Not in the list? Choose Add school.">
                    <AddableSelect Id="a-school" AriaLabel="Previous school" Choices="schools" Placeholder="Choose the school" AddLabel="Add school" AddPlaceholder="Name of the school" @bind-Value="SchoolText" Add="AddSchoolAsync" />
                </Field>
                <AddressFields IdPrefix="a-addr" Label="Address" Parts="form.Address" Cities="cities" AddCity="AddCityAsync" />
            </section>

            <section class="col" aria-label="Parents and guardian">
                <h3 class="part"><Icon Name="users" Size="16" /> Parents and guardian <small>(at least one)</small></h3>
                <div class="pair">
                    <Field For="a-father" Label="Father's name"><input id="a-father" type="text" maxlength="150" data-letters class="cap" autocomplete="off" @bind="form.FatherName" /></Field>
                    <Field For="a-father-phone" Label="Father's phone"><input id="a-father-phone" type="tel" data-digits maxlength="12" autocomplete="off" @bind="form.FatherPhone" /></Field>
                </div>
                <div class="pair">
                    <Field For="a-father-job" Label="Father's occupation"><input id="a-father-job" type="text" maxlength="100" autocomplete="off" @bind="form.FatherOccupation" /></Field>
                    <Field For="a-father-email" Label="Father's email"><input id="a-father-email" type="email" maxlength="150" autocomplete="off" @bind="form.FatherEmail" /></Field>
                </div>
                <div class="pair">
                    <Field For="a-mother" Label="Mother's name"><input id="a-mother" type="text" maxlength="150" data-letters class="cap" autocomplete="off" @bind="form.MotherName" /></Field>
                    <Field For="a-mother-phone" Label="Mother's phone"><input id="a-mother-phone" type="tel" data-digits maxlength="12" autocomplete="off" @bind="form.MotherPhone" /></Field>
                </div>
                <div class="pair">
                    <Field For="a-mother-job" Label="Mother's occupation"><input id="a-mother-job" type="text" maxlength="100" autocomplete="off" @bind="form.MotherOccupation" /></Field>
                    <Field For="a-mother-email" Label="Mother's email"><input id="a-mother-email" type="email" maxlength="150" autocomplete="off" @bind="form.MotherEmail" /></Field>
                </div>
                <AddressFields IdPrefix="a-parents" Label="Parents' address" Parts="form.ParentsAddress" Cities="cities" AddCity="AddCityAsync" />
                <div class="pair">
                    <Field For="a-guardian" Label="Guardian's name"><input id="a-guardian" type="text" maxlength="150" data-letters class="cap" autocomplete="off" @bind="form.GuardianName" /></Field>
                    <Field For="a-relationship" Label="Relationship">
                        <SelectOther Id="a-relationship" AriaLabel="Relationship" Choices="AdmissionService.Relationships" Placeholder="Choose" OtherPlaceholder="Type the relationship" MaxLength="50" @bind-Value="RelationshipText" />
                    </Field>
                </div>
                <div class="pair">
                    <Field For="a-guardian-phone" Label="Guardian's phone"><input id="a-guardian-phone" type="tel" data-digits maxlength="12" autocomplete="off" @bind="form.GuardianPhone" /></Field>
                    <Field For="a-guardian-job" Label="Guardian's occupation"><input id="a-guardian-job" type="text" maxlength="100" autocomplete="off" @bind="form.GuardianOccupation" /></Field>
                </div>
                <Field For="a-guardian-email" Label="Guardian's email"><input id="a-guardian-email" type="email" maxlength="150" autocomplete="off" @bind="form.GuardianEmail" /></Field>
                <AddressFields IdPrefix="a-guardian-addr" Label="Guardian's address" Parts="form.GuardianAddress" Cities="cities" AddCity="AddCityAsync" />
            </section>
        </div>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseForm">Cancel</Button>
            <Button IconName="circle-check" Disabled="busy" OnClick="SaveAsync">@(busy ? "Saving…" : "Save")</Button>
        </div>
    }
</Modal>

@* View student info: the same two columns, only to read. *@
<Modal Open="viewing is not null" Title="@($"Student info · {viewingRow?.FullName}")" Large="true" Wide="true" OnClose="CloseView">
    @if (viewing is not null && viewingRow is not null)
    {
        <div class="two-cols" id="student-info">
            <section class="col" aria-label="The student">
                <h3 class="part"><Icon Name="user" Size="16" /> The student</h3>
                <dl class="info">
                    <div><dt>LRN</dt><dd class="mono">@viewing.Lrn</dd></div>
                    <div><dt>Name</dt><dd>@viewingRow.FullName</dd></div>
                    <div><dt>Sex</dt><dd>@viewing.Sex.Display()</dd></div>
                    <div><dt>Track</dt><dd>@(TrackCodeOf(viewing.TrackId))</dd></div>
                    <div><dt>Strand</dt><dd>@(viewingRow.Strand ?? "—")</dd></div>
                    <div><dt>Section</dt><dd>@(viewingRow.Section ?? "—")</dd></div>
                    <div><dt>Phone number</dt><dd class="mono">@Or(viewing.PhoneNumber)</dd></div>
                    <div><dt>Email address</dt><dd>@Or(viewing.Email)</dd></div>
                    <div><dt>Previous school</dt><dd>@Or(viewing.PreviousSchool)</dd></div>
                    <div><dt>Address</dt><dd>@Or(viewing.Address.Line())</dd></div>
                    <div><dt>State</dt><dd>@(viewingRow.Enrolled ? "Enrolled by the registrar" : "Recorded, waiting to be enrolled")</dd></div>
                </dl>
            </section>
            <section class="col" aria-label="Parents and guardian">
                <h3 class="part"><Icon Name="users" Size="16" /> Parents and guardian</h3>
                <dl class="info">
                    <div><dt>Father</dt><dd>@Or(viewing.FatherName)</dd></div>
                    <div><dt>Father's phone</dt><dd class="mono">@Or(viewing.FatherPhone)</dd></div>
                    <div><dt>Father's occupation</dt><dd>@Or(viewing.FatherOccupation)</dd></div>
                    <div><dt>Father's email</dt><dd>@Or(viewing.FatherEmail)</dd></div>
                    <div><dt>Mother</dt><dd>@Or(viewing.MotherName)</dd></div>
                    <div><dt>Mother's phone</dt><dd class="mono">@Or(viewing.MotherPhone)</dd></div>
                    <div><dt>Mother's occupation</dt><dd>@Or(viewing.MotherOccupation)</dd></div>
                    <div><dt>Mother's email</dt><dd>@Or(viewing.MotherEmail)</dd></div>
                    <div><dt>Parents' address</dt><dd>@Or(viewing.ParentsAddress.Line())</dd></div>
                    <div><dt>Guardian</dt><dd>@Or(viewing.GuardianName)@(string.IsNullOrWhiteSpace(viewing.GuardianRelationship) ? "" : $" ({viewing.GuardianRelationship})")</dd></div>
                    <div><dt>Guardian's phone</dt><dd class="mono">@Or(viewing.GuardianPhone)</dd></div>
                    <div><dt>Guardian's occupation</dt><dd>@Or(viewing.GuardianOccupation)</dd></div>
                    <div><dt>Guardian's email</dt><dd>@Or(viewing.GuardianEmail)</dd></div>
                    <div><dt>Guardian's address</dt><dd>@Or(viewing.GuardianAddress.Line())</dd></div>
                </dl>
            </section>
        </div>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Secondary" IconName="pencil" OnClick="EditFromView">Edit</Button>
            <Button OnClick="CloseView">Close</Button>
        </div>
    }
</Modal>

@* Documents: one line for each kind, no list to choose from. *@
<Modal Open="docsOf is not null" Title="@($"Documents · {docsOf?.FullName}")" Large="true" OnClose="CloseDocuments">
    @if (docsOf is not null)
    {
        <p class="dialog-text">Each kind of document has its line. <strong>Add document</strong> keeps a picture or a PDF of it (a picture or a PDF counts as a document), and <strong>Edit</strong> says that the paper is in hand, changes the photo or takes it away. <strong>View document</strong> shows the photo in a box.</p>
        <AdmissionDocuments RecordId="docsOf.Id" CanEdit="true" OnChanged="RefreshAsync" />
        <div class="modal-actions"><Button OnClick="CloseDocuments">Close</Button></div>
    }
</Modal>

@code {
    [Parameter] public int Grade { get; set; }

    private int userId;
    private bool allowed;
    private IReadOnlyList<AdmissionRow> all = [];
    private IReadOnlyList<AdmissionRow> rows = [];
    private int pageNo = 1;
    /// <summary>Round 48: a grade level has hundreds of students; the table draws 25 lines at a time (the page was slow with all of them).</summary>
    private const int PageSize = 25;
    private IReadOnlyList<AdmissionStrand> strands = [];
    private IReadOnlyList<AdmissionTrack> tracks = [];
    private IReadOnlyList<string> schools = [];
    private IReadOnlyList<string> cities = [];
    private string searchText = "";
    private string stateFilter = "";
    private string strandFilter = "";
    private AdmissionInput? form;
    private AdmissionInput? viewing;
    private AdmissionRow? viewingRow;
    private string sexText { get => form?.Sex?.ToString() ?? ""; set { if (form is not null) { form.Sex = Enum.TryParse<Sex>(value, out var s) ? s : null; } } }
    private string strandText { get => form?.StrandId?.ToString() ?? ""; set { if (form is not null) { form.StrandId = int.TryParse(value, out var s) ? s : null; if (form.StrandId is { } id && strands.FirstOrDefault(x => x.Id == id) is { } picked) { form.TrackId = picked.TrackId; } } } }
    private List<string> errors = [];
    private string? message;
    private bool messageIsError;
    private int messageStamp;
    private bool busy;
    private AdmissionRow? docsOf;

    protected override async Task OnParametersSetAsync()
    {
        userId = (await Me.GetAsync())?.UserId ?? 0;
        allowed = Grade is 11 or 12 && (await Admission.GradesOfAsync(userId)).Contains((byte)Grade);
        if (allowed)
        {
            strands = await Admission.ListStrandsAsync();
            tracks = await Admission.ListTracksAsync();
            schools = await Admission.GetOptionsAsync(AdmissionOptionKinds.School);
            cities = await Admission.GetOptionsAsync(AdmissionOptionKinds.City);
            await ReloadAsync();
        }
    }

    /// <summary>The strands of the track that was chosen (all of them while no track is chosen).</summary>
    private IEnumerable<AdmissionStrand> StrandChoices => form?.TrackId is { } trackId ? strands.Where(s => s.TrackId == trackId) : strands;

    private string ExtText { get => form?.NameExtension ?? ""; set { if (form is not null) { form.NameExtension = string.IsNullOrWhiteSpace(value) ? null : value; } } }

    private string SchoolText { get => form?.PreviousSchool ?? ""; set { if (form is not null) { form.PreviousSchool = string.IsNullOrWhiteSpace(value) ? null : value; } } }

    private string RelationshipText { get => form?.GuardianRelationship ?? ""; set { if (form is not null) { form.GuardianRelationship = string.IsNullOrWhiteSpace(value) ? null : value; } } }

    private string TrackCodeOf(int? trackId) => tracks.FirstOrDefault(t => t.Id == trackId)?.Code ?? "—";

    /// <summary>A track was chosen: the strand goes away when it is not one of the track.</summary>
    private void TrackChosen(ChangeEventArgs e)
    {
        if (form is null) { return; }
        form.TrackId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        if (form.TrackId is { } trackId && form.StrandId is { } strandId && strands.FirstOrDefault(s => s.Id == strandId)?.TrackId != trackId) { form.StrandId = null; }
    }

    private async Task<(bool Ok, string Text)> AddSchoolAsync(string name)
    {
        var result = await Admission.AddOptionAsync(userId, AdmissionOptionKinds.School, name);
        if (!result.Succeeded) { return (false, string.Join(" ", result.Errors)); }
        schools = await Admission.GetOptionsAsync(AdmissionOptionKinds.School);
        return (true, schools.FirstOrDefault(x => string.Equals(x, NameCase.Title(name.Trim()), StringComparison.OrdinalIgnoreCase)) ?? name.Trim());
    }

    private async Task<(bool Ok, string Text)> AddCityAsync(string name)
    {
        var result = await Admission.AddOptionAsync(userId, AdmissionOptionKinds.City, name);
        if (!result.Succeeded) { return (false, string.Join(" ", result.Errors)); }
        cities = await Admission.GetOptionsAsync(AdmissionOptionKinds.City);
        return (true, cities.FirstOrDefault(x => string.Equals(x, NameCase.Title(name.Trim()), StringComparison.OrdinalIgnoreCase)) ?? name.Trim());
    }

    private IEnumerable<string> StrandCodes => all.Select(r => r.Strand).Where(c => !string.IsNullOrEmpty(c)).Select(c => c!).Distinct().Order();

    private static string Or(string? text) => string.IsNullOrWhiteSpace(text) ? "—" : text;

    private void Say(string? text, bool error = false) { message = text; messageIsError = error; messageStamp++; }

    /// <summary>Every recorded student of the grade level (the tiles count them), then the ones that match the search and the filters.</summary>
    private async Task ReloadAsync()
    {
        all = await Admission.ListAsync(userId, (byte)Grade, null);
        Filter();
        pageNo = Math.Min(pageNo, Math.Max(1, (int)Math.Ceiling(rows.Count / (double)PageSize)));
    }

    private IEnumerable<AdmissionRow> PageRows => rows.Skip((pageNo - 1) * PageSize).Take(PageSize);

    private void PreviousPage() => pageNo = Math.Max(1, pageNo - 1);

    private void NextPage() => pageNo = Math.Min(Math.Max(1, (int)Math.Ceiling(rows.Count / (double)PageSize)), pageNo + 1);

    /// <summary>A new search or filter starts at the first page; saving or closing a box keeps the page.</summary>
    private Task SearchAsync()
    {
        pageNo = 1;
        Filter();
        return Task.CompletedTask;
    }

    private void Filter()
    {
        var words = (searchText ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        rows = [.. all.Where(r =>
            words.All(w => r.FullName.Contains(w, StringComparison.OrdinalIgnoreCase) || r.Lrn.Contains(w))
            && (stateFilter == "" || (stateFilter == "enrolled") == r.Enrolled)
            && (strandFilter == "" || r.Strand == strandFilter))];
    }

    private async Task ApplyFilter() => await SearchAsync();

    private async Task RefreshAsync() => await ReloadAsync();

    private void OpenNew() { errors = []; form = new AdmissionInput(); }

    private async Task OpenEditAsync(int id) { errors = []; form = await Admission.GetForEditAsync(userId, id); }

    private void CloseForm() => form = null;

    private async Task OpenViewAsync(AdmissionRow row)
    {
        viewingRow = row;
        viewing = await Admission.GetForEditAsync(userId, row.Id);
    }

    private void CloseView() { viewing = null; viewingRow = null; }

    private async Task EditFromView()
    {
        if (viewingRow is null) { return; }
        var id = viewingRow.Id;
        CloseView();
        await OpenEditAsync(id);
    }

    private async Task SaveAsync()
    {
        if (busy || form is null) { return; }
        busy = true;
        try
        {
            var result = await Admission.SaveAsync(userId, (byte)Grade, form);
            if (!result.Succeeded) { errors = [.. result.Errors]; return; }
            var savedLrn = form.Lrn?.Trim();
            form = null;
            Say(result.Message);
            await ReloadAsync();
            // the list is in pages of 25: show the page where the student that was just saved is
            var at = savedLrn is null ? -1 : rows.ToList().FindIndex(r => r.Lrn == savedLrn);
            if (at >= 0) { pageNo = at / PageSize + 1; }
        }
        finally { busy = false; }
    }

    private void OpenDocumentsAsync(AdmissionRow row)
    {
        errors = [];
        docsOf = row;
    }

    private void CloseDocuments() { docsOf = null; _ = ReloadAsync(); }
}
