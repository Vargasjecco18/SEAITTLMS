@page "/student/subjects"
@attribute [Authorize(Roles = AppRoles.Student)]
@using System.Globalization
@inject CurrentUser Me
@inject TeachingService Teaching
@inject TimeProvider Clock

<PageTitle>Courses · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Courses" IconName="book-open" />

<PageWithAside Show="calendar,upnext">@Body</PageWithAside>


@code {
    // The cards and the list both share the page with the widgets at the right (calendar, due dates); a wide list scrolls sideways inside its own box.
    private RenderFragment Body => @<text>

@if (cards is null)
{
    <p class="muted">Loading…</p>
}
else if (cards.Count == 0)
{
    <Card>
        <EmptyState IconName="book-open" Title="No courses yet">
            <p>Your courses appear here once the registrar has enrolled you.</p>
        </EmptyState>
    </Card>
}
else
{
    <div class="bar">
        @* The chips and the switch are plain links: the page opens again with the choice in its address. *@
        <nav class="chips" aria-label="Show the courses that are">
            <a class="chip @(filter is null ? "on" : "")" href="@Url(null, view)">All <span class="n">@cards.Count</span></a>
            <a class="chip @(filter == "enrolled" ? "on" : "")" href="@Url("enrolled", view)">Enrolled <span class="n">@cards.Count(c => !c.IsCompleted)</span></a>
            <a class="chip @(filter == "completed" ? "on" : "")" href="@Url("completed", view)">Completed <span class="n">@cards.Count(c => c.IsCompleted)</span></a>
        </nav>

        <nav class="views" aria-label="View">
            <a class="view @(view == "cards" ? "on" : "")" href="@Url(filter, "cards")" title="Cards" aria-label="Cards"><Icon Name="layout-grid" Size="18" /></a>
            <a class="view @(view == "list" ? "on" : "")" href="@Url(filter, "list")" title="List" aria-label="List"><Icon Name="list" Size="18" /></a>
        </nav>
    </div>

    @if (shown.Count == 0)
    {
        <Card>
            <EmptyState IconName="search-x" Title="@(filter == "completed" ? "No completed courses yet" : "No courses you are enrolled in right now")">
                <p>@(filter == "completed" ? "A course is completed when its term is over." : "")</p>
                <ButtonLink Href="student/subjects" Variant="ButtonVariant.Secondary">Show all courses</ButtonLink>
            </EmptyState>
        </Card>
    }
    else if (view == "list")
    {
        <Card>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Course</th>
                            <th scope="col" class="col-more">Teacher</th>
                            <th scope="col">Status</th>
                            <th scope="col">Modules</th>
                            <th scope="col">Assignments</th>
                            <th scope="col">Progress</th>
                            <th scope="col">Next due</th>
                            <th scope="col" class="col-more">Grade</th>
                            <th scope="col" class="col-more">Attendance</th>
                            <th scope="col" class="col-actions"><span class="sr-only">Open</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var card in shown)
                        {
                            <tr>
                                <td>
                                    <span class="name">@card.SubjectName</span>
                                    <span class="sub">@card.TermName@(card.Meets is null ? "" : " · " + card.Meets)</span>
                                </td>
                                <td class="col-more">
                                    @(card.TeacherName ?? "—")
                                    <span class="sub">@card.SectionLabel</span>
                                </td>
                                <td><Badge Tone="@(card.IsCompleted ? Tone.Neutral : Tone.Success)">@(card.IsCompleted ? "Completed" : "Enrolled")</Badge></td>
                                <td>
                                    @if (card.AssignmentId is null)
                                    {
                                        <span class="muted">No teacher yet</span>
                                    }
                                    else
                                    {
                                        <span>@card.ModulesVisible @(card.ModulesVisible == 1 ? "module" : "modules")</span>
                                        @if (card.ModulesUnopened > 0) { <Badge Tone="Tone.Warning">@card.ModulesUnopened new</Badge> }
                                    }
                                </td>
                                <td>
                                    @if (card.AssignmentId is not { } workId)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else if (card.Activities + card.Quizzes + card.TaskPerformances == 0)
                                    {
                                        <span class="muted">No assignments yet</span>
                                    }
                                    else
                                    {
                                        @if (card.ItemsOpen > 0)
                                        {
                                            @* The number is a button: it opens the assignments, quizzes and task performances still to do, each one a link. *@
                                            <CourseWorkButton AssignmentId="workId" CourseName="@card.SubjectName" Text="@($"{card.ItemsOpen} to do")" Student="true" />
                                        }
                                        else
                                        {
                                            <Badge Tone="Tone.Success">All done</Badge>
                                        }
                                        <span class="sub" title="@WorkTitle(card)">@WorkSummary(card)</span>
                                    }
                                </td>
                                <td class="progress-cell">
                                    @if (card.ProgressPercent is { } percent)
                                    {
                                        <ProgressBar Percent="percent" Title="@card.ProgressText" />
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (card.NextDueUtc is { } due)
                                    {
                                        <Badge Tone="@(due < now.UtcDateTime ? Tone.Danger : Tone.Neutral)">@PhilippineTime.DueText(due, now)</Badge>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td class="col-more">
                                    @if (card.AveragePercent is { } avg)
                                    {
                                        <Badge Tone="@(avg >= 75 ? Tone.Success : avg >= 70 ? Tone.Warning : Tone.Danger)">@avg.ToString("0.#")%</Badge>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td class="col-more">
                                    @if (card.AttendancePercent is { } att)
                                    {
                                        <Badge Tone="@(att >= 90 ? Tone.Success : att >= 80 ? Tone.Warning : Tone.Danger)">@att.ToString("0.#")%</Badge>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td class="col-actions">
                                    @if (card.AssignmentId is { } id)
                                    {
                                        <ButtonLink Href="@($"student/subjects/{id}")" IconName="arrow-right" IconAfter="true" Small="true">Open</ButtonLink>
                                    }
                                    else
                                    {
                                        <span class="muted">Not open yet</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    }
    else
    {
        <div class="grid">
            @foreach (var card in shown)
            {
                <SubjectCard Name="@card.SubjectName" Cover="@StrandArt.For(card.StrandCode, card.StrandName)" CoverLabel="@card.StrandName"
                             Teacher="@(card.TeacherName ?? "No teacher yet")" Section="@card.SectionLabel" Meets="@card.Meets"
                             Modules="@(card.AssignmentId is null ? null : card.ModulesVisible)" Activities="card.Activities" Quizzes="card.Quizzes" TaskPerformances="card.TaskPerformances"
                             Href="@(card.AssignmentId is { } id ? $"student/subjects/{id}" : null)" OffText="No teacher yet"
                             Progress="card.ProgressPercent" ProgressText="@card.ProgressText" />
            }
        </div>
    }
}
</text>;

    [SupplyParameterFromQuery(Name = "show")] private string? Show { get; set; }

    [SupplyParameterFromQuery(Name = "view")] private string? ViewText { get; set; }

    private IReadOnlyList<StudentSubjectCard>? cards;
    private List<StudentSubjectCard> shown = [];
    private string view = "cards";
    private string? filter;
    private DateTimeOffset now;

    protected override async Task OnParametersSetAsync()
    {
        view = ViewText == "list" ? "list" : "cards";
        filter = Show is "enrolled" or "completed" ? Show : null;
        now = PhilippineTime.Now(Clock);
        var studentId = await Me.GetStudentIdAsync();
        cards = studentId is { } id ? await Teaching.GetStudentCardsAsync(id) : [];
        shown = cards.Where(c => filter is null || (filter == "completed") == c.IsCompleted).ToList();
    }

    /// <summary>"2 A · 1 Q · 1 TP": the assignments, quizzes and task performances (the short names the gradebook uses); the full words are in the title.</summary>
    private static string WorkSummary(StudentSubjectCard card)
    {
        var parts = new List<string>();
        if (card.Activities > 0) { parts.Add($"{card.Activities} A"); }
        if (card.Quizzes > 0) { parts.Add($"{card.Quizzes} Q"); }
        if (card.TaskPerformances > 0) { parts.Add($"{card.TaskPerformances} TP"); }
        return string.Join(" · ", parts);
    }

    private static string WorkTitle(StudentSubjectCard card)
    {
        var parts = new List<string>();
        if (card.Activities > 0) { parts.Add(card.Activities == 1 ? "1 assignment" : $"{card.Activities} assignments"); }
        if (card.Quizzes > 0) { parts.Add(card.Quizzes == 1 ? "1 quiz" : $"{card.Quizzes} quizzes"); }
        if (card.TaskPerformances > 0) { parts.Add(card.TaskPerformances == 1 ? "1 task performance" : $"{card.TaskPerformances} task performances"); }
        return string.Join(" · ", parts);
    }

    private static string Url(string? show, string view)
    {
        var parts = new List<string>();
        if (show is not null)
        {
            parts.Add("show=" + show);
        }

        if (view == "list")
        {
            parts.Add("view=list");
        }

        return "student/subjects" + (parts.Count == 0 ? "" : "?" + string.Join('&', parts));
    }
}
