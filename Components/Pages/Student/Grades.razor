@page "/student/grades"
@attribute [Authorize(Roles = AppRoles.Student)]
@inject CurrentUser Me
@inject GradeService GradeBook
@inject AttendanceService AttendanceBook

<PageTitle>Grades and progress · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Grades and progress" IconName="trending-up" />

@if (summary is null)
{
    <p class="muted">Loading…</p>
}
else
{
    @if (summary.Subjects.Count == 0)
    {
        <Card>
            <EmptyState IconName="book-open" Title="No courses yet">
                <p>Your grades appear here once you are enrolled and your teachers give scores.</p>
            </EmptyState>
        </Card>
    }
    else
    {
        var failing = summary.Subjects.Where(s => s.Percent < GradeRules.PassingPercent).ToList();
        var risk = summary.Subjects.Where(s => s.Percent >= GradeRules.PassingPercent && s.Percent < GradeRules.AtRiskUntil).ToList();

        @if (failing.Count > 0)
        {
            <div class="alert danger" role="alert">
                <Icon Name="triangle-alert" Size="20" />
                <span>
                    <strong>Your grade is below @GradeRules.PassingPercent.ToString("0") in @string.Join(", ", failing.Select(f => f.SubjectName)).</strong>
                    Talk to your teacher or the guidance counselor, and hand in the work you have missed.
                </span>
            </div>
        }
        else if (risk.Count > 0)
        {
            <div class="alert warn" role="status">
                <Icon Name="info" Size="20" />
                <span>Your grade in <strong>@string.Join(", ", risk.Select(f => f.SubjectName))</strong> is close to failing. A few good scores will lift it.</span>
            </div>
        }

        <div class="stats">
            <StatCard Label="Overall average" Text="@(summary.Overall is { } avg ? $"{avg:0.#}%" : "—")" IconName="trending-up" Accent="@(summary.Overall is null ? AccentColor.Slate : summary.Overall < GradeRules.PassingPercent ? AccentColor.Rose : AccentColor.Green)"
                      Hint="@(summary.Overall is { } o ? GradeRules.Descriptor(o) : "No graded assignments yet")" />
            <StatCard Label="Attendance" Text="@(attendance?.Percent is { } rate ? $"{rate:0.#}%" : "—")" IconName="calendar-check"
                      Accent="@(attendance?.Percent is { } r2 && r2 < AttendanceService.LowAttendancePercent ? AccentColor.Rose : AccentColor.Blue)"
                      Hint="@(attendance is { Days: > 0 } ? $"{attendance.Present} present · {attendance.Late} late · {attendance.Absent} absent" : "Nothing marked yet")" />
            <StatCard Label="@($"Below {GradeRules.PassingPercent:0}")" Value="@summary.FailingSubjects" IconName="triangle-alert" Accent="@(summary.FailingSubjects > 0 ? AccentColor.Rose : AccentColor.Green)" Hint="@(summary.FailingSubjects == 0 ? "None, well done" : "Needs attention")" />
            <StatCard Label="Graded works" Value="@summary.GradedCount" IconName="clipboard-check" Accent="AccentColor.Violet" Hint="@($"{summary.Subjects.Sum(s => s.Missing)} missing")" />
        </div>

        @* Each subject is closed at first. A click on its name shows its progress and its graded work (a plain details box, no script needed). *@
        <div class="subjects">
            @foreach (var s in summary.Subjects)
            {
                var att = attendance?.Subjects.FirstOrDefault(a => a.AssignmentId == s.AssignmentId);
                <details class="subject" aria-label="@s.SubjectName">
                    <summary>
                        <span class="chev" aria-hidden="true"><Icon Name="chevron-right" Size="18" /></span>
                        <span class="subject-title">
                            <span class="subject-name">@s.SubjectName</span>
                            <span class="sub">@s.TeacherName · @s.SectionLabel</span>
                        </span>
                    </summary>

                    <div class="subject-body">
                        <div class="progress-row">
                            <span class="progress-label">Progress</span>
                            <span class="track" role="progressbar" aria-label="@($"{s.SubjectName} grade")" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)(s.Percent ?? 0))">
                                <i class="@Band(s.Percent)" style="width: @Width(s.Percent)%"></i>
                                <b class="mark" style="left: @GradeRules.PassingPercent.ToString("0")%" title="Passing: @GradeRules.PassingPercent.ToString("0")"></b>
                            </span>
                            <span class="grade">
                                <span class="grade-number">@(s.Percent is { } p ? $"{p:0.#}%" : "—")</span>
                                @if (s.Percent is { } pp)
                                {
                                    <Badge Tone="@GradeRules.ToneOf(pp)">@GradeRules.Descriptor(pp)</Badge>
                                }
                                else
                                {
                                    <Badge>No grade yet</Badge>
                                }
                            </span>
                        </div>
                        @if (s.FinalGrade is { } finalGrade)
                        {
                            <p class="final-grade">Final grade from your teacher: <strong>@finalGrade.ToString("0.##")</strong> <Badge Tone="@GradeRules.ToneOf(finalGrade)">@GradeRules.Descriptor(finalGrade)</Badge></p>
                        }
                        <p class="note"><span class="mark-sample"></span> The line is the passing grade, @GradeRules.PassingPercent.ToString("0").</p>

                        <h3 class="work-title">Assignments</h3>
                        <p class="counts">
                            @if (att is { Percent: { } attRate })
                            {
                                <span class="att @(attRate < AttendanceService.LowAttendancePercent ? "low" : "")" title="@($"{att.Present} present, {att.Late} late, {att.Absent} absent")">Attendance @attRate.ToString("0.#")% · </span>
                            }
                            @s.GradedCount of @s.TotalItems @(s.TotalItems == 1 ? "assignment" : "assignments") graded
                            @if (s.OpenItems > 0) { <span> · @s.OpenItems to do</span> }
                            @if (s.Missing > 0) { <span class="missing"> · @s.Missing missing</span> }
                        </p>

                        @if (s.Graded.Count > 0)
                        {
                            <div class="table-wrap">
                                <table class="table">
                                    <thead><tr><th scope="col">Assignment</th><th scope="col">Score</th><th scope="col">Percent</th><th scope="col" class="col-more">Graded</th></tr></thead>
                                    <tbody>
                                        @foreach (var g in s.Graded)
                                        {
                                            <tr>
                                                <td><a href="student/items/@g.ItemId">@g.Title</a> <span class="kind">@ItemKinds.Display(g.Kind)</span>@if (g.IsLate) { <Badge Tone="Tone.Warning">Late</Badge> }</td>
                                                <td>@g.Score.ToString("0.##") / @g.Max.ToString("0.##")</td>
                                                <td><Badge Tone="@GradeRules.ToneOf(g.Percent)">@g.Percent.ToString("0.#")%</Badge></td>
                                                <td class="col-more">@(g.GradedAtUtc is { } at ? PhilippineTime.FormatDate(at) : "")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="muted">No assignment is graded yet.</p>
                        }

                        <p class="open-course"><a href="student/subjects/@s.AssignmentId">Open the course <Icon Name="arrow-right" Size="14" /></a></p>
                    </div>
                </details>
            }
        </div>
    }
}

@code {
    private StudentGradeSummary? summary;
    private StudentAttendance? attendance;

    protected override async Task OnInitializedAsync()
    {
        var studentId = await Me.GetStudentIdAsync();
        summary = studentId is { } id ? await GradeBook.GetStudentSummaryAsync(id) : new StudentGradeSummary([], null, 0, 0);
        if (studentId is { } sid)
        {
            attendance = await AttendanceBook.GetStudentAsync(sid);
        }
    }

    private static string Band(decimal? percent) => percent switch
    {
        null => "none",
        < GradeRules.PassingPercent => "bad",
        < GradeRules.AtRiskUntil => "warn",
        _ => "good",
    };

    private static string Width(decimal? percent) => Math.Clamp(percent ?? 0, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
