@page "/student/subjects/{AssignmentId:int}"
@attribute [Authorize(Roles = AppRoles.Student)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ModuleService Modules
@inject GradeService GradeBook
@inject AttendanceService AttendanceBook
@inject TimeProvider Clock

<PageTitle>@(subject?.SubjectName ?? "Course") · SEAITT Legazpi LMS</PageTitle>

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (subject is null)
{
    <Card>
        <EmptyState IconName="book-open" Title="Course not found" IsPage="true">
            <p>This is not one of your courses.</p>
            <ButtonLink Href="student/subjects" Variant="ButtonVariant.Secondary">Back to your courses</ButtonLink>
        </EmptyState>
    </Card>
}
else
{
    <PageHeader Title="@subject.SubjectName" IconName="book-open">
        <ButtonLink Href="student/subjects" Variant="ButtonVariant.Ghost" IconName="chevron-left">All courses</ButtonLink>
    </PageHeader>

    @if (shownKind is { } listKind)
    {
        var listNow = PhilippineTime.Now(Clock);
        var listed = subject.Modules.SelectMany(m => m.Items.Where(i => i.Kind == listKind)).ToList();
        <CourseLayout Student="subject" Selected="@CourseMenu.KeyOf(listKind)">
        <Card Title="@CourseMenuBuilder.Label(listKind)" IconName="@SubjectStyle.KindIcon(listKind)">
            @if (listed.Count == 0)
            {
                <p class="muted">No @CourseMenuBuilder.Label(listKind).ToLowerInvariant() in this course yet.</p>
            }
            else
            {
                <ul class="kind-list">
                    @foreach (var item in listed)
                    {
                        var hidden = ItemKinds.IsQuizLike(item.Kind) && item.Status == SubmissionStatus.Graded && item.Score is null;
                        var (text, tone) = SubjectStyle.StudentStatus(item.Status, item.IsLate, item.IsOverdue, ItemKinds.IsQuizLike(item.Kind), hidden, item.LateDecision);
                        <li>
                            <a class="kind-link" href="student/items/@item.Id">
                                <span class="kind-text">
                                    <span class="kind-title">@item.Title</span>
                                    <span class="kind-meta">
                                        <span><Icon Name="layers" Size="14" /> @item.ModuleTitle</span>
                                        @if (item.DueAtUtc is { } due)
                                        {
                                            <span class="@(item.IsOverdue ? "late" : "")"><Icon Name="calendar-clock" Size="14" /> @PhilippineTime.DueText(due, listNow)</span>
                                        }
                                        else
                                        {
                                            <span>No due date</span>
                                        }
                                        <span>@item.MaxScore.ToString("0.##") points</span>
                                    </span>
                                </span>
                                <span class="kind-end">
                                    @if (item.Score is { } listScore)
                                    {
                                        <span class="kind-score">@listScore.ToString("0.##") / @item.MaxScore.ToString("0.##")</span>
                                    }
                                    <Badge Tone="@tone">@text</Badge>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </Card>
        </CourseLayout>
    }
    else
    {
        @* The first page of the course counts as being in the course: the Courses link of the menu comes back here (wwwroot/app.js). *@
        <span data-last-course="@($"student/subjects/{AssignmentId}")" hidden></span>
        @* What was on the card of the course in the list is here, after the click: the attendance, the work and the grade of this course. *@
        <div class="kpis">
            <StatCard Label="Attendance" Text="@(attendanceOf?.Percent is { } rate ? $"{rate:0.#}%" : "—")" IconName="calendar-check"
                      Accent="@(attendanceOf?.Percent is { } r2 && r2 < AttendanceService.LowAttendancePercent ? AccentColor.Rose : AccentColor.Blue)"
                      Hint="@(attendanceOf is { Percent: not null } ? $"{attendanceOf.Present} present · {attendanceOf.Late} late · {attendanceOf.Absent} absent" : "Nothing marked yet")" />
            <StatCard Label="Graded" Text="@(gradeOf is null ? "—" : $"{gradeOf.GradedCount} of {gradeOf.TotalItems}")" IconName="clipboard-check" Accent="AccentColor.Violet"
                      Hint="works checked by the teacher" />
            <StatCard Label="To do" Text="@(gradeOf is null ? "—" : gradeOf.OpenItems.ToString())" IconName="clipboard-list" Accent="@(gradeOf?.Missing > 0 ? AccentColor.Amber : AccentColor.Green)"
                      Hint="@(gradeOf is null ? "" : gradeOf.Missing > 0 ? $"{gradeOf.Missing} missing" : "Nothing missing")" />
            <StatCard Label="Grade" Text="@(gradeOf?.Percent is { } pct ? $"{pct:0.#}%" : "—")" IconName="trending-up"
                      Accent="@(gradeOf?.Percent is { } p2 && p2 < GradeRules.PassingPercent ? AccentColor.Rose : AccentColor.Green)"
                      Hint="@(gradeOf?.Percent is { } p3 ? GradeRules.Descriptor(p3) : "No grade yet")" />
        </div>

        @* The first page of a course: only the syllabus and the modules, one line each. A click on the line opens it. *@
        @if (subject.Modules.All(m => m.IsExamSet))
        {
            <Card>
                <EmptyState IconName="layers" Title="No modules yet">
                    <p>Your teacher has not posted any module for this course. You will be told when one appears.</p>
                </EmptyState>
            </Card>
        }
        else
        {
            <Card Title="Syllabus and modules" IconName="layers">
                <ul class="course-rows">
                    @for (var n = 0; n < subject.Modules.Count; n++)
                    {
                        var module = subject.Modules[n];
                        if (module.IsExamSet)
                        {
                            continue;
                        }

                        var number = subject.Modules.Take(n + 1).Count(m => !m.IsSyllabus && !m.IsExamSet);
                        <li>
                            <a class="course-row" href="@($"student/modules/{module.Id}")" aria-label="@(module.IsSyllabus ? $"Open the syllabus" : $"Open {module.Title}")">
                                <span class="row-number">@if (module.IsSyllabus) { <Icon Name="book-marked" Size="18" /> } else { @number }</span>
                                <span class="row-text">
                                    <span class="row-title">@module.Title @if (module.IsSyllabus) { <Badge Tone="Tone.Info">Syllabus</Badge> } @if (!module.Opened) { <Badge Tone="Tone.Warning">New</Badge> }</span>
                                    <span class="row-meta">@ModuleSummary(module)</span>
                                </span>
                                <span class="row-go @(module.Opened ? "again" : "")">
                                    <Icon Name="book-open" Size="16" />
                                    @(module.IsSyllabus ? (module.Opened ? "Read again" : "Read syllabus") : module.Opened ? "Read again" : "Read lesson")
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </Card>
        }
    }
}

@code {
    [Parameter] public int AssignmentId { get; set; }

    /// <summary>The tab of the second menu: assignments, quizzes or tasks (the modules when empty).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private string? shownKind => CourseMenu.KindOfKey(Tab);

    /// <summary>"2 assignments · 1 quiz" under the title of a module.</summary>
    private static string ModuleSummary(StudentModule module)
    {
        if (module.IsSyllabus)
        {
            return "How the course is taught and graded";
        }

        var parts = new List<string>();
        foreach (var kind in ItemKinds.Listed)
        {
            var count = module.Items.Count(i => i.Kind == kind);
            if (count > 0)
            {
                parts.Add($"{count} {(count == 1 ? ItemKinds.Display(kind).ToLowerInvariant() : ItemKinds.Plural(kind).ToLowerInvariant())}");
            }
        }

        return parts.Count == 0 ? "Lesson only" : string.Join(" · ", parts);
    }

    private bool loaded;
    private StudentSubject? subject;
    private SubjectGrade? gradeOf;
    private SubjectAttendance? attendanceOf;

    protected override async Task OnParametersSetAsync()
    {
        var studentId = await Me.GetStudentIdAsync();
        subject = studentId is { } id ? await Modules.GetStudentSubjectAsync(id, AssignmentId) : null;
        if (studentId is { } sid && subject is not null)
        {
            gradeOf = (await GradeBook.GetStudentSummaryAsync(sid)).Subjects.FirstOrDefault(g => g.AssignmentId == AssignmentId);
            attendanceOf = (await AttendanceBook.GetStudentAsync(sid)).Subjects.FirstOrDefault(a => a.AssignmentId == AssignmentId);
        }

        loaded = true;
    }
}
