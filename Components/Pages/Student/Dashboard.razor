@page "/student"
@attribute [Authorize(Roles = AppRoles.Student)]
@inject CurrentUser Me
@inject DashboardService Dashboards
@inject AchievementService Achievements
@inject EvaluationService EvaluationTasks
@inject TeachingService Teaching
@inject TimeProvider Clock

<PageTitle>Dashboard · SEAITT e-LMS</PageTitle>
<AutoRefresh />

@{
    var now = PhilippineTime.Now(Clock);
}

<PageHeader Title="@($"{PhilippineTime.Greeting(now)}, {data?.FirstName ?? "student"}")" IconName="layout-dashboard" />

@if (data is null)
{
    <Card>
        <EmptyState IconName="graduation-cap" Title="No student record found">
            <p>Your account is not linked to a student record. Please ask the registrar.</p>
        </EmptyState>
    </Card>
}
else
{
    @* At the right, in this order: the calendar, the assignments and due dates, the announcements, the students who are online and the teachers who are online. *@
    <PageWithAside Show="calendar,activities,announcements,online,onlineteachers">
        <div class="stats">
            <StatCard Label="Work to do" Value="@data.OpenWork" IconName="clipboard-list" Accent="AccentColor.Blue" Hint="@(data.DueThisWeek == 0 ? "Nothing due this week" : $"{data.DueThisWeek} due this week")" />
            <StatCard Label="Overdue" Value="@data.Overdue" IconName="triangle-alert" Accent="@(data.Overdue > 0 ? AccentColor.Rose : AccentColor.Green)" Hint="@(data.Overdue == 0 ? "You are on track" : "Hand these in soon")" />
            <StatCard Label="New modules" Value="@data.UnopenedModules" IconName="layers" Accent="AccentColor.Amber" Hint="Not opened yet" />
            <StatCard Label="Average grade" Text="@(data.Overall is { } avg ? $"{avg:0.#}%" : "—")" IconName="trending-up" Accent="@(data.Failing > 0 ? AccentColor.Rose : AccentColor.Violet)"
                      Hint="@(data.Failing > 0 ? $"{data.Failing} course{(data.Failing == 1 ? "" : "s")} below 70" : data.Overall is null ? "No grades yet" : "Keep it up")" Href="student/grades" />
        </div>

        <div class="cards">
            @if (pendingEvaluations.Count > 0)
            {
                <div class="wide">
                <Card Title="Teacher evaluation" IconName="clipboard-check">
                    <p class="eval-note">The school asks you to rate your teachers. Your answers are anonymous.</p>
                    <ul class="work">
                        @foreach (var e in pendingEvaluations.Take(5))
                        {
                            <li>
                                <a class="work-link" href="student/evaluations/@e.EvaluationId/@e.AssignmentId">
                                    <span class="work-icon"><Icon Name="clipboard-pen" Size="18" /></span>
                                    <span class="work-text">
                                        <span class="work-title">@e.TeacherName</span>
                                        <span class="work-sub">@e.SubjectName · @e.Title</span>
                                    </span>
                                    <span class="work-end"><Badge Tone="Tone.Warning">@PhilippineTime.DueText(e.DueAtUtc, now)</Badge></span>
                                </a>
                            </li>
                        }
                    </ul>
                    <p class="more"><a href="student/evaluations">Open Teacher evaluation (@pendingEvaluations.Count to answer) <Icon Name="arrow-right" Size="14" /></a></p>
                </Card>
                </div>
            }

            <div class="wide">
            <Card Title="Progress" IconName="gauge">
                @if (courses.Count == 0)
                {
                    <EmptyState IconName="book-open" Title="No courses yet">
                        <p>Your progress in each course appears here.</p>
                    </EmptyState>
                }
                else
                {
                    <ul class="course-progress">
                        @foreach (var c in courses)
                        {
                            <li>
                                <a href="@(c.AssignmentId is { } aid ? $"student/subjects/{aid}" : "student/subjects")">
                                    <span class="progress-name">@c.SubjectName</span>
                                    @if (c.ProgressPercent is { } pct)
                                    {
                                        <ProgressBar Percent="pct" Title="@c.ProgressText" />
                                    }
                                    else
                                    {
                                        <span class="progress-none">Nothing posted yet</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
            </Card>
            </div>

            <Card Title="Modules not opened yet" IconName="layers">
                @if (data.Unopened.Count == 0)
                {
                    <EmptyState IconName="book-open" Title="Nothing new">
                        <p>You have opened every module your teachers posted.</p>
                    </EmptyState>
                }
                else
                {
                    <ul class="modules">
                        @foreach (var m in data.Unopened)
                        {
                            <li>
                                <a href="student/modules/@m.ModuleId">
                                    <span class="module-title">@m.Title</span>
                                    <span class="module-sub">@m.SubjectName · posted @PhilippineTime.FormatDate(m.PostedAtUtc)</span>
                                </a>
                                <Badge Tone="Tone.Warning">New</Badge>
                            </li>
                        }
                    </ul>
                }
            </Card>

            <Card Title="Recent grades" IconName="award">
                @if (data.Recent.Count == 0)
                {
                    <EmptyState IconName="award" Title="No grades yet">
                        <p>Scores your teachers give appear here.</p>
                    </EmptyState>
                }
                else
                {
                    <ul class="grades">
                        @foreach (var g in data.Recent)
                        {
                            var percent = g.Max <= 0 ? 0 : g.Score / g.Max * 100;
                            <li>
                                <a href="student/items/@g.ItemId"><span class="grade-title">@g.Title</span><span class="grade-sub">@g.SubjectName</span></a>
                                <Badge Tone="@GradeRules.ToneOf(percent)">@g.Score.ToString("0.##") / @g.Max.ToString("0.##")</Badge>
                            </li>
                        }
                    </ul>
                }

                <p class="more"><a href="student/grades">Open Grades and progress <Icon Name="arrow-right" Size="14" /></a></p>
            </Card>

            <div class="wide">
                <AchievementsWidget Items="achievements" />
            </div>
        </div>
    </PageWithAside>
}

@code {
    private StudentDashboard? data;
    private IReadOnlyList<Achievement> achievements = [];
    private IReadOnlyList<StudentEvaluationTask> pendingEvaluations = [];
    private IReadOnlyList<StudentSubjectCard> courses = [];

    protected override async Task OnInitializedAsync()
    {
        var studentId = await Me.GetStudentIdAsync();
        data = studentId is { } id ? await Dashboards.GetStudentAsync(id) : null;
        if (studentId is { } sid)
        {
            achievements = await Achievements.GetAsync(sid);
            courses = (await Teaching.GetStudentCardsAsync(sid)).Where(c => !c.IsCompleted).ToList();
            pendingEvaluations = (await EvaluationTasks.GetStudentTasksAsync(sid)).Where(e => !e.Answered && !e.Closed).ToList();
        }
    }
}
