@page "/provider/library"
@attribute [Authorize(Roles = AppRoles.AcademicProvider)]
@inject MaterialService Library

<PageTitle>Course library · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Course library"
            IconName="folder-open" />

@* The library looks like the Courses of a teacher or a student: a card for each course (or a list), with the picture of its strand. Where the chips All, Enrolled and Completed are there, here are the
   search box and the lists Track, Grade level, Strand and Course. Only the courses of the term that is going on are shown, because that is what the provider prepares. Every choice is in the address
   (a plain form), so the back button works. *@
@if (cards is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="bar">
        <form method="get" action="provider/library" class="filters" role="search" data-autosubmit>
            <input type="hidden" name="view" value="@view" />
            <SearchField Id="lib-search" Name="q" Static="true" Value="@Q" Placeholder="Search a course by name or code" AriaLabel="Search the courses" ClearHref="@Url(null, null, null, null)" />
            <select id="f-track" name="track" aria-label="Track">
                <option value="">All tracks</option>
                @foreach (var t in Tracks)
                {
                    <option value="@t.Id" selected="@(TrackId == t.Id)">@t.Code</option>
                }
            </select>
            <select id="f-grade" name="grade" aria-label="Grade level">
                <option value="">All grade levels</option>
                <option value="11" selected="@(Grade == 11)">Grade 11</option>
                <option value="12" selected="@(Grade == 12)">Grade 12</option>
            </select>
            <select id="f-strand" name="strand" aria-label="Strand">
                <option value="">All strands</option>
                @foreach (var st in Strands)
                {
                    <option value="@st.Id" selected="@(StrandId == st.Id)">@st.Code</option>
                }
            </select>
            <select id="f-course" name="course" aria-label="Course">
                <option value="">All courses</option>
                @foreach (var c in CourseChoices)
                {
                    <option value="@c.SubjectId" selected="@(CourseId == c.SubjectId)">@c.Name</option>
                }
            </select>
            <noscript><button type="submit" class="button secondary small">Show</button></noscript>
        </form>

        @* At the right of the lists (All courses ...): post the summative exam of the courses that are listed to their students. It is its own live island and sits outside the form, so its boxes do not send the filters. *@
        <div class="post-exams">
            <PostExamsButton Courses="PostCourses" />
        </div>

        <nav class="views" aria-label="View">
            <a class="view @(view == "cards" ? "on" : "")" href="@Url(Q, null, null, null, "cards", true)" title="Cards" aria-label="Cards"><Icon Name="layout-grid" Size="18" /></a>
            <a class="view @(view == "list" ? "on" : "")" href="@Url(Q, null, null, null, "list", true)" title="List" aria-label="List"><Icon Name="list" Size="18" /></a>
        </nav>
    </div>

    @if (shown.Count == 0)
    {
        <Card>
            <EmptyState IconName="search-x" Title="No course matches">
                <p>Try another name or code, or choose All in the lists. Courses are made in the academic setup, and the library shows the courses of the term that is going on.</p>
                <ButtonLink Href="provider/library" Variant="ButtonVariant.Secondary">Show all courses</ButtonLink>
            </EmptyState>
        </Card>
    }
    else if (view == "list")
    {
        @* The list: a table with a line for each course (its track, strand, grade level and term, and what the library has for it), and an Open button. *@
        <Card>
            <div class="table-wrap">
                <table class="lib-table" aria-label="Courses of the library">
                    <thead>
                        <tr>
                            <th scope="col">Course</th>
                            <th scope="col">Track · Strand</th>
                            <th scope="col">Grade</th>
                            <th scope="col">Term</th>
                            <th scope="col">Syllabus</th>
                            <th scope="col" class="num">Handouts</th>
                            <th scope="col" class="num">Exam</th>
                            <th scope="col" class="num">Sections</th>
                            <th scope="col" class="c-open"><span class="sr-only">Open the course</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in shown)
                        {
                            <tr data-course="@c.Code">
                                <td class="c-course">
                                    <strong>@c.Name</strong>
                                    <small>@c.Code</small>
                                </td>
                                <td>@c.TrackCode · @c.StrandCode</td>
                                <td>Grade @c.GradeLevel</td>
                                <td>@SchoolCalendar.TermName(c.TermNumber)</td>
                                <td>
                                    @if (c.HasSyllabus)
                                    {
                                        <Badge Tone="Tone.Success">Ready</Badge>
                                    }
                                    else
                                    {
                                        <Badge Tone="Tone.Warning">None yet</Badge>
                                    }
                                </td>
                                <td class="num">@c.Modules</td>
                                <td class="num">@(c.Exams == 0 ? "—" : c.Exams)</td>
                                <td class="num">@Plural(c.Teachers, "section")</td>
                                <td class="c-open"><ButtonLink Href="@($"provider/library/{c.SubjectId}?track={c.TrackId}&strand={c.StrandId}&term={c.TermNumber}")" Small="true" Variant="ButtonVariant.Secondary" IconName="arrow-right">Open</ButtonLink></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Card>
    }
    else
    {
        <div class="grid">
            @foreach (var c in shown)
            {
                <SubjectCard Name="@c.Name" Cover="@StrandArt.For(c.StrandCode, c.StrandName)" CoverLabel="@c.StrandName"
                             Section="@($"{c.TrackCode} · {c.StrandCode} · Grade {c.GradeLevel}")" Term="@SchoolCalendar.TermName(c.TermNumber)"
                             Href="@($"provider/library/{c.SubjectId}?track={c.TrackId}&strand={c.StrandId}&term={c.TermNumber}")" OffText="Open">
                    <span class="card-facts" data-course="@c.Code">
                        @if (c.HasSyllabus)
                        {
                            <Badge Tone="Tone.Success">Syllabus ready</Badge>
                        }
                        else
                        {
                            <Badge Tone="Tone.Warning">No syllabus yet</Badge>
                        }
                        <span class="fact">@Plural(c.Modules, "handout")</span>
                        <span class="fact">@Plural(c.Exams, "summative exam")</span>
                    </span>
                </SubjectCard>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "track")] private string? TrackText { get; set; }
    [SupplyParameterFromQuery(Name = "grade")] private string? GradeText { get; set; }
    [SupplyParameterFromQuery(Name = "strand")] private string? StrandText { get; set; }
    [SupplyParameterFromQuery(Name = "course")] private string? CourseText { get; set; }
    [SupplyParameterFromQuery(Name = "view")] private string? ViewText { get; set; }

    [CascadingParameter] private HttpContext? Http { get; set; }

    private IReadOnlyList<LibraryCard>? cards;
    private List<LibraryCard> shown = [];
    private string view = "cards";

    private int? TrackId => ParseNumber(TrackText);
    private int? Grade => ParseNumber(GradeText) is 11 or 12 ? ParseNumber(GradeText) : null;
    private int? CourseId => ParseNumber(CourseText);

    // A strand that does not belong to the track that is chosen is not a choice any more (the lists follow each other: track, then strand, then course).
    private int? StrandId => ParseNumber(StrandText) is { } id && Strands.Any(s => s.Id == id) ? id : null;

    private static int? ParseNumber(string? text) => int.TryParse(text, out var number) && number > 0 ? number : null;

    private IEnumerable<(int Id, string Code)> Tracks => cards!.Select(c => (c.TrackId, c.TrackCode)).Distinct().OrderBy(t => t.TrackCode);

    private IEnumerable<(int Id, string Code)> Strands => cards!.Where(c => TrackId is null || c.TrackId == TrackId).Select(c => (c.StrandId, c.StrandCode)).Distinct().OrderBy(s => s.StrandCode);

    private IEnumerable<(int SubjectId, string Name)> CourseChoices => cards!
        .Where(c => (TrackId is null || c.TrackId == TrackId) && (Grade is null || c.GradeLevel == Grade) && (StrandId is null || c.StrandId == StrandId))
        .Select(c => (c.SubjectId, c.Name)).Distinct().OrderBy(c => c.Name);

    private IReadOnlyList<MaterialCourseRow> ListRows => [.. shown.Select(c => new MaterialCourseRow(c.SubjectId, c.Code, c.Name, c.HasSyllabus, c.Modules, c.Exams, c.Teachers, c.Sent, $"{c.TrackCode} · {c.StrandCode} · Grade {c.GradeLevel} · {SchoolCalendar.TermName(c.TermNumber)}"))];

    protected override async Task OnParametersSetAsync()
    {
        view = ViewPreference.Resolve(Http, "library", ViewText, "cards", "list");
        cards = await Library.ListLibraryCardsAsync();
        var words = (Q ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        shown = [.. cards.Where(c =>
            (TrackId is null || c.TrackId == TrackId) && (Grade is null || c.GradeLevel == Grade) && (StrandId is null || c.StrandId == StrandId) && (CourseId is null || c.SubjectId == CourseId)
            && words.All(w => c.Name.Contains(w, StringComparison.OrdinalIgnoreCase) || c.Code.Contains(w, StringComparison.OrdinalIgnoreCase)))];
    }

    /// <summary>The courses the button of the list posts: the ones that are listed now (the lists above decide), with the page of each to go to when it has no summative exam.</summary>
    private List<PostExamsButton.PostCourse> PostCourses => [.. shown.Select(c => new PostExamsButton.PostCourse
    {
        SubjectId = c.SubjectId, Name = c.Name, Exams = c.Exams,
        Href = $"provider/library/{c.SubjectId}?track={c.TrackId}&strand={c.StrandId}&term={c.TermNumber}",
    })];

    private string? PathOf(int? _) => null;

    private static string Plural(int n, string one) => n == 1 ? $"1 {one}" : $"{n:N0} {one}s";

    private string Url(string? q, int? track, int? grade, int? strand, string? viewName = null, bool explicitView = false)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(q)) { parts.Add("q=" + Uri.EscapeDataString(q)); }
        if (TrackId is { } t) { parts.Add("track=" + t); }
        if (Grade is { } g) { parts.Add("grade=" + g); }
        if (StrandId is { } s) { parts.Add("strand=" + s); }
        if (CourseId is { } c) { parts.Add("course=" + c); }
        var chosen = viewName ?? view;
        if (chosen == "list" || explicitView) { parts.Add("view=" + chosen); }
        return "provider/library" + (parts.Count == 0 ? "" : "?" + string.Join('&', parts));
    }
}
