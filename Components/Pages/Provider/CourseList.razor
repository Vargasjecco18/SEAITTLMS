@page "/provider/library"
@attribute [Authorize(Roles = AppRoles.AcademicProvider)]
@inject MaterialService Library

<PageTitle>Course library · SEAITT e-LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Course library"
            IconName="folder-open" />

@* The library is read from the top: the tracks, then (a click on a track) its strands, then (a click on a strand) the courses of the strand,
   and a course opens its library. Searching a course by name or code shows the matching courses of the whole school at once.
   Every step is a plain link (/provider/library, ?track=..., ?track=...&strand=...), so the back button works. *@
<Card Class="search-card">
    <form method="get" action="provider/library" class="filter-bar" role="search">
        <SearchField Id="lib-search" Name="q" Static="true" Value="@Q" Placeholder="Search a course by name or code" AriaLabel="Search the courses" ClearHref="provider/library" />
    </form>
</Card>

<div class="level">
    @if (searching)
    {
        <nav class="crumbs" aria-label="Where you are"><a href="provider/library">Course library</a><span aria-hidden="true">›</span><span>Search “@Q”</span></nav>
        <CourseTable Courses="courses" ShowPlacement="false" />
    }
    else if (tracks is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (strand is not null)
    {
        <nav class="crumbs" aria-label="Where you are">
            <a href="provider/library">Course library</a><span aria-hidden="true">›</span>
            <a href="@($"provider/library?track={track!.TrackId}")">@track.Name</a><span aria-hidden="true">›</span>
            <span>@strand.Name</span>
        </nav>
        <h2 class="level-title">@strand.Name <span class="code">@strand.Code</span></h2>
        <CourseTable Courses="courses" ShowPlacement="true" />
    }
    else if (track is not null)
    {
        <nav class="crumbs" aria-label="Where you are">
            <a href="provider/library">Course library</a><span aria-hidden="true">›</span><span>@track.Name</span>
        </nav>
        <h2 class="level-title">@track.Name <span class="code">@track.Code</span></h2>
        <p class="level-hint">Choose a course (strand) to see its subjects.</p>
        @if (track.Strands.Count == 0)
        {
            <EmptyState IconName="layers" Title="No course in this track yet"><p>Strands are made in the academic setup.</p></EmptyState>
        }
        else
        {
            <div class="rows">
                @for (var i = 0; i < track.Strands.Count; i++)
                {
                    var s = track.Strands[i];
                    <LibraryRow Href="@($"provider/library?track={track.TrackId}&strand={s.StrandId}")" Title="@s.Name" Code="@s.Code" Number="@(i + 1)"
                                Description="@($"{Plural(s.Courses, "subject")} · {s.WithSyllabus} with a syllabus")" ActionText="Open course" />
                }
            </div>
        }
    }
    else
    {
        <h2 class="level-title">Tracks</h2>
        <p class="level-hint">Choose a track to see its courses (strands).</p>
        @if (tracks.Count == 0)
        {
            <EmptyState IconName="layers" Title="No track yet"><p>Tracks are made in the academic setup.</p></EmptyState>
        }
        else
        {
            <div class="rows">
                @for (var i = 0; i < tracks.Count; i++)
                {
                    var t = tracks[i];
                    <LibraryRow Href="@($"provider/library?track={t.TrackId}")" Title="@t.Name" Code="@t.Code" Number="@(i + 1)"
                                Description="@($"{Plural(t.Strands.Count, "course")} · {Plural(t.Courses, "subject")} · {t.WithSyllabus} with a syllabus")" ActionText="Open track" />
                }
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "track")] private int? TrackId { get; set; }
    [SupplyParameterFromQuery(Name = "strand")] private int? StrandId { get; set; }

    private IReadOnlyList<LibraryTrack>? tracks;
    private IReadOnlyList<MaterialCourseRow> courses = [];
    private LibraryTrack? track;
    private LibraryStrand? strand;
    private bool searching;

    private static string Plural(int n, string one) => n == 1 ? $"1 {one}" : $"{n:N0} {one}s";

    protected override async Task OnParametersSetAsync()
    {
        searching = !string.IsNullOrWhiteSpace(Q);
        tracks = await Library.ListTracksAsync();
        track = TrackId is { } t ? tracks.FirstOrDefault(x => x.TrackId == t) : null;
        strand = track is not null && StrandId is { } sid ? track.Strands.FirstOrDefault(x => x.StrandId == sid) : null;
        courses = searching
            ? await Library.ListCoursesAsync(Q)
            : strand is not null ? await Library.ListCoursesAsync(null, default, strand.StrandId) : [];
    }
}
