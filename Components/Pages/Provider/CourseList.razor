@page "/provider/library"
@attribute [Authorize(Roles = AppRoles.AcademicProvider)]
@inject MaterialService Library

<PageTitle>Course library · SEAITT e-LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Course library"
            Subtitle="Prepare the syllabus, modules, activities, quizzes and task performances of a course, then send them to the teachers who teach it."
            IconName="folder-open" />

<Card>
    <form class="toolbar" role="search" method="get" action="provider/library">
        <div class="search-box">
            <Icon Name="search" Size="18" Class="search-icon" />
            <input type="search" name="q" aria-label="Search courses" placeholder="Course name or code" autocomplete="off" value="@Q" />
        </div>
        <Button Type="submit" Variant="ButtonVariant.Secondary">Search</Button>
        @if (!string.IsNullOrWhiteSpace(Q))
        {
            <ButtonLink Href="provider/library" Variant="ButtonVariant.Ghost">Clear</ButtonLink>
        }
        <span class="result-count">@(courses is null ? "" : courses.Count == 1 ? "1 course" : $"{courses.Count:N0} courses")</span>
    </form>

    @if (courses is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (courses.Count == 0)
    {
        <EmptyState IconName="search-x" Title="No course matches">
            <p>Try another name or code. Courses are made in the academic setup.</p>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Course</th>
                        <th scope="col">Syllabus</th>
                        <th scope="col">Modules</th>
                        <th scope="col" class="col-more">Activities</th>
                        <th scope="col" class="col-more">Quizzes</th>
                        <th scope="col" class="col-more">Task performances</th>
                        <th scope="col" class="col-more">Teachers</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in courses)
                    {
                        <tr>
                            <td>
                                <a class="name" href="provider/library/@course.SubjectId">@course.Name</a>
                                <span class="sub">@course.Code</span>
                            </td>
                            <td>
                                @if (course.HasSyllabus)
                                {
                                    <Badge Tone="Tone.Success">Ready</Badge>
                                }
                                else
                                {
                                    <span class="muted">None yet</span>
                                }
                            </td>
                            <td>@course.Modules</td>
                            <td class="col-more">@course.Activities</td>
                            <td class="col-more">@course.Quizzes</td>
                            <td class="col-more">@course.TaskPerformances</td>
                            <td class="col-more">
                                @if (course.Teachers == 0)
                                {
                                    <span class="muted">None this year</span>
                                }
                                else
                                {
                                    <span>@course.Teachers @(course.Teachers == 1 ? "course" : "courses")</span>
                                    @if (course.Sent > 0)
                                    {
                                        <span class="sub">@course.Sent sent so far</span>
                                    }
                                }
                            </td>
                            <td class="col-actions">
                                <ButtonLink Href="@($"provider/library/{course.SubjectId}")" IconName="arrow-right" IconAfter="true" Small="true">Open</ButtonLink>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }

    private IReadOnlyList<MaterialCourseRow>? courses;

    protected override async Task OnParametersSetAsync() => courses = await Library.ListCoursesAsync(Q);
}
