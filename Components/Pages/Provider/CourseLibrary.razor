        ? (editingModuleId is null ? "Add syllabus" : "Edit syllabus")
        : (editingModuleId is null ? "Add module" : "Edit module");

    // ---- the workbook of modules of the course

    private bool modulesExcelOpen;

    private IReadOnlyList<ModuleExportRow> ModulesExisting =>
        [.. (course?.Modules ?? []).Where(m => !m.IsSyllabus).Select(m => new ModuleExportRow(m.Title, m.Description, m.Body, m.LinkUrl, [.. FilesOf(moduleAttachments, m.Id).Select(f => f.Name)]))];

