    {
        moduleForm = null;
        modulesExcelOpen = true;
    }

    private void CloseModulesExcel() => modulesExcelOpen = false;

    private async Task<ItemImportSummary> ImportModulesAsync(IReadOnlyList<ModuleToSave> list)
    {
        var created = 0;
        var problems = new List<string>();
        foreach (var m in list)
        {
            var saved = await Library.SaveModuleAsync(userId, SubjectId, null, m.Input, false);
            if (!saved.Succeeded || saved.Id is not { } id)
            {
                problems.Add($"Row {m.Row} ({m.Input.Title}): {string.Join(" ", saved.Errors)}");
                continue;
            }

            created++;
            openModules.Add(id);
            if (m.Files.Count > 0)
            {
                var added = await Files.AddAsync(userId, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, id), m.Files);
                if (!added.Succeeded)
                {
                    problems.Add($"Row {m.Row} ({m.Input.Title}): it was added, but not its files: {string.Join(" ", added.Errors)}");
                }
            }
        }

        await LoadAsync();
        return new ItemImportSummary(created, problems);
    }

    protected override async Task OnParametersSetAsync()
    {
        userId = (await Me.GetAsync())?.UserId ?? 0;
        await LoadAsync();
        loaded = true;
    }

    private async Task LoadAsync()
    {
        course = await Library.GetCourseAsync(SubjectId);
        var modules = course?.Modules ?? [];
        moduleAttachments = await Files.ListForAsync(AttachmentOwnerKind.MaterialModule, modules.Select(m => m.Id).ToList());
        itemAttachments = await Files.ListForAsync(AttachmentOwnerKind.MaterialItem, (course?.Exams ?? []).Select(e => e.Id).ToList());
        questionsByExam = await Library.GetExamQuestionsAsync((course?.Exams ?? []).Select(e => e.Id).ToList());
    }

    private static IReadOnlyList<AttachmentRow> FilesOf(IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> map, int? id) =>
        id is { } key && map.TryGetValue(key, out var list) ? list : [];

    private void ToggleModule(int id)
    {
        if (!openModules.Remove(id))
        {
            openModules.Add(id);
        }
    }

    /// <summary>Saves the files chosen in a form for the syllabus, module or item with this number: the new ones are attached, the ones taken off are removed.</summary>
    private async Task<List<string>> ApplyFilesAsync(AttachmentPicker? picker, AttachmentOwner owner, bool slides = false)
    {
        var problems = new List<string>();
        if (picker is null)
        {
            return problems;
        }

        var removed = await Files.RemoveAsync(userId, [.. picker.Removed]);
        if (!removed.Succeeded)
        {
            problems.AddRange(removed.Errors);
        }

        var added = await Files.AddAsync(userId, owner, picker.Pending, slides: slides);
        if (!added.Succeeded)
        {
            problems.AddRange(added.Errors);
        }

        return problems;
    }

    /// <summary>"14 Dec 2026, 8:00 AM to 10:00 AM" for the schedule of an exam.</summary>
    private static string ScheduleText(MaterialExamView exam) =>
        exam.OpensAtUtc is { } opens && exam.DueAtUtc is { } closes
            ? $"{PhilippineTime.FormatDateTime(opens)} to {PhilippineTime.FormatDateTime(closes)}"
            : "No schedule";

    private void Say(ServiceResult result, string? fallback = null)
    {
        messageIsError = !result.Succeeded;
        message = result.Succeeded ? result.Message ?? fallback : string.Join(" ", result.Errors);
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- modules and the syllabus

    private void OpenNewModule()
    {
        formErrors = [];
        editingModuleId = null;
        editingIsSyllabus = false;
        moduleFormKey++;
        moduleForm = new ModuleInput();
    }

    private void OpenNewSyllabus()
    {
        formErrors = [];
        editingModuleId = null;
        editingIsSyllabus = true;
        moduleFormKey++;
        moduleForm = new ModuleInput { Title = course is null ? "Syllabus" : $"Syllabus: {course.Name}" };
    }

    private void OpenEditModule(MaterialModuleView module)
    {
        formErrors = [];
        editingModuleId = module.Id;
        editingIsSyllabus = module.IsSyllabus;
        moduleFormKey++;
        moduleForm = new ModuleInput { Title = module.Title, Description = module.Description, Body = module.Body, LinkUrl = module.LinkUrl };
    }

    private void CloseModuleForm() => moduleForm = null;

    private async Task SaveModuleAsync()
    {
        if (moduleForm is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Library.SaveModuleAsync(userId, SubjectId, editingModuleId, moduleForm, editingIsSyllabus);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            var fileProblems = result.Id is { } savedModuleId ? await ApplyFilesAsync(modulePicker, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, savedModuleId)) : [];
            if (result.Id is { } slidesModuleId)
            {
                fileProblems.AddRange(await ApplyFilesAsync(slidesPicker, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, slidesModuleId), slides: true));
            }

            moduleForm = null;
            if (result.Id is { } newModuleId)
            {
                openModules.Add(newModuleId);
            }

            Say(result);
            if (fileProblems.Count > 0)
            {
                messageIsError = true;
                message = $"{result.Message} But the files: {string.Join(" ", fileProblems)}";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- summative exams

    private void OpenNewExam()
    {
        formErrors = [];
        editingExamId = null;
        examFormKey++;
        examQuestions = [];
        examQuestionsChanged = false;
        examForm = new ExamInput();
    }

    private void OpenEditExam(MaterialExamView exam)
    {
        formErrors = [];
        editingExamId = exam.Id;
        examFormKey++;
        examForm = new ExamInput
        {
            Title = exam.Title, Instructions = exam.Instructions, MaxScore = exam.MaxScore,
            OpensText = PhilippineTime.ToInputValue(exam.OpensAtUtc), DueText = PhilippineTime.ToInputValue(exam.DueAtUtc),
            TimeLimitMinutes = exam.TimeLimitMinutes, AntiCheat = exam.AntiCheat, MaxViolations = exam.MaxViolations,
            ShuffleQuestions = exam.ShuffleQuestions, ShuffleOptions = exam.ShuffleOptions, ShowResult = exam.ShowResult,
        };
        examQuestions = [.. questionsByExam.GetValueOrDefault(exam.Id) ?? []];
        examQuestionsChanged = false;
    }

    /// <summary>The questions of the Excel file replace the ones in the box (the exam is worth their total).</summary>
    private void QuestionsImported(IReadOnlyList<QuestionInput> imported)
    {
        examQuestions = [.. imported];
        examQuestionsChanged = true;
        if (examForm is not null)
        {
            examForm.MaxScore = examQuestions.Sum(q => q.Points);
        }
    }

    private void CloseExamForm() => examForm = null;

    private void SetOpens(ChangeEventArgs e) => examForm!.OpensText = e.Value?.ToString() ?? "";

    private void SetCloses(ChangeEventArgs e) => examForm!.DueText = e.Value?.ToString() ?? "";

    private async Task SaveExamAsync()
    {
        if (examForm is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            // The date boxes are written out (not @bind) because their text is converted by PhilippineTime, not by Blazor.
            examForm.OpensAtUtc = PhilippineTime.FromInputValue(examForm.OpensText);
            examForm.DueAtUtc = PhilippineTime.FromInputValue(examForm.DueText);
            examForm.Questions = examQuestionsChanged ? examQuestions : null;
            if (examQuestions.Count > 0)
            {
                examForm.MaxScore = examQuestions.Sum(q => q.Points);
            }

            var result = await Library.SaveExamAsync(userId, SubjectId, editingExamId, examForm);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            var fileProblems = result.Id is { } savedId ? await ApplyFilesAsync(examPicker, new AttachmentOwner(AttachmentOwnerKind.MaterialItem, savedId)) : [];
            examForm = null;
            Say(result);
            if (fileProblems.Count > 0)
            {
                messageIsError = true;
                message = $"{result.Message} But the files: {string.Join(" ", fileProblems)}";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

