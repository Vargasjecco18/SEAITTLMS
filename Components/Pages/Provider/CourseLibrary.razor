@page "/provider/library/{SubjectId:int}"
@attribute [Authorize(Roles = AppRoles.AcademicProvider)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject MaterialService Library
@inject AttachmentService Files
@inject NavigationManager Navigation

<PageTitle>@(course?.Name ?? "Course") · Course library · SEAITT Legazpi LMS</PageTitle>

@if (!loaded)
{
    <p class="muted">Loading…</p>
}
else if (course is null)
{
    <Card>
        <EmptyState IconName="folder-open" Title="Course not found" IsPage="true">
            <p>This course was removed.</p>
            <ButtonLink Href="provider/library" Variant="ButtonVariant.Secondary">Back to the courses</ButtonLink>
        </EmptyState>
    </Card>
}
else
{
    var syllabus = course.Modules.FirstOrDefault(m => m.IsSyllabus);
    var modules = course.Modules.Where(m => !m.IsSyllabus).ToList();

    @* The Course Menu at the left (Syllabus, Modules, Summative exams, each with what is inside) and the menu of the school folded to its icons: the page has the room. *@
    <CourseLayout CustomGroups="LibraryMenu(syllabus, modules)" CustomExtra="NoLinks" CollapseMenu="true">
    <CustomExtraContent>
        @* Instead of "Back to 1st Term": Track, then Strand, then Course, to go to another course. *@
        <LibraryCourseMenu CurrentSubjectId="SubjectId" TrackId="TrackQuery" StrandId="StrandQuery" />
    </CustomExtraContent>
    <ChildContent>
    @* Where the person came from: Course library › Academic › Business and Entrepreneurship › 1st Term. The back button goes to that list, not to all the courses. *@
    <nav class="crumbs" aria-label="Where you are">
        <a href="provider/library">Course library</a>
        @if (backTrack is not null)
        {
            <span aria-hidden="true">›</span><a href="@($"provider/library?track={backTrack.TrackId}")">@backTrack.Name</a>
            @if (backStrand is not null)
            {
                <span aria-hidden="true">›</span><a href="@($"provider/library?track={backTrack.TrackId}&strand={backStrand.StrandId}")">@backStrand.Name</a>
                @if (TermQuery is { } crumbTerm)
                {
                    <span aria-hidden="true">›</span><a href="@BackHref">@SchoolCalendar.TermName(crumbTerm)</a>
                }
            }
        }
        <span aria-hidden="true">›</span><span>@course.Name</span>
    </nav>

    <PageHeader Title="@course.Name" IconName="folder-open">
        <ButtonLink Href="@BackHref" Variant="ButtonVariant.Ghost" IconName="chevron-left">@BackText</ButtonLink>
        @if (syllabus is null)
        {
            <Button Variant="ButtonVariant.Secondary" IconName="book-marked" OnClick="OpenNewSyllabus">Add syllabus</Button>
        }
        @* The buttons of the course in groups, with a bar | between the groups: the handouts, and the summative exam. *@
        <span class="head-group">
            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" OnClick="OpenNewModule">Add handout</Button>
            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="send" Disabled="@(course.Modules.Count == 0)" OnClick="OpenSend">Send to teachers</Button>
        </span>
        <span class="head-group">
            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="clipboard-list" OnClick="OpenNewExam">Add summative exam</Button>
        </span>
    </PageHeader>

    <Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

    <p class="hint-line">
        <Icon Name="send" Size="16" />
        <span><strong>Syllabus</strong> and <strong>handouts</strong> go to the teachers, <strong>hidden from the students</strong> until the teacher posts them. <strong>Summative exams</strong> are posted to the students from the Course library list.</span>
    </p>

    <div class="tiles">
        <div class="tile"><strong>@(syllabus is null ? "No" : "Yes")</strong><span>Syllabus</span></div>
        <div class="tile"><strong>@modules.Count</strong><span>Handouts</span></div>
        <div class="tile"><strong>@course.Exams.Count</strong><span>Summative exams</span></div>
    </div>

    <div class="layout">
        <Card Title="Teachers of this course" IconName="presentation">
            @if (course.Teachers.Count == 0)
            {
                <p class="muted">No teacher has this course this school year yet. The administrator gives courses to teachers (Users Management, Teachers, Courses). You can prepare the materials now and send them later.</p>
            }
            else
            {
                <ul class="teachers">
                    @foreach (var t in course.Teachers)
                    {
                        var got = t.Received.Count;
                        <li>
                            <span class="who"><strong>@t.TeacherName</strong><span>@t.SectionLabel · @t.Students @(t.Students == 1 ? "student" : "students")</span></span>
                            @* Handouts n of m, in a column of its own at the right, so it lines up in every row. (The exams are posted from Post summative exam to students.) *@
                            <span class="got">
                                @if (course.Modules.Count == 0)
                                {
                                    <span class="muted">Nothing to send yet</span>
                                }
                                else
                                {
                                    <Badge Tone="@(got == 0 ? Tone.Neutral : got >= course.Modules.Count ? Tone.Success : Tone.Info)">Handouts @got of @course.Modules.Count</Badge>
                                }
                            </span>
                        </li>
                    }
                </ul>
            }
        </Card>
    </div>

    @if (course.Modules.Count == 0)
    {
        <Card>
            <EmptyState IconName="layers" Title="No syllabus or handout yet">
                <p>Start with the syllabus, then add the handouts. The teachers write the assignments, quizzes and task performances.</p>
                <div class="modal-actions">
                    <Button Variant="ButtonVariant.Secondary" IconName="book-marked" OnClick="OpenNewSyllabus">Add syllabus</Button>
                    <Button IconName="plus" OnClick="OpenNewModule">Add the first handout</Button>
                </div>
            </EmptyState>
        </Card>
    }
    else
    {
        <div class="modules" id="modules">
            @* The syllabus always comes first: when there is none yet, its place is held. *@
            @if (syllabus is null)
            {
                <section class="module syllabus syllabus-missing" aria-label="Syllabus">
                    <header class="module-head">
                        <div class="module-title">
                            <span class="module-number"><Icon Name="book-marked" Size="18" /></span>
                            <div>
                                <h2>Syllabus</h2>
                                <div class="module-state"><Badge Tone="Tone.Warning">Not added yet</Badge></div>
                            </div>
                        </div>
                        <div class="module-actions">
                            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" OnClick="OpenNewSyllabus">Add syllabus</Button>
                        </div>
                    </header>
                    <p class="module-description">The syllabus is sent first, before the handouts.</p>
                </section>
            }

            @foreach (var module in course.Modules.OrderByDescending(m => m.IsSyllabus))
            {
                var number = module.IsSyllabus ? 0 : modules.IndexOf(module) + 1;
                var id = module.Id;
                var moduleFiles = FilesOf(moduleAttachments, id);
                <section class="module @(module.IsSyllabus ? "syllabus" : "library")" id="@(module.IsSyllabus ? "syllabus" : $"module-section-{module.Id}")" aria-label="@(module.IsSyllabus ? "Syllabus" : $"Handout {number}")">
                    @* A click on the row opens the syllabus or the handout in a box: the other handouts at the left, the preview of the files in the center and the upload form at the right. There is no dropdown and no Edit button. *@
                    <header class="module-head">
                        <button type="button" class="module-toggle" data-open-handout="@id" title="@($"Open {module.Title}")" @onclick="() => OpenView(id)">
                            <span class="module-number">@if (module.IsSyllabus) { <Icon Name="book-marked" Size="18" /> } else { @number }</span>
                            <span class="module-heading">
                                <span class="module-name">@module.Title</span>
                                <span class="module-state">
                                    @if (module.IsSyllabus) { <Badge Tone="Tone.Info">Syllabus</Badge> }
                                    <Badge Tone="@(module.SentTo == 0 ? Tone.Neutral : Tone.Success)">@(module.SentTo == 0 ? "Not sent yet" : $"Sent to {module.SentTo} {(module.SentTo == 1 ? "course" : "courses")}")</Badge>
                                    @if (moduleFiles.Count > 0)
                                    {
                                        <span class="count-chip"><Icon Name="paperclip" Size="13" /> @moduleFiles.Count</span>
                                    }
                                </span>
                            </span>
                        </button>
                        <div class="module-actions">
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="trash-2" Title="Delete" OnClick="() => AskDeleteModule(module)" />
                        </div>
                    </header>
                </section>
            }
        </div>
    }

    @* ===== The summative exams of the course: the paper, the highest score and the schedule ===== *@
    <section class="exams" id="exams" aria-labelledby="exams-title">
        <header class="exams-head">
            <h2 id="exams-title"><Icon Name="clipboard-list" Size="20" /> Summative exams <span class="count">@course.Exams.Count</span></h2>
            <span class="exams-actions">
                <Button Small="true" Variant="ButtonVariant.Ghost" IconName="file-spreadsheet" Title="Template, import and export in Excel" OnClick="OpenExamsExcel">Excel</Button>
                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" OnClick="OpenNewExam">Add summative exam</Button>
            </span>
        </header>
        <p class="exams-note">Write the questions here. The exam is posted to the students from the Course library list: <strong>Post summative exam to students</strong>, at the right of the lists. Scores go to the gradebook.</p>
        @if (course.Exams.Count == 0)
        {
            <p class="none">No summative exam yet.</p>
        }
        else
        {
            <ul class="items">
                @foreach (var exam in course.Exams)
                {
                    var examFiles = FilesOf(itemAttachments, exam.Id);
                    <li class="item" id="@($"exam-{exam.Id}")">
                        <div class="item-main">
                            <span class="item-title">@exam.Title</span>
                            <div class="item-meta">
                                <span><Icon Name="calendar-clock" Size="14" /> @ScheduleText(exam)</span>
                                <span>@exam.MaxScore.ToString("0.##") points</span>
                                <span><Icon Name="list-checks" Size="14" /> @(exam.Questions == 0 ? "No questions yet" : exam.Questions == 1 ? "1 question" : $"{exam.Questions} questions")</span>
                                @if (exam.TimeLimitMinutes is { } minutes)
                                {
                                    <span><Icon Name="timer" Size="14" /> @minutes min</span>
                                }
                                @if (exam.AntiCheat)
                                {
                                    <span title="Warns after @exam.MaxViolations leaves of the exam, copies, pastes, prints or screenshots"><Icon Name="shield-check" Size="14" /> Anti-cheat on</span>
                                }
                                <Badge Tone="@(exam.SentTo == 0 ? Tone.Neutral : Tone.Success)">@(exam.SentTo == 0 ? "Not posted yet" : $"Posted to {exam.SentTo} {(exam.SentTo == 1 ? "section" : "sections")}")</Badge>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(exam.Instructions))
                            {
                                <p class="exam-text">@exam.Instructions</p>
                            }
                            <AttachmentList Items="examFiles" Label="@($"Files of {exam.Title}")" />
                        </div>
                        <div class="item-actions">
                            <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" OnClick="() => OpenEditExam(exam)">Edit</Button>
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconOnly="true" IconName="trash-2" Title="Delete" OnClick="() => AskDeleteExam(exam)" />
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
    </ChildContent>
    </CourseLayout>
}

@* ===== Module or syllabus: add or edit ===== *@
<Modal Open="moduleForm is not null" Title="@ModuleModalTitle" OnClose="CloseModuleForm" Wider="true">
    @if (moduleForm is not null)
    {
        <EditForm Model="moduleForm" OnValidSubmit="SaveModuleAsync">
            <FormErrors Errors="formErrors" />
            @if (editingModuleId is null && !editingIsSyllabus)
            {
                <p class="from-excel"><Button Small="true" Variant="ButtonVariant.Secondary" IconName="table" OnClick="OpenModulesExcel">Add many handouts in a sheet</Button> <span class="muted">title, link and files, no Excel needed</span></p>
            }

            <Field For="m-title" Label="Title" Required="true">
                <InputText id="m-title" @bind-Value="moduleForm.Title" maxlength="200" autocomplete="off" />
            </Field>
            <Field For="m-link" Label="Link to a file or a video" Hint="Optional, for example in Google Drive (starts with https://).">
                <InputText id="m-link" @bind-Value="moduleForm.LinkUrl" maxlength="500" autocomplete="off" />
            </Field>
            <AttachmentPicker @ref="slidesPicker" NoSizeLimit="true" @key="@($"slides-{moduleFormKey}")" Slides="true" Title="@(editingIsSyllabus ? "Slides of the syllabus (PowerPoint or PDF)" : "Slides of the handout (PowerPoint or PDF)")" Existing="@(FilesOf(moduleAttachments, editingModuleId).Where(f => f.IsSlides).ToList())" />
            <AttachmentPicker @ref="modulePicker" NoSizeLimit="true" @key="moduleFormKey" Title="@(editingIsSyllabus ? "Files of the syllabus" : "Files of the handout")" Existing="@(FilesOf(moduleAttachments, editingModuleId).Where(f => !f.IsSlides).ToList())" />
            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseModuleForm">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Summative exam: add or edit ===== *@
<Modal Open="examForm is not null" Title="@(editingExamId is null ? "Add summative exam" : "Edit summative exam")" OnClose="CloseExamForm" Large="true">
    @if (examForm is not null)
    {
        <EditForm Model="examForm" OnValidSubmit="SaveExamAsync">
            <FormErrors Errors="formErrors" />
            <Field For="x-title" Label="Title" Required="true" Hint="Like 1st Term summative exam.">
                <InputText id="x-title" @bind-Value="examForm.Title" maxlength="200" autocomplete="off" />
            </Field>
            <Field For="x-text" Label="Instructions" Hint="What the students must know or do.">
                <InputTextArea id="x-text" @bind-Value="examForm.Instructions" rows="4" />
            </Field>

            @* Under the instructions: the questions, then the highest score (the total of the points of the questions), then the settings, and last the days it opens and closes. *@
            <section class="exam-questions" aria-label="Questions of the exam">
                <h3><Icon Name="list-checks" Size="16" /> Questions <span class="count">@examQuestions.Count</span></h3>
                <p class="exams-note">@(examQuestions.Count == 0 ? "No question yet. Write them in the sheet: the type and the right answer are chosen from lists." : $"The exam is worth {examQuestions.Sum(q => q.Points):0.##} points.")</p>
                <Button Variant="ButtonVariant.Secondary" IconName="table" OnClick="OpenQuestionsSheet">@(examQuestions.Count == 0 ? "Add questions" : "Edit the questions")</Button>
            </section>

            <Field For="x-score" Label="Highest score" Required="true" Hint="@(examQuestions.Count == 0 ? "With questions, the highest score is the total of their points." : "The total of the points of the questions.")">
                <InputNumber id="x-score" Value="@(examQuestions.Count > 0 ? examQuestions.Sum(q => q.Points) : examForm.MaxScore)" ValueChanged="@((decimal v) => examForm.MaxScore = v)" ValueExpression="@(() => examForm.MaxScore)" disabled="@(examQuestions.Count > 0)" />
            </Field>

            @* The Summative Exam Settings and when the exam opens and closes are not asked here: they are chosen when the exam is posted (Post summative exam to students). *@
            <p class="exams-note">The settings and the days it opens and closes are chosen when you <strong>post it to the students</strong>.</p>

            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseExamForm">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : "Save")</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Excel: template, import, export of the summative exams of the course ===== *@
<SheetImportDialog Open="examsExcelOpen" Title="Summative exams in Excel"
                   Lead="One row for each exam: its title, instructions, highest score and when it opens and closes. Download the template, fill it in and import it, or export the exams of this course, change them and import again. The files of an exam are added afterwards with Edit."
                   Single="exam was" Plural="exams were" Added="added" RowLabel="Row" PreviewHint="The rows with a problem are left out; the reason is on its line."
                   TemplateName="@ExamSheets.FileName("Template")" Template="ExamSheets.Template"
                   Export="ExamsExportBytes" ExportName="@ExamSheets.FileName(course?.Name ?? "Course")" ExportLabel="Export the exams of this course" ExportCount="@(course?.Exams.Count ?? 0)"
                   Read="ReadExams" OnImport="ImportExamsAsync" OnClose="CloseExamsExcel" />
<QuestionsSheetDialog Open="questionsSheetOpen" ExamTitle="@(string.IsNullOrWhiteSpace(examForm?.Title) ? "Summative exam" : examForm!.Title)" Existing="examQuestions"
                      OnSave="QuestionsSaved" OnClose="CloseQuestionsSheet" />
<ModulesSheetDialog Open="modulesExcelOpen" CourseName="@(course?.Name ?? "")" OnImport="ImportModulesAsync" OnClose="CloseModulesExcel" />
@if (course is not null)
{
    <LibraryHandoutDialog Course="course" OpenId="viewId" UserId="userId" OnClose="CloseView" OnSaved="LoadAsync" />
}

@* ===== Send to teachers (syllabus and handouts) ===== *@
<Modal Open="sending" Title="Send to teachers" OnClose="CloseSend" Large="true">
    @if (sending && course is not null)
    {
        <p class="dialog-text">Each teacher gets their own copy, <strong>hidden from the students</strong> until the teacher posts it. A handout that a teacher's course already got is not sent again.</p>
        <FormErrors Errors="formErrors" />

        <p class="pick-title">What to send</p>
        <button type="button" class="link-button" @onclick="ToggleAllModules">@(sendModules.Count == course.Modules.Count ? "Clear all" : "Select all")</button>
        <ul class="picks">
            @* The syllabus is the first thing on the list (and the first thing the teacher sees in the course). *@
            @if (!course.Modules.Any(m => m.IsSyllabus))
            {
                <li>
                    <div class="pick pick-missing">
                        <Icon Name="book-marked" Size="18" />
                        <span>
                            <strong>Syllabus</strong>
                            <small>Not added yet. Add it and it goes first, before the handouts.</small>
                        </span>
                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="plus" OnClick="AddSyllabusFromSend">Add syllabus</Button>
                    </div>
                </li>
            }
            @foreach (var module in course.Modules.OrderByDescending(m => m.IsSyllabus))
            {
                var id = module.Id;
                <li>
                    <label class="pick">
                        <input type="checkbox" checked="@sendModules.Contains(id)" @onchange="e => TogglePick(sendModules, id, e)" />
                        <span>
                            <strong>@(module.IsSyllabus ? "Syllabus: " : "")@module.Title</strong>
                            <small>@(module.IsSyllabus ? "Syllabus" : "Handout") · sent to @module.SentTo of @course.Teachers.Count</small>
                        </span>
                    </label>
                </li>
            }
        </ul>

        <p class="pick-title">Who gets it</p>
        @if (course.Teachers.Count == 0)
        {
            <p class="muted">No teacher has this course this school year.</p>
        }
        else
        {
            <button type="button" class="link-button" @onclick="ToggleAllTeachers">@(sendTargets.Count == course.Teachers.Count ? "Clear all" : "Select all")</button>
            <ul class="picks">
                @foreach (var t in course.Teachers)
                {
                    var id = t.AssignmentId;
                    <li>
                        <label class="pick">
                            <input type="checkbox" checked="@sendTargets.Contains(id)" @onchange="e => TogglePick(sendTargets, id, e)" />
                            <span>
                                <strong>@t.TeacherName</strong>
                                <small>@t.SectionLabel · @t.Students @(t.Students == 1 ? "student" : "students")</small>
                            </span>
                        </label>
                    </li>
                }
            </ul>
        }

        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseSend">Cancel</Button>
            <Button IconName="send" Disabled="@(busy || course.Teachers.Count == 0)" OnClick="SendAsync">@(busy ? "Sending…" : "Send")</Button>
        </div>
    }
</Modal>

@* ===== Delete ===== *@
<Modal Open="deleteTarget is not null" Title="@(deleteTarget?.Title ?? "")" OnClose="CloseDelete">
    @if (deleteTarget is not null)
    {
        <p class="dialog-text">@deleteTarget.Text</p>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="DeleteAsync">Delete</Button>
        </div>
    }
</Modal>

@code {
    private sealed record DeleteTarget(string Title, string Text, bool IsModule, int Id);

    [Parameter] public int SubjectId { get; set; }

    private int userId;
    private bool loaded;
    private CourseMaterials? course;
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    private ModuleInput? moduleForm;
    private int? editingModuleId;
    private bool editingIsSyllabus;

    private ExamInput? examForm;
    private int? editingExamId;

    // the questions of the exam in the box (imported from Excel; saved with the exam), and the questions of every exam of the course (for the export)
    private List<QuestionInput> examQuestions = [];
    private bool examQuestionsChanged;
    private IReadOnlyDictionary<int, IReadOnlyList<QuestionInput>> questionsByExam = new Dictionary<int, IReadOnlyList<QuestionInput>>();

    private bool sending;
    private readonly HashSet<int> sendModules = [];
    private readonly HashSet<int> sendTargets = [];

    private DeleteTarget? deleteTarget;

    // the syllabus or handout that is open in its box (the other handouts, the preview and the upload form)
    private int? viewId;

    private void OpenView(int id) => viewId = id;

    private void CloseView() => viewId = null;

    // the files of the library, by syllabus or module and by exam
    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> moduleAttachments = new Dictionary<int, IReadOnlyList<AttachmentRow>>();
    private IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> itemAttachments = new Dictionary<int, IReadOnlyList<AttachmentRow>>();
    private AttachmentPicker? modulePicker;
    private AttachmentPicker? slidesPicker;
    private int moduleFormKey;
    private int examFormKey;

    private string ModuleModalTitle => editingIsSyllabus
        ? (editingModuleId is null ? "Add syllabus" : "Edit syllabus")
        : (editingModuleId is null ? "Add handout" : "Edit handout");

    // ---- the sheet for adding many modules of the course at once (inside the system, no Excel)

    private bool modulesExcelOpen;

    private void OpenModulesExcel()
    {
        moduleForm = null;
        modulesExcelOpen = true;
    }

    private void CloseModulesExcel() => modulesExcelOpen = false;

    private async Task<ItemImportSummary> ImportModulesAsync(IReadOnlyList<ModuleToSave> list)
    {
        var created = 0;
        var problems = new List<string>();
        foreach (var m in list)
        {
            var saved = await Library.SaveModuleAsync(userId, SubjectId, null, m.Input, false);
            if (!saved.Succeeded || saved.Id is not { } id)
            {
                problems.Add($"Row {m.Row} ({m.Input.Title}): {string.Join(" ", saved.Errors)}");
                continue;
            }

            created++;
            if (m.Files.Count > 0)
            {
                var added = await Files.AddAsync(userId, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, id), m.Files);
                if (!added.Succeeded)
                {
                    problems.Add($"Row {m.Row} ({m.Input.Title}): it was added, but not its files: {string.Join(" ", added.Errors)}");
                }
            }

            if (m.Slides is { Count: > 0 })
            {
                var addedSlides = await Files.AddAsync(userId, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, id), m.Slides, slides: true);
                if (!addedSlides.Succeeded)
                {
                    problems.Add($"Row {m.Row} ({m.Input.Title}): it was added, but not its slides: {string.Join(" ", addedSlides.Errors)}");
                }
            }
        }

        await LoadAsync();
        return new ItemImportSummary(created, problems);
    }

    [SupplyParameterFromQuery(Name = "track")] private int? TrackQuery { get; set; }

    [SupplyParameterFromQuery(Name = "strand")] private int? StrandQuery { get; set; }

    [SupplyParameterFromQuery(Name = "term")] private int? TermQuery { get; set; }

    private LibraryTrack? backTrack;
    private LibraryStrand? backStrand;

    /// <summary>The list this page was opened from (the term of the strand, the strand or the track), or the whole library.</summary>
    /// <summary>The Course Menu: Syllabus, Modules and Summative exams, each a dropdown of what is inside (the lines go to the place on this page).</summary>
    /// <summary>The library has no pages under the line of the menu (no classmates, teachers or grades: those are for a student's course).</summary>
    private static readonly IReadOnlyList<CourseMenuLink> NoLinks = [];

    private IReadOnlyList<CourseMenuGroup> LibraryMenu(MaterialModuleView? syllabus, IReadOnlyList<MaterialModuleView> modules) =>
    [
        new("syllabus", "Syllabus", "book-marked", syllabus is null ? 0 : 1, PageBase + "#syllabus", syllabus is null ? [] : [new CourseMenuEntry(syllabus.Title, PageBase + "#syllabus")]),
        new("modules", "Handouts", "layers", modules.Count, PageBase + "#modules", [.. modules.Select((m, n) => new CourseMenuEntry(AddItemMenuLabels.ModuleLabel(n + 1, m.Title), $"{PageBase}#module-section-{m.Id}"))]),
        new("exams", "Summative exams", "clipboard-list", course!.Exams.Count, PageBase + "#exams", [.. course.Exams.Select(e => new CourseMenuEntry(e.Title, $"{PageBase}#exam-{e.Id}"))]),
    ];

    /// <summary>This page's own address without the part after #: the page has a base address, so a link that is only "#exams" would go to the home page.</summary>
    private string PageBase => Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0];


    private string BackHref => backTrack is null ? "provider/library"
        : backStrand is null ? $"provider/library?track={backTrack.TrackId}"
        : TermQuery is { } term ? $"provider/library?track={backTrack.TrackId}&strand={backStrand.StrandId}&term={term}"
        : $"provider/library?track={backTrack.TrackId}&strand={backStrand.StrandId}";

    private string BackText => backTrack is null ? "All courses"
        : backStrand is null ? $"Back to {backTrack.Name}"
        : TermQuery is { } term ? $"Back to {SchoolCalendar.TermName(term)}" : $"Back to {backStrand.Name}";

    protected override async Task OnParametersSetAsync()
    {
        userId = (await Me.GetAsync())?.UserId ?? 0;
        await LoadAsync();
        if (TrackQuery is { } trackId)
        {
            var tracks = await Library.ListTracksAsync();
            backTrack = tracks.FirstOrDefault(t => t.TrackId == trackId);
            backStrand = backTrack is not null && StrandQuery is { } strandId ? backTrack.Strands.FirstOrDefault(s => s.StrandId == strandId) : null;
        }
        else
        {
            backTrack = null;
            backStrand = null;
        }

        loaded = true;
    }

    private async Task LoadAsync()
    {
        course = await Library.GetCourseAsync(SubjectId);
        var modules = course?.Modules ?? [];
        moduleAttachments = await Files.ListForAsync(AttachmentOwnerKind.MaterialModule, modules.Select(m => m.Id).ToList());
        itemAttachments = await Files.ListForAsync(AttachmentOwnerKind.MaterialItem, (course?.Exams ?? []).Select(e => e.Id).ToList());
        questionsByExam = await Library.GetExamQuestionsAsync((course?.Exams ?? []).Select(e => e.Id).ToList());
    }

    private static IReadOnlyList<AttachmentRow> FilesOf(IReadOnlyDictionary<int, IReadOnlyList<AttachmentRow>> map, int? id) =>
        id is { } key && map.TryGetValue(key, out var list) ? list : [];

    /// <summary>Saves the files chosen in a form for the syllabus, module or item with this number: the new ones are attached, the ones taken off are removed.</summary>
    private async Task<List<string>> ApplyFilesAsync(AttachmentPicker? picker, AttachmentOwner owner, bool slides = false)
    {
        var problems = new List<string>();
        if (picker is null)
        {
            return problems;
        }

        var removed = await Files.RemoveAsync(userId, [.. picker.Removed]);
        if (!removed.Succeeded)
        {
            problems.AddRange(removed.Errors);
        }

        var added = await Files.AddAsync(userId, owner, picker.Pending, slides: slides);
        if (!added.Succeeded)
        {
            problems.AddRange(added.Errors);
        }

        return problems;
    }

    /// <summary>"14 Dec 2026, 8:00 AM to 10:00 AM" for the schedule of an exam.</summary>
    private static string ScheduleText(MaterialExamView exam) =>
        exam.OpensAtUtc is { } opens && exam.DueAtUtc is { } closes
            ? $"{PhilippineTime.FormatDateTime(opens)} to {PhilippineTime.FormatDateTime(closes)}"
            : "Opens and closes when you post it";

    private void Say(ServiceResult result, string? fallback = null)
    {
        messageIsError = !result.Succeeded;
        message = result.Succeeded ? result.Message ?? fallback : string.Join(" ", result.Errors);
    }

    private void ClearMessage() => message = null;

    // ---------------------------------------------------------------- modules and the syllabus

    private void OpenNewModule()
    {
        formErrors = [];
        editingModuleId = null;
        editingIsSyllabus = false;
        moduleFormKey++;
        moduleForm = new ModuleInput();
    }

    private void OpenNewSyllabus()
    {
        formErrors = [];
        editingModuleId = null;
        editingIsSyllabus = true;
        moduleFormKey++;
        moduleForm = new ModuleInput { Title = course is null ? "Syllabus" : $"Syllabus: {course.Name}" };
    }

    private void CloseModuleForm() => moduleForm = null;

    private async Task SaveModuleAsync()
    {
        if (moduleForm is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Library.SaveModuleAsync(userId, SubjectId, editingModuleId, moduleForm, editingIsSyllabus);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            var fileProblems = result.Id is { } savedModuleId ? await ApplyFilesAsync(modulePicker, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, savedModuleId)) : [];
            if (result.Id is { } slidesModuleId)
            {
                fileProblems.AddRange(await ApplyFilesAsync(slidesPicker, new AttachmentOwner(AttachmentOwnerKind.MaterialModule, slidesModuleId), slides: true));
            }

            moduleForm = null;
            Say(result);
            if (fileProblems.Count > 0)
            {
                messageIsError = true;
                message = $"{result.Message} But the files: {string.Join(" ", fileProblems)}";
            }

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- summative exams

    private void OpenNewExam()
    {
        formErrors = [];
        editingExamId = null;
        examFormKey++;
        examQuestions = [];
        examQuestionsChanged = false;
        examForm = new ExamInput();
    }

    private void OpenEditExam(MaterialExamView exam)
    {
        formErrors = [];
        editingExamId = exam.Id;
        examFormKey++;
        examForm = new ExamInput
        {
            Title = exam.Title, Instructions = exam.Instructions, MaxScore = exam.MaxScore,
            OpensAtUtc = exam.OpensAtUtc, DueAtUtc = exam.DueAtUtc,
            TimeLimitMinutes = exam.TimeLimitMinutes, AntiCheat = exam.AntiCheat, MaxViolations = exam.MaxViolations,
            ShuffleQuestions = exam.ShuffleQuestions, ShuffleOptions = exam.ShuffleOptions, ShowResult = exam.ShowResult,
        };
        examQuestions = [.. questionsByExam.GetValueOrDefault(exam.Id) ?? []];
        examQuestionsChanged = false;
    }

    private bool questionsSheetOpen;

    private void OpenQuestionsSheet() => questionsSheetOpen = true;

    private void CloseQuestionsSheet() => questionsSheetOpen = false;

    /// <summary>The questions of the sheet are the questions of the exam (it is worth their total). They are saved with the exam.</summary>
    private void QuestionsSaved(IReadOnlyList<QuestionInput> saved)
    {
        questionsSheetOpen = false;
        examQuestions = [.. saved];
        examQuestionsChanged = true;
        if (examForm is not null)
        {
            examForm.MaxScore = examQuestions.Sum(q => q.Points);
        }
    }

    private void CloseExamForm() => examForm = null;

    private async Task SaveExamAsync()
    {
        if (examForm is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            // (the settings and the days it opens and closes are the ones the exam has: they are chosen when it is posted)
            examForm.Questions = examQuestionsChanged ? examQuestions : null;
            if (examQuestions.Count > 0)
            {
                examForm.MaxScore = examQuestions.Sum(q => q.Points);
            }

            var result = await Library.SaveExamAsync(userId, SubjectId, editingExamId, examForm);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            examForm = null;
            Say(result);

            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---- the workbook of summative exams of the course

    private bool examsExcelOpen;

    private void OpenExamsExcel()
    {
        examForm = null;
        examsExcelOpen = true;
    }


    private void CloseExamsExcel() => examsExcelOpen = false;

    private byte[] ExamsExportBytes() =>
        ExamSheets.Export((course?.Exams ?? []).Select(e => new ExamExportRow(e.Title, e.Instructions, e.MaxScore, e.OpensAtUtc, e.DueAtUtc, e.TimeLimitMinutes, e.AntiCheat, questionsByExam.GetValueOrDefault(e.Id))));

    private static SheetImportDialog.SheetPreview ReadExams(byte[] data)
    {
        var parsed = ExamSheets.Parse(data);
        return new SheetImportDialog.SheetPreview([.. parsed.Rows.Select(r => new SheetImportDialog.SheetPreviewRow($"Row {r.Row}", r.Title, r.Errors.Count == 0 ? null : string.Join(" ", r.Errors)))], parsed.FileError);
    }

    private async Task<ItemImportSummary> ImportExamsAsync(byte[] data)
    {
        var created = 0;
        var problems = new List<string>();
        foreach (var row in ExamSheets.Parse(data).Rows)
        {
            if (row.Input is null)
            {
                problems.Add($"Row {row.Row} ({row.Title}): {string.Join(" ", row.Errors)}");
                continue;
            }

            var saved = await Library.SaveExamAsync(userId, SubjectId, null, row.Input);
            if (saved.Succeeded)
            {
                created++;
            }
            else
            {
                problems.Add($"Row {row.Row} ({row.Title}): {string.Join(" ", saved.Errors)}");
            }
        }

        await LoadAsync();
        return new ItemImportSummary(created, problems);
    }

    // ---------------------------------------------------------------- send

    private void OpenSend()
    {
        if (course is null)
        {
            return;
        }

        formErrors = [];
        sendModules.Clear();
        sendTargets.Clear();

        // What a teacher's course still lacks is chosen at the start; the teachers are all chosen.
        foreach (var module in course.Modules.Where(m => m.SentTo < course.Teachers.Count || course.Teachers.Count == 0))
        {
            sendModules.Add(module.Id);
        }

        foreach (var teacher in course.Teachers)
        {
            sendTargets.Add(teacher.AssignmentId);
        }

        sending = true;
    }

    private void CloseSend() => sending = false;

    // "Add syllabus" inside the send window: the window closes and the form of the syllabus opens.
    private void AddSyllabusFromSend()
    {
        sending = false;
        OpenNewSyllabus();
    }

    private static void TogglePick(HashSet<int> set, int id, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            set.Add(id);
        }
        else
        {
            set.Remove(id);
        }
    }

    private void ToggleAllModules()
    {
        if (course is null)
        {
            return;
        }

        if (sendModules.Count == course.Modules.Count)
        {
            sendModules.Clear();
        }
        else
        {
            sendModules.UnionWith(course.Modules.Select(m => m.Id));
        }
    }

    private void ToggleAllTeachers()
    {
        if (course is null)
        {
            return;
        }

        if (sendTargets.Count == course.Teachers.Count)
        {
            sendTargets.Clear();
        }
        else
        {
            sendTargets.UnionWith(course.Teachers.Select(t => t.AssignmentId));
        }
    }

    private async Task SendAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Library.SendAsync(userId, SubjectId, [.. sendModules], [.. sendTargets]);
            if (!result.Succeeded)
            {
                formErrors = [.. result.Errors];
                return;
            }

            sending = false;
            Say(result);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    // ---------------------------------------------------------------- delete

    private void AskDeleteModule(MaterialModuleView module)
    {
        deleteTarget = new DeleteTarget(module.IsSyllabus ? "Delete the syllabus?" : "Delete this handout?",
            $"\"{module.Title}\" will be deleted from the library. The copies the teachers already got stay with them.", true, module.Id);
    }

    private void AskDeleteExam(MaterialExamView exam) =>
        deleteTarget = new DeleteTarget("Delete this summative exam?", $"\"{exam.Title}\" will be deleted from the library. The copies the teachers already got stay with them.", false, exam.Id);

    private void CloseDelete() => deleteTarget = null;

    private async Task DeleteAsync()
    {
        if (deleteTarget is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = deleteTarget.IsModule
                ? await Library.DeleteModuleAsync(userId, deleteTarget.Id)
                : await Library.DeleteExamAsync(userId, deleteTarget.Id);
            deleteTarget = null;
            Say(result);
            await LoadAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
