@inject ProviderService Provider

<Card>
    <form class="filter-bar one-row" role="search" @onsubmit="ApplyAsync">
        <SearchField Id="user-search" @bind-Value="search" Label="Search" SubmitText="" Placeholder="@(Tab == "teachers" ? "A teacher" : "A student or a section")" AriaLabel="@(Tab == "teachers" ? "Search the teachers" : "Search the students")" OnClear="ApplyAsync" />
        <Field For="user-grade" Label="Grade level">
            <select id="user-grade" class="input" @bind="gradeLevel" @bind:after="ApplyAsync">
                <option value="0">All</option>
                @foreach (var g in options?.GradeLevels ?? [])
                {
                    <option value="@g">Grade @g</option>
                }
            </select>
        </Field>
        <Field For="user-section" Label="Section">
            <select id="user-section" class="input" @bind="section" @bind:after="ApplyAsync">
                <option value="">All</option>
                @foreach (var x in options?.Sections ?? [])
                {
                    <option value="@x">@x</option>
                }
            </select>
        </Field>
        @if (Tab == "teachers")
        {
            <Field For="user-course" Label="Course">
                <select id="user-course" class="input" @bind="subjectId" @bind:after="ApplyAsync">
                    <option value="0">All</option>
                    @foreach (var c in options?.Courses ?? [])
                    {
                        <option value="@c.SubjectId">@c.Name</option>
                    }
                </select>
            </Field>
        }
        @if (gradeLevel != 0 || !string.IsNullOrEmpty(section) || subjectId != 0)
        {
            <div class="filter-actions">
                <Button Variant="ButtonVariant.Ghost" IconName="x" OnClick="ClearChoicesAsync">Clear filters</Button>
            </div>
        }
    </form>

    @if (Tab == "teachers")
    {
        @if (teachers is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (teachers.Count == 0)
        {
            <EmptyState IconName="presentation" Title="No teacher found">
                <p>Teachers appear here when they have a course this school year.</p>
            </EmptyState>
        }
        else
        {
            <div class="data-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Teacher</th>
                            <th scope="col" class="num">Courses</th>
                            <th scope="col" class="num">Received</th>
                            <th scope="col" class="bar-cell">Opened</th>
                            <th scope="col" class="num">Posted</th>
                            <th scope="col">Waiting</th>
                            <th scope="col" class="col-more">Last opened</th>
                            <th scope="col" class="col-more">Opens in</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in teachers)
                        {
                            <tr>
                                <td><a class="name-link" href="provider/tracking/users/@t.UserId">@t.Name</a></td>
                                <td class="num">@t.Courses</td>
                                <td class="num">@t.Received</td>
                                <td class="bar-cell">
                                    @if (t.OpenedPercent is { } op)
                                    {
                                        <ProgressBar Percent="op" Title="@($"{t.Opened} of {t.Received} opened")" />
                                    }
                                    else
                                    {
                                        <span class="na">Nothing sent</span>
                                    }
                                </td>
                                <td class="num">@t.Posted</td>
                                <td>
                                    @if (t.Waiting == 0)
                                    {
                                        <span class="na">—</span>
                                    }
                                    else
                                    {
                                        <Badge Tone="@(t.LongestWaitingDays >= 3 ? Tone.Danger : Tone.Warning)">@t.Waiting waiting</Badge>
                                        <span class="muted-line">the oldest @(t.LongestWaitingDays is { } d && d > 0 ? $"{d} days" : "today")</span>
                                    }
                                </td>
                                <td class="col-more">@(t.LastOpenedAtUtc is { } last ? PhilippineTime.FormatDate(last) : "—")</td>
                                <td class="col-more">@ProviderUi.Duration(t.AverageHoursToOpen)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="muted foot">@teachers.Count.ToString("N0") @(teachers.Count == 1 ? "teacher" : "teachers"). “Opened” counts a teacher who read it, edited it, opened one of its assignments, or posted it.</p>
        }
    }
    else
    {
        @if (students is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (students.Rows.Count == 0)
        {
            <EmptyState IconName="graduation-cap" Title="No student found">
                <p>Students appear here when a teacher has posted something you sent to their course.</p>
            </EmptyState>
        }
        else
        {
            <div class="data-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Student</th>
                            <th scope="col">Section</th>
                            <th scope="col" class="num">Posted to them</th>
                            <th scope="col" class="bar-cell">Opened</th>
                            <th scope="col" class="col-more">Last opened</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in students.Rows)
                        {
                            <tr>
                                <td><a class="name-link" href="provider/tracking/users/@s.UserId">@s.Name</a></td>
                                <td>@s.SectionLabel</td>
                                <td class="num">@s.Available</td>
                                <td class="bar-cell">
                                    @if (s.OpenedPercent is { } sp)
                                    {
                                        <ProgressBar Percent="sp" Title="@($"{s.Opened} of {s.Available} opened")" />
                                        <span class="muted-line">@s.Opened of @s.Available</span>
                                    }
                                </td>
                                <td class="col-more">@(s.LastOpenedAtUtc is { } last ? PhilippineTime.FormatDate(last) : "Never")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pager" aria-label="Pages of the students">
                <span class="muted">@students.Total.ToString("N0") @(students.Total == 1 ? "student" : "students"), those who opened the least first</span>
                <span class="pager-buttons">
                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevron-left" Disabled="@(students.Page <= 1)" OnClick="PreviousAsync">Previous</Button>
                    <span>Page @students.Page of @StudentPages</span>
                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevron-right" IconAfter="true" Disabled="@(students.Page >= StudentPages)" OnClick="NextAsync">Next</Button>
                </span>
            </nav>
        }
    }
</Card>

@code {
    private string search = "";
    private string loadedTab = "";
    private int pageNumber = 1;
    private int gradeLevel;
    private string section = "";
    private int subjectId;
    private TrackingOptions? options;
    private IReadOnlyList<TeacherTrack>? teachers;
    private StudentTrackPage? students;

    /// <summary>"teachers" or "students": which list this is.</summary>
    [Parameter] public string Tab { get; set; } = "teachers";

    private int StudentPages => students is null ? 1 : Math.Max(1, (int)Math.Ceiling(students.Total / (double)students.PageSize));

    protected override async Task OnParametersSetAsync()
    {
        // The tab changed (the parent keeps this component and gives it another list): start that list from its first page.
        if (loadedTab != Tab)
        {
            loadedTab = Tab;
            search = "";
            gradeLevel = subjectId = 0;
            section = "";
            pageNumber = 1;
            teachers = null;
            students = null;
            await ReloadAsync();
        }
    }

    /// <summary>Looks at the list again (the Refresh button of the page).</summary>
    public async Task ReloadAsync()
    {
        options ??= await Provider.GetTrackingOptionsAsync();
        if (Tab == "teachers")
        {
            teachers = await Provider.ListTeachersAsync(search, gradeLevel: gradeLevel, section: section, subjectId: subjectId);
        }
        else
        {
            students = await Provider.ListStudentsAsync(search, pageNumber, gradeLevel: gradeLevel, section: section);
            pageNumber = students.Page;
        }

        StateHasChanged();
    }

    private async Task ApplyAsync()
    {
        pageNumber = 1;
        await ReloadAsync();
    }

    private async Task ClearChoicesAsync()
    {
        gradeLevel = subjectId = 0;
        section = "";
        await ApplyAsync();
    }

    private async Task PreviousAsync()
    {
        pageNumber = Math.Max(1, pageNumber - 1);
        await ReloadAsync();
    }

    private async Task NextAsync()
    {
        pageNumber++;
        await ReloadAsync();
    }
}
