@page "/provider/tracking"
@attribute [Authorize(Roles = AppRoles.AcademicProvider)]
@rendermode InteractiveServer
@inject ProviderService Provider
@implements IDisposable
@inject TimeProvider Clock

<PageTitle>Tracking · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Tracking" IconName="eye">
    <ButtonLink Href="provider/analytics" Variant="ButtonVariant.Secondary" IconName="chart-column">Analytics</ButtonLink>
    <Button Variant="ButtonVariant.Secondary" IconName="refresh-cw" OnClick="ReloadAsync">Refresh</Button>
</PageHeader>

@* Three parts: the syllabus, the modules and the summative exams. In each one the list is of the people who have not done their part: the teachers who did not post, and (once it is posted) the students who did not open or hand in. *@
<PillTabs Items="PartTabs" Selected="@part" SelectedChanged="PartChangedAsync" Label="Part of the tracking" />
<p class="part-hint">@PartHint</p>

<Card>
    <div class="track-bar">
        <form class="track-search" role="search" @onsubmit="ApplyAsync">
            <SearchField Id="track-search" @bind-Value="search" SubmitText="" Placeholder="@SearchHint" AriaLabel="Search the tracking" OnClear="ApplyAsync" />
        </form>

        @if (part == "exams")
        {
            <Field For="track-grade" Label="Grade">
                <select id="track-grade" class="input" @bind="grade" @bind:after="ApplyAsync">
                    <option value="0">All grades</option>
                    @foreach (var g in grades)
                    {
                        <option value="@g">Grade @g</option>
                    }
                </select>
            </Field>
            <Field For="track-course" Label="Course">
                <select id="track-course" class="input" @bind="subjectId" @bind:after="ApplyAsync">
                    <option value="0">All courses</option>
                    @foreach (var c in courses)
                    {
                        <option value="@c.SubjectId">@c.Name</option>
                    }
                </select>
            </Field>
        }

        <div class="state-choice" role="radiogroup" aria-label="State">
            @foreach (var option in StateOptions)
            {
                <button type="button" role="radio" class="state @(state == option.Key ? "on" : "")" aria-checked="@(state == option.Key ? "true" : "false")" data-state="@option.Key" @onclick="() => StateChangedAsync(option.Key)">
                    @option.Label
                </button>
            }
        </div>

        <div class="track-message">
            <Button Variant="ButtonVariant.Secondary" IconName="bell-ring" Disabled="@(Total == 0 || !CanMessage)" OnClick="OpenMessageAsync">Message @(Total == 0 || !CanMessage ? "" : WhoText)</Button>
        </div>
    </div>

    @if (loading)
    {
        <p class="muted">Loading…</p>
    }
    else if (Total == 0)
    {
        <EmptyState IconName="circle-check" Title="@EmptyTitle">
            <p>@EmptyText</p>
        </EmptyState>
    }
    else if (part == "exams")
    {
        <div class="data-wrap">
            <table class="data-table tracking exams-table">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Section</th>
                        <th scope="col">Summative exam</th>
                        <th scope="col">Opened</th>
                        <th scope="col">Handed in</th>
                        <th scope="col" class="right">Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in examRows!.Rows)
                    {
                        <tr>
                            <td class="what"><span class="name">@row.StudentName</span></td>
                            <td>@row.SectionLabel</td>
                            <td>
                                <span class="name">@row.ExamTitle</span>
                                <span class="muted-line">@row.SubjectName</span>
                            </td>
                            <td><Badge Tone="@(row.Opened ? Tone.Success : Tone.Warning)">@(row.Opened ? "Opened" : "Not opened")</Badge></td>
                            <td><Badge Tone="@(row.HandedIn ? Tone.Success : Tone.Neutral)">@(row.HandedIn ? "Handed in" : "Not handed in")</Badge></td>
                            <td class="right">@(row.Percent is { } p ? $"{row.Score:0.#} / {row.MaxScore:0.#} ({p}%)" : row.HandedIn ? "Not graded yet" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="examRows.Page" Total="examRows.Total" PageSize="examRows.PageSize" Unit="students" OnPrevious="PreviousAsync" OnNext="NextAsync" />
    }
    else if (state is TrackStates.NotPosted or TrackStates.Scheduled)
    {
        <div class="data-wrap">
            <table class="data-table tracking">
                <thead>
                    <tr>
                        <th scope="col">@(part == "syllabus" ? "Syllabus" : "Module")</th>
                        <th scope="col">Teacher</th>
                        <th scope="col">@(state == TrackStates.Scheduled ? "Appears for the students" : "What the teacher did")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in postedRows!.Rows)
                    {
                        <tr>
                            <td class="what">
                                <span class="name">@(row.IsSyllabus ? "Syllabus" : row.Title)</span>
                                <span class="muted-line">@row.SubjectName · sent @PhilippineTime.FormatDate(row.SentAtUtc)</span>
                            </td>
                            <td>
                                <span class="name">@row.TeacherName</span>
                                <span class="muted-line">@row.SectionLabel</span>
                            </td>
                            <td>
                                @if (state == TrackStates.Scheduled && row.ScheduledForUtc is { } at)
                                {
                                    <Badge Tone="@ProviderUi.StateTone(row.State)">Scheduled</Badge>
                                    <span class="muted-line">@PhilippineTime.FormatDateTime(at)</span>
                                }
                                else
                                {
                                    <Badge Tone="@ProviderUi.StateTone(row.State)">@DeliveryStates.Display(row.State)</Badge>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="postedRows.Page" Total="postedRows.Total" PageSize="postedRows.PageSize" Unit="lines" OnPrevious="PreviousAsync" OnNext="NextAsync" />
    }
    else
    {
        <div class="data-wrap">
            <table class="data-table tracking">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">@(part == "syllabus" ? "Syllabus" : "Module")</th>
                        <th scope="col">Teacher</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in openedRows!.Rows)
                    {
                        <tr>
                            <td class="what">
                                <span class="name">@row.StudentName</span>
                                <span class="muted-line">@row.SectionLabel</span>
                            </td>
                            <td>
                                <span class="name">@(row.IsSyllabus ? "Syllabus" : row.Title)</span>
                                <span class="muted-line">@row.SubjectName · posted @PhilippineTime.FormatDate(row.PostedAtUtc)</span>
                            </td>
                            <td>@row.TeacherName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Page="openedRows.Page" Total="openedRows.Total" PageSize="openedRows.PageSize" Unit="students" OnPrevious="PreviousAsync" OnNext="NextAsync" />
    }
</Card>

<Modal Open="messaging" Title="@MessageTitle" OnClose="CloseMessage">
    <form @onsubmit="SendMessageAsync">
        <p class="muted">@MessageLead</p>
        @if (ShowsTeachers && listTeachers.Count > 1)
        {
            <Field For="track-teacher" Label="Teacher" Hint="Everybody on the list, or one teacher.">
                <select id="track-teacher" @bind="chosenTeacher">
                    <option value="0">Everybody on the list (@listTeachers.Count teachers)</option>
                    @foreach (var t in listTeachers)
                    {
                        <option value="@t.UserId">@t.Name (@(t.Lines == 1 ? "1 line" : $"{t.Lines} lines"))</option>
                    }
                </select>
            </Field>
        }
        <Field For="track-message" Label="Message" Hint="Leave it as it is, or write your own words.">
            <textarea id="track-message" rows="4" maxlength="500" @bind="messageText" @bind:event="oninput"></textarea>
        </Field>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseMessage">Cancel</Button>
            <Button Type="submit" IconName="send" Disabled="sending">@(sending ? "Sending…" : $"Send to {SendTo}")</Button>
        </div>
    </form>
</Modal>

<Notice Message="@notice" IsError="false" OnDismiss="ClearNotice" />

@code {
    private sealed record StateOption(string Key, string Label);

    private string part = "syllabus";
    private string state = TrackStates.NotPosted;
    private string search = "";
    private int grade;
    private int subjectId;
    private int pageNumber = 1;
    private bool loading = true;
    private TrackPage<NotPostedRow>? postedRows;
    private TrackPage<NotOpenedRow>? openedRows;
    private TrackPage<ExamStudentRow>? examRows;
    private IReadOnlyList<int> grades = [];
    private IReadOnlyList<(int SubjectId, string Name)> courses = [];
    private int people;
    private bool messaging;
    private bool sending;
    private string messageText = "";
    private string? notice;
    private string? lastQuery;

    [SupplyParameterFromQuery(Name = "tab")] private string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "state")] private string? StateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")] private string? SearchQuery { get; set; }

    private static readonly string[] Parts = ["syllabus", "modules", "exams"];

    private static readonly IReadOnlyList<PillTabs.Tab> PartTabs =
    [
        new("syllabus", "Syllabus", "book-open"),
        new("modules", "Modules", "layers"),
        new("exams", "Summative exams", "clipboard-list"),
    ];

    // The order of the buttons is the order of the work: first the teacher posts (or schedules), then the students open, then (for an exam) they hand in.
    private IReadOnlyList<StateOption> StateOptions => part == "exams"
        ? [new(TrackStates.NotOpened, "Not opened"), new(TrackStates.NotHandedIn, "Not handed in"), new(TrackStates.HandedIn, "Handed in")]
        : [new(TrackStates.NotPosted, "Not posted"), new(TrackStates.Scheduled, "Scheduled"), new(TrackStates.NotOpened, "Not opened")];

    /// <summary>The message is for the people who are late, or who scheduled it for too long: not for the students who handed in.</summary>
    private bool CanMessage => state != TrackStates.HandedIn;

    private string PartHint => part switch
    {
        "exams" when state == TrackStates.NotOpened => "Students who have not opened a posted exam.",
        "exams" when state == TrackStates.NotHandedIn => "Students who opened an exam but have not handed it in.",
        "exams" => "Students who handed in, with their scores.",
        _ when state == TrackStates.Scheduled => "Teachers who scheduled it: it shows to students at the time given.",
        _ when state == TrackStates.NotPosted => "Teachers who have not posted it to their students.",
        _ => "Students who have not opened what the teacher posted.",
    };

    private string SearchHint => part == "exams" ? "Student, course, section…" : ShowsTeachers ? "Course, teacher, module…" : "Student, course, teacher…";

    private bool ShowsTeachers => state is TrackStates.NotPosted or TrackStates.Scheduled;

    private int Total => part == "exams" ? examRows?.Total ?? 0 : ShowsTeachers ? postedRows?.Total ?? 0 : openedRows?.Total ?? 0;

    private string WhoText => people == 1 ? "1 person" : $"{people:N0} people";

    private int chosenTeacher;
    private IReadOnlyList<(int UserId, string Name, int Lines)> listTeachers = [];

    /// <summary>Who the message goes to now: the chosen teacher, or everybody on the list.</summary>
    private string SendTo => ShowsTeachers && chosenTeacher != 0 ? (listTeachers.FirstOrDefault(t => t.UserId == chosenTeacher).Name ?? "1 person") : WhoText;

    private string EmptyTitle => part == "exams"
        ? (state == TrackStates.HandedIn ? "Nobody handed in yet" : state == TrackStates.NotHandedIn ? "Nobody is late" : "Everybody opened it")
        : state == TrackStates.Scheduled ? "Nothing is scheduled" : state == TrackStates.NotPosted ? "Everything is posted" : "Everybody opened it";

    private string EmptyText => (part, state) switch
    {
        ("exams", _) => string.IsNullOrWhiteSpace(search) && grade == 0 && subjectId == 0
            ? "No summative exam is posted yet, or the exams that are posted have no student on this list. Open the Course library, choose a course, add a summative exam and press “Post to students”."
            : "Nothing matches. Change the words you searched or the choices.",
        (_, TrackStates.Scheduled) => string.IsNullOrWhiteSpace(search) ? "The teachers have not scheduled anything." : "Nothing matches the words you searched.",
        (_, TrackStates.NotPosted) => string.IsNullOrWhiteSpace(search) ? "Every teacher posted what was sent to them." : "Nothing matches the words you searched.",
        _ => string.IsNullOrWhiteSpace(search) ? "Every student opened what was posted for them." : "Nothing matches the words you searched.",
    };

    private string MessageTitle => part == "exams" ? "Message the students" : state == TrackStates.NotPosted ? "Message the teachers" : "Message the students";

    private string MessageLead => part == "exams"
        ? $"A notification goes to {WhoText}: the students on this list."
        : state == TrackStates.Scheduled ? $"A notification goes to the teachers who scheduled the {(part == "syllabus" ? "syllabus" : "modules")}: choose one teacher, or everybody on the list. Use it when the day is too far."
        : state == TrackStates.NotPosted ? $"A notification goes to {WhoText}: the teachers who have not posted the {(part == "syllabus" ? "syllabus" : "modules")}." : $"A notification goes to {WhoText}: the students who have not opened it.";

    private System.Threading.Timer? refresher;

    protected override void OnAfterRender(bool firstRender)
    {
        // The page looks again every minute, so what changed (a module whose time came and is posted now, a student who opened it) shows without pressing Refresh.
        if (firstRender)
        {
            refresher = new System.Threading.Timer(_ => _ = InvokeAsync(async () =>
            {
                if (!messaging && !sending)
                {
                    await ReloadAsync();
                    StateHasChanged();
                }
            }), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
        }
    }

    public void Dispose() => refresher?.Dispose();

    protected override async Task OnParametersSetAsync()
    {
        // The links of the menu change the address of this same page (?tab=exams), so it is read every time it changes.
        var query = $"{TabQuery}|{StateQuery}|{SearchQuery}";
        if (query == lastQuery && postedRows is not null)
        {
            return;
        }

        lastQuery = query;
        part = TabQuery is not null && Parts.Contains(TabQuery) ? TabQuery : (TabQuery is "teachers" or "students" ? "modules" : "syllabus");
        state = StateOptions.Any(o => o.Key == StateQuery) ? StateQuery! : StateOptions[0].Key;
        search = SearchQuery ?? "";
        if (part == "exams")
        {
            var choices = await Provider.GetExamFilterChoicesAsync();
            grades = choices.Grades;
            courses = choices.Courses;
        }

        pageNumber = 1;
        await ReloadAsync();
    }

    private async Task PartChangedAsync(string? key)
    {
        part = key is not null && Parts.Contains(key) ? key : "syllabus";
        state = StateOptions[0].Key;
        pageNumber = 1;
        if (part == "exams")
        {
            var choices = await Provider.GetExamFilterChoicesAsync();
            grades = choices.Grades;
            courses = choices.Courses;
        }

        await ReloadAsync();
    }

    private async Task StateChangedAsync(string key)
    {
        state = key;
        pageNumber = 1;
        await ReloadAsync();
    }

    private async Task ApplyAsync()
    {
        pageNumber = 1;
        await ReloadAsync();
    }

    private bool IsSyllabus => part == "syllabus";

    private async Task ReloadAsync()
    {
        loading = true;
        if (part == "exams")
        {
            examRows = await Provider.ListExamStudentsAsync(state, grade, subjectId, search, pageNumber);
            pageNumber = examRows.Page;
            people = (await Provider.GetExamStudentsAsync(state, grade, subjectId, search)).Select(r => r.StudentUserId).Distinct().Count();
        }
        else if (state == TrackStates.Scheduled)
        {
            postedRows = await Provider.ListScheduledAsync(IsSyllabus, search, pageNumber);
            pageNumber = postedRows.Page;
            people = (await Provider.GetScheduledAsync(IsSyllabus, search)).Select(r => r.TeacherUserId).Distinct().Count();
        }
        else if (state == TrackStates.NotPosted)
        {
            postedRows = await Provider.ListNotPostedAsync(IsSyllabus, search, pageNumber);
            pageNumber = postedRows.Page;
            people = (await Provider.GetNotPostedAsync(IsSyllabus, search)).Select(r => r.TeacherUserId).Distinct().Count();
        }
        else
        {
            openedRows = await Provider.ListNotOpenedAsync(IsSyllabus, search, pageNumber);
            pageNumber = openedRows.Page;
            people = (await Provider.GetNotOpenedAsync(IsSyllabus, search)).Select(r => r.StudentUserId).Distinct().Count();
        }

        loading = false;
    }

    private async Task PreviousAsync()
    {
        pageNumber = Math.Max(1, pageNumber - 1);
        await ReloadAsync();
    }

    private async Task NextAsync()
    {
        pageNumber++;
        await ReloadAsync();
    }

    // ---- the message to everybody on the list
    private async Task OpenMessageAsync()
    {
        chosenTeacher = 0;
        if (ShowsTeachers)
        {
            var rows = state == TrackStates.Scheduled ? await Provider.GetScheduledAsync(IsSyllabus, search) : await Provider.GetNotPostedAsync(IsSyllabus, search);
            listTeachers = [.. rows.GroupBy(r => (r.TeacherUserId, r.TeacherName)).Select(g => (g.Key.TeacherUserId, g.Key.TeacherName, g.Count())).OrderBy(t => t.TeacherName, StringComparer.OrdinalIgnoreCase)];
        }

        messageText = part == "exams"
            ? (state == TrackStates.NotHandedIn ? "You have not handed in your summative exam yet. Open your course and take it before it closes." : state == TrackStates.NotOpened ? "You have not opened your summative exam yet. Open your course and take it before it closes." : "A reminder about your summative exam: open your course and take it before it closes.")
            : state == TrackStates.Scheduled
                ? $"You scheduled the {(IsSyllabus ? "syllabus" : "modules")} for a day that is too far. Please post {(IsSyllabus ? "it" : "them")} sooner so the students can start reading."
            : state == TrackStates.NotPosted
                ? $"The {(IsSyllabus ? "syllabus" : "modules")} that was sent to you is not posted yet. Please open your course and post {(IsSyllabus ? "it" : "them")} for the students."
                : $"Your teacher posted the {(IsSyllabus ? "syllabus" : "modules")} for you. Please open your course and read {(IsSyllabus ? "it" : "them")}.";
        messaging = true;
    }

    private void CloseMessage() => messaging = false;

    private async Task SendMessageAsync()
    {
        sending = true;
        try
        {
            var told = await Provider.NotifyAsync(state, part == "exams", IsSyllabus, search, grade, subjectId, messageText, ShowsTeachers ? chosenTeacher : 0);
            messaging = false;
            notice = told == 0 ? "Nobody was on the list, so nobody was told." : $"{(told == 1 ? "1 person was" : $"{told:N0} people were")} told.";
        }
        finally
        {
            sending = false;
        }
    }

    private void ClearNotice() => notice = null;
}
