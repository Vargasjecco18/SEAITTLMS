@page "/provider/tracking"
@attribute [Authorize(Roles = AppRoles.AcademicProvider)]
@rendermode InteractiveServer
@inject ProviderService Provider
@inject TimeProvider Clock

<PageTitle>Tracking · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh Seconds="60" />

<PageHeader Title="Tracking"
            IconName="eye">
    <ButtonLink Href="provider/analytics" Variant="ButtonVariant.Secondary" IconName="chart-column">Analytics</ButtonLink>
    <Button Variant="ButtonVariant.Secondary" IconName="refresh-cw" OnClick="RefreshAsync">Refresh</Button>
</PageHeader>

@* Four parts: the syllabi and modules that were sent to the teachers, the summative exams posted to the students, the teachers who got them and the students who see them. *@
<PillTabs Items="PartTabs" Selected="@part" SelectedChanged="PartChangedAsync" Label="Part of the tracking" />
<p class="part-hint">@PartHint</p>

@if (part is "teachers" or "students")
{
    <TrackingUsers @ref="usersPanel" Tab="@part" />
}
else if (part == "exams")
{
    <Card>
        <form class="filter-bar one-row" role="search" @onsubmit="LoadExamsAsync">
            <SearchField Id="exam-search" @bind-Value="search" Label="Search" SubmitText="" Placeholder="Exam, course, teacher, section…" AriaLabel="Search the exams" OnClear="LoadExamsAsync" />
        </form>

        @if (exams is null)
        {
            <p class="muted">Loading…</p>
        }
        else if (exams.Count == 0)
        {
            <EmptyState IconName="clipboard-list" Title="No exam posted yet">
                <p>Open the Course library, choose a course, add a summative exam and press “Post to students”.</p>
            </EmptyState>
        }
        else
        {
            <div class="data-wrap">
                <table class="data-table tracking">
                    <thead>
                        <tr>
                            <th scope="col">Exam</th>
                            <th scope="col">Section</th>
                            <th scope="col">Schedule</th>
                            <th scope="col" class="bar-cell">Opened it</th>
                            <th scope="col" class="bar-cell">Handed in</th>
                            <th scope="col" class="right">Average</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in exams)
                        {
                            <tr>
                                <td class="what">
                                    <span class="name">@row.Title</span>
                                    <span class="muted-line">@row.SubjectName</span>
                                </td>
                                <td>
                                    <span class="name">@row.SectionLabel</span>
                                    <span class="muted-line">@row.TeacherName</span>
                                </td>
                                <td>
                                    <span>@(row.OpensAtUtc is { } o ? PhilippineTime.FormatDateTime(o) : "—")</span>
                                    <span class="muted-line">to @(row.ClosesAtUtc is { } c ? PhilippineTime.FormatDateTime(c) : "—")</span>
                                </td>
                                <td class="bar-cell">
                                    <ProgressBar Percent="@ProviderMath.Percent(row.Opened, row.Students)" Title="@($"{row.Opened} of {row.Students} students opened it")" />
                                    <span class="muted-line">@row.Opened of @row.Students</span>
                                </td>
                                <td class="bar-cell">
                                    <ProgressBar Percent="@ProviderMath.Percent(row.HandedIn, row.Students)" Title="@($"{row.HandedIn} of {row.Students} students handed it in")" />
                                    <span class="muted-line">@row.HandedIn of @row.Students</span>
                                </td>
                                <td class="right">@(row.AveragePercent is { } avg ? $"{avg}%" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>
}
else
{
<PillTabs Items="Tabs" Selected="@state" SelectedChanged="StateChangedAsync" Label="State of what was sent" />

<Card>
    <form class="filter-bar one-row" role="search" @onsubmit="ApplyAsync">
        <SearchField Id="track-search" @bind-Value="search" Label="Search" SubmitText="" Placeholder="Course, teacher, module…" AriaLabel="Search the tracking" OnClear="ApplyAsync" />
        <Field For="track-kind" Label="What">
            <select id="track-kind" class="input" @bind="kind" @bind:after="ApplyAsync">
                <option value="">All</option>
                <option value="Syllabus">Syllabi</option>
                <option value="Module">Modules</option>
            </select>
        </Field>
        <Field For="track-course" Label="Course">
            <select id="track-course" class="input" @bind="subjectId" @bind:after="ApplyAsync">
                <option value="0">All</option>
                @foreach (var c in options?.Courses ?? [])
                {
                    <option value="@c.SubjectId">@c.Name</option>
                }
            </select>
        </Field>
        @if (HasChoice)
        {
            <div class="filter-actions">
                <Button Variant="ButtonVariant.Ghost" IconName="x" OnClick="ClearChoicesAsync">Clear filters</Button>
            </div>
        }
    </form>

    @if (data is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (data.Rows.Count == 0)
    {
        <EmptyState IconName="eye" Title="Nothing here">
            <p>@(data.Total == 0 && string.IsNullOrWhiteSpace(search) && string.IsNullOrEmpty(state) && string.IsNullOrEmpty(kind) && !HasChoice ? "Nothing was sent to the teachers yet. Open the Course library, choose a course and press “Send to teachers”." : "Nothing matches. Change the state or the words you searched.")</p>
        </EmptyState>
    }
    else
    {
        <div class="data-wrap">
            <table class="data-table tracking">
                <thead>
                    <tr>
                        <th scope="col">Sent</th>
                        <th scope="col">Teacher</th>
                        <th scope="col">State</th>
                        <th scope="col" class="bar-cell">Students opened it</th>
                        <th scope="col"><span class="sr-only">Details</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in data.Rows)
                    {
                        <tr>
                            <td class="what">
                                <a class="name-link" href="provider/tracking/@row.DeliveryId">@(row.IsSyllabus ? "Syllabus" : row.Title)</a>
                                <span class="muted-line">@row.SubjectName · @PhilippineTime.FormatDate(row.SentAtUtc)</span>
                            </td>
                            <td>
                                <a class="name-link" href="provider/tracking/users/@row.TeacherUserId">@row.TeacherName</a>
                                <span class="muted-line">@row.SectionLabel</span>
                            </td>
                            <td>
                                <Badge Tone="@ProviderUi.StateTone(row.State)">@DeliveryStates.Display(row.State)</Badge>
                                @if (row.State != DeliveryStates.NotOpened && row.OpenedAtUtc is { } opened)
                                {
                                    <span class="muted-line">@(row.State == DeliveryStates.Posted ? "posted" : "opened") @ProviderUi.Ago(row.State == DeliveryStates.Posted ? row.PostedAtUtc ?? opened : opened, nowUtc)</span>
                                }
                                else
                                {
                                    <span class="muted-line">sent @ProviderUi.Ago(row.SentAtUtc, nowUtc)</span>
                                }
                            </td>
                            <td class="bar-cell">
                                @if (row.ModulePercent is { } mp)
                                {
                                    <ProgressBar Percent="mp" Title="@($"{row.ModuleOpens} of {row.Audience} students opened it")" />
                                    <span class="muted-line">@row.ModuleOpens of @row.Audience</span>
                                }
                                else
                                {
                                    <span class="na">@(row.State == DeliveryStates.Scheduled ? "Not yet: scheduled" : "Not posted yet")</span>
                                }
                            </td>
                            <td class="right"><ButtonLink Href="@($"provider/tracking/{row.DeliveryId}")" Variant="ButtonVariant.Secondary" Small="true" IconName="arrow-right" IconAfter="true">Details</ButtonLink></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="pager" aria-label="Pages of the list">
            <span class="muted">@data.Total.ToString("N0") @(data.Total == 1 ? "line" : "lines")</span>
            <span class="pager-buttons">
                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevron-left" Disabled="@(data.Page <= 1)" OnClick="PreviousAsync">Previous</Button>
                <span>Page @data.Page of @PageCount</span>
                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="chevron-right" IconAfter="true" Disabled="@(data.Page >= PageCount)" OnClick="NextAsync">Next</Button>
            </span>
        </nav>
    }
</Card>
}

@code {
    private TrackingUsers? usersPanel;
    private string part = "modules";
    private TrackingPage? data;
    private IReadOnlyList<ExamTrackRow>? exams;
    private string state = "";
    private string search = "";
    private string kind = "";
    private int subjectId;
    private TrackingOptions? options;
    private int pageNumber = 1;
    private DateTime nowUtc;

    [SupplyParameterFromQuery(Name = "tab")] private string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "state")] private string? StateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")] private string? SearchQuery { get; set; }

    [SupplyParameterFromQuery(Name = "kind")] private string? KindQuery { get; set; }

    private int PageCount => data is null ? 1 : Math.Max(1, (int)Math.Ceiling(data.Total / (double)data.PageSize));

    private static readonly string[] Parts = ["modules", "exams", "teachers", "students"];

    /// <summary>The provider sends the syllabus, the modules and the summative exams only (the teacher makes the activities), so these are the parts to look at.</summary>
    private static readonly IReadOnlyList<PillTabs.Tab> PartTabs =
    [
        new("modules", "Syllabus and modules", "eye"),
        new("exams", "Summative exams", "clipboard-list"),
        new("teachers", "Teachers", "presentation"),
        new("students", "Students", "graduation-cap"),
    ];

    private string PartHint => part switch
    {
        "exams" => "The summative exams posted to the students: when each one opens, how many students opened it and handed it in, and their average.",
        "teachers" => "Each teacher who has a course this school year: what they were sent and what they did with it.",
        "students" => "Each student: what was posted to them and how much of it they opened.",
        _ => "The syllabi and the modules that were sent: did the teacher open it, post it, and did the students open it.",
    };

    private IReadOnlyList<PillTabs.Tab> Tabs => data is null
        ? [new("", "All", "list")]
        :
        [
            new("", "All", "list", data.NotOpened + data.Opened + data.Scheduled + data.Posted),
            new(DeliveryStates.NotOpened, "Not opened", "mail", data.NotOpened),
            new(DeliveryStates.Opened, "Opened · draft", "eye", data.Opened),
            new(DeliveryStates.Scheduled, "Scheduled", "calendar-clock", data.Scheduled),
            new(DeliveryStates.Posted, "Posted", "circle-check", data.Posted),
        ];

    protected override async Task OnParametersSetAsync()
    {
        // The links in the menu change the address of this same page (?tab=teachers), so the address is read every time it changes.
        var wantedPart = TabQuery is not null && Parts.Contains(TabQuery) ? TabQuery : "modules";
        if (data is not null && wantedPart == part && StateQuery == lastStateQuery)
        {
            return;
        }

        part = wantedPart;
        lastStateQuery = StateQuery;
        if (StateQuery is { } wanted && DeliveryStates.All.Contains(wanted))
        {
            state = wanted;
        }

        search = SearchQuery ?? "";
        kind = KindQuery is "Syllabus" or "Module" ? KindQuery : "";
        await ReloadAsync();
    }

    private string? lastStateQuery;

    private async Task PartChangedAsync(string? key)
    {
        part = key is not null && Parts.Contains(key) ? key : "modules";
        if (part == "modules")
        {
            await ReloadAsync();
        }
        else if (part == "exams")
        {
            await LoadExamsAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (part == "modules")
        {
            await ReloadAsync();
        }
        else if (part == "exams")
        {
            await LoadExamsAsync();
        }
        else if (usersPanel is not null)
        {
            await usersPanel.ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        nowUtc = Clock.GetUtcNow().UtcDateTime;
        options ??= await Provider.GetTrackingOptionsAsync();
        data = await Provider.ListTrackingAsync(new TrackingFilter(search, state, kind, pageNumber, SubjectId: subjectId));
        pageNumber = data.Page;
        if (part == "exams")
        {
            await LoadExamsAsync();
        }
    }

    private async Task LoadExamsAsync() => exams = await Provider.ListExamTrackingAsync(search);

    private async Task StateChangedAsync(string? key)
    {
        state = key ?? "";
        pageNumber = 1;
        await ReloadAsync();
    }

    private async Task ApplyAsync()
    {
        pageNumber = 1;
        await ReloadAsync();
    }

    private bool HasChoice => subjectId != 0;

    private async Task ClearChoicesAsync()
    {
        subjectId = 0;
        await ApplyAsync();
    }

    private async Task PreviousAsync()
    {
        pageNumber = Math.Max(1, pageNumber - 1);
        await ReloadAsync();
    }

    private async Task NextAsync()
    {
        pageNumber++;
        await ReloadAsync();
    }
}
