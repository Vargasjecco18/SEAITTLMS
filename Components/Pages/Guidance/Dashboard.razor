@page "/guidance"
@attribute [Authorize(Roles = AppRoles.GuidanceCounselor)]
@inject ReferralService Referrals
@inject TimeProvider Clock

<PageTitle>Dashboard · SEAITT Legazpi LMS</PageTitle>
<AutoRefresh />

@{
    var now = PhilippineTime.Now(Clock);
}

<PageHeader Title="@($"{PhilippineTime.Greeting(now)}, counselor")" IconName="layout-dashboard" />

@if (overview is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="stats">
        <StatCard Label="Students with concerns" Value="@overview.Students" IconName="flag" Accent="@(overview.Students > 0 ? AccentColor.Amber : AccentColor.Green)" Hint="Attendance or violation" Href="guidance/referrals?show=concerns" />
        <StatCard Label="Attendance" Value="@overview.Attendance" IconName="user-x" Accent="AccentColor.Violet" Hint="@($"Attendance under {AttendanceService.LowAttendancePercent:0}%")" Href="guidance/referrals?reason=LowAttendance" />
        <StatCard Label="Violations" Value="@overview.Violations" IconName="shield-alert" Accent="@(overview.Violations > 0 ? AccentColor.Rose : AccentColor.Green)" Hint="Broke a school rule" Href="guidance/referrals?reason=Violation" />
    </div>

    <div class="cards">
        <Card Title="New concerns" IconName="flag">
            @if (overview.Newest.Count == 0)
            {
                <EmptyState IconName="circle-check" Title="No concern yet">
                    <p>When a student keeps missing class, it appears here by itself. You can also record a violation for any student in Referrals.</p>
                </EmptyState>
            }
            else
            {
                <ul class="rows">
                    @foreach (var r in overview.Newest)
                    {
                        <li>
                            <a href="@($"guidance/referrals?reason={r.Reason}")">
                                <span class="row-icon @r.Reason.ToLowerInvariant()"><Icon Name="@ReasonIcon(r.Reason)" Size="18" /></span>
                                <span class="row-text">
                                    <span class="row-title">@r.StudentName</span>
                                    <span class="row-sub">@r.Detail@(r.Placement is null ? "" : " · " + r.Placement)</span>
                                </span>
                                <Badge Tone="@ReasonTone(r.Reason)">@ReferralReasons.Display(r.Reason)</Badge>
                            </a>
                        </li>
                    }
                </ul>
                <p class="more"><a href="guidance/referrals?show=concerns">Students with concerns <Icon Name="arrow-right" Size="14" /></a></p>
            }
        </Card>

        <Card Title="Students not attending class" IconName="user-x">
            @if (absent.Count == 0)
            {
                <EmptyState IconName="award" Title="Everybody is attending">
                    <p>Students whose attendance is under @AttendanceService.LowAttendancePercent.ToString("0")% are listed here.</p>
                </EmptyState>
            }
            else
            {
                <ul class="rows">
                    @foreach (var s in absent.Take(6))
                    {
                        <li>
                            <a href="guidance/referrals?reason=LowAttendance">
                                <span class="row-icon lowattendance"><Icon Name="user-x" Size="18" /></span>
                                <span class="row-text">
                                    <span class="row-title">@s.StudentName</span>
                                    <span class="row-sub">@s.SubjectName · @s.TeacherName@(s.Placement is null ? "" : " · " + s.Placement)</span>
                                </span>
                                <Badge Tone="Tone.Info">@(s.Metric is { } m ? $"{m:0.#}%" : "")</Badge>
                            </a>
                        </li>
                    }
                </ul>
                <p class="more"><a href="guidance/referrals?reason=LowAttendance">See them <Icon Name="arrow-right" Size="14" /></a></p>
            }
        </Card>
    </div>
}

@code {
    private GuidanceOverview? overview;
    private IReadOnlyList<AtRiskRow> absent = [];

    protected override async Task OnInitializedAsync()
    {
        overview = await Referrals.GetOverviewAsync();
        absent = await Referrals.GetAtRiskAsync(ReferralReasons.LowAttendance);
    }

    internal static string ReasonIcon(string reason) => reason switch
    {
        ReferralReasons.Violation => "shield-alert",
        _ => "user-x",
    };

    internal static Tone ReasonTone(string reason) => reason switch
    {
        ReferralReasons.Violation => Tone.Danger,
        _ => Tone.Info,
    };
}
