@page "/guidance/referrals"
@attribute [Authorize(Roles = AppRoles.GuidanceCounselor)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ReferralService Desk

<PageTitle>Referrals · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="Referrals" IconName="flag" />

<Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />

<Card>
    <p class="lead-line">You look after <strong>attendance</strong> and <strong>violations</strong>. Every student of the school is in the list: press <strong>At risk</strong> on a student to see their concerns, to add one, or to write what you did.</p>
    <form class="filter-bar one-row" role="search" @onsubmit="SearchAsync">
        <SearchField Id="r-search" @bind-Value="searchText" Label="Search" SubmitText="" Placeholder="Name, LRN, grade level, strand, section…"
                     AriaLabel="Search the students" OnClear="SearchAsync" />
        <Field For="r-show" Label="Show">
            <select id="r-show" value="@show" @onchange="ShowChanged">
                <option value="all" selected="@(show == "all")">All students</option>
                <option value="concerns" selected="@(show == "concerns")">Only students with a concern</option>
            </select>
        </Field>
        <Field For="r-reason" Label="Concern">
            <select id="r-reason" value="@reason" @onchange="ReasonChanged">
                <option value="">All</option>
                @foreach (var r in ReferralReasons.All)
                {
                    <option value="@r" selected="@(reason == r)">@ReferralReasons.Display(r)</option>
                }
            </select>
        </Field>
        <Field For="r-grade" Label="Grade level">
            <select id="r-grade" value="@grade" @onchange="GradeChanged">
                <option value="">All</option>
                <option value="11" selected="@(grade == "11")">Grade 11</option>
                <option value="12" selected="@(grade == "12")">Grade 12</option>
            </select>
        </Field>
    </form>

    @if (result is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (result.Items.Count == 0)
    {
        <EmptyState IconName="circle-check" Title="@(show == "all" ? "No student matches" : "No student with a concern here")">
            <p>@(show == "all" ? "Try another name, number or grade level." : "Attendance concerns appear by themselves. Choose All students to record a concern for anybody.")</p>
        </EmptyState>
    }
    else
    {
        <p class="filter-count">@(result.Total == 1 ? "1 student" : $"{result.Total:N0} students")</p>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col" class="col-level">Grade level</th>
                        <th scope="col">Strand</th>
                        <th scope="col">Section</th>
                        <th scope="col">Concerns</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Open</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in result.Items)
                    {
                        <tr>
                            <td>
                                <span class="name">@student.StudentName</span>
                                <span class="sub">@student.Lrn</span>
                            </td>
                            <td class="col-level">@(student.GradeLevel is { } level ? $"Grade {level}" : "—")</td>
                            <td>@(student.Strand ?? "—")</td>
                            <td>@(student.Placement ?? "—")</td>
                            <td>
                                @if (!student.HasOpen)
                                {
                                    <span class="muted">None</span>
                                }
                                else
                                {
                                    <span class="reasons">
                                        @foreach (var r in student.Reasons)
                                        {
                                            <Badge Tone="@Pages.Guidance.Dashboard.ReasonTone(r)">@ReferralReasons.Display(r)</Badge>
                                        }
                                    </span>
                                }
                            </td>
                            <td class="col-actions">
                                <Button Small="true" Variant="@(student.HasOpen ? ButtonVariant.Danger : ButtonVariant.Secondary)" IconName="shield-alert" Title="@(student.HasOpen ? "A concern is open: press to see it" : "No concern now: press to add one")" OnClick="() => ViewAll(student)">At risk</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (result.PageCount > 1)
        {
            <nav class="pager" aria-label="Pages">
                <Button Variant="ButtonVariant.Secondary" Small="true" IconName="chevron-left" Disabled="@(result.Page <= 1)" OnClick="PreviousAsync">Previous</Button>
                <span class="muted">Page @result.Page of @result.PageCount · @result.Total students</span>
                <Button Variant="ButtonVariant.Secondary" Small="true" IconAfter="true" IconName="chevron-right" Disabled="@(result.Page >= result.PageCount)" OnClick="NextAsync">Next</Button>
            </nav>
        }
    }
</Card>

@* ===== One student: their concerns (Notes and Solved at the top right), the earlier ones, and a place to add one ===== *@
<Modal Open="viewing is not null" Title="@(viewing?.StudentName ?? "")" OnClose="CloseViewAll" Large="true">
    @if (viewing is not null)
    {
        <div class="modal-top">
            <p class="sub all-sub">@viewing.Lrn@(viewing.GradeLevel is { } viewLevel ? $" · Grade {viewLevel}" : "")@(viewing.Strand is null ? "" : " · " + viewing.Strand)@(viewing.Placement is null ? "" : " · " + viewing.Placement)</p>
            <div class="top-actions">
                <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" Disabled="@(!viewing.HasOpen)" OnClick="OpenNotes">Notes</Button>
                <Button Small="true" IconName="circle-check" Disabled="@(busy || !viewing.HasOpen)" OnClick="SolveAsync">Solved</Button>
            </div>
        </div>

        <FormErrors Errors="formErrors" />

        @if (viewing.OpenReferrals.Count == 0)
        {
            <p class="muted none-yet">No concern now.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table all-table">
                    <thead>
                        <tr>
                            <th scope="col">Concern</th>
                            <th scope="col">What was found or what happened</th>
                            <th scope="col" class="col-more">Since</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in Grouped(viewing.OpenReferrals))
                        {
                            var first = group.Rows[0];
                            <tr>
                                <td>
                                    <Badge Tone="@Pages.Guidance.Dashboard.ReasonTone(group.Reason)">@ReferralReasons.Display(group.Reason)</Badge>
                                </td>
                                <td>
                                    @if (group.Rows.Count > 1)
                                    {
                                        @* Several attendance concerns found on the same day: one line with a button that shows each course. *@
                                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="@(openGroups.Contains(group.Key) ? "chevron-up" : "eye")" OnClick="() => ToggleGroup(group.Key)">@(openGroups.Contains(group.Key) ? "Hide attendance" : $"View attendance ({group.Rows.Count} courses)")</Button>
                                        @if (openGroups.Contains(group.Key))
                                        {
                                            <ul class="attendance-list">
                                                @foreach (var line in group.Rows)
                                                {
                                                    <li>@line.Detail</li>
                                                }
                                            </ul>
                                        }
                                    }
                                    else
                                    {
                                        <span class="detail">@first.Detail</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(first.Intervention))
                                    {
                                        <span class="sub">Help: @first.Intervention</span>
                                    }
                                </td>
                                <td class="col-more">@PhilippineTime.FormatDate(group.Since)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (viewing.PreviousReferrals.Count > 0)
        {
            <div class="previous-bar">
                <Button Small="true" Variant="ButtonVariant.Ghost" IconName="history" OnClick="() => showPrevious = !showPrevious">@(showPrevious ? "Hide previous concerns" : $"Previous concerns ({viewing.PreviousReferrals.Count})")</Button>
            </div>
            @if (showPrevious)
            {
                <ul class="previous-list">
                    @foreach (var old in viewing.PreviousReferrals)
                    {
                        <li>
                            <Badge Tone="@Pages.Guidance.Dashboard.ReasonTone(old.Reason)">@ReferralReasons.Display(old.Reason)</Badge>
                            <span class="detail">@old.Detail</span>
                            <span class="sub">Since @PhilippineTime.FormatDate(old.CreatedAtUtc)@(old.ResolvedAtUtc is { } solved ? $" · solved {PhilippineTime.FormatDate(solved)}" : "")@(string.IsNullOrWhiteSpace(old.Intervention) ? "" : $" · help: {old.Intervention}")</span>
                            @if (!string.IsNullOrWhiteSpace(old.Notes))
                            {
                                <span class="sub">Notes: @old.Notes</span>
                            }
                        </li>
                    }
                </ul>
            }
        }

        <h3 class="add-title">Add a concern</h3>
        <div class="two">
            <Field For="a-reason" Label="What is it?" Required="true">
                <select id="a-reason" value="@newReason" @onchange="ReasonPicked">
                    <option value="">None</option>
                    @foreach (var r in ReferralReasons.All)
                    {
                        <option value="@r" selected="@(newReason == r)">@ReferralReasons.Display(r)</option>
                    }
                </select>
            </Field>
            <Field For="a-happened" Label="What happened?" Required="true">
                <select id="a-happened" value="@newHappened" disabled="@(newReason == "")" @onchange="e => newHappened = e.Value?.ToString() ?? string.Empty">
                    <option value="">@(newReason == "" ? "Choose what it is first" : "Choose what happened")</option>
                    @foreach (var choice in newReason == "" ? [] : ReferralService.HappenedChoices(newReason))
                    {
                        <option value="@choice" selected="@(newHappened == choice)">@choice</option>
                    }
                </select>
            </Field>
        </div>
        <Field For="a-more" Label="More about it" Hint="Optional. Only you can read this.">
            <textarea id="a-more" rows="2" maxlength="400" value="@newMore" @onchange="e => newMore = e.Value?.ToString() ?? string.Empty"></textarea>
        </Field>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseViewAll">Close</Button>
            <Button IconName="plus" Disabled="busy" OnClick="AddConcernAsync">@(busy ? "Adding…" : "Add the concern")</Button>
        </div>
    }
</Modal>

@* ===== The help given and the notes of the student ===== *@
<Modal Open="notesOpen" Title="@($"Notes · {viewing?.StudentName}")" OnClose="CloseNotes">
    @if (notesOpen && viewing is not null)
    {
        <FormErrors Errors="formErrors" />

        <Field For="w-help" Label="Help given">
            <select id="w-help" value="@editIntervention" @onchange="e => editIntervention = e.Value?.ToString() ?? string.Empty">
                <option value="">Not decided yet</option>
                @foreach (var i in InterventionTypes.All)
                {
                    <option value="@i" selected="@(editIntervention == i)">@i</option>
                }
            </select>
        </Field>

        <Field For="w-notes" Label="Notes" Hint="Only you can read these.">
            <textarea id="w-notes" rows="4" maxlength="1000" value="@editNotes" @onchange="e => editNotes = e.Value?.ToString() ?? string.Empty"></textarea>
        </Field>

        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseNotes">Cancel</Button>
            <Button IconName="circle-check" Disabled="busy" OnClick="SaveAsync">@(busy ? "Saving…" : "Save")</Button>
        </div>
    }
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "show")] private string? ShowQuery { get; set; }

    [SupplyParameterFromQuery(Name = "reason")] private string? ReasonQuery { get; set; }

    [SupplyParameterFromQuery(Name = "q")] private string? SearchQuery { get; set; }

    private int userId;
    private string show = "all";
    private string reason = "";
    private string newReason = "";
    private string newHappened = "";
    private string newMore = "";
    private bool showPrevious;
    private bool notesOpen;
    private readonly HashSet<string> openGroups = [];
    private string grade = "";
    private string searchText = "";
    private string appliedSearch = "";
    private int pageNumber = 1;
    private ReferralStudentPage? result;
    private ReferralStudentRow? viewing;
    private string editIntervention = "";
    private string editNotes = "";
    private string? message;
    private bool messageIsError;
    private bool busy;
    private List<string> formErrors = [];

    protected override async Task OnInitializedAsync()
    {
        userId = (await Me.GetAsync())?.UserId ?? 0;
        // The page opens on the whole school; "With concerns" in the menu, and a choice of concern, open only the students who have one.
        show = ShowQuery == "concerns" || ReferralReasons.All.Contains(ReasonQuery ?? "") ? "concerns" : "all";
        reason = ReferralReasons.All.Contains(ReasonQuery ?? "") ? ReasonQuery! : "";
        searchText = appliedSearch = SearchQuery?.Trim() ?? "";
        await LoadAsync();
    }

    private void ClearMessage() => message = null;

    private async Task LoadAsync()
    {
        result = show == "all" && reason == ""
            ? await Desk.ListAllStudentsAsync(appliedSearch, pageNumber, grade == "" ? null : int.Parse(grade))
            : await Desk.ListByStudentAsync(null, reason == "" ? null : reason, appliedSearch, pageNumber, grade == "" ? null : int.Parse(grade));
    }

    /// <summary>The student that is open stays up to date after a concern is added or saved.</summary>
    private async Task RefreshViewingAsync()
    {
        if (viewing is null)
        {
            return;
        }

        var row = viewing;
        var fresh = await Desk.ListAllStudentsAsync(row.Lrn, 1);
        viewing = fresh.Items.FirstOrDefault(x => x.StudentId == row.StudentId) ?? row;
    }

    private void ViewAll(ReferralStudentRow student)
    {
        formErrors = [];
        newReason = "";
        newHappened = "";
        newMore = "";
        showPrevious = false;
        openGroups.Clear();
        viewing = student;
    }

    private void CloseViewAll()
    {
        viewing = null;
        notesOpen = false;
    }

    private void ReasonPicked(ChangeEventArgs e)
    {
        newReason = e.Value?.ToString() ?? "";
        newHappened = "";
    }

    private void ToggleGroup(string key)
    {
        if (!openGroups.Remove(key))
        {
            openGroups.Add(key);
        }
    }

    /// <summary>One line of the list of concerns: attendance concerns found on the same day are one line (View attendance shows each course); a violation is a line of its own.</summary>
    private sealed record ConcernGroup(string Key, string Reason, DateTime Since, IReadOnlyList<ReferralRow> Rows);

    private static IReadOnlyList<ConcernGroup> Grouped(IReadOnlyList<ReferralRow> open) =>
        [.. open.GroupBy(r => r.Reason == ReferralReasons.LowAttendance ? $"{r.Reason}-{PhilippineTime.DayOf(r.CreatedAtUtc):yyyyMMdd}" : $"{r.Reason}-{r.Id}")
            .Select(g => new ConcernGroup(g.Key, g.First().Reason, g.Min(r => r.CreatedAtUtc), [.. g.OrderBy(r => r.SubjectName)]))
            .OrderByDescending(g => g.Since)];

    private async Task ShowChanged(ChangeEventArgs e)
    {
        show = e.Value?.ToString() == "all" ? "all" : "concerns";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task AddConcernAsync()
    {
        if (viewing is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var saved = await Desk.AddConcernAsync(viewing.StudentId, newReason, newHappened, newMore, userId);
            if (!saved.Succeeded)
            {
                formErrors = [.. saved.Errors];
                return;
            }

            formErrors = [];
            newReason = "";
            newHappened = "";
            newMore = "";
            messageIsError = false;
            message = saved.Message;
            await LoadAsync();
            await RefreshViewingAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ReasonChanged(ChangeEventArgs e)
    {
        reason = e.Value?.ToString() ?? "";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task GradeChanged(ChangeEventArgs e)
    {
        grade = e.Value?.ToString() ?? "";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        appliedSearch = searchText.Trim();
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task PreviousAsync()
    {
        pageNumber--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        pageNumber++;
        await LoadAsync();
    }

    private void OpenNotes()
    {
        if (viewing is null)
        {
            return;
        }

        formErrors = [];
        var latest = viewing.OpenReferrals.OrderByDescending(r => r.CreatedAtUtc).FirstOrDefault();
        editIntervention = latest?.Intervention ?? "";
        editNotes = latest?.Notes ?? "";
        notesOpen = true;
    }

    private void CloseNotes() => notesOpen = false;

    private async Task SaveAsync()
    {
        if (viewing is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var saved = await Desk.SaveStudentNotesAsync(viewing.StudentId, editIntervention, editNotes, userId);
            if (!saved.Succeeded)
            {
                formErrors = [.. saved.Errors];
                return;
            }

            notesOpen = false;
            messageIsError = false;
            message = $"{viewing.StudentName}: {saved.Message}";
            await LoadAsync();
            await RefreshViewingAsync();
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Solved: the concerns move to Previous concerns and the At risk button of the student is white again.</summary>
    private async Task SolveAsync()
    {
        if (viewing is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var solved = await Desk.SolveStudentAsync(viewing.StudentId, userId);
            if (!solved.Succeeded)
            {
                formErrors = [.. solved.Errors];
                return;
            }

            formErrors = [];
            messageIsError = false;
            message = solved.Message;
            await LoadAsync();
            await RefreshViewingAsync();
        }
        finally
        {
            busy = false;
        }
    }
}
