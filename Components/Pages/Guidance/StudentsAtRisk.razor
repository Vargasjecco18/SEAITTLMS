@page "/guidance/students"
@attribute [Authorize(Roles = AppRoles.GuidanceCounselor)]
@inject ReferralService Referrals

<PageTitle>Students at risk · SEAITT e-LMS</PageTitle>

<PageHeader Title="Students at risk" Subtitle="@($"Students with a grade below {GradeRules.PassingPercent:0}, students close to failing or missing work, and students who miss class.")" IconName="triangle-alert" />

<nav class="tabs" aria-label="Kind of problem">
    @foreach (var tab in Tabs)
    {
        <a class="tab @(tab.Key == Kind ? "on" : "")" href="@tab.Href" aria-current="@(tab.Key == Kind ? "page" : null)">
            <Icon Name="@tab.Icon" Size="16" />
            <span>@tab.Label</span>
            <span class="count">@(rows is null ? "" : CountOf(tab.Key))</span>
        </a>
    }
</nav>

<Card>
    @if (rows is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (shown.Count == 0)
    {
        <EmptyState IconName="circle-check" Title="Nobody here">
            <p>No student has this problem right now.</p>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Student</th>
                        <th scope="col">Subject</th>
                        <th scope="col" class="col-more">Teacher</th>
                        <th scope="col">@(Kind == ReferralReasons.LowAttendance ? "Attendance" : "Grade")</th>
                        <th scope="col">Problem</th>
                        <th scope="col">Referral</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in shown)
                    {
                        <tr>
                            <td>
                                <span class="name">@r.StudentName</span>
                                <span class="sub">@r.Lrn@(r.Placement is null ? "" : " · " + r.Placement)</span>
                            </td>
                            <td>@r.SubjectName</td>
                            <td class="col-more">@r.TeacherName</td>
                            <td>@if (r.Metric is { } m) { <Badge Tone="@(r.Reason == ReferralReasons.FailingGrades ? Tone.Danger : r.Reason == ReferralReasons.AtRisk ? Tone.Warning : Tone.Info)">@m.ToString("0.#")%</Badge> } else { <span class="muted">—</span> }</td>
                            <td><Badge Tone="@Pages.Guidance.Dashboard.ReasonTone(r.Reason)">@ReferralReasons.Display(r.Reason)</Badge><span class="detail">@r.Detail</span></td>
                            <td>
                                @if (r.ReferralStatus is { } status)
                                {
                                    <a class="ref" href="guidance/referrals?status=@status">@ReferralStatus.Display(status)</a>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Card>

@code {
    private sealed record TabInfo(string Key, string Label, string Icon, string Href);

    private static readonly TabInfo[] Tabs =
    [
        new(ReferralReasons.FailingGrades, "Failing", "trending-down", "guidance/students"),
        new(ReferralReasons.AtRisk, "At risk", "shield-alert", "guidance/students?kind=AtRisk"),
        new(ReferralReasons.LowAttendance, "Not attending", "user-x", "guidance/students?kind=LowAttendance"),
    ];

    [SupplyParameterFromQuery(Name = "kind")] private string? KindText { get; set; }

    private string Kind => Tabs.Any(t => t.Key == KindText) ? KindText! : ReferralReasons.FailingGrades;

    private IReadOnlyList<AtRiskRow>? rows;
    private IReadOnlyList<AtRiskRow> shown = [];

    protected override async Task OnParametersSetAsync()
    {
        await Referrals.EvaluateAsync();
        rows = await Referrals.GetAtRiskAsync(null);
        shown = rows.Where(r => r.Reason == Kind).ToList();
    }

    private int CountOf(string kind) => rows!.Count(r => r.Reason == kind);
}
