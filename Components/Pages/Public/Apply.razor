@page "/apply"
@layout BlankLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using System.Globalization
@using SEAITT_LMS.Services
@inject ApplicationService Applications
@inject TimeProvider Clock

<PageTitle>Student application · SEAITT Legazpi LMS</PageTitle>

@* The student application: for a new Grade 11 student. It has five parts (personal, contact, academic, parent / guardian, papers) and the day the student will come to the school to confirm it. *@
<div class="apply">
    <header class="apply-head">
        <a class="logo-link" href="/" aria-label="Home page"><img src="@Assets["images/logo.png"]" alt="" width="56" height="56" /></a>
        <div>
            <h1>Student application</h1>
            <p>South East Asia Institute of Trade and Technology · <strong>Grade 11</strong></p>
        </div>
        <a class="back" href="/">Back to the home page</a>
    </header>

    @if (sentMessage is not null)
    {
        <section class="done" role="status" aria-live="polite">
            <span class="done-icon"><Icon Name="circle-check" Size="34" /></span>
            <h2>Application sent</h2>
            <p>@sentMessage</p>
            <p class="muted">Keep your reference. The admission office will look at your application. <strong>Your application is not final until you come to the school</strong> on the day you chose, with the original papers.</p>
            <a class="button primary" href="/"><span>Back to the home page</span></a>
        </section>
    }
    else if (choices is null)
    {
        <p class="muted">Loading…</p>
    }
    else
    {
        <div class="info-box" role="note">
            <Icon Name="info" Size="20" />
            <div>
                <strong>Before you start</strong>
                <ul>
                    <li>This application is for <strong>Grade 11</strong> only. Fields with a star (*) are needed.</li>
                    <li>Have the four papers ready as a PDF, a JPG or a PNG (up to 5 MB each).</li>
                    <li><strong>You will have to go to the school to confirm your application.</strong> Choose the day and the hour you will come in part 6: the admission office is told.</li>
                </ul>
            </div>
        </div>

        <FormErrors Errors="errors" />

        <section class="part" aria-labelledby="p1">
            <h2 id="p1"><span class="n">1</span> Personal information</h2>
            <div class="grid">
                <Field For="first-name" Label="First name" Required="true"><input id="first-name" type="text" maxlength="100" autocomplete="given-name" data-letters @bind="a.FirstName" /></Field>
                <Field For="middle-name" Label="Middle name"><input id="middle-name" type="text" maxlength="100" autocomplete="additional-name" data-letters @bind="a.MiddleName" /></Field>
                <Field For="last-name" Label="Last name" Required="true"><input id="last-name" type="text" maxlength="100" autocomplete="family-name" data-letters @bind="a.LastName" /></Field>
                <Field For="suffix" Label="Suffix" Hint="Optional"><SelectOther Id="suffix" AriaLabel="Suffix" Choices="PhilippineAddresses.SuffixChoices()" Placeholder="None" MaxLength="20" @bind-Value="a.Suffix" /></Field>
                <Field For="birth" Label="Date of birth" Required="true"><input id="birth" type="date" max="@Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" value="@(a.BirthDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" @onchange="e => a.BirthDate = ParseDay(e.Value?.ToString())" /></Field>
                <Field For="sex" Label="Sex" Required="true">
                    <select id="sex" @bind="a.Sex">
                        <option value="">Choose</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </Field>
                <Field For="civil" Label="Civil status" Required="true"><SelectOther Id="civil" AriaLabel="Civil status" Choices="[.. PhilippineAddresses.CivilStatuses, PhilippineAddresses.Others]" MaxLength="30" @bind-Value="a.CivilStatus" /></Field>
                <Field For="nationality" Label="Nationality" Required="true"><SelectOther Id="nationality" AriaLabel="Nationality" Choices="[.. PhilippineAddresses.Nationalities, PhilippineAddresses.Others]" MaxLength="60" @bind-Value="a.Nationality" /></Field>
                <Field For="religion" Label="Religion" Required="true"><SelectOther Id="religion" AriaLabel="Religion" Choices="[.. PhilippineAddresses.Religions, PhilippineAddresses.Others]" MaxLength="80" @bind-Value="a.Religion" /></Field>
                <Field For="lrn" Label="LRN" Hint="Your 12-digit Learner Reference Number, if you have it."><input id="lrn" type="text" inputmode="numeric" data-digits maxlength="12" autocomplete="off" @bind="a.Lrn" /></Field>
            </div>
        </section>

        <section class="part" aria-labelledby="p2">
            <h2 id="p2"><span class="n">2</span> Contact information</h2>
            <div class="grid">
                <Field For="email" Label="Email address" Required="true"><input id="email" type="email" maxlength="254" autocomplete="email" @bind="a.Email" /></Field>
                <Field For="mobile" Label="Mobile number" Required="true" Hint="Like 09171234567"><input id="mobile" type="tel" inputmode="numeric" data-digits maxlength="12" autocomplete="tel" @bind="a.MobileNumber" /></Field>
                <Field For="address" Label="Complete address" Required="true" Class="wide" Hint="House number, street, subdivision or purok"><input id="address" type="text" maxlength="250" autocomplete="street-address" @bind="a.Address" /></Field>
                <Field For="province" Label="Province" Required="true"><SelectOther Id="province" AriaLabel="Province" Choices="PhilippineAddresses.ProvinceChoices()" Value="@a.Province" ValueChanged="ProvinceChanged" /></Field>
                <Field For="city" Label="City / municipality" Required="true"><SelectOther Id="city" AriaLabel="City or municipality" Choices="PhilippineAddresses.CityChoices(a.Province)" Value="@a.City" ValueChanged="CityChanged" /></Field>
                <Field For="barangay" Label="Barangay" Required="true"><SelectOther Id="barangay" AriaLabel="Barangay" Choices="PhilippineAddresses.BarangayChoices(a.City)" @bind-Value="a.Barangay" /></Field>
                <Field For="zip" Label="ZIP code" Required="true"><input id="zip" type="text" inputmode="numeric" data-digits maxlength="10" autocomplete="postal-code" @bind="a.ZipCode" /></Field>
            </div>
        </section>

        <section class="part" aria-labelledby="p3">
            <h2 id="p3"><span class="n">3</span> Academic information</h2>
            <div class="grid">
                <Field For="grade" Label="Applying grade level" Hint="The application is for Grade 11."><input id="grade" type="text" value="Grade 11" readonly /></Field>
                <Field For="year" Label="Academic year" Required="true">
                    <select id="year" @bind="a.AcademicYear">
                        <option value="">Choose</option>
                        @foreach (var year in choices.AcademicYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </Field>
                <Field For="term" Label="Semester / term" Required="true">
                    <select id="term" @bind="a.TermNumber">
                        @foreach (var term in choices.Terms)
                        {
                            <option value="@term.Number">@term.Name</option>
                        }
                    </select>
                </Field>
                <Field For="track" Label="Track" Required="true">
                    <select id="track" value="@a.TrackId" @onchange="TrackChanged">
                        <option value="0">Choose a track</option>
                        @foreach (var track in choices.Tracks)
                        {
                            <option value="@track.Id">@track.Code · @track.Name</option>
                        }
                    </select>
                </Field>
                <Field For="strand" Label="Strand" Required="true">
                    <select id="strand" disabled="@(a.TrackId == 0)" @bind="a.StrandId">
                        <option value="0">@(a.TrackId == 0 ? "Choose a track first" : "Choose a strand")</option>
                        @foreach (var strand in StrandsOfTrack)
                        {
                            <option value="@strand.Id">@strand.Code · @strand.Name</option>
                        }
                    </select>
                </Field>
            </div>
        </section>

        <section class="part" aria-labelledby="p4">
            <h2 id="p4"><span class="n">4</span> Parent / guardian information</h2>
            <div class="grid">
                <Field For="father" Label="Father's full name"><input id="father" type="text" maxlength="150" data-letters @bind="a.FatherName" /></Field>
                <Field For="father-phone" Label="Father's contact number"><input id="father-phone" type="tel" inputmode="numeric" data-digits maxlength="12" @bind="a.FatherContact" /></Field>
                <Field For="mother" Label="Mother's full name"><input id="mother" type="text" maxlength="150" data-letters @bind="a.MotherName" /></Field>
                <Field For="mother-phone" Label="Mother's contact number"><input id="mother-phone" type="tel" inputmode="numeric" data-digits maxlength="12" @bind="a.MotherContact" /></Field>
                <Field For="guardian" Label="Guardian's full name" Required="true"><input id="guardian" type="text" maxlength="150" data-letters @bind="a.GuardianName" /></Field>
                <Field For="relationship" Label="Relationship to student" Required="true"><SelectOther Id="relationship" AriaLabel="Relationship to student" Choices="[.. PhilippineAddresses.Relationships, PhilippineAddresses.Others]" MaxLength="50" @bind-Value="a.GuardianRelationship" /></Field>
                <Field For="guardian-phone" Label="Guardian's contact number" Required="true"><input id="guardian-phone" type="tel" inputmode="numeric" data-digits maxlength="12" @bind="a.GuardianContact" /></Field>
                <Field For="guardian-address" Label="Guardian's address" Required="true"><input id="guardian-address" type="text" maxlength="250" @bind="a.GuardianAddress" /></Field>
            </div>
        </section>

        <section class="part" aria-labelledby="p5">
            <h2 id="p5"><span class="n">5</span> Requirements upload</h2>
            <p class="muted">A PDF, a JPG or a PNG, up to @(ApplicationService.MaxFileBytes / 1024 / 1024) MB each. The admission office and the registrar can open them.</p>
            <ul class="uploads">
                @foreach (var kind in ApplicationFileKinds.All)
                {
                    var k = kind;
                    <li class="upload @(files.ContainsKey(k) ? "has" : "")">
                        <div class="upload-text">
                            <strong>@ApplicationFileKinds.Display(k) <span class="required" aria-hidden="true">*</span></strong>
                            @if (files.TryGetValue(k, out var chosen))
                            {
                                <span class="upload-name"><Icon Name="file-check" Size="15" /> @chosen.Name · @(chosen.Data.Length / 1024) KB</span>
                            }
                            else
                            {
                                <span class="muted">Nothing chosen yet</span>
                            }
                        </div>
                        <div class="upload-actions">
                            <label class="button secondary small" for="@("file-" + k)"><Icon Name="upload" Size="15" /> <span>@(files.ContainsKey(k) ? "Change" : "Choose a file")</span></label>
                            <InputFile id="@("file-" + k)" class="file-input" accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" OnChange="e => ChooseAsync(k, e)" />
                            @if (files.ContainsKey(k))
                            {
                                <button type="button" class="button ghost small" @onclick="() => files.Remove(k)">Remove</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>

        <section class="part" aria-labelledby="p6">
            <h2 id="p6"><span class="n">6</span> Come to the school</h2>
            <div class="info-box visit" role="note">
                <Icon Name="calendar-clock" Size="20" />
                <div>
                    <strong>You will go to the school to confirm your application.</strong>
                    <p>Choose the day and the hour you will come, from Monday to Friday, 8:00 AM to 5:00 PM. The admission office is told, so they wait for you. Bring the original papers.</p>
                </div>
            </div>
            <div class="grid">
                <Field For="visit-day" Label="Day" Required="true"><input id="visit-day" type="date" min="@Tomorrow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" max="@Today.AddDays(60).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" value="@visitDay" @onchange="e => visitDay = e.Value?.ToString() ?? string.Empty" /></Field>
                <Field For="visit-time" Label="Hour" Required="true">
                    <select id="visit-time" @bind="visitTime">
                        <option value="">Choose</option>
                        @foreach (var hour in VisitHours)
                        {
                            <option value="@hour.Value">@hour.Label</option>
                        }
                    </select>
                </Field>
            </div>
        </section>

        <div class="submit-row">
            <FormErrors Errors="errors" />
            <Button IconName="send" Disabled="busy" OnClick="SubmitAsync">@(busy ? "Sending…" : "Send my application")</Button>
        </div>
    }
</div>

@code {
    private readonly ApplicationInput a = new() { Nationality = "Filipino" };
    private readonly Dictionary<string, ApplicationUpload> files = [];
    private ApplicationService.FormChoices? choices;
    private IReadOnlyList<string> errors = [];
    private string? sentMessage;
    private bool busy;
    private string visitDay = "";
    private string visitTime = "";

    private DateOnly Today => PhilippineTime.Today(Clock);
    private DateOnly Tomorrow => Today.AddDays(1);

    private IEnumerable<(int Id, string Code, string Name)> StrandsOfTrack => choices?.Tracks.FirstOrDefault(t => t.Id == a.TrackId).Strands ?? [];

    private static IEnumerable<(string Value, string Label)> VisitHours =>
        Enumerable.Range(16, 18).Select(n => TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(n * 30))).Where(t => t.Hour is >= 8 and <= 16).Select(t => (t.ToString("HH:mm", CultureInfo.InvariantCulture), t.ToString("h:mm tt", CultureInfo.InvariantCulture)));

    protected override async Task OnInitializedAsync()
    {
        choices = await Applications.GetChoicesAsync();
        if (choices.AcademicYears.Count > 0)
        {
            a.AcademicYear = choices.AcademicYears[0];
        }

        if (choices.Terms.Count > 0)
        {
            a.TermNumber = (byte)choices.Terms[0].Number;
        }
    }

    private static DateOnly? ParseDay(string? text) =>
        DateOnly.TryParseExact(text, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day) ? day : null;

    private Task ProvinceChanged(string value)
    {
        if (a.Province != value)
        {
            a.Province = value;
            a.City = "";
            a.Barangay = "";
        }

        return Task.CompletedTask;
    }

    private Task CityChanged(string value)
    {
        if (a.City != value)
        {
            a.City = value;
            a.Barangay = "";
        }

        return Task.CompletedTask;
    }

    private void TrackChanged(ChangeEventArgs e)
    {
        a.TrackId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        a.StrandId = 0;
    }

    private async Task ChooseAsync(string kind, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > ApplicationService.MaxFileBytes)
        {
            errors = [$"{ApplicationFileKinds.Display(kind)}: the file can be up to {ApplicationService.MaxFileBytes / 1024 / 1024} MB."];
            return;
        }

        try
        {
            using var memory = new MemoryStream();
            await file.OpenReadStream(ApplicationService.MaxFileBytes).CopyToAsync(memory);
            files[kind] = new ApplicationUpload(kind, file.Name, file.ContentType, memory.ToArray());
            errors = [];
        }
        catch (IOException)
        {
            errors = [$"{ApplicationFileKinds.Display(kind)}: the file could not be read. Choose it again."];
        }
    }

    private async Task SubmitAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            a.VisitAtLocal = DateTime.TryParse($"{visitDay} {visitTime}", CultureInfo.InvariantCulture, DateTimeStyles.None, out var visit) ? visit : null;
            var result = await Applications.SubmitAsync(a, [.. files.Values]);
            if (!result.Succeeded)
            {
                errors = [.. result.Errors];
                return;
            }

            errors = [];
            sentMessage = result.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
