@page "/login"
@layout BlankLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.Extensions.Options
@using SEAITT_LMS.Auth
@using SEAITT_LMS.Services
@inject AuthService Auth
@inject IOptions<AuthOptions> AuthSettings
@inject SystemSettingsService SystemSettings
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject SessionWatcher Watcher

<PageTitle>Log-in · SEAITT Legazpi LMS</PageTitle>

<div class="login">
    <section class="panel">
        <a class="logo-link" href="/" aria-label="@(SystemSettings.Current.SchoolTitle), home page">
            <img class="logo" src="@Assets["images/logo.png"]" alt="" width="72" height="72" />
        </a>

        <h1>@SystemSettings.Current.SchoolShortName LMS</h1>
        <p class="subtitle">Log-in to access your courses</p>

        @if (Notice == "password-changed")
        {
            <p class="login-notice" role="status"><Icon Name="circle-check" Size="18" /> <span>Your password was changed. Log in with your new password.</span></p>
        }

        @* The alert at the top center: the account is in use (this page's own answer), or the one the address asks for (?alert=other-device: the sign-in of this browser was ended). *@
        <TopAlert Name="@(accountInUse ? "in-use" : null)" />

        <FormErrors Errors="@(string.IsNullOrEmpty(errorMessage) ? Array.Empty<string>() : new[] { errorMessage })" />

        <EditForm Model="Input" FormName="login" method="post" OnValidSubmit="SignInAsync">
            <DataAnnotationsValidator />

            @* The time that is left while the account is locked, over the email. It counts down by itself (wwwroot/app.js, "data-lock-seconds"). *@
            @if (SecondsLeft > 0)
            {
                <div class="lock-timer" role="status" data-lock-seconds="@SecondsLeft">
                    <span class="lock-icon"><Icon Name="lock" Size="20" /></span>
                    <div class="lock-text">
                        <strong>@(string.IsNullOrEmpty(lockedEmail) ? "This account is locked" : $"{lockedEmail} is locked")</strong>
                        <span class="lock-wait">Too many wrong attempts. Nobody can login here until the time is over: <b class="lock-clock">@Mmss(SecondsLeft)</b></span>
                        <span class="lock-done" hidden>The time is over. You can try to login again.</span>
                    </div>
                </div>
            }

            <div class="field">
                <label for="email">Email</label>
                <InputText id="email" type="email" @bind-Value="Input.Email" placeholder="lastname.lrn@legazpi.seaitt.edu.ph" autocomplete="username" autofocus />
                <ValidationMessage For="() => Input.Email" class="field-error" />
            </div>

            <div class="field">
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" placeholder="Enter your password" autocomplete="current-password" />
                <ValidationMessage For="() => Input.Password" class="field-error" />
            </div>

            <p class="session-note">You are signed out when you close the browser, or when the page has been closed for a few minutes.</p>

            <button type="submit" class="submit">Login</button>
        </EditForm>

        <a class="back" href="/">Back to the home page</a>
    </section>

    @* The school on the right. The picture is wwwroot/images/hero/login-photo.jpg. *@
    <div class="photo">
        <img src="@Assets["images/hero/login-photo.jpg"]" alt="The South East-Asia Institute of Trade and Technology building" />
    </div>
</div>

@code {
    private string? errorMessage;

    /// <summary>The right password was typed, but the account is signed in on another browser or device: the alert at the top says so.</summary>
    private bool accountInUse;

    /// <summary>The moment the account that was tried is unlocked (a lock this browser saw: the answer of the sign-in, or the cookie of an earlier try).</summary>
    private DateTime? lockedUntil;
    private string? lockedEmail;

    private const string LockCookie = "seaitt_login_lock";
    private const string LastUserCookie = "seaitt_last_user";

    private int SecondsLeft => lockedUntil is { } until ? Math.Max(0, (int)Math.Ceiling((until - Clock.GetUtcNow().UtcDateTime).TotalSeconds)) : 0;

    private static string Mmss(int seconds) => $"{seconds / 60:00}:{seconds % 60:00}";

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery] private string? Notice { get; set; }

    [SupplyParameterFromForm] private LoginInput Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        // Somebody is signed in on this browser and came to the login page (the Back button, or the address was typed): they are signed out at once, with no countdown and no message, and
        // the login page is what they see. (Going back out of the system, or closing the browser, ends the sign-in the same way.)
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            if (int.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId))
            {
                var session = HttpContext.User.FindFirstValue(AppClaimTypes.SessionId);
                await Auth.EndSessionAsync(userId, session, HttpContext.RequestAborted);
                Watcher.End(userId, session);
            }

            await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        }

        // The page is opened again while the timer of this browser still runs: it is still there.
        if (LockOfThisBrowser() is { } browserLock)
        {
            lockedUntil = browserLock.Until;
            lockedEmail = browserLock.Email;
        }
    }

    /// <summary>
    /// The lock of this browser: set when an account is locked by the tries made here (or the account tried here was locked already), it lasts as long as the timer.
    /// It is what the timer on the page shows, so while it runs no sign-in is accepted from this browser, for any email. (The account has its own lock in the database too.)
    /// </summary>
    private (DateTime Until, string Email)? LockOfThisBrowser()
    {
        if (HttpContext.Request.Cookies.TryGetValue(LockCookie, out var saved) && saved.Split('|') is [var email, var unix]
            && long.TryParse(unix, out var seconds) && DateTimeOffset.FromUnixTimeSeconds(seconds).UtcDateTime is var until && until > Clock.GetUtcNow().UtcDateTime)
        {
            return (until, Uri.UnescapeDataString(email));
        }

        return null;
    }

    private async Task SignInAsync()
    {
        // While the timer of this browser runs nobody signs in from it, with any email and any password (even the right one): the password is not even looked at.
        if (LockOfThisBrowser() is { } browserLock)
        {
            lockedUntil = browserLock.Until;
            lockedEmail = browserLock.Email;
            errorMessage = null;
            Input.Password = "";
            return;
        }

        var result = await Auth.LoginAsync(Input.Email, Input.Password, ClientInfo.From(HttpContext), HttpContext.RequestAborted);

        if (!result.Succeeded)
        {
            if (result.Failure == LoginFailure.LockedOut && result.LockedUntilUtc is { } until)
            {
                lockedUntil = until;
                lockedEmail = Input.Email?.Trim();
                errorMessage = null;   // the box with the timer over the email says it all
                // It lasts as long as the lock (counted from now, not from a date, so a wrong clock of the computer does not matter).
                HttpContext.Response.Cookies.Append(LockCookie, Uri.EscapeDataString(lockedEmail ?? "") + "|" + new DateTimeOffset(DateTime.SpecifyKind(until, DateTimeKind.Utc)).ToUnixTimeSeconds(),
                    new CookieOptions { HttpOnly = true, SameSite = SameSiteMode.Lax, Secure = HttpContext.Request.IsHttps, Path = "/login", MaxAge = TimeSpan.FromSeconds(Math.Max(1, SecondsLeft)) });
            }
            else if (result.Failure == LoginFailure.Maintenance)
            {
                errorMessage = SystemSettings.ClosedMessage;
            }
            else if (result.Failure == LoginFailure.UserNotFound)
            {
                errorMessage = "User Not Found. No account uses this email.";
            }
            else if (result.Failure == LoginFailure.AlreadySignedIn)
            {
                // The alert at the top of the page says it; the form stays as it is.
                errorMessage = null;
                accountInUse = true;
            }
            else
            {
                var limits = SystemSettings.Current;
                errorMessage = $"Incorrect email or password. After {limits.MaxFailedAttempts} wrong attempts " +
                               $"the account is locked for {limits.LockoutMinutes} minutes.";
            }

            Input.Password = "";
            return;
        }

        HttpContext.Response.Cookies.Delete(LockCookie, new CookieOptions { Path = "/login" });
        // The sign-in cookie lives only while the browser is open (no date of its own), and the server ends the sign-in when no page of it has been open for a few minutes.
        var properties = new AuthenticationProperties { IsPersistent = false };

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal!, properties);

        // A page the browser was asking for when the last sign-in ended (?returnUrl=/teacher/subjects/5) belongs to the person who was signed in then. Somebody else who signs in on the same
        // browser would land on a page that is not theirs ("Course not found"), so it is only used when it is the same person (the browser remembers who signed in last) and a page of their role.
        var me = result.Principal!.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        var sameAsLast = HttpContext.Request.Cookies.TryGetValue(LastUserCookie, out var last) && last == me;
        HttpContext.Response.Cookies.Append(LastUserCookie, me, new CookieOptions { HttpOnly = true, SameSite = SameSiteMode.Lax, Secure = HttpContext.Request.IsHttps, MaxAge = TimeSpan.FromDays(60) });
        var home = RoleHome.For(result.Principal!.FindFirstValue(ClaimTypes.Role));
        var wanted = LocalUrl.Sanitize(ReturnUrl);
        GoTo(sameAsLast && LocalUrl.IsPageOf(wanted, home) ? wanted : home);
    }

    /// <summary>
    /// Goes to a page of this site with a <b>relative</b> address (<c>/student</c>). NavigationManager.NavigateTo makes an absolute address from the Host of the request, which is
    /// <c>localhost:5000</c> when the site is opened through a forwarded port (VS Code ports, a dev tunnel, a proxy), and then the browser is sent to a place it can't reach.
    /// A relative address keeps the person on the address they used.
    /// </summary>
    private static void GoTo(string path) => throw new NavigationException(path);

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";

    }
}
