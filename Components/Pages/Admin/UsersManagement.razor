@page "/admin/users"
@page "/admin/users/{RoleKey}"
@attribute [Authorize(Roles = AppRoles.Admin)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using SEAITT_LMS.Auth
@using SEAITT_LMS.Services
@inject UserManagementService Management
@inject TeachingService Teaching
@inject EnrollmentService Enrollment
@inject StudentLifecycleService Lifecycle
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject PresenceService Presence
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@tab.Title · Users Management · SEAITT Legazpi LMS</PageTitle>

<span data-side-rail hidden></span>

<PageHeader Title="Users Management" IconName="users">
    @if (tab.Role == AppRoles.Student)
    {
        <Button IconName="user-plus" OnClick="() => OpenAddAsync(null)">Add student</Button>
    }
    else if (tab.Role == AppRoles.Teacher)
    {
        <Button IconName="user-plus" OnClick="() => OpenAddAsync(null)">Add teacher</Button>
    }
    else
    {
        <Button IconName="user-plus" OnClick="() => OpenAddAsync(null)">Add staff</Button>
    }
</PageHeader>

<nav class="tabs" aria-label="User roles">
    @foreach (var t in Tabs)
    {
        <a class="tab @(t.Key == tab.Key ? "active" : "")" href="@($"admin/users/{t.Key}")" aria-current="@(t.Key == tab.Key ? "page" : null)">
            <Icon Name="@t.Icon" Size="18" />
            <span>@t.Label</span>
            <span class="count">@CountOf(t)</span>
        </a>
    }
</nav>

@if (message is not null)
{
    <div class="banner" role="status">
        <Icon Name="circle-check" Size="18" />
        <span>@message</span>
        <button type="button" class="dismiss" aria-label="Dismiss" @onclick="() => message = null"><Icon Name="x" Size="16" /></button>
    </div>
}

<Card>
    <form class="filter-bar" role="search" @onsubmit="SearchAsync">
        <SearchField Id="u-search" @bind-Value="searchText" Label="Search" Placeholder="@SearchHint" AriaLabel="@($"Search {tab.Title.ToLowerInvariant()}")" OnClear="ClearSearchAsync" />
        @if (tab.Role == UserManagementService.NonTeachingRole)
        {
            <Field For="u-role" Label="Role">
                <select id="u-role" @bind="staffRoleFilter" @bind:after="StatusChangedAsync">
                    <option value="">All staff</option>
                    @foreach (var staffRole in UserManagementService.NonTeachingRoles)
                    {
                        <option value="@staffRole">@AppRoles.DisplayName(staffRole)</option>
                    }
                </select>
            </Field>
        }
        @* The order of the list is at the left of the status. *@
        <Field For="u-sort" Label="Order">
            <select id="u-sort" @bind="sortChoice" @bind:after="StatusChangedAsync">
                <option value="newest">Newest to oldest</option>
                <option value="oldest">Oldest to newest</option>
                <option value="name">Name A to Z</option>
            </select>
        </Field>
        <Field For="u-status" Label="Status">
            <select id="u-status" @bind="statusFilter" @bind:after="StatusChangedAsync">
                <option value="">All statuses</option>
                <option value="active">Activated</option>
                <option value="inactive">Deactivated</option>
                @if (tab.Role == AppRoles.Student)
                {
                    <option value="archived">Archived</option>
                }
            </select>
        </Field>
        <span class="filter-count">@(list is null ? "" : list.Total == 1 ? "1 account" : $"{list.Total:N0} accounts")</span>
    </form>

    @if (list is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (list.Items.Count == 0)
    {
        <EmptyState IconName="@(string.IsNullOrEmpty(appliedSearch) ? tab.Icon : "search-x")"
                    Title="@(string.IsNullOrEmpty(appliedSearch) ? $"No {tab.Title.ToLowerInvariant()} yet" : "No account matches")">
            @if (!string.IsNullOrEmpty(appliedSearch))
            {
                <p>Try another name, email or number.</p>
            }
            else if (tab.Role == AppRoles.Student)
            {
                <p>Students get their account when the registrar enrolls them, or when you add the student here.</p>
            }
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        @if (tab.Role == UserManagementService.NonTeachingRole)
                        {
                            <th scope="col">Role</th>
                        }
                        @if (tab.Role == AppRoles.Student)
                        {
                            <th scope="col">LRN</th>
                            <th scope="col" class="col-more">Section</th>
                            <th scope="col" class="col-more">Courses</th>
                        }
                        else
                        {
                            <th scope="col">Employee no.</th>
                            @if (tab.Role == AppRoles.Teacher)
                            {
                                <th scope="col" class="col-more">Section</th>
                                <th scope="col" class="col-more">Courses</th>
                            }
                            else
                            {
                                <th scope="col" class="col-more">Phone</th>
                            }
                        }
                        <th scope="col">Status</th>
                        <th scope="col" class="col-wide">Last login</th>
                        <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in list.Items)
                    {
                        <tr>
                            <td>
                                <div class="person">
                                    <span class="face">
                                        <Avatar Name="@user.FullName" UserId="@user.UserId" Size="34" />
                                        <span class="dot @(Presence.IsOnline(user.UserId) ? "on" : "")" title="@(Presence.IsOnline(user.UserId) ? "Online now" : "Offline")" role="img"
                                              aria-label="@(Presence.IsOnline(user.UserId) ? "Online now" : "Offline")"></span>
                                    </span>
                                    <div class="person-text">
                                        <span class="person-name">@user.FullName@if (user.UserId == currentUserId) { <span class="you">You</span> }</span>
                                        <span class="sub" title="@user.Email">@user.Email</span>
                                    </div>
                                </div>
                            </td>
                            @if (tab.Role == UserManagementService.NonTeachingRole)
                            {
                                <td>@(user.RoleTitle ?? AppRoles.DisplayName(user.Role))</td>
                            }
                            @if (tab.Role == AppRoles.Student)
                            {
                                <td class="mono">@user.Lrn</td>
                                <td class="col-more">@(user.Placement ?? "Not set yet")</td>
                                <td class="col-more"><CoursesPopup Key="@($"u{user.UserId}")" Who="@user.FullName" Detail="@user.Placement" Names="user.Courses" None="Not enrolled yet" /></td>
                            }
                            else
                            {
                                <td>@(user.EmployeeNumber ?? "—")</td>
                                @if (tab.Role == AppRoles.Teacher)
                                {
                                    <td class="col-more">
                                        @if (SectionsOf(user) is { Count: > 1 } sections)
                                        {
                                            <CoursesPopup Key="@($"u{user.UserId}")" Noun="section" Who="@user.FullName" Detail="Teacher" Names="sections" />
                                        }
                                        else
                                        {
                                            @(user.Placement ?? "—")
                                        }
                                    </td>
                                    <td class="col-more"><CoursesPopup Key="@($"u{user.UserId}")" Who="@user.FullName" Detail="Teacher" Names="user.Courses" None="No course yet" /></td>
                                }
                                else
                                {
                                    <td class="col-more">@(user.PhoneNumber ?? "—")</td>
                                }
                            }
                            <td><Badge Tone="@StatusTone(user)">@StatusText(user)</Badge></td>
                            <td class="col-wide">
                                @if (user.LastLoginAtUtc is { } signedIn)
                                {
                                    @PhilippineTime.FormatDateTime(signedIn)
                                }
                                else
                                {
                                    <span class="muted">Never</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    @if (tab.Role == AppRoles.Teacher)
                                    {
                                        <Button Small="true" Variant="ButtonVariant.Secondary" IconName="book-open" Title="@($"Give or take away the courses of {user.FullName}")"
                                                OnClick="() => OpenTeachingAsync(user)">Assign courses</Button>
                                    }
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="key-round" Title="@($"The email and the password of {user.FullName}")"
                                            OnClick="() => OpenSignInAsync(user)">Sign-in details</Button>
                                    <Button Small="true" Variant="ButtonVariant.Secondary" IconName="pencil" Title="@($"Edit {user.FullName}")"
                                            OnClick="() => OpenEditAsync(user)">Edit</Button>
                                    @if (user.Role == AppRoles.Student && user.StudentStatus == StudentStatus.Active)
                                    {
                                        <Button Small="true" Variant="ButtonVariant.Ghost" IconName="user-x" Title="@($"Mark {user.FullName} as dropped out")"
                                                OnClick="() => OpenDropOut(user)">Drop out</Button>
                                    }
                                    <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" IconOnly="true"
                                            Title="@(user.UserId == currentUserId ? "You can't delete your own account" : $"Delete {user.FullName}")"
                                            Disabled="@(user.UserId == currentUserId)" OnClick="() => OpenDeleteAsync(user)" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (list.PageCount > 1)
        {
            <nav class="pager" aria-label="Pages">
                <Button Variant="ButtonVariant.Secondary" Small="true" IconName="chevron-left" Disabled="@(list.Page <= 1)" OnClick="PreviousPageAsync">Previous</Button>
                <span class="muted">Page @list.Page of @list.PageCount</span>
                <Button Variant="ButtonVariant.Secondary" Small="true" IconAfter="true" IconName="chevron-right" Disabled="@(list.Page >= list.PageCount)" OnClick="NextPageAsync">Next</Button>
            </nav>
        }
    }
</Card>

@* ===== The sign-in details of a row ===== *@
<Modal Open="signInFor is not null" Title="@($"Sign-in details · {signInFor?.FullName}")" Centered="true" OnClose="CloseSignIn">
    @if (signInFor is not null)
    {
        @if (signIn is null)
        {
            <p class="muted">Loading…</p>
        }
        else
        {
            <dl class="account">
                <div><dt>Name</dt><dd>@signIn.FullName</dd></div>
                <div><dt>Role</dt><dd>@signIn.Role</dd></div>
                <div><dt>Email</dt><dd class="mono" id="signin-email">@signIn.Email</dd></div>
                <div>
                    <dt>Password</dt>
                    @if (signIn.Password is { } first)
                    {
                        <dd class="mono" id="signin-password">@first</dd>
                    }
                    else
                    {
                        <dd class="muted" id="signin-password">Not shown</dd>
                    }
                </div>
            </dl>
            @if (signIn.Password is null)
            {
                <p class="hint">The person changed the password, or it was set again in Edit, so nobody can read it. Set a new one in Edit to give it to the person.</p>
            }
            else
            {
                <p class="hint">This is the first password, made from the last name and the number of the person. Tell it to them and ask them to keep it private.</p>
            }

            @if (!signIn.IsActive)
            {
                <p class="hint">This account is deactivated, so the person can't sign in.</p>
            }

            <div class="modal-actions">
                @if (signIn.Password is not null)
                {
                    <Button Variant="ButtonVariant.Secondary" IconName="@(signInCopied ? "circle-check" : "file-text")" OnClick="CopySignInAsync">@(signInCopied ? "Copied" : "Copy the login")</Button>
                }
                <Button OnClick="CloseSignIn">Close</Button>
            </div>
        }
    }
</Modal>

@* ===== Edit ===== *@
<Modal Open="edit is not null" Title="@($"Edit {EditTitle}")" OnClose="CloseEdit">
    @if (edit is not null)
    {
        <EditForm Model="edit" OnValidSubmit="SaveEditAsync">
            <DataAnnotationsValidator />

            <FormErrors Errors="formErrors" />

            <div class="two">
                <Field For="e-first" Label="First name" Required="true">
                    <InputText id="e-first" @bind-Value="edit.FirstName" autocomplete="off" data-letters />
                    <ValidationMessage For="() => edit.FirstName" />
                </Field>
                <Field For="e-middle" Label="Middle name">
                    <InputText id="e-middle" @bind-Value="edit.MiddleName" autocomplete="off" data-letters />
                </Field>
            </div>
            <div class="two">
                <Field For="e-last" Label="Last name" Required="true">
                    <InputText id="e-last" @bind-Value="edit.LastName" autocomplete="off" data-letters />
                    <ValidationMessage For="() => edit.LastName" />
                </Field>
                <Field For="e-ext" Label="Suffix" Hint="Jr., Sr., I to V. Others lets you type another one."><SelectOther Id="e-ext" AriaLabel="Suffix" Choices="PhilippineAddresses.SuffixChoices()" Placeholder="None" MaxLength="10" @bind-Value="edit.NameExtension" /></Field>
            </div>

            <Field For="e-email" Label="Email" Required="true" Hint="This is what they sign in with.">
                <InputText id="e-email" type="email" @bind-Value="edit.Email" autocomplete="off" />
                <ValidationMessage For="() => edit.Email" />
            </Field>

            <div class="two">
                @if (edit.Role == AppRoles.Student)
                {
                    <Field For="e-lrn" Label="LRN" Required="true" Hint="12 digits.">
                        <InputText id="e-lrn" @bind-Value="edit.Lrn" inputmode="numeric" maxlength="12" autocomplete="off" />
                    </Field>
                }
                else
                {
                    <Field For="e-emp" Label="Employee number">
                        <InputText id="e-emp" @bind-Value="edit.EmployeeNumber" autocomplete="off" />
                        <ValidationMessage For="() => edit.EmployeeNumber" />
                    </Field>
                }
                <Field For="e-phone" Label="Phone number" Hint="Like 09171234567">
                    <InputText id="e-phone" @bind-Value="edit.PhoneNumber" inputmode="tel" autocomplete="off" />
                </Field>
            </div>

            <Field For="e-password" Label="New password" Hint="Leave empty to keep the current password. A new one signs the account out everywhere.">
                <InputText id="e-password" type="password" @bind-Value="edit.NewPassword" autocomplete="new-password" />
            </Field>

            <Field For="e-status" Label="Status" Hint="@EditStatusHint">
                <select id="e-status" disabled="@(edit.UserId == currentUserId)" value="@editStatus" @onchange="SetEditStatus">
                    <option value="Active">Activated</option>
                    <option value="Inactive">Deactivated</option>
                    @if (edit.Role == AppRoles.Student)
                    {
                        <option value="DroppedOut">Archived (dropped out)</option>
                        @if (edit.StudentStatus == StudentStatus.Graduated)
                        {
                            <option value="Graduated">Archived (graduated)</option>
                        }
                    }
                </select>
            </Field>

            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseEdit">Cancel</Button>
                <Button Type="submit" IconName="circle-check" Disabled="busy">@(busy ? "Saving…" : "Save changes")</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Add a student ===== *@
<Modal Open="newStudent is not null" Title="Add student" OnClose="CloseAddStudent">
    @if (newStudent is not null)
    {
        <EditForm Model="newStudent" OnValidSubmit="SaveAddStudentAsync">
            <DataAnnotationsValidator />

            <FormErrors Errors="formErrors" />

            <p class="muted small">This makes the account of the student. The registrar enrolls the student in a section later, with the same LRN.</p>

            <div class="two">
                <Field For="s-first" Label="First name" Required="true">
                    <InputText id="s-first" @bind-Value="newStudent.FirstName" autocomplete="off" data-letters />
                    <ValidationMessage For="() => newStudent.FirstName" />
                </Field>
                <Field For="s-middle" Label="Middle name">
                    <InputText id="s-middle" @bind-Value="newStudent.MiddleName" autocomplete="off" data-letters />
                </Field>
            </div>
            <div class="two">
                <Field For="s-last" Label="Last name" Required="true">
                    <input id="s-last" @bind="newStudent.LastName" @bind:event="oninput" autocomplete="off" data-letters />
                    <ValidationMessage For="() => newStudent.LastName" />
                </Field>
                <Field For="s-ext" Label="Suffix" Hint="Jr., Sr., I to V. Others lets you type another one."><SelectOther Id="s-ext" AriaLabel="Suffix" Choices="PhilippineAddresses.SuffixChoices()" Placeholder="None" MaxLength="10" @bind-Value="newStudent.NameExtension" /></Field>
            </div>
            <div class="two">
                <Field For="s-lrn" Label="LRN" Required="true" Hint="12 digits.">
                    <input id="s-lrn" @bind="newStudent.Lrn" @bind:event="oninput" inputmode="numeric" maxlength="12" autocomplete="off" data-digits />
                    <ValidationMessage For="() => newStudent.Lrn" />
                </Field>
                <Field For="s-phone" Label="Phone number" Hint="Like 09171234567">
                    <InputText id="s-phone" @bind-Value="newStudent.PhoneNumber" inputmode="tel" autocomplete="off" />
                </Field>
            </div>
            @* The email and the first password are made by the system from the last name and the end of the LRN, like the registrar's form does. *@
            <section class="signin" aria-label="Sign-in details">
                <h4><Icon Name="key-round" Size="16" /> Sign-in details · student</h4>
                @if (Management.PreviewStudentLogin(newStudent.LastName, newStudent.Lrn) is { } studentLogin)
                {
                    <dl class="preview">
                        <div><dt>Role</dt><dd>Student</dd></div>
                        <div><dt>Email</dt><dd class="mono" id="s-preview-email">@studentLogin.Email</dd></div>
                        <div><dt>First password</dt><dd class="mono" id="s-preview-password">@studentLogin.Password</dd></div>
                    </dl>
                    <p class="hint">Made from the last name and the last 6 digits of the LRN. They are created when you press the button below.</p>
                }
                else
                {
                    <p class="muted">Type the last name and the 12 digits of the LRN and the email and the password appear here.</p>
                }
            </section>

            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseAddStudent">Cancel</Button>
                <Button Type="submit" IconName="user-plus" Disabled="busy">@(busy ? "Adding…" : "Add student")</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Mark a student as dropped out ===== *@
<Modal Open="dropTarget is not null" Title="Mark this student as dropped out?" OnClose="CloseDropOut">
    @if (dropTarget is not null)
    {
        <p class="delete-text">
            <strong>@dropTarget.FullName</strong> (LRN @dropTarget.Lrn) left school. The sign-in is switched off, the enrollments are marked dropped and the student is
            <strong>not in the list of graduating students</strong>. The records stay in the archive, and an administrator can restore the student later.
        </p>
        <Field For="drop-note" Label="Why (optional)">
            <InputText id="drop-note" @bind-Value="dropNote" maxlength="300" autocomplete="off" />
        </Field>
        <FormErrors Errors="formErrors" />
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDropOut">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" IconName="user-x" Disabled="busy" OnClick="ConfirmDropOutAsync">@(busy ? "Saving…" : "Mark as dropped out")</Button>
        </div>
    }
</Modal>

@* ===== Add (teachers, and the staff: registrar, guidance counselor, academic coordinator, academic provider) ===== *@
<Modal Open="add is not null" Title="@AddTitle" OnClose="CloseAdd">
    @if (add is not null)
    {
        @if (tab.Role == UserManagementService.NonTeachingRole)
        {
            @* The role is typed: the name of a role that was used before is picked from the list that opens (the usual roles and the ones made before). A name that is new makes a new role, and then the pages of
               the role are ticked one by one. The first letter of the role starts the employee number (Librarian: L-). This part is not inside the form below, so Enter here does not send the form. *@
            <div class="role-row">
                @if (!roleTyping)
                {
                    @* Round 43: the role is chosen from a list (the usual roles and the ones made before), with New role at the end. Writing a new role takes the box below; when what was written is
                       deleted, the list is back. *@
                    <Field For="a-role-select" Label="Role" Required="true" Class="grow" Hint="Pick the role of the person, or New role to make one.">
                        <select id="a-role-select" @onchange="RolePicked">
                            <option value="" selected="@(roleText.Trim().Length == 0)">Choose a role</option>
                            @foreach (var roleName in RoleNames)
                            {
                                <option value="@roleName" selected="@string.Equals(roleName, roleText.Trim(), StringComparison.OrdinalIgnoreCase)">@roleName</option>
                            }
                            <option value="@NewRoleValue">New role…</option>
                        </select>
                    </Field>
                }
                else
                {
                    <Field For="a-role" Label="Name of the new role" Required="true" Class="grow" Hint="Type it, or pick a role that was used before from the list. Delete it to go back to the list of roles.">
                        <input id="a-role" list="a-roles" maxlength="40" autocomplete="off" placeholder="Like Librarian or Cashier" @bind="RoleText" @bind:event="oninput" />
                        <datalist id="a-roles">
                            @foreach (var roleName in RoleNames)
                            {
                                <option value="@roleName"></option>
                            }
                        </datalist>
                    </Field>
                    <Button Variant="ButtonVariant.Ghost" OnClick="BackToRoleList">Choose from the list</Button>
                }
            </div>

            @if (RoleIsNew)
            {
                <fieldset class="page-picks" aria-label="The pages of the new role">
                    <legend>What pages can the people of the role <strong>@roleText.Trim()</strong> open?</legend>
                    <p class="muted small">Tick every page, one by one: the pages every account has, the analytics and the pages of the registrar, the guidance counselor, the academic coordinator and the academic provider (the pages of the administrator can't be ticked). They get their own dashboard and only the pages you tick.</p>
                    @foreach (var group in StaffPages.All.GroupBy(p => p.Group))
                    {
                        <p class="page-group">@group.Key</p>
                        @foreach (var entry in group)
                        {
                            var key = entry.Key;
                            <label class="page-pick @(newRolePages.Contains(key) ? "on" : "")">
                                <input type="checkbox" name="r-pages" value="@key" checked="@newRolePages.Contains(key)" @onchange="e => TogglePage(key, e.Value is true)" />
                                <span>
                                    <strong>@entry.Title</strong>
                                    <small>@entry.Hint</small>
                                </span>
                            </label>
                        }
                    }
                </fieldset>
            }
        }

        <EditForm Model="add" OnValidSubmit="SaveAddAsync">
            <DataAnnotationsValidator />

            <FormErrors Errors="formErrors" />

            <div class="two">
                <Field For="a-first" Label="First name" Required="true">
                    <InputText id="a-first" @bind-Value="add.FirstName" autocomplete="off" data-letters />
                    <ValidationMessage For="() => add.FirstName" />
                </Field>
                <Field For="a-middle" Label="Middle name">
                    <InputText id="a-middle" @bind-Value="add.MiddleName" autocomplete="off" data-letters />
                </Field>
            </div>
            <div class="two">
                <Field For="a-last" Label="Last name" Required="true">
                    <input id="a-last" @bind="add.LastName" @bind:event="oninput" autocomplete="off" data-letters />
                    <ValidationMessage For="() => add.LastName" />
                </Field>
                <Field For="a-ext" Label="Suffix" Hint="Jr., Sr., I to V. Others lets you type another one."><SelectOther Id="a-ext" AriaLabel="Suffix" Choices="PhilippineAddresses.SuffixChoices()" Placeholder="None" MaxLength="10" @bind-Value="add.NameExtension" /></Field>
            </div>
            <div class="two">
                <Field For="a-emp" Label="Employee number" Required="true" Hint="@($"{(EmployeePrefix.Length > 0 ? EmployeePrefix : "T-")} is put by itself. Type the digits. The email and the password are made from the last name and the digits.")">
                    <input id="a-emp" type="text" maxlength="30" autocomplete="off" @bind="EmployeeValue" @bind:event="oninput" />
                </Field>
                <Field For="a-phone" Label="Phone number" Hint="Like 09171234567">
                    <InputText id="a-phone" @bind-Value="add.PhoneNumber" inputmode="tel" autocomplete="off" />
                </Field>
            </div>
            <Field For="a-status" Label="Status" Hint="An inactive account can't sign in until it is made active.">
                <select id="a-status" value="@(add.IsActive ? "Active" : "Inactive")" @onchange="SetAddStatus">
                    <option value="Active">Activated</option>
                    <option value="Inactive">Deactivated</option>
                </select>
            </Field>
            @* The email and the password are made by the system, like a student's: the last name and the digits of the employee number. *@
            <section class="signin" aria-label="Sign-in details">
                <h4><Icon Name="key-round" Size="16" /> Sign-in details · @SignInRoleName</h4>
                @if (Management.PreviewLogin(add.LastName, add.EmployeeNumber) is { } login)
                {
                    <dl class="preview">
                        <div><dt>Role</dt><dd id="a-preview-role">@SignInRoleName</dd></div>
                        <div><dt>Email</dt><dd class="mono" id="a-preview-email">@login.Email</dd></div>
                        <div><dt>First password</dt><dd class="mono" id="a-preview-password">@login.Password</dd></div>
                    </dl>
                    <p class="hint">Made from the last name and the digits of the employee number. They are created when you press the button below. Tell the password to the person: they can ask an administrator to change it later.</p>
                }
                else
                {
                    <p class="muted">Type the last name and the employee number and the email and the password appear here.</p>
                }
            </section>

            @if (tab.Role == AppRoles.Teacher && teachingLookups is not null)
            {
                @* Where the teacher works. Optional: the courses can also be given later with the Courses button of the list. *@
                <fieldset class="teaching">
                    <legend>Teaching <span class="optional">Optional. Courses can be given later.</span></legend>
                    <Field For="a-track" Label="Track">
                        <select id="a-track" @bind="add.TrackId" @bind:after="AddTrackChanged">
                            <option value="0">Choose a track</option>
                            @foreach (var track in teachingLookups.Tracks)
                            {
                                <option value="@track.Id">@track.Code</option>
                            }
                        </select>
                    </Field>
                    <Field For="a-strand" Label="Strand">
                        <select id="a-strand" disabled="@(add.TrackId == 0)" @bind="add.StrandId" @bind:after="AddStrandChanged">
                            <option value="0">@(add.TrackId == 0 ? "Choose a track first" : "Choose a strand")</option>
                            @foreach (var strand in AddStrands)
                            {
                                <option value="@strand.Id">@strand.Code@(string.Equals(strand.Name, strand.Code, StringComparison.OrdinalIgnoreCase) ? "" : $" · {strand.Name}")</option>
                            }
                        </select>
                    </Field>
                    <Field For="a-section" Label="Section">
                        <select id="a-section" disabled="@(add.StrandId == 0)" @bind="add.SectionId" @bind:after="AddSectionChanged">
                            <option value="0">@(add.StrandId == 0 ? "Choose a strand first" : AddSections.Count == 0 ? "No section for this strand yet" : "Choose a section")</option>
                            @foreach (var choice in AddSections)
                            {
                                <option value="@choice.SectionId">@choice.Label</option>
                            }
                        </select>
                    </Field>
                    <div class="field">
                        <span class="field-label" id="a-courses-label">Courses</span>
                        @if (add.SectionId == 0)
                        {
                            <p class="muted small">Choose a section to see its courses.</p>
                        }
                        else
                        {
                            <div class="course-picks" role="group" aria-labelledby="a-courses-label">
                                @foreach (var course in AddCourses)
                                {
                                    <label class="course-pick">
                                        <input type="checkbox" checked="@add.SubjectIds.Contains(course.SubjectId)" @onchange="e => ToggleAddCourse(course.SubjectId, e.Value is true)" />
                                        <span>@course.Name</span>
                                    </label>
                                }
                            </div>
                            <button type="button" class="link-button" @onclick="ToggleAllAddCourses">@(add.SubjectIds.Count == AddCourses.Count ? "Clear all" : "Select all")</button>
                        }
                    </div>
                </fieldset>
            }

            <div class="modal-actions">
                <Button Variant="ButtonVariant.Ghost" OnClick="CloseAdd">Cancel</Button>
                <Button Type="submit" IconName="user-plus" Disabled="busy">@(busy ? "Adding…" : AddTitle)</Button>
            </div>
        </EditForm>
    }
</Modal>

@* ===== Subjects of a teacher ===== *@
<Modal Open="teachingFor is not null" Title="@($"Courses of {teachingFor?.FullName}")" OnClose="CloseTeaching" Large="true">
    @if (teachingFor is not null)
    {
        <p class="delete-text">
            These are the courses this teacher teaches, and to which section. The teacher opens them under <strong>Courses</strong>, and the
            students of that section see them there too. A course of a section has one teacher.
        </p>

        @if (teachingMessage is not null)
        {
            <div class="banner" role="status"><Icon Name="circle-check" Size="18" /><span>@teachingMessage</span></div>
        }

        <FormErrors Errors="formErrors" />

        @if (assignments is { Count: 0 })
        {
            <p class="muted">No courses yet.</p>
        }
        else if (assignments is not null)
        {
            <ul class="assigned">
                @foreach (var a in assignments)
                {
                    <li>
                        <div class="assigned-text">
                            <strong>@a.SubjectName</strong>
                            <span>@a.SectionLabel · @a.Students @(a.Students == 1 ? "student" : "students") · @a.Modules @(a.Modules == 1 ? "handout" : "handouts")</span>
                        </div>
                        @if (removing?.Id == a.Id)
                        {
                            <div class="assigned-confirm">
                                @if (removalImpact is { Modules: > 0 })
                                {
                                    <span>This deletes @removalImpact.Modules @(removalImpact.Modules == 1 ? "handout" : "handouts"), @removalImpact.Items @(removalImpact.Items == 1 ? "assignment" : "assignments") and @removalImpact.Submissions @(removalImpact.Submissions == 1 ? "piece" : "pieces") of handed-in work.</span>
                                }
                                <Button Small="true" Variant="ButtonVariant.Ghost" OnClick="CancelRemove">Keep</Button>
                                <Button Small="true" Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="ConfirmRemoveAsync">Remove</Button>
                            </div>
                        }
                        else
                        {
                            <Button Small="true" Variant="ButtonVariant.Ghost" IconName="trash-2" Title="@($"Remove {a.SubjectName} from this teacher")" OnClick="() => AskRemoveAsync(a)">Remove</Button>
                        }
                    </li>
                }
            </ul>
        }

        <h3 class="add-heading">Give a course</h3>
        <div class="two">
            <Field For="t-section" Label="Section">
                <select id="t-section" @bind="chosenSection" @bind:after="SectionChanged">
                    <option value="0">Choose a section</option>
                    @foreach (var choice in sectionChoices ?? [])
                    {
                        <option value="@choice.SectionId">@choice.Label</option>
                    }
                </select>
            </Field>
            <Field For="t-subject" Label="Course">
                <select id="t-subject" @bind="chosenSubject" disabled="@(chosenSection == 0)">
                    <option value="0">@(chosenSection == 0 ? "Choose the section first" : "Choose a course")</option>
                    @foreach (var subject in SubjectsOfChosenSection)
                    {
                        <option value="@subject.SubjectId">@subject.Name</option>
                    }
                </select>
            </Field>
        </div>
        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseTeaching">Close</Button>
            <Button IconName="plus" Disabled="@(busy || chosenSection == 0 || chosenSubject == 0)" OnClick="AssignAsync">Give the course</Button>
        </div>
    }
</Modal>

@* ===== Delete ===== *@
<Modal Open="deleteTarget is not null" Title="Delete this account?" OnClose="CloseDelete">
    @if (deleteTarget is not null)
    {
        <p class="delete-text">
            You are about to delete <strong>@deleteTarget.FullName</strong> (@deleteTarget.Email).
            <strong>This can't be undone.</strong>
        </p>

        @if (impact is { Effects.Count: > 0 })
        {
            <ul class="effects">
                @foreach (var effect in impact.Effects)
                {
                    <li>@effect</li>
                }
            </ul>
        }

        <FormErrors Errors="formErrors" />

        <div class="modal-actions">
            <Button Variant="ButtonVariant.Ghost" OnClick="CloseDelete">Keep the account</Button>
            <Button Variant="ButtonVariant.Danger" IconName="trash-2" Disabled="busy" OnClick="ConfirmDeleteAsync">@(busy ? "Deleting…" : "Delete the account")</Button>
        </div>
    }
</Modal>

@code {
    private const int PageSize = 15;

    /// <summary>Label is what the tab says (short, so all five fit), Title is the plural name used in the texts.</summary>
    private sealed record Tab(string Key, string Role, string Title, string Singular, string Icon, string? ShortLabel = null)
    {
        public string Label => ShortLabel ?? Title;
    }

    // Three lists: the students, the teachers, and the staff who do not teach (registrar, guidance counselor, academic coordinators and academic providers,
    // each with its role). There is no list of administrators: the school has one and it is not managed here.
    private static readonly Tab[] Tabs =
    [
        new("students", AppRoles.Student, "Students", "student", "graduation-cap"),
        new("teachers", AppRoles.Teacher, "Teachers", "teacher", "presentation"),
        new("staff", UserManagementService.NonTeachingRole, "Staff / Non-teaching", "staff member", "id-card", "Staff / Non-teaching"),
    ];

    // The old addresses of the lists of the staff open the staff list with that role chosen (the menu and the search link to them).
    private static readonly Dictionary<string, string> StaffAddresses = new(StringComparer.OrdinalIgnoreCase)
    {
        ["registrars"] = AppRoles.Registrar,
        ["guidance"] = AppRoles.GuidanceCounselor,
        ["coordinators"] = AppRoles.AcademicCoordinator,
        ["providers"] = AppRoles.AcademicProvider,
    };

    /// <summary>The roles that can be given to a new member of the staff: the academic provider always, and the registrar, the guidance counselor and the academic coordinator only while the school has none.</summary>
    private IReadOnlyList<string> AvailableStaffRoles =>
        UserManagementService.NonTeachingRoles.Where(r => !AppRoles.OnlyOneAllowed(r) || counts.GetValueOrDefault(r) == 0).ToList();

    private int CountOf(Tab t) => t.Role == UserManagementService.NonTeachingRole
        ? UserManagementService.NonTeachingRoles.Sum(r => counts.GetValueOrDefault(r))
        : counts.GetValueOrDefault(t.Role);

    private string AddTitle => tab.Role == UserManagementService.NonTeachingRole
        ? (roleText.Trim().Length > 0 ? $"Add {SignInRoleName.ToLowerInvariant()}" : "Add staff")
        : $"Add {tab.Singular}";

    private static string StatusText(UserListItem user) => user.StudentStatus switch
    {
        StudentStatus.DroppedOut or StudentStatus.Graduated => "Archived",
        _ => user.IsActive ? "Activated" : "Deactivated",
    };

    private static Tone StatusTone(UserListItem user) => user.StudentStatus switch
    {
        StudentStatus.DroppedOut => Tone.Warning,
        StudentStatus.Graduated => Tone.Info,
        _ => user.IsActive ? Tone.Success : Tone.Neutral,
    };

    private string EditStatusHint => edit is null ? "" : edit.UserId == currentUserId
        ? "You can't deactivate your own account."
        : edit.Role == AppRoles.Student
            ? "A deactivated account can't sign in. Archived: the student left school or graduated; the sign-in is off and the records stay in Archive Accounts."
            : "A deactivated account can't sign in.";

    private sealed class NewStaff
    {
        [Required(ErrorMessage = "Enter the first name."), StringLength(100)]
        public string FirstName { get; set; } = "";

        [StringLength(100)]
        public string? MiddleName { get; set; }

        [Required(ErrorMessage = "Enter the last name."), StringLength(100)]
        public string LastName { get; set; } = "";

        [StringLength(10, ErrorMessage = "At most 10 characters.")]
        public string? NameExtension { get; set; }

        // (not asked: the system makes the email and the password of a teacher or a member of the staff)

        public string Email { get; set; } = "";

        public string? PhoneNumber { get; set; }

        [StringLength(30, ErrorMessage = "At most 30 characters.")]
        public string? EmployeeNumber { get; set; }

        public string Password { get; set; } = "";

        public bool IsActive { get; set; } = true;

        /// <summary>The staff list only: the role of the new account.</summary>
        public string Role { get; set; } = "";

        /// <summary>The staff list only: the role made up by the administrator (Add role) the account has; <see cref="Role"/> is the role it works like.</summary>
        public int? CustomRoleId { get; set; }

        // Teachers only: where they work (all optional).
        public int TrackId { get; set; }
        public int StrandId { get; set; }
        public int SectionId { get; set; }
        public HashSet<int> SubjectIds { get; set; } = [];
    }

    [Parameter] public string? RoleKey { get; set; }

    /// <summary>Words to search for, from the address (?q=...).</summary>
    [SupplyParameterFromQuery(Name = "q")] private string? InitialSearch { get; set; }

    private Tab tab = Tabs[0];
    private string? loadedKey;
    private int currentUserId;
    private string searchText = "";
    private string appliedSearch = "";
    private string statusFilter = "";
    private string sortChoice = UserManagementService.SortName;
    private string staffRoleFilter = "";
    private int pageNumber = 1;
    private UserPage? list;
    private IReadOnlyDictionary<string, int> counts = new Dictionary<string, int>();

    private string? message;
    private bool busy;
    private List<string> formErrors = [];

    private UserEdit? edit;
    private NewStaff? add;

    // The roles made up by the administrator, and the role that is typed in Add staff.
    private IReadOnlyList<CustomRole> customRoles = [];
    private string roleText = "";
    private readonly HashSet<string> newRolePages = ["calendar", "users", "groups"];

    /// <summary>The names the list of the role box offers: the usual roles of the staff, and the roles made before.</summary>
    private IEnumerable<string> RoleNames => AvailableStaffRoles.Select(AppRoles.DisplayName).Concat(customRoles.Select(c => c.Name));

    private static string? BuiltInOf(string text) => UserManagementService.NonTeachingRoles.FirstOrDefault(r =>
        string.Equals(AppRoles.DisplayName(r), text.Trim(), StringComparison.OrdinalIgnoreCase) || string.Equals(r, text.Replace(" ", "").Trim(), StringComparison.OrdinalIgnoreCase));

    private CustomRole? CustomOf(string text) => customRoles.FirstOrDefault(c => string.Equals(c.Name, text.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>The name typed is not a role that is there: it makes a new one, and its pages are ticked.</summary>
    private bool RoleIsNew => roleText.Trim().Length > 0 && BuiltInOf(roleText) is null && CustomOf(roleText) is null;

    /// <summary>What the Sign-in details say the person is: the role that was typed, or Teacher.</summary>
    private string SignInRoleName => tab.Role == AppRoles.Teacher ? "Teacher"
        : BuiltInOf(roleText) is { } built ? AppRoles.DisplayName(built) : roleText.Trim().Length > 0 ? roleText.Trim() : "Staff";

    private string RoleText
    {
        get => roleText;
        set
        {
            roleText = value ?? "";
            ApplyRole();

            // The name that was being written is deleted: the list of roles is back.
            if (roleTyping && roleText.Trim().Length == 0)
            {
                roleTyping = false;
            }
        }
    }

    /// <summary>The list of roles is shown (false) or the box where a new role is written (true).</summary>
    private bool roleTyping;

    private const string NewRoleValue = "__new";

    private void RolePicked(ChangeEventArgs e)
    {
        var picked = e.Value?.ToString() ?? "";
        if (picked == NewRoleValue)
        {
            RoleText = "";
            roleTyping = true;
            return;
        }

        RoleText = picked;
    }

    private void BackToRoleList()
    {
        roleTyping = false;
        RoleText = "";
    }

    /// <summary>The role that matches what was typed (a usual role, or one made before); a new name has no role yet. The employee number starts with the first letter of the role.</summary>
    private void ApplyRole()
    {
        if (add is null)
        {
            return;
        }

        if (BuiltInOf(roleText) is { } built)
        {
            add.Role = built;
            add.CustomRoleId = null;
        }
        else if (CustomOf(roleText) is { } custom)
        {
            add.Role = custom.BaseRole;
            add.CustomRoleId = custom.Id;
        }
        else
        {
            add.Role = CustomRole.DefaultBaseRole;
            add.CustomRoleId = null;
        }

        add.EmployeeNumber = WithPrefix(add.EmployeeNumber);
    }

    /// <summary>T- for a teacher; for the staff the first letter of the role and a dash (Librarian: L-). Nothing until a role is typed.</summary>
    private string EmployeePrefix => tab.Role == AppRoles.Teacher ? "T-"
        : roleText.Trim().Length > 0 && char.IsLetter(roleText.Trim()[0]) ? char.ToUpperInvariant(roleText.Trim()[0]) + "-" : "";

    private string WithPrefix(string? value)
    {
        var digits = System.Text.RegularExpressions.Regex.Replace((value ?? "").Trim(), "^[A-Za-z]-", "").TrimStart('-');
        return EmployeePrefix + digits;
    }

    private string EmployeeValue
    {
        get => add?.EmployeeNumber ?? "";
        set
        {
            if (add is not null)
            {
                add.EmployeeNumber = WithPrefix(value);
            }
        }
    }

    private void TogglePage(string key, bool on)
    {
        if (on)
        {
            newRolePages.Add(key);
        }
        else
        {
            newRolePages.Remove(key);
        }
    }

    // ---------- the sign-in details of a row
    private UserListItem? signInFor;
    private UserManagementService.SignInDetails? signIn;
    private bool signInCopied;

    private async Task OpenSignInAsync(UserListItem user)
    {
        signInFor = user;
        signIn = null;
        signInCopied = false;
        signIn = await Management.GetSignInDetailsAsync(user.UserId, currentUserId);
    }

    private void CloseSignIn()
    {
        signInFor = null;
        signIn = null;
    }

    private async Task CopySignInAsync()
    {
        if (signIn is not null)
        {
            signInCopied = await JS.InvokeAsync<bool>("seaitt.copyText", $"Email: {signIn.Email}" + (signIn.Password is null ? "" : $"\nPassword: {signIn.Password}"));
        }
    }
    private UserListItem? deleteTarget;
    private DeleteImpact? impact;

    private string SearchHint => tab.Role == AppRoles.Student ? "Search by name, LRN or email" : "Search by name, employee number or email";

    private string EditTitle => edit is null ? "" : string.Join(' ', new[] { edit.FirstName, edit.LastName }.Where(p => !string.IsNullOrWhiteSpace(p)));

    private Timer? onlineTimer;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
        _ = int.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);

        // The green dots follow who has a page open, so look again now and then.
        onlineTimer = new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose() => onlineTimer?.Dispose();

    /// <summary>The sections a teacher teaches in ("11-BUSSENT-A, 12-HT1-A" is two).</summary>
    private static IReadOnlyList<string> SectionsOf(UserListItem user) =>
        (user.Placement ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override async Task OnParametersSetAsync()
    {
        // /admin/users alone, or an address that is not one of the tabs, opens the first tab.
        var found = Tabs.FirstOrDefault(t => string.Equals(t.Key, RoleKey, StringComparison.OrdinalIgnoreCase));
        var addressRole = RoleKey is not null && StaffAddresses.TryGetValue(RoleKey, out var staffOfAddress) ? staffOfAddress : null;
        if (found is null && addressRole is not null)
        {
            found = Tabs.First(t => t.Role == UserManagementService.NonTeachingRole);
        }

        if (found is null)
        {
            Navigation.NavigateTo($"admin/users/{Tabs[0].Key}", replace: true);
            return;
        }

        // The tab and the words in the address (?q=...) decide what is shown; the search page links here with a name.
        var loading = $"{found.Key}|{addressRole}|{InitialSearch}";
        if (loading != loadedKey)
        {
            tab = found;
            loadedKey = loading;
            searchText = appliedSearch = InitialSearch?.Trim() ?? "";
            statusFilter = "";
            staffRoleFilter = addressRole ?? "";
            pageNumber = 1;
            message = null;
            list = null;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        list = await Management.ListAsync(tab.Role, appliedSearch, pageNumber, PageSize, active: ActiveFilter, sort: sortChoice, status: StudentFilter, staffRole: staffRoleFilter);

        // The last account of the last page was deleted: show the new last page.
        if (list.Items.Count == 0 && pageNumber > 1)
        {
            pageNumber = list.PageCount;
            list = await Management.ListAsync(tab.Role, appliedSearch, pageNumber, PageSize, active: ActiveFilter, sort: sortChoice, status: StudentFilter, staffRole: staffRoleFilter);
        }

        counts = await Management.CountByRoleAsync();
    }

    private string editStatus = "Active";

    private void SetEditStatus(ChangeEventArgs e)
    {
        editStatus = e.Value?.ToString() ?? "Active";
        edit!.IsActive = editStatus == "Active";
    }

    private void SetAddStatus(ChangeEventArgs e) => add!.IsActive = e.Value?.ToString() != "Inactive";

    // Students use their own filter (active, inactive, dropped out, graduated); the others use active or inactive.
    private bool? ActiveFilter => tab.Role == AppRoles.Student ? null : statusFilter switch { "active" => true, "inactive" => false, _ => null };

    private string? StudentFilter => tab.Role == AppRoles.Student && statusFilter.Length > 0 ? statusFilter : null;

    private async Task StatusChangedAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        appliedSearch = searchText.Trim();
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        searchText = appliedSearch = "";
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        pageNumber = Math.Max(1, pageNumber - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        pageNumber++;
        await LoadAsync();
    }

    // ---------- edit
    private async Task OpenEditAsync(UserListItem user)
    {
        formErrors = [];
        edit = await Management.GetForEditAsync(user.UserId);
        if (edit is null)
        {
            message = "This account no longer exists.";
            await LoadAsync();
            return;
        }

        editStatus = edit.StudentStatus is StudentStatus.DroppedOut or StudentStatus.Graduated ? edit.StudentStatus : edit.IsActive ? "Active" : "Inactive";
    }

    private void CloseEdit()
    {
        edit = null;
        formErrors = [];
    }

    private async Task SaveEditAsync()
    {
        if (edit is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            // A student who comes back from the archive (dropped out or graduated) is restored first; the other changes are saved after that.
            var wasArchived = edit.StudentStatus is StudentStatus.DroppedOut or StudentStatus.Graduated;
            var wantsArchived = editStatus is StudentStatus.DroppedOut or StudentStatus.Graduated;
            if (edit.Role == AppRoles.Student && edit.StudentId is { } studentId && wasArchived && !wantsArchived)
            {
                var restored = await Lifecycle.RestoreAsync(studentId, currentUserId);
                if (!restored.Succeeded)
                {
                    formErrors = restored.Errors.ToList();
                    return;
                }
            }

            edit.IsActive = editStatus == "Active";
            var result = await Management.UpdateAsync(edit, currentUserId);
            if (result.Succeeded)
            {
                var dropFailed = false;
                if (edit.Role == AppRoles.Student && edit.StudentId is { } id && editStatus == StudentStatus.DroppedOut && edit.StudentStatus == StudentStatus.Active)
                {
                    var dropped = await Lifecycle.DropOutAsync(id, null, currentUserId);
                    dropFailed = !dropped.Succeeded;
                    if (dropFailed)
                    {
                        formErrors = dropped.Errors.ToList();
                    }
                }

                if (!dropFailed)
                {
                    message = result.Message;
                    CloseEdit();
                    await LoadAsync();
                }
            }
            else
            {
                formErrors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- drop out
    private UserListItem? dropTarget;
    private string dropNote = "";

    private void OpenDropOut(UserListItem user)
    {
        formErrors = [];
        dropNote = "";
        dropTarget = user;
    }

    private void CloseDropOut()
    {
        dropTarget = null;
        formErrors = [];
    }

    private async Task ConfirmDropOutAsync()
    {
        if (dropTarget is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var studentId = await Management.GetStudentIdAsync(dropTarget.UserId);
            var result = studentId is { } id ? await Lifecycle.DropOutAsync(id, dropNote, currentUserId) : ServiceResult.Fail("This student was not found.");
            if (result.Succeeded)
            {
                message = result.Message;
                CloseDropOut();
                await LoadAsync();
            }
            else
            {
                formErrors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- add a student
    private NewStudentAccount? newStudent;

    private void CloseAddStudent()
    {
        newStudent = null;
        formErrors = [];
    }

    private async Task SaveAddStudentAsync()
    {
        if (newStudent is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Management.AddStudentAsync(newStudent, currentUserId);
            if (result.Succeeded)
            {
                message = result.Message;
                CloseAddStudent();
                sortChoice = UserManagementService.SortNewest; // the new account is the first one
                await LoadAsync();
            }
            else
            {
                formErrors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- add
    private EnrollmentLookups? teachingLookups;
    private IReadOnlyList<SectionChoice> addSectionChoices = [];

    private IEnumerable<StrandOption> AddStrands => teachingLookups!.Strands.Where(s => s.TrackId == add!.TrackId);

    private IReadOnlyList<SectionChoice> AddSections => addSectionChoices.Where(s => s.StrandId == add!.StrandId).ToList();

    private IReadOnlyList<SubjectChoice> AddCourses => addSectionChoices.FirstOrDefault(s => s.SectionId == add!.SectionId)?.Subjects ?? [];

    private async Task OpenAddAsync(string? role)
    {
        formErrors = [];

        if (tab.Role == AppRoles.Student)
        {
            newStudent = new NewStudentAccount();
            return;
        }

        // A teacher is added together with the track, strand, section and courses they work in: load the choices before the box opens.
        if (tab.Role == AppRoles.Teacher)
        {
            teachingLookups = await Enrollment.GetLookupsAsync();
            addSectionChoices = await Teaching.GetAssignableAsync();
        }

        if (tab.Role == UserManagementService.NonTeachingRole)
        {
            customRoles = await Management.ListCustomRolesAsync();
            roleText = "";
            roleTyping = false;
            newRolePages.Clear();
            newRolePages.UnionWith(["calendar", "users", "groups"]);
        }

        add = new NewStaff
        {
            // The staff list: the role is typed (nothing at first). A teacher's employee number starts with T-.
            Role = tab.Role != UserManagementService.NonTeachingRole ? tab.Role : CustomRole.DefaultBaseRole,
        };
        add.EmployeeNumber = WithPrefix("");
    }

    private void AddTrackChanged()
    {
        add!.StrandId = 0;
        AddStrandChanged();
    }

    private void AddStrandChanged()
    {
        add!.SectionId = 0;
        add.SubjectIds.Clear();
    }

    private void AddSectionChanged() => add!.SubjectIds.Clear();

    private void ToggleAddCourse(int subjectId, bool on)
    {
        if (on)
        {
            add!.SubjectIds.Add(subjectId);
        }
        else
        {
            add!.SubjectIds.Remove(subjectId);
        }
    }

    private void ToggleAllAddCourses()
    {
        var all = AddCourses;
        if (add!.SubjectIds.Count == all.Count)
        {
            add.SubjectIds.Clear();
        }
        else
        {
            add.SubjectIds = all.Select(c => c.SubjectId).ToHashSet();
        }
    }

    private void CloseAdd()
    {
        add = null;
        formErrors = [];
    }

    private async Task SaveAddAsync()
    {
        if (add is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            // A role name that is new makes the role first, with the pages that were ticked.
            if (tab.Role == UserManagementService.NonTeachingRole)
            {
                if (roleText.Trim().Length == 0)
                {
                    formErrors = ["Write the name of the role (like Librarian), or pick one from the list."];
                    return;
                }

                if (RoleIsNew)
                {
                    var created = await Management.AddRoleAsync(roleText, newRolePages, currentUserId);
                    if (!created.Succeeded)
                    {
                        formErrors = [.. created.Errors];
                        return;
                    }

                    customRoles = await Management.ListCustomRolesAsync();
                    add.CustomRoleId = created.Id;
                    add.Role = CustomRole.DefaultBaseRole;
                }
            }

            var account = new NewAccount(
                add.Role, add.Email, add.Password, add.FirstName, add.LastName, add.MiddleName, add.NameExtension,
                add.PhoneNumber, EmployeeNumber: add.EmployeeNumber, IsActive: add.IsActive, CustomRoleId: add.CustomRoleId);

            var result = add.Role == AppRoles.Teacher
                ? await Management.AddTeacherAsync(account, new TeacherPlacement(add.TrackId, add.StrandId, add.SectionId, add.SubjectIds.ToList()), currentUserId)
                : await Management.AddStaffAsync(account, currentUserId);
            if (result.Succeeded)
            {
                message = result.Message;
                CloseAdd();
                await LoadAsync();
            }
            else
            {
                formErrors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- delete
    private async Task OpenDeleteAsync(UserListItem user)
    {
        formErrors = [];
        deleteTarget = user;
        impact = await Management.GetDeleteImpactAsync(user.UserId);
    }

    private void CloseDelete()
    {
        deleteTarget = null;
        impact = null;
        formErrors = [];
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleteTarget is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Management.DeleteAsync(deleteTarget.UserId, currentUserId);
            if (result.Succeeded)
            {
                message = result.Message;
                CloseDelete();
                await LoadAsync();
            }
            else
            {
                formErrors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    // ---------- the subjects of a teacher
    private UserListItem? teachingFor;
    private IReadOnlyList<AssignmentRow>? assignments;
    private IReadOnlyList<SectionChoice>? sectionChoices;
    private int chosenSection;
    private int chosenSubject;
    private string? teachingMessage;
    private AssignmentRow? removing;
    private RemovalImpact? removalImpact;

    private IReadOnlyList<SubjectChoice> SubjectsOfChosenSection =>
        sectionChoices?.FirstOrDefault(c => c.SectionId == chosenSection)?.Subjects ?? [];

    private async Task OpenTeachingAsync(UserListItem user)
    {
        formErrors = [];
        teachingMessage = null;
        removing = null;
        chosenSection = chosenSubject = 0;
        sectionChoices = await Teaching.GetAssignableAsync();
        assignments = await Teaching.ListForTeacherUserAsync(user.UserId);
        teachingFor = user;
    }

    private void CloseTeaching()
    {
        teachingFor = null;
        formErrors = [];
    }

    private void SectionChanged() => chosenSubject = 0;

    private async Task AssignAsync()
    {
        if (teachingFor is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Teaching.AssignAsync(teachingFor.UserId, chosenSection, chosenSubject, currentUserId);
            if (result.Succeeded)
            {
                formErrors = [];
                teachingMessage = result.Message;
                chosenSubject = 0;
                assignments = await Teaching.ListForTeacherUserAsync(teachingFor.UserId);
            }
            else
            {
                teachingMessage = null;
                formErrors = result.Errors.ToList();
            }
        }
        finally
        {
            busy = false;
        }
    }

    private async Task AskRemoveAsync(AssignmentRow row)
    {
        removing = row;
        removalImpact = await Teaching.GetRemovalImpactAsync(row.Id);
    }

    private void CancelRemove()
    {
        removing = null;
        removalImpact = null;
    }

    private async Task ConfirmRemoveAsync()
    {
        if (teachingFor is null || removing is null || busy)
        {
            return;
        }

        busy = true;
        try
        {
            var result = await Teaching.RemoveAsync(removing.Id, currentUserId);
            teachingMessage = result.Succeeded ? result.Message : null;
            formErrors = result.Succeeded ? [] : result.Errors.ToList();
            removing = null;
            removalImpact = null;
            assignments = await Teaching.ListForTeacherUserAsync(teachingFor.UserId);
        }
        finally
        {
            busy = false;
        }
    }
}
