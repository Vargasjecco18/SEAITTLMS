@page "/admin/settings"
@attribute [Authorize(Roles = AppRoles.Admin)]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject SystemSettingsService Settings
@inject NotificationSoundService Sounds

<PageTitle>System Settings · SEAITT Legazpi LMS</PageTitle>

<PageHeader Title="System Settings" IconName="settings-2" />

<Notice Message="@message" IsError="@messageIsError" OnDismiss="ClearMessage" />
<FormErrors Errors="errors" />

@if (form is not null)
{
    <form id="settings-form" class="grid" @onsubmit="SaveAsync">
        <Card Title="Maintenance" IconName="settings-2">
            <p class="note">While maintenance is on, only administrators can sign in or use the system. Everybody else sees the message below.</p>
            <label class="check">
                <input id="s-maintenance" type="checkbox" @bind="form.MaintenanceOn" />
                <span><strong>Close the system for maintenance</strong><small>People who are signed in are sent to the message when they open another page.</small></span>
            </label>
            <Field For="s-message" Label="Message">
                <textarea id="s-message" class="input" rows="3" maxlength="300" @bind="form.MaintenanceMessage"></textarea>
            </Field>
        </Card>

        <Card Title="Files and lockers" IconName="folder-open">
            <p class="note">What people can upload: a file in a locker, an attachment of a module or a file sent in a message.</p>
            <div class="two">
                <Field For="s-max-file" Label="Biggest file (MB)" Hint="From 1 to 1000. Each file can be this big.">
                    <input id="s-max-file" type="number" class="input" min="1" max="1000" @bind="form.MaxFileMegabytes" />
                </Field>
                <Field For="s-locker" Label="Locker of each person (MB)" Hint="From 10 to 50000. All the files of a person together.">
                    <input id="s-locker" type="number" class="input" min="10" max="50000" @bind="form.LockerMegabytes" />
                </Field>
            </div>
            @if (packetMegabytes > 0 && packetMegabytes < form.MaxFileMegabytes + 1)
            {
                <p class="warn" id="s-packet-warning">
                    The database accepts files up to <strong>@packetMegabytes MB</strong> only, so a bigger file can't be saved. To allow @form.MaxFileMegabytes MB, put <code>max_allowed_packet=1G</code> under
                    <code>[mysqld]</code> in the my.ini of MySQL and restart MySQL (the app asks MySQL for it by itself when its user is allowed to).
                </p>
            }
        </Card>

        <Card Title="Notification sound of the school" IconName="bell">
            <p class="note">The sound people hear when a new message or notification arrives, unless they chose another one in their Settings. Without a file, the browser plays two short tones.</p>
            @if (schoolSound is { } current)
            {
                <p class="sound-now" id="s-sound-name"><Icon Name="music" Size="16" /> <strong>@current.SchoolName</strong></p>
            }
            else
            {
                <p class="sound-now" id="s-sound-name"><Icon Name="music" Size="16" /> No file. The two short tones are used.</p>
            }

            <div class="sound-row">
                <button type="button" class="link-button" data-sound-test data-sound-choice="@(schoolSound is null ? "tones" : "school")" data-sound-url="@(schoolSound is null ? "" : $"account/school-sound?v={schoolSound.SchoolVersion}")">Play it</button>
                @if (schoolSound is not null)
                {
                    <button type="button" class="link-button" disabled="@soundBusy" @onclick="RemoveSchoolSoundAsync">Remove it</button>
                }
            </div>
            <label class="sound-upload">
                <span>Choose a sound file: .mp3, .ogg, .wav or .m4a, up to @(NotificationSoundService.MaxBytes / (1024 * 1024)) MB (a second or two is enough)</span>
                <InputFile id="s-sound-file" OnChange="SchoolSoundChosenAsync" accept=".mp3,.ogg,.oga,.wav,.m4a,.aac,audio/*" disabled="@soundBusy" aria-label="Choose the sound of the school" />
            </label>
            @if (soundMessage is not null)
            {
                <p class="@(soundFailed ? "warn" : "note")" role="status" id="s-sound-message">@soundMessage</p>
            }
        </Card>

        <Card Title="Backups and the log" IconName="database-backup">
            <p class="note">The backups themselves are made on the <a href="admin/backups">Database Backup &amp; Restore</a> page.</p>
            <label class="check">
                <input id="s-auto" type="checkbox" @bind="form.AutoBackupOn" />
                <span><strong>Make a backup by itself every day</strong><small>The system must be running at that time.</small></span>
            </label>
            <div class="two">
                <Field For="s-auto-hour" Label="From this hour (Philippine time)">
                    <select id="s-auto-hour" class="input" disabled="@(!form.AutoBackupOn)" @bind="form.AutoBackupHour">
                        @foreach (var hour in Hours)
                        {
                            <option value="@hour">@MessagingHours.HourText(hour)</option>
                        }
                    </select>
                </Field>
                <Field For="s-keep" Label="Automatic backups to keep" Hint="The older ones are deleted. From 1 to 60.">
                    <input id="s-keep" type="number" class="input" min="1" max="60" disabled="@(!form.AutoBackupOn)" @bind="form.BackupsToKeep" />
                </Field>
            </div>
            <Field For="s-log" Label="Days the security log is kept" Hint="Older lines are deleted once a day. From 30 to 3650.">
                <input id="s-log" type="number" class="input" min="30" max="3650" @bind="form.LogKeepDays" />
            </Field>
        </Card>

        <div class="save-bar">
            <Button Type="submit" IconName="save" Disabled="@busy">@(busy ? "Saving…" : "Save settings")</Button>
            <Button Variant="ButtonVariant.Ghost" IconName="rotate-ccw" Disabled="@busy" OnClick="Reload">Undo my changes</Button>
        </div>
    </form>
}

@code {
    private static readonly int[] Hours = Enumerable.Range(0, 24).ToArray();

    private int userId;
    private long packetMegabytes;
    private SoundInfo? schoolSound;
    private bool soundBusy;
    private bool soundFailed;
    private string? soundMessage;
    private SettingsForm? form;
    private IReadOnlyList<string> errors = [];
    private string? message;
    private bool messageIsError;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        userId = (await Me.GetAsync())?.UserId ?? 0;
        packetMegabytes = await Settings.GetDatabasePacketBytesAsync() / (1024 * 1024);
        await LoadSchoolSoundAsync();
        Reload();
    }

    private async Task LoadSchoolSoundAsync()
    {
        var info = await Sounds.GetInfoAsync(userId);
        schoolSound = info.HasSchool ? info : null;
    }

    private async Task SchoolSoundChosenAsync(InputFileChangeEventArgs e)
    {
        if (soundBusy)
        {
            return;
        }

        soundBusy = true;
        try
        {
            var file = e.File;
            if (file.Size > NotificationSoundService.MaxBytes)
            {
                soundFailed = true;
                soundMessage = $"The sound is bigger than {NotificationSoundService.MaxBytes / (1024 * 1024)} MB. A sound of a second or two is enough.";
                return;
            }

            await using var stream = file.OpenReadStream(NotificationSoundService.MaxBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var result = await Sounds.SaveSchoolAsync(userId, file.Name, buffer.ToArray());
            soundFailed = !result.Succeeded;
            soundMessage = result.Succeeded ? result.Message : string.Join(" ", result.Errors);
            await LoadSchoolSoundAsync();
        }
        catch (IOException)
        {
            soundFailed = true;
            soundMessage = "The file could not be read. Try again.";
        }
        finally
        {
            soundBusy = false;
        }
    }

    private async Task RemoveSchoolSoundAsync()
    {
        if (soundBusy)
        {
            return;
        }

        soundBusy = true;
        try
        {
            var result = await Sounds.RemoveSchoolAsync(userId);
            soundFailed = !result.Succeeded;
            soundMessage = result.Succeeded ? result.Message : string.Join(" ", result.Errors);
            await LoadSchoolSoundAsync();
        }
        finally
        {
            soundBusy = false;
        }
    }

    private void ClearMessage() => message = null;

    private void Reload()
    {
        form = SettingsForm.From(Settings.Current);
        errors = [];
    }

    private async Task SaveAsync()
    {
        if (busy || form is null)
        {
            return;
        }

        busy = true;
        try
        {
            // The number of students in a section is changed by the academic coordinator (Academic setup > Sections): what is saved here is the number it has now.
            form.SectionCapacity = Settings.Current.SectionCapacity;
            var result = await Settings.SaveAsync(userId, form.ToValues());
            errors = result.Succeeded ? [] : result.Errors;
            messageIsError = false;
            message = result.Succeeded ? result.Message : null;
        }
        finally
        {
            busy = false;
        }
    }

    // The boxes are bound to this (the record of the settings can't change, so it is copied in and out).
    private sealed class SettingsForm
    {
        public string SchoolName { get; set; } = "";
        public string SchoolShortName { get; set; } = "";
        public string Tagline { get; set; } = "";
        public string Address { get; set; } = "";
        public string ContactEmail { get; set; } = "";
        public string ContactPhone { get; set; } = "";
        public int MaxFailedAttempts { get; set; }
        public int LockoutMinutes { get; set; }
        public bool MaintenanceOn { get; set; }
        public string MaintenanceMessage { get; set; } = "";
        public bool MessagesHaveClosingHours { get; set; }
        public int MessagesCloseHour { get; set; }
        public int MessagesOpenHour { get; set; }
        public bool AutoBackupOn { get; set; }
        public int AutoBackupHour { get; set; }
        public int BackupsToKeep { get; set; }
        public int LogKeepDays { get; set; }
        public int SectionCapacity { get; set; }
        public int MaxFileMegabytes { get; set; }
        public int LockerMegabytes { get; set; }

        public static SettingsForm From(SystemSettingsValues v) => new()
        {
            SchoolName = v.SchoolName, SchoolShortName = v.SchoolShortName, Tagline = v.Tagline, Address = v.Address,
            ContactEmail = v.ContactEmail, ContactPhone = v.ContactPhone, MaxFailedAttempts = v.MaxFailedAttempts, LockoutMinutes = v.LockoutMinutes,
            MaintenanceOn = v.MaintenanceOn, MaintenanceMessage = v.MaintenanceMessage, MessagesHaveClosingHours = v.MessagesHaveClosingHours,
            MessagesCloseHour = v.MessagesCloseHour, MessagesOpenHour = v.MessagesOpenHour, AutoBackupOn = v.AutoBackupOn,
            AutoBackupHour = v.AutoBackupHour, BackupsToKeep = v.BackupsToKeep, LogKeepDays = v.LogKeepDays,
            SectionCapacity = v.SectionCapacity, MaxFileMegabytes = v.MaxFileMegabytes, LockerMegabytes = v.LockerMegabytes,
        };

        public SystemSettingsValues ToValues() => new()
        {
            SchoolName = SchoolName, SchoolShortName = SchoolShortName, Tagline = Tagline, Address = Address,
            ContactEmail = ContactEmail, ContactPhone = ContactPhone, MaxFailedAttempts = MaxFailedAttempts, LockoutMinutes = LockoutMinutes,
            MaintenanceOn = MaintenanceOn, MaintenanceMessage = MaintenanceMessage, MessagesHaveClosingHours = MessagesHaveClosingHours,
            MessagesCloseHour = MessagesCloseHour, MessagesOpenHour = MessagesOpenHour, AutoBackupOn = AutoBackupOn,
            AutoBackupHour = AutoBackupHour, BackupsToKeep = BackupsToKeep, LogKeepDays = LogKeepDays,
            SectionCapacity = SectionCapacity, MaxFileMegabytes = MaxFileMegabytes, LockerMegabytes = LockerMegabytes,
        };
    }
}
