@page "/admin"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using Microsoft.EntityFrameworkCore
@using SEAITT_LMS.Data
@using SEAITT_LMS.Data.Queries
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TimeProvider Clock

<PageTitle>Admin · SEAITT e-LMS</PageTitle>
<AutoRefresh />

<PageHeader Title="Admin dashboard" Subtitle="The teachers, the students and the school setup at a glance." IconName="layout-dashboard" />

@if (overview is not null)
{
    <section aria-labelledby="accounts-title">
        <h2 id="accounts-title" class="section-title">Accounts</h2>

        <div class="stats">
            @* Only the teachers and the students (the staff accounts are in Users Management). *@
            @foreach (var role in overview.Roles.Where(r => r.Role is AppRoles.Teacher or AppRoles.Student))
            {
                var (label, icon, color, key) = RoleLook(role.Role);
                <StatCard Label="@label" Value="@role.Total" IconName="@icon" Accent="@color"
                          Hint="@InactiveHint(role.Inactive)" Href="@($"admin/users/{key}")" />
            }
        </div>
    </section>

    <div class="stack">
        <Card Title="School setup" IconName="school">
            <ul class="setup">
                @foreach (var item in SetupItems(overview.Setup))
                {
                    <li>
                        <a class="setup-link" href="admin/school-setup/@item.Key">
                            <span class="setup-icon"><Icon Name="@item.Icon" Size="18" /></span>
                            <span class="setup-text">
                                <strong class="setup-count">@item.Count.ToString("N0")</strong>
                                <span class="setup-label">@item.Label@(item.ReadOnly ? " · view only" : "")</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
            <p class="note">Add, edit and delete them in the school setup. Enrollments and the students who are not enrolled are the registrar's work: you can look at them, but not change them.</p>
            <p class="see-all"><a href="admin/school-setup">Open the school setup <Icon Name="arrow-right" Size="16" /></a></p>
        </Card>

        <Card Title="Latest accounts" IconName="users">
            @if (overview.LatestAccounts.Count == 0)
            {
                <EmptyState IconName="users" Title="No accounts yet" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Role</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="last-sign-in">Last sign-in</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in overview.LatestAccounts)
                            {
                                <tr>
                                    <td>
                                        <div class="person">
                                            <Avatar Name="@account.Name" Size="34" />
                                            <div class="person-text">
                                                <span class="person-name">@account.Name</span>
                                                <span class="person-email" title="@account.Email">@account.Email</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><Badge Tone="Tone.Info">@account.Role</Badge></td>
                                    <td>
                                        @if (!account.IsActive)
                                        {
                                            <Badge Tone="Tone.Neutral">Inactive</Badge>
                                        }
                                        else if (account.IsLocked)
                                        {
                                            <Badge Tone="Tone.Danger">Locked</Badge>
                                        }
                                        else
                                        {
                                            <Badge Tone="Tone.Success">Active</Badge>
                                        }
                                    </td>
                                    <td class="last-sign-in">
                                        @if (account.LastLoginAtUtc is { } signedIn)
                                        {
                                            @PhilippineTime.FormatDateTime(signedIn)
                                        }
                                        else
                                        {
                                            <span class="never">Never</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Card>
    </div>
}

@code {
    private AdminOverview? overview;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        overview = await AdminOverview.LoadAsync(db, Clock.GetUtcNow().UtcDateTime);
    }

    private static string? InactiveHint(int inactive) => inactive > 0 ? $"{inactive} inactive" : null;

    private static (string Label, string Icon, AccentColor Color, string Key) RoleLook(string role) => role switch
    {
        AppRoles.Admin => ("Administrators", "shield-check", AccentColor.Violet, "administrators"),
        AppRoles.Teacher => ("Teachers", "presentation", AccentColor.Blue, "teachers"),
        AppRoles.Student => ("Students", "graduation-cap", AccentColor.Green, "students"),
        AppRoles.Registrar => ("Registrars", "clipboard-check", AccentColor.Amber, "registrars"),
        _ => ("Guidance counselors", "heart-handshake", AccentColor.Rose, "guidance"),
    };

    private static (string Label, string Icon, int Count, string Key, bool ReadOnly)[] SetupItems(SetupTotals setup) =>
    [
        ("School years", "calendar-range", setup.SchoolYears, "school-years", false),
        ("Terms", "calendar-days", setup.Terms, "terms", false),
        ("Tracks", "layers", setup.Tracks, "tracks", false),
        ("Strands", "layout-grid", setup.Strands, "strands", false),
        ("Courses", "book-open", setup.Subjects, "subjects", false),
        ("Sections", "users", setup.Sections, "sections", false),
        ("Enrollments", "user-check", setup.Enrollments, "enrollments", true),
        ("Not enrolled", "user-x", setup.NotEnrolled, "not-enrolled", true),
    ];
}
